script milvusCoverage
targets [ milvus ]
version "1.0"
description "Every native and concealed Milvus statement, in an order that runs against a fresh server"
param queryVector : vector = [0.9, 0.1, 0.0, 0.1]
param queryText : text = "vector database"

connectLocal: create connection local uri "http://localhost:19530"

dropBooks: drop books if-exists

dropNotes: drop notes if-exists

plainCheck: create analyzer plainProbe tokenizer standard

foldedCheck: create analyzer foldedProbe tokenizer standard { filter lower type lowercase }

createBooks: create collection books consistency strong {
    primary id
    analyzer english tokenizer standard language "en"
    field id type int
    field title type varchar max-length 256 full-text analyzer english
    field category type varchar max-length 64
    field price type float
    field tags type array element-type varchar field-limit tagLimit array_len = 8
    field meta type json nullable
    vector-field embedding type float_vector dim 4 metric cosine {
        vector-index embeddingIndex family hnsw max-degree 16 build-candidates 200
    }
    vector-field titleSparse type sparse_float_vector
    payload-index categoryIndex on category kind keyword
    function titleBm25 type bm25 input [title] output [titleSparse]
    alias shelf for books
} with {
    create payload-index priceRange on price kind float
}

createNotes: create collection notes consistency strong {
    primary id
    field id type int
    field body type varchar max-length 256
    vector-field noteVector type float_vector dim 2 metric cosine
    partition drafts
    namespace teamA key "team-a"
    tenant north
    tenant beta
} with {
    create tenant gamma
}

analyticsDb: create logical-db analytics {
    collection events {
        primary id
        field id type int
        vector-field eventVector type float_vector dim 2 metric cosine
    }
}

evolveBooks: alter books {
    add-field field pages type int
    add-field vector-field summaryVector type float_vector dim 2 metric cosine
    set description = "Books about databases"
    set ttl = 86400
    set dynamic = true
    set consistency = "strong"
    add-alias alias stacks for books
}

seed: insert into books values [
    { id: 1, title: "Milvus in action: vector database design", category: "books", price: 39.5, tags: ["vector", "database"], embedding: [0.9, 0.1, 0.0, 0.1] },
    { id: 2, title: "Approximate nearest neighbour search", category: "books", price: 52.0, tags: ["ann"], embedding: [0.8, 0.2, 0.1, 0.0] },
    { id: 3, title: "Espresso machine", category: "kitchen", price: 249.0, tags: ["coffee"], embedding: [0.0, 0.1, 0.9, 0.3] },
    { id: 4, title: "Graph databases explained", category: "books", price: 28.0, tags: ["graph", "database"], embedding: [0.5, 0.5, 0.2, 0.1] }
]

serverImport: bulk-import into books from "s3://a-bucket/vecdsl/books.jsonl" format json

localImport: bulk-import into books from "file://../books_local.jsonl" format json

trimBooks: alter books { drop-field meta }

restock: upsert into books values [
    { id: 4, title: "Graph databases explained", category: "books", price: 30.0, tags: ["graph", "database"], embedding: [0.5, 0.5, 0.2, 0.1] }
]

reprice: update books set { price: 35.0 } ids [1]

priceReady: await-index priceRange until ready timeout 120

vectorsReady: await-index embeddingIndex until ready timeout 120

reindexPrice: rebuild-index priceRange

reindexVectors: rebuild-index embeddingIndex

persist: flush books

compactBooks: compact books

loadBooks: load books

similar: vector-search in books top 3 query vector $queryVector using embedding output [title, price] where category eq "books"

keywords: search in books top 2 query text $queryText fields [title] output [title]

hybrid: hybrid-search in books top 3 fusion rrf fusion-k 60 {
    vector { query vector $queryVector using embedding limit 10 }
    keyword { query text $queryText fields [title] limit 10 }
} output [title]

byId: get from books ids [1, 4] output [title, price]

recommended: recommend in books top 2 positive [1] negative [3] using embedding output [title]

browse: scroll in books limit 10 output [title, price]

firstTwo: sample in books size 2 method first output [title]

anyTwo: sample in books size 2 output [title]

pairs: distance-matrix in books using embedding sample 3 limit 2

hybridPage: hybrid-search in books top 2 fusion rrf fusion-k 60 offset 1 consistency strong {
    vector { query vector $queryVector using embedding limit 10 }
    keyword { query text $queryText fields [title] limit 10 }
} output [title]

hybridGroups: hybrid-search in books top 2 fusion rrf fusion-k 60 group-by category size 1 {
    vector { query vector $queryVector using embedding limit 10 }
    keyword { query text $queryText fields [title] limit 10 }
} output [title, category]

byIdStrong: get from books ids [2] consistency strong output [title]

browsePage: scroll in books limit 3 offset 2 output [title]

pairsKitchen: distance-matrix in books using embedding sample 3 limit 2 consistency strong where category eq "kitchen"

both: batch-query {
    count in books
    count in books where price lt 40
}

info: describe books stats index-progress

collectionNames: list collections prefix "bo"

databaseNames: list databases

aliasNames: list aliases in books

indexNames: list indexes in books

partitionNames: list partitions in notes

tenantNames: list tenants in notes

writeNorth: insert into notes values [ { id: 1, body: "first note", noteVector: [1.0, 0.0] } ] tenant north

writeTeam: insert into notes values [ { id: 2, body: "team note", noteVector: [0.0, 1.0] }, { id: 3, body: "second team note", noteVector: [0.6, 0.8] } ] namespace "team-a"

countNorth: count in notes tenant north

countTeam: count in notes namespace "team-a"

releaseNotes: release notes

loadNotes: load notes

removeBeta: drop beta

removeDrafts: drop drafts

clearNorth: delete from notes all tenant north

northLeft: count in notes tenant north

trimKitchen: delete from books limit 1 where category eq "kitchen"

moveShelf: swap-alias shelf from books to notes

dropStacks: drop stacks

nightly: snapshot books as "nightly" description "before cleanup"

snapshotNames: list snapshots in books

copyBooks: clone books to "booksCopy"

createArchive: create collection archive {
    primary id
    field id type int
    vector-field archiveVector type float_vector dim 2 metric cosine
}

dropArchive: drop archive

restoreArchive: restore archive from "nightly"

restored: count in archive

dropNightly: drop-snapshot "nightly"

emptyBooks: truncate books

remaining: count in books

clearTeam: truncate notes namespace "team-a"

teamLeft: count in notes namespace "team-a"

renameNotes: alter notes rename to notesArchive
