				newLeafNode(enumLiteral_2, grammarAccess.getEGeoRelationAccess().getCONTAINSEnumLiteralDeclaration_2());
			}
		)
		    |
		(
			enumLiteral_3='disjoint'
			{
				$current = grammarAccess.getEGeoRelationAccess().getDISJOINTEnumLiteralDeclaration_3().getEnumLiteral().getInstance();
				newLeafNode(enumLiteral_3, grammarAccess.getEGeoRelationAccess().getDISJOINTEnumLiteralDeclaration_3());
			}
		)
	)
;

RULE_DECIMAL : RULE_INT '.' RULE_INT;

RULE_ID : '^'? ('a'..'z'|'A'..'Z'|'_') ('a'..'z'|'A'..'Z'|'_'|'0'..'9')*;

RULE_INT : ('0'..'9')+;

RULE_STRING : ('"' ('\\' .|~(('\\'|'"')))* '"'|'\'' ('\\' .|~(('\\'|'\'')))* '\'');

RULE_ML_COMMENT : '/*' ( options {greedy=false;} : . )*'*/';

RULE_SL_COMMENT : '//' ~(('\n'|'\r'))* ('\r'? '\n')?;

RULE_WS : (' '|'\t'|'\r'|'\n')+;

RULE_ANY_OTHER : .;
