/**
 * Runtime support for vecDSL programs generated for Chroma over its HTTP API (/api/v2), with java.net.http and Gson.
 * Generated by vecDSL 7. Do not edit.
 */
public final class ChromaRuntime {

	private static final int PAGE = 256;
	private static final int BATCH = 100;
	private static final int DIGITS = 6;
	private static final Gson GSON = new GsonBuilder().create();
	private static final Gson REQUESTS = new GsonBuilder().serializeNulls().create();
	private static final Gson PRETTY = new GsonBuilder().serializeNulls().setPrettyPrinting().create();
	private static final Gson NUMBERS = new GsonBuilder().setObjectToNumberStrategy(ToNumberPolicy.LONG_OR_DOUBLE).create();
	private static final HttpClient HTTP = HttpClient.newBuilder().version(HttpClient.Version.HTTP_1_1).build();
	private static final Comparator<Object> ORDER = ChromaRuntime::compare;

	private ChromaRuntime() {
	}

	public static final class UnsupportedFeature extends UnsupportedOperationException {

		private static final long serialVersionUID = 1L;

		UnsupportedFeature(String message) {
			super(message);
		}
	}

	public static RuntimeException unsupported(String vendor, String feature) {
		return new UnsupportedFeature(feature + " is not supported for target " + vendor);
	}

	// ---------------------------------------------------------------- values

	public static Map<String, Object> args(Object... pairs) {
		Map<String, Object> result = new LinkedHashMap<>();
		for (int i = 0; i < pairs.length; i += 2) {
			result.put((String) pairs[i], pairs[i + 1]);
		}
		return result;
	}

	public static List<Object> list(Object... items) {
		return new ArrayList<>(Arrays.asList(items));
	}

	public static String env(String name) {
		String value = System.getenv(name);
		if (value == null) {
			throw new IllegalStateException("environment variable " + name + " is not set");
		}
		return value;
	}

	public static String envOr(String name, String fallback) {
		String value = System.getenv(name);
		return value == null ? fallback : value;
	}

	public static String text(Object value) {
		return value == null ? null : value.toString();
	}

	public static long integer(Object value) {
		return ((Number) value).longValue();
	}

	public static double decimal(Object value) {
		return ((Number) value).doubleValue();
	}

	public static boolean flag(Object value) {
		return (Boolean) value;
	}

	public static List<Float> floats(Object value) {
		return ((Collection<?>) value).stream().map(item -> ((Number) item).floatValue()).toList();
	}

	public static List<String> texts(Object value) {
		return ((Collection<?>) value).stream().map(String::valueOf).toList();
	}

	@SuppressWarnings("unchecked")
	public static List<Map<String, Object>> records(Object value) {
		return (List<Map<String, Object>>) value;
	}

	public static String toJson(Object value) {
		return PRETTY.toJson(value);
	}

	public static Map<String, Object> parameters(Map<String, Object> given, Map<String, Object> defaults, List<String> names) {
		Set<String> unknown = new HashSet<>(given.keySet());
		unknown.removeAll(names);
		if (!unknown.isEmpty()) {
			throw new IllegalArgumentException("unknown program parameters: " + unknown);
		}
		Map<String, Object> values = new LinkedHashMap<>(defaults);
		values.putAll(given);
		List<String> missing = names.stream().filter(name -> !values.containsKey(name)).toList();
		if (!missing.isEmpty()) {
			throw new IllegalArgumentException("missing program parameters: " + missing);
		}
		return values;
	}

	public static Map<String, Object> parseArguments(String[] arguments) {
		Map<String, Object> parameters = new LinkedHashMap<>();
		for (String argument : arguments) {
			int separator = argument.indexOf('=');
			if (separator < 0) {
				throw new IllegalArgumentException("expected name=value, got " + argument);
			}
			String raw = argument.substring(separator + 1);
			Object value;
			try {
				value = NUMBERS.fromJson(JsonParser.parseString(raw), Object.class);
			} catch (JsonParseException e) {
				value = raw;
			}
			parameters.put(argument.substring(0, separator), value);
		}
		return parameters;
	}

	/** Result values in one form for every host language: floats rounded, integral numbers as integers. */
	@SuppressWarnings("unchecked")
	static Object value(Object item) {
		if (item instanceof Float || item instanceof Double) {
			double number = ((Number) item).doubleValue();
			if (!Double.isFinite(number)) {
				return number;
			}
			double rounded = new BigDecimal(number).setScale(DIGITS, RoundingMode.HALF_EVEN).doubleValue();
			return rounded == Math.rint(rounded) && Math.abs(rounded) < 1e15 ? (Object) (long) rounded : (Object) rounded;
		}
		if (item instanceof Number number) {
			return number.longValue();
		}
		if (item instanceof Collection<?> items) {
			return items.stream().map(ChromaRuntime::value).toList();
		}
		if (item instanceof Map<?, ?> map) {
			Map<String, Object> result = new LinkedHashMap<>();
			((Map<String, Object>) map).forEach((key, entry) -> result.put(key, value(entry)));
			return result;
		}
		return item;
	}

	/** Chroma id of a primary key: the key's text; integral numbers print without a fraction. */
	public static String recordId(Object key) {
		if (key instanceof Integer || key instanceof Long || key instanceof Short || key instanceof Byte || key instanceof BigInteger) {
			return key.toString();
		}
		if ((key instanceof Double || key instanceof Float) && Double.isFinite(((Number) key).doubleValue())
				&& ((Number) key).doubleValue() == Math.rint(((Number) key).doubleValue())) {
			return new BigDecimal(((Number) key).doubleValue()).toBigInteger().toString();
		}
		if (key instanceof String string) {
			return string;
		}
		throw new IllegalArgumentException("cannot use " + key + " as a Chroma primary key");
	}

	private static int compare(Object a, Object b) {
		if (a == null || b == null) {
			return a == null ? (b == null ? 0 : 1) : -1;
		}
		if (a instanceof Number x && b instanceof Number y) {
			return Double.compare(x.doubleValue(), y.doubleValue());
		}
		return a.toString().compareTo(b.toString());
	}

	private static <T> List<List<T>> chunks(List<T> items, int size) {
		List<List<T>> result = new ArrayList<>();
		for (int start = 0; start < items.size(); start += size) {
			result.add(items.subList(start, Math.min(items.size(), start + size)));
		}
		return result;
	}

	@SuppressWarnings("unchecked")
	private static Map<String, Object> map(Object value) {
		return value == null ? new LinkedHashMap<>() : (Map<String, Object>) value;
	}

	@SuppressWarnings("unchecked")
	private static List<Object> items(Object value) {
		return value == null ? new ArrayList<>() : (List<Object>) value;
	}

	private static String string(Map<String, Object> args, String key) {
		Object value = args.get(key);
		return value == null ? null : value.toString();
	}

	private static List<String> strings(Object value) {
		return items(value).stream().map(String::valueOf).toList();
	}

	private static List<Double> vector(Object value) {
		return items(value).stream().map(item -> ((Number) item).doubleValue()).toList();
	}

	// ---------------------------------------------------------------- HTTP

	/** The server endpoint, its tenant and default database. */
	public static final class Client implements AutoCloseable {

		final String base;
		final String tenant;
		final String database;

		Client(String uri, String tenant, String database) {
			this.base = uri.endsWith("/") ? uri.substring(0, uri.length() - 1) : uri;
			this.tenant = tenant;
			this.database = database;
		}

		@Override
		public void close() {
		}
	}

	public static Client connect(Map<String, Object> args) {
		String tenant = string(args, "tenant");
		String database = string(args, "database");
		return new Client(string(args, "uri"), tenant == null ? "default_tenant" : tenant, database == null ? "default_database" : database);
	}

	private static String encode(String segment) {
		return URLEncoder.encode(segment, StandardCharsets.UTF_8).replace("+", "%20");
	}

	private static Object call(Client client, String method, String path, Object body) {
		HttpRequest.Builder request = HttpRequest.newBuilder(URI.create(client.base + "/api/v2" + path)).timeout(Duration.ofSeconds(120))
				.header("Content-Type", "application/json");
		request.method(method, body == null ? HttpRequest.BodyPublishers.noBody()
				: HttpRequest.BodyPublishers.ofString(REQUESTS.toJson(body), StandardCharsets.UTF_8));
		HttpResponse<String> response;
		try {
			response = HTTP.send(request.build(), HttpResponse.BodyHandlers.ofString(StandardCharsets.UTF_8));
		} catch (IOException e) {
			throw new IllegalStateException("Chroma request " + method + " " + path + " failed", e);
		} catch (InterruptedException e) {
			Thread.currentThread().interrupt();
			throw new IllegalStateException("Chroma request " + method + " " + path + " was interrupted", e);
		}
		if (response.statusCode() >= 300) {
			throw new IllegalStateException("Chroma " + method + " " + path + " returned " + response.statusCode() + ": " + response.body());
		}
		String text = response.body();
		return text == null || text.isBlank() ? null : NUMBERS.fromJson(text, Object.class);
	}

	private static String databasePath(Client client, Object database) {
		return "/tenants/" + encode(client.tenant) + "/databases/" + encode(database == null ? client.database : database.toString());
	}

	private static String collectionPath(Client client, Map<String, Object> collection) {
		String id = map(call(client, "GET", databasePath(client, collection.get("database")) + "/collections/"
				+ encode(collection.get("name").toString()), null)).get("id").toString();
		return databasePath(client, collection.get("database")) + "/collections/" + id;
	}

	private static Map<String, Object> collectionInfo(Client client, Object name, Object database) {
		return map(call(client, "GET", databasePath(client, database) + "/collections/" + encode(name.toString()), null));
	}

	// ---------------------------------------------------------------- databases and collections

	private static List<String> databaseNames(Client client) {
		return items(call(client, "GET", "/tenants/" + encode(client.tenant) + "/databases", null)).stream()
				.map(item -> map(item).get("name").toString()).toList();
	}

	public static boolean hasDatabase(Client client, Map<String, Object> args) {
		return databaseNames(client).contains(string(args, "name"));
	}

	public static void createDatabase(Client client, Map<String, Object> args) {
		call(client, "POST", "/tenants/" + encode(client.tenant) + "/databases", args("name", string(args, "name")));
	}

	public static void dropDatabase(Client client, Map<String, Object> args) {
		call(client, "DELETE", databasePath(client, string(args, "name")), null);
	}

	private static List<String> collectionNames(Client client, Object database) {
		List<String> names = new ArrayList<>();
		while (true) {
			List<Object> page = items(call(client, "GET", databasePath(client, database) + "/collections?limit=" + PAGE + "&offset=" + names.size(), null));
			page.forEach(item -> names.add(map(item).get("name").toString()));
			if (page.size() < PAGE) {
				return names;
			}
		}
	}

	public static boolean hasCollection(Client client, Map<String, Object> args) {
		return collectionNames(client, args.get("database")).contains(string(args, "name"));
	}

	/** Collection metadata; tags are kept as JSON text, because the server rejects array values there. */
	private static Map<String, Object> collectionMetadata(Object metadata) {
		if (metadata == null || map(metadata).isEmpty()) {
			return null;
		}
		Map<String, Object> result = new LinkedHashMap<>();
		map(metadata).forEach((key, item) -> result.put(key, key.equals("tags") ? GSON.toJson(item) : item));
		return result;
	}

	/** A collection whose embeddings the program supplies: no embedding function, the HNSW space and parameters given. */
	public static void createCollection(Client client, Map<String, Object> args) {
		Map<String, Object> hnsw = new LinkedHashMap<>();
		hnsw.put("space", args.get("metric"));
		hnsw.putAll(map(args.get("hnsw")));
		Map<String, Object> body = args("name", args.get("name"), "configuration", args("hnsw", hnsw), "get_or_create", false);
		Map<String, Object> metadata = collectionMetadata(args.get("metadata"));
		if (metadata != null) {
			body.put("metadata", metadata);
		}
		call(client, "POST", databasePath(client, args.get("database")) + "/collections", body);
	}

	public static void dropCollection(Client client, Map<String, Object> args) {
		call(client, "DELETE", databasePath(client, args.get("database")) + "/collections/" + encode(string(args, "name")), null);
	}

	/** The collection must exist; Chroma serves every collection and its metadata is schemaless. */
	public static void requireCollection(Client client, Map<String, Object> args) {
		collectionInfo(client, args.get("name"), args.get("database"));
	}

	private static void modify(Client client, Map<String, Object> args, Map<String, Object> body) {
		String id = collectionInfo(client, args.get("name"), args.get("database")).get("id").toString();
		call(client, "PUT", databasePath(client, args.get("database")) + "/collections/" + id, body);
	}

	public static void renameCollection(Client client, Map<String, Object> args) {
		modify(client, args, args("new_name", args.get("new_name")));
	}

	/** Mutable HNSW parameters, and collection metadata merged into the stored metadata (modify replaces it). */
	public static void alterCollection(Client client, Map<String, Object> args) {
		if (args.get("hnsw") != null) {
			modify(client, args, args("new_configuration", args("hnsw", args.get("hnsw"))));
		}
		if (args.get("metadata") != null) {
			Map<String, Object> merged = new LinkedHashMap<>(map(collectionInfo(client, args.get("name"), args.get("database")).get("metadata")));
			merged.putAll(collectionMetadata(args.get("metadata")));
			modify(client, args, args("new_metadata", merged));
		}
	}

	/** Name, metadata and HNSW settings; the local server indexes every write before it answers, so progress is always ready. */
	public static Map<String, Object> describe(Client client, Map<String, Object> args) {
		Map<String, Object> info = collectionInfo(client, args.get("name"), args.get("database"));
		Map<String, Object> hnsw = map(map(info.get("configuration_json")).get("hnsw"));
		Map<String, Object> metadata = new LinkedHashMap<>();
		map(info.get("metadata")).forEach((key, item) -> metadata.put(key, key.equals("tags") ? NUMBERS.fromJson(item.toString(), Object.class) : item));
		Map<String, Object> settings = new LinkedHashMap<>();
		hnsw.keySet().stream().filter(key -> hnsw.get(key) != null).sorted().forEach(key -> settings.put(key, value(hnsw.get(key))));
		Map<String, Object> result = args("name", info.get("name"), "database", args.get("database") == null ? client.database : args.get("database"),
				"metadata", metadata, "hnsw", settings);
		if (Boolean.TRUE.equals(args.get("stats"))) {
			result.put("count", count(client, args("collection", args("name", args.get("name"), "database", args.get("database")))));
		}
		if (Boolean.TRUE.equals(args.get("index_progress"))) {
			result.put("index_progress", "ready");
		}
		return result;
	}

	public static String awaitIndex(Client client, Map<String, Object> args) {
		requireCollection(client, args);
		return "ready";
	}

	/** Names of databases, collections, or the tenant or namespace values of a collection's slice key, sorted. */
	public static List<String> listObjects(Client client, Map<String, Object> args) {
		String kind = string(args, "kind");
		List<String> names;
		if (kind.equals("databases")) {
			names = databaseNames(client);
		} else if (kind.equals("collections")) {
			names = collectionNames(client, args.get("scope") == null ? null : map(args.get("scope")).get("database"));
		} else {
			String key = string(args, "key");
			Set<String> values = new LinkedHashSet<>();
			for (Map<String, Object> row : rows(client, map(args.get("scope")), null, List.of(key), null, false)) {
				if (row.get(key) != null) {
					values.add(row.get(key).toString());
				}
			}
			names = new ArrayList<>(values);
		}
		String prefix = string(args, "prefix");
		List<String> result = names.stream().filter(name -> prefix == null || name.startsWith(prefix)).sorted().toList();
		return args.get("limit") == null ? result : result.subList(0, Math.min(result.size(), ((Number) args.get("limit")).intValue()));
	}

	/** A new collection with the source's configuration and metadata, filled with a copy of every record. */
	public static Map<String, Object> cloneCollection(Client client, Map<String, Object> args) {
		Map<String, Object> collection = map(args.get("collection"));
		Map<String, Object> info = collectionInfo(client, collection.get("name"), collection.get("database"));
		Map<String, Object> stored = map(map(info.get("configuration_json")).get("hnsw"));
		Map<String, Object> hnsw = new LinkedHashMap<>();
		hnsw.put("space", stored.getOrDefault("space", "l2"));
		for (String key : List.of("ef_construction", "ef_search", "max_neighbors")) {
			if (stored.get(key) != null) {
				hnsw.put(key, stored.get(key));
			}
		}
		Map<String, Object> body = args("name", args.get("target"), "configuration", args("hnsw", hnsw), "get_or_create", false);
		if (!map(info.get("metadata")).isEmpty()) {
			body.put("metadata", info.get("metadata"));
		}
		call(client, "POST", databasePath(client, collection.get("database")) + "/collections", body);
		String source = databasePath(client, collection.get("database")) + "/collections/" + info.get("id");
		String target = collectionPath(client, args("name", args.get("target"), "database", collection.get("database")));
		int copied = 0;
		for (Map<String, Object> page : pages(client, source, null, List.of("metadatas", "documents", "embeddings"), null)) {
			Map<String, Object> add = args("ids", page.get("ids"), "embeddings", page.get("embeddings"), "metadatas", page.get("metadatas"));
			if (items(page.get("documents")).stream().anyMatch(doc -> doc != null)) {
				add.put("documents", page.get("documents"));
			}
			call(client, "POST", target + "/add", add);
			copied += items(page.get("ids")).size();
		}
		return args("copied", copied);
	}

	// ---------------------------------------------------------------- records

	private record Entry(String id, List<Double> embedding, Map<String, Object> metadata, Object document) {
	}

	private static void check(Map<String, Object> collection, Map<String, Object> record) {
		for (Map.Entry<String, Object> limit : map(collection.get("limits")).entrySet()) {
			Object item = record.get(limit.getKey());
			if (item == null) {
				continue;
			}
			Map<String, Object> bounds = map(limit.getValue());
			if (bounds.containsKey("max_items") && items(item).size() > ((Number) bounds.get("max_items")).intValue()) {
				throw new IllegalArgumentException(limit.getKey() + " has " + items(item).size() + " items; at most " + bounds.get("max_items") + " are allowed");
			}
			if (bounds.containsKey("max_length")) {
				for (Object text : item instanceof Collection<?> many ? many : List.of(item)) {
					if (text instanceof String string && string.length() > ((Number) bounds.get("max_length")).intValue()) {
						throw new IllegalArgumentException(limit.getKey() + " is longer than " + bounds.get("max_length") + " characters");
					}
				}
			}
		}
	}

	/** Integral numbers of integer fields as integers, also inside arrays. */
	private static Object typed(Map<String, Object> collection, String name, Object item) {
		if (!strings(collection.get("integers")).contains(name)) {
			return item;
		}
		if (item instanceof Number number && !(item instanceof Long) && number.doubleValue() == Math.rint(number.doubleValue())) {
			return number.longValue();
		}
		if (item instanceof Collection<?> many) {
			return many.stream().map(element -> typed(collection, name, element)).toList();
		}
		return item;
	}

	private static boolean absent(Object item) {
		return item == null || (item instanceof Collection<?> many && many.isEmpty());
	}

	/** Id, embedding, metadata and document of a record; null values and empty arrays are left out, as Chroma stores neither. */
	private static Entry entry(Map<String, Object> collection, Map<String, Object> row, Object slice) {
		Map<String, Object> record = new LinkedHashMap<>(map(collection.get("defaults")));
		record.putAll(row);
		record.putAll(map(slice));
		Object key = record.get(string(collection, "key"));
		if (key == null) {
			throw new IllegalArgumentException("record without primary key " + collection.get("key") + ": " + row);
		}
		check(collection, record);
		String vectorField = string(collection, "vector");
		if (record.get(vectorField) == null) {
			throw new IllegalArgumentException("record without vector " + vectorField + ": " + row);
		}
		List<Double> embedding = vector(record.get(vectorField));
		if (collection.get("dim") != null && embedding.size() != ((Number) collection.get("dim")).intValue()) {
			throw new IllegalArgumentException(vectorField + " has " + embedding.size() + " dimensions; " + collection.get("dim") + " are declared");
		}
		String documentField = string(collection, "document");
		Map<String, Object> metadata = new LinkedHashMap<>();
		record.forEach((name, item) -> {
			if (!name.equals(vectorField) && !name.equals(documentField) && !absent(item)) {
				metadata.put(name, typed(collection, name, item));
			}
		});
		return new Entry(recordId(key), embedding, metadata, documentField == null ? null : record.get(documentField));
	}

	private static void add(Client client, String path, List<Entry> entries, int batchSize) {
		for (List<Entry> chunk : chunks(entries, batchSize)) {
			Map<String, Object> body = args("ids", chunk.stream().map(Entry::id).toList(), "embeddings",
					chunk.stream().map(Entry::embedding).toList(), "metadatas", chunk.stream().map(Entry::metadata).toList());
			if (chunk.stream().anyMatch(entry -> entry.document() != null)) {
				body.put("documents", chunk.stream().map(Entry::document).toList());
			}
			call(client, "POST", path + "/add", body);
		}
	}

	private static List<String> existing(Client client, String path, List<String> ids) {
		Set<String> found = new HashSet<>();
		for (List<String> chunk : chunks(ids, PAGE)) {
			found.addAll(strings(map(call(client, "POST", path + "/get", args("ids", chunk, "include", List.of()))).get("ids")));
		}
		return ids.stream().filter(found::contains).toList();
	}

	private static int batch(Map<String, Object> args) {
		return args.get("batch_size") == null ? BATCH : ((Number) args.get("batch_size")).intValue();
	}

	/** Chroma's add skips ids that exist, so conflicts are detected first: error raises, ignore skips them. */
	public static Map<String, Object> insertRows(Client client, Map<String, Object> args) {
		Map<String, Object> collection = map(args.get("collection"));
		String path = collectionPath(client, collection);
		List<Entry> entries = records(args.get("rows")).stream().map(row -> entry(collection, row, args.get("slice"))).toList();
		Set<String> present = new HashSet<>(existing(client, path, entries.stream().map(Entry::id).toList()));
		String onConflict = args.get("on_conflict") == null ? "error" : args.get("on_conflict").toString();
		if (!present.isEmpty() && onConflict.equals("error")) {
			throw new IllegalStateException(present.size() + " records already exist in " + collection.get("name"));
		}
		List<Entry> fresh = entries.stream().filter(entry -> !present.contains(entry.id())).toList();
		add(client, path, fresh, batch(args));
		return args("insert_count", fresh.size(), "skipped", entries.size() - fresh.size());
	}

	/** Whole-record replacement: Chroma's upsert merges metadata, so existing records are deleted and added again. */
	public static Map<String, Object> upsertRows(Client client, Map<String, Object> args) {
		Map<String, Object> collection = map(args.get("collection"));
		String path = collectionPath(client, collection);
		Map<String, Entry> unique = new LinkedHashMap<>();
		for (Map<String, Object> row : records(args.get("rows"))) {
			Entry entry = entry(collection, row, args.get("slice"));
			unique.remove(entry.id());
			unique.put(entry.id(), entry);
		}
		List<Entry> entries = new ArrayList<>(unique.values());
		for (List<String> chunk : chunks(existing(client, path, entries.stream().map(Entry::id).toList()), PAGE)) {
			call(client, "POST", path + "/delete", args("ids", chunk));
		}
		add(client, path, entries, batch(args));
		return args("upsert_count", entries.size());
	}

	/** Every record that matches a filter (and the ids, if given), page by page. */
	private static List<Map<String, Object>> pages(Client client, String path, Object filter, List<String> include, List<String> ids) {
		List<Map<String, Object>> result = new ArrayList<>();
		Map<String, Object> parts = map(filter);
		for (int offset = 0;; offset += PAGE) {
			Map<String, Object> body = args("ids", ids, "where", parts.get("where"), "where_document", parts.get("where_document"),
					"limit", PAGE, "offset", offset, "include", include);
			Map<String, Object> page = map(call(client, "POST", path + "/get", body));
			if (items(page.get("ids")).isEmpty()) {
				return result;
			}
			result.add(page);
			if (items(page.get("ids")).size() < PAGE) {
				return result;
			}
		}
	}

	private static List<String> ids(List<Map<String, Object>> pages) {
		List<String> result = new ArrayList<>();
		pages.forEach(page -> result.addAll(strings(page.get("ids"))));
		return result;
	}

	private static Map<String, Object> row(Map<String, Object> collection, Map<String, Object> page, int index, List<String> output, boolean vectors) {
		Map<String, Object> metadata = map(items(page.get("metadatas")).isEmpty() ? null : items(page.get("metadatas")).get(index));
		String key = string(collection, "key");
		Map<String, Object> row = new LinkedHashMap<>();
		row.put(key, metadata.get(key));
		for (String name : output) {
			row.put(name, name.equals(string(collection, "document")) ? items(page.get("documents")).get(index) : value(metadata.get(name)));
		}
		if (vectors) {
			row.put(string(collection, "vector"), value(items(page.get("embeddings")).get(index)));
		}
		return row;
	}

	/** Matching records as rows (key first, then the output fields, then the vector if asked), in primary key order. */
	private static List<Map<String, Object>> rows(Client client, Map<String, Object> collection, Object filter, List<String> output, List<String> ids,
			boolean vectors) {
		List<String> include = new ArrayList<>(List.of("metadatas"));
		if (output.contains(string(collection, "document"))) {
			include.add("documents");
		}
		if (vectors) {
			include.add("embeddings");
		}
		List<Map<String, Object>> rows = new ArrayList<>();
		for (Map<String, Object> page : pages(client, collectionPath(client, collection), filter, include, ids)) {
			for (int index = 0; index < items(page.get("ids")).size(); index++) {
				rows.add(row(collection, page, index, output, vectors));
			}
		}
		String key = string(collection, "key");
		rows.sort((a, b) -> compare(a.get(key), b.get(key)));
		return rows;
	}

	/** Ids of the records a write selects: the given keys that exist and match the filter, or every match of the filter. */
	private static List<String> targets(Client client, String path, Object ids, Object filter) {
		if (!items(ids).isEmpty()) {
			List<String> wanted = new ArrayList<>(new LinkedHashSet<>(items(ids).stream().map(ChromaRuntime::recordId).toList()));
			if (filter != null && !map(filter).isEmpty()) {
				Set<String> matching = new HashSet<>(ids(pages(client, path, filter, List.of(), wanted)));
				return wanted.stream().filter(matching::contains).toList();
			}
			return existing(client, path, wanted);
		}
		if (filter != null) {
			return ids(pages(client, path, filter, List.of(), null));
		}
		throw new IllegalArgumentException("the statement selects no records");
	}

	private static Map<String, Map<String, Object>> storedMetadata(Client client, String path, List<String> ids) {
		Map<String, Map<String, Object>> stored = new LinkedHashMap<>();
		for (Map<String, Object> page : pages(client, path, null, List.of("metadatas"), ids)) {
			List<String> pageIds = strings(page.get("ids"));
			for (int index = 0; index < pageIds.size(); index++) {
				stored.put(pageIds.get(index), map(items(page.get("metadatas")).get(index)));
			}
		}
		return stored;
	}

	/**
	 * Chroma's update merges metadata and deletes the keys set to null; replace also clears the keys not given. A new document is
	 * sent with the stored embedding, because the SDKs would otherwise embed the document.
	 */
	public static Map<String, Object> updateRows(Client client, Map<String, Object> args) {
		Map<String, Object> collection = map(args.get("collection"));
		String path = collectionPath(client, collection);
		String key = string(collection, "key");
		String vectorField = string(collection, "vector");
		String documentField = string(collection, "document");
		Map<String, Map<String, Object>> replacements = new LinkedHashMap<>();
		records(args.get("rows") == null ? List.of() : args.get("rows")).forEach(row -> replacements.put(recordId(row.get(key)), row));
		List<String> targets;
		if (!replacements.isEmpty()) {
			Set<String> chosen = new HashSet<>(items(args.get("ids")).stream().map(ChromaRuntime::recordId).toList());
			List<Object> keys = replacements.values().stream().map(row -> row.get(key)).toList();
			targets = targets(client, path, keys, args.get("filter")).stream().filter(id -> chosen.isEmpty() || chosen.contains(id)).toList();
		} else if (!items(args.get("ids")).isEmpty() || args.get("filter") != null) {
			targets = targets(client, path, args.get("ids"), args.get("filter"));
		} else {
			throw new IllegalArgumentException("update requires ids, a filter or records");
		}
		if (targets.isEmpty()) {
			return args("update_count", 0);
		}
		boolean redocument = documentField != null && (map(args.get("values")).containsKey(documentField)
				|| replacements.values().stream().anyMatch(row -> row.containsKey(documentField)));
		Map<String, Map<String, Object>> stored = new LinkedHashMap<>();
		Map<String, List<Double>> embeddings = new LinkedHashMap<>();
		for (Map<String, Object> page : pages(client, path, null, redocument ? List.of("metadatas", "embeddings") : List.of("metadatas"), targets)) {
			List<String> pageIds = strings(page.get("ids"));
			for (int index = 0; index < pageIds.size(); index++) {
				stored.put(pageIds.get(index), map(items(page.get("metadatas")).get(index)));
				if (redocument) {
					embeddings.put(pageIds.get(index), vector(items(page.get("embeddings")).get(index)));
				}
			}
		}
		List<String> append = strings(args.get("append"));
		List<String> removeItems = strings(args.get("remove_items"));
		for (String id : targets) {
			Map<String, Object> record = new LinkedHashMap<>(replacements.getOrDefault(id, Map.of()));
			record.putAll(map(args.get("values")));
			if (record.containsKey(key) && !recordId(record.get(key)).equals(id)) {
				throw new IllegalArgumentException("update cannot change the primary key " + key);
			}
			Map<String, Object> current = stored.getOrDefault(id, Map.of());
			Map<String, Object> metadata = new LinkedHashMap<>();
			for (Map.Entry<String, Object> field : record.entrySet()) {
				String name = field.getKey();
				if (name.equals(vectorField) || name.equals(documentField) || name.equals(key)) {
					continue;
				}
				Object item = field.getValue();
				if (append.contains(name)) {
					List<Object> joined = new ArrayList<>(items(current.get(name)));
					items(item).forEach(element -> joined.add(typed(collection, name, element)));
					item = joined;
				} else if (removeItems.contains(name)) {
					List<Object> dropped = items(item).stream().map(element -> typed(collection, name, element)).toList();
					item = items(current.get(name)).stream().filter(element -> dropped.stream().noneMatch(other -> compare(other, element) == 0)).toList();
				}
				metadata.put(name, item instanceof Collection<?> many && many.isEmpty() ? null : typed(collection, name, item));
			}
			for (String name : strings(args.get("remove"))) {
				metadata.put(name, null);
			}
			if ("replace".equals(args.get("mode"))) {
				for (String name : current.keySet()) {
					if (!name.equals(key) && !metadata.containsKey(name)) {
						metadata.put(name, null);
					}
				}
			}
			check(collection, metadata);
			Map<String, Object> body = args("ids", List.of(id));
			if (!metadata.isEmpty()) {
				body.put("metadatas", List.of(metadata));
			}
			if (record.get(vectorField) != null) {
				body.put("embeddings", List.of(vector(record.get(vectorField))));
			}
			if (documentField != null && record.containsKey(documentField)) {
				body.put("documents", Collections.singletonList(record.get(documentField)));
				body.putIfAbsent("embeddings", List.of(embeddings.get(id)));
			}
			if (body.size() > 1) {
				call(client, "POST", path + "/update", body);
			}
		}
		return args("update_count", targets.size());
	}

	/** Deletes by id after resolving the targets, so the count is exact; limit takes the first targets in key order. */
	public static Map<String, Object> deleteRows(Client client, Map<String, Object> args) {
		Map<String, Object> collection = map(args.get("collection"));
		String path = collectionPath(client, collection);
		boolean hasIds = !items(args.get("ids")).isEmpty();
		List<String> targets = Boolean.TRUE.equals(args.get("delete_all")) && !hasIds ? ids(pages(client, path, args.get("filter"), List.of(), null))
				: targets(client, path, args.get("ids"), args.get("filter") != null ? args.get("filter") : hasIds ? null : Map.of());
		if (args.get("limit") != null) {
			Map<String, Map<String, Object>> stored = storedMetadata(client, path, targets);
			String key = string(collection, "key");
			targets = targets.stream().sorted((a, b) -> compare(stored.getOrDefault(a, Map.of()).get(key), stored.getOrDefault(b, Map.of()).get(key)))
					.limit(((Number) args.get("limit")).longValue()).toList();
		}
		for (List<String> chunk : chunks(targets, PAGE)) {
			call(client, "POST", path + "/delete", args("ids", chunk));
		}
		return args("delete_count", targets.size());
	}

	private static void updateEach(Client client, String path, Map<String, Map<String, Object>> changes) {
		List<String> ids = new ArrayList<>(changes.keySet());
		for (List<String> chunk : chunks(ids, PAGE)) {
			call(client, "POST", path + "/update", args("ids", chunk, "metadatas", chunk.stream().map(changes::get).toList()));
		}
	}

	/** Writes a new field's default into every record that lacks it. */
	public static Map<String, Object> fillField(Client client, Map<String, Object> args) {
		Map<String, Object> collection = map(args.get("collection"));
		String path = collectionPath(client, collection);
		String field = string(args, "field");
		Map<String, Map<String, Object>> changes = new LinkedHashMap<>();
		storedMetadata(client, path, null).forEach((id, stored) -> {
			if (stored.get(field) == null) {
				Map<String, Object> change = new LinkedHashMap<>();
				change.put(field, typed(collection, field, args.get("value")));
				changes.put(id, change);
			}
		});
		updateEach(client, path, changes);
		return args("update_count", changes.size());
	}

	/** Removes a metadata key from every record (Chroma deletes a key set to null). */
	public static Map<String, Object> dropField(Client client, Map<String, Object> args) {
		String path = collectionPath(client, map(args.get("collection")));
		String field = string(args, "field");
		Map<String, Map<String, Object>> changes = new LinkedHashMap<>();
		storedMetadata(client, path, null).forEach((id, stored) -> {
			if (stored.containsKey(field)) {
				Map<String, Object> change = new LinkedHashMap<>();
				change.put(field, null);
				changes.put(id, change);
			}
		});
		updateEach(client, path, changes);
		return args("update_count", changes.size());
	}

	/** Moves a metadata key to a new name in every record that has it. */
	public static Map<String, Object> renameField(Client client, Map<String, Object> args) {
		String path = collectionPath(client, map(args.get("collection")));
		String field = string(args, "field");
		String newName = string(args, "new_name");
		Map<String, Map<String, Object>> changes = new LinkedHashMap<>();
		storedMetadata(client, path, null).forEach((id, stored) -> {
			if (stored.containsKey(field)) {
				Map<String, Object> change = new LinkedHashMap<>();
				change.put(newName, stored.get(field));
				change.put(field, null);
				changes.put(id, change);
			}
		});
		for (Map.Entry<String, Map<String, Object>> change : changes.entrySet()) {
			call(client, "POST", path + "/update", args("ids", List.of(change.getKey()), "metadatas", List.of(change.getValue())));
		}
		return args("update_count", changes.size());
	}

	/** Records of a local JSON array or JSON Lines file (file:// URI or path). */
	public static List<Map<String, Object>> readRecords(Client client, Map<String, Object> args) {
		String location = string(args, "location");
		Path path = Path.of(location.startsWith("file://") ? location.substring("file://".length()) : location);
		String text;
		try {
			text = Files.readString(path, StandardCharsets.UTF_8);
		} catch (IOException e) {
			throw new IllegalStateException("cannot read " + location, e);
		}
		if (text.stripLeading().startsWith("[")) {
			return records(NUMBERS.fromJson(text, Object.class));
		}
		return text.lines().filter(line -> !line.isBlank()).map(line -> map(NUMBERS.fromJson(line, Object.class))).toList();
	}

	public static Map<String, Object> importFile(Client client, Map<String, Object> args) {
		List<Map<String, Object>> rows = readRecords(client, args("location", args.get("location")));
		Map<String, Object> write = args("collection", args.get("collection"), "rows", rows, "batch_size", args.get("batch_size"), "slice", args.get("slice"));
		Object onConflict = args.get("on_conflict");
		if ("update".equals(onConflict) || "replace".equals(onConflict)) {
			return upsertRows(client, write);
		}
		write.put("on_conflict", onConflict == null ? "error" : onConflict);
		return insertRows(client, write);
	}

	// ---------------------------------------------------------------- reads

	/** Records by primary key, in the order of the keys given. */
	public static List<Map<String, Object>> getRows(Client client, Map<String, Object> args) {
		Map<String, Object> collection = map(args.get("collection"));
		List<String> wanted = new ArrayList<>(new LinkedHashSet<>(items(args.get("ids")).stream().map(ChromaRuntime::recordId).toList()));
		Map<String, Map<String, Object>> found = new LinkedHashMap<>();
		for (Map<String, Object> row : rows(client, collection, args.get("filter"), strings(args.get("output")), wanted, Boolean.TRUE.equals(args.get("vectors")))) {
			found.put(recordId(row.get(string(collection, "key"))), row);
		}
		return wanted.stream().filter(found::containsKey).map(found::get).toList();
	}

	public static long count(Client client, Map<String, Object> args) {
		String path = collectionPath(client, map(args.get("collection")));
		if (args.get("filter") == null || map(args.get("filter")).isEmpty()) {
			return ((Number) call(client, "GET", path + "/count", null)).longValue();
		}
		return ids(pages(client, path, args.get("filter"), List.of(), null)).size();
	}

	/** Records in primary key order, or in the order of the sort fields; Chroma returns them in insertion order. */
	public static List<Map<String, Object>> scroll(Client client, Map<String, Object> args) {
		Map<String, Object> collection = map(args.get("collection"));
		String key = string(collection, "key");
		List<String> output = strings(args.get("output"));
		List<Map<String, Object>> order = records(args.get("order") == null ? List.of() : args.get("order"));
		Set<String> fields = new LinkedHashSet<>(output);
		order.forEach(item -> {
			if (!item.get("key").equals(key)) {
				fields.add(item.get("key").toString());
			}
		});
		boolean vectors = Boolean.TRUE.equals(args.get("vectors"));
		List<Map<String, Object>> rows = new ArrayList<>(rows(client, collection, args.get("filter"), new ArrayList<>(fields), null, vectors));
		List<Map<String, Object>> reversed = new ArrayList<>(order);
		Collections.reverse(reversed);
		for (Map<String, Object> item : reversed) {
			String field = item.get("key").toString();
			Comparator<Map<String, Object>> comparator = (a, b) -> ORDER.compare(a.get(field), b.get(field));
			rows.sort("desc".equals(item.get("direction")) ? comparator.reversed() : comparator);
		}
		int offset = args.get("offset") == null ? 0 : ((Number) args.get("offset")).intValue();
		rows = rows.subList(Math.min(offset, rows.size()), rows.size());
		if (args.get("limit") != null) {
			rows = rows.subList(0, Math.min(rows.size(), ((Number) args.get("limit")).intValue()));
		}
		List<String> names = new ArrayList<>(List.of(key));
		names.addAll(output);
		if (vectors) {
			names.add(string(collection, "vector"));
		}
		List<Map<String, Object>> result = new ArrayList<>();
		for (Map<String, Object> row : rows) {
			Map<String, Object> projected = new LinkedHashMap<>();
			names.forEach(name -> projected.put(name, row.get(name)));
			result.add(projected);
		}
		return result;
	}

	/** A random sample (or the first records in key order) of the matching records. */
	public static List<Map<String, Object>> sampleRows(Client client, Map<String, Object> args) {
		Map<String, Object> collection = map(args.get("collection"));
		List<Map<String, Object>> rows = new ArrayList<>(rows(client, collection, args.get("filter"), strings(args.get("output")), null, false));
		int size = ((Number) args.get("size")).intValue();
		if (!Boolean.TRUE.equals(args.get("first"))) {
			Collections.shuffle(rows, new Random());
			rows = new ArrayList<>(rows.subList(0, Math.min(size, rows.size())));
			String key = string(collection, "key");
			rows.sort((a, b) -> compare(a.get(key), b.get(key)));
			return rows;
		}
		return rows.subList(0, Math.min(size, rows.size()));
	}

	/** Canonical similarity of a Chroma distance: l2 is squared Euclidean, cosine and ip are 1 minus the similarity. */
	public static double similarity(Object metric, double distance) {
		return "l2".equals(metric) ? -Math.sqrt(Math.max(distance, 0.0)) : 1.0 - distance;
	}

	public static List<Double> lookupVector(Client client, Map<String, Object> args) {
		Map<String, Object> collection = map(args.get("collection"));
		Map<String, Object> found = map(call(client, "POST", collectionPath(client, collection) + "/get",
				args("ids", List.of(recordId(args.get("id"))), "include", List.of("embeddings"))));
		if (items(found.get("ids")).isEmpty()) {
			throw new IllegalArgumentException("record " + args.get("id") + " not found in " + collection.get("name"));
		}
		return vector(items(found.get("embeddings")).get(0));
	}

	private record Hit(Map<String, Object> row, double score) {
	}

	private static List<Hit> nearest(Client client, Map<String, Object> collection, List<Double> query, int size, Object filter, List<String> output,
			boolean vectors, boolean nativeScore) {
		List<String> include = new ArrayList<>(List.of("metadatas", "distances"));
		if (output.contains(string(collection, "document"))) {
			include.add("documents");
		}
		if (vectors) {
			include.add("embeddings");
		}
		Map<String, Object> parts = map(filter);
		Map<String, Object> body = args("query_embeddings", List.of(query), "n_results", size, "where", parts.get("where"), "where_document",
				parts.get("where_document"), "include", include);
		Map<String, Object> result = map(call(client, "POST", collectionPath(client, collection) + "/query", body));
		Map<String, Object> page = new LinkedHashMap<>();
		for (String name : List.of("ids", "embeddings", "metadatas", "documents", "distances")) {
			List<Object> perQuery = items(result.get(name));
			page.put(name, perQuery.isEmpty() ? null : perQuery.get(0));
		}
		List<Hit> hits = new ArrayList<>();
		List<Object> distances = items(page.get("distances"));
		for (int index = 0; index < items(page.get("ids")).size(); index++) {
			double distance = ((Number) distances.get(index)).doubleValue();
			hits.add(new Hit(row(collection, page, index, output, vectors), nativeScore ? distance : similarity(collection.get("metric"), distance)));
		}
		return hits;
	}

	private static List<Map<String, Object>> hits(Map<String, Object> collection, List<Hit> hits, Map<String, Object> args) {
		int offset = args.get("offset") == null ? 0 : ((Number) args.get("offset")).intValue();
		int limit = ((Number) args.get("limit")).intValue();
		Number min = (Number) args.get("score_min");
		Number max = (Number) args.get("score_max");
		List<Hit> ranked = new ArrayList<>(hits);
		Comparator<Hit> byScore = Comparator.comparingDouble(Hit::score);
		ranked.sort(Boolean.TRUE.equals(args.get("native")) ? byScore : byScore.reversed());
		List<Map<String, Object>> result = new ArrayList<>();
		for (Hit hit : ranked.subList(Math.min(offset, ranked.size()), Math.min(offset + limit, ranked.size()))) {
			if ((min == null || hit.score() >= min.doubleValue()) && (max == null || hit.score() <= max.doubleValue())) {
				Map<String, Object> row = new LinkedHashMap<>(hit.row());
				Map<String, Object> entry = args("id", row.remove(string(collection, "key")), "score", value(hit.score()));
				entry.putAll(row);
				result.add(entry);
			}
		}
		return result;
	}

	/** Nearest neighbours by the collection's HNSW space; offset pages the ranking, bounds apply to the canonical similarity. */
	public static List<Map<String, Object>> vectorSearch(Client client, Map<String, Object> args) {
		Map<String, Object> collection = map(args.get("collection"));
		int offset = args.get("offset") == null ? 0 : ((Number) args.get("offset")).intValue();
		int size = ((Number) args.get("limit")).intValue() + offset;
		List<Hit> found = nearest(client, collection, vector(args.get("vector")), size, args.get("filter"), strings(args.get("output")),
				Boolean.TRUE.equals(args.get("vectors")), Boolean.TRUE.equals(args.get("native")));
		return hits(collection, found, args);
	}

	private static List<Double> mean(List<List<Double>> vectors) {
		List<Double> result = new ArrayList<>();
		for (int i = 0; i < vectors.get(0).size(); i++) {
			double sum = 0;
			for (List<Double> vector : vectors) {
				sum += vector.get(i);
			}
			result.add(sum / vectors.size());
		}
		return result;
	}

	/** The average-vector strategy, avg(positive) + (avg(positive) - avg(negative)); example records are not returned. */
	public static List<Map<String, Object>> recommend(Client client, Map<String, Object> args) {
		Map<String, Object> collection = map(args.get("collection"));
		Map<String, Object> source = args.get("lookup") == null ? collection : map(args.get("lookup"));
		List<List<Double>> good = new ArrayList<>();
		List<List<Double>> bad = new ArrayList<>();
		Set<String> excluded = new HashSet<>();
		for (Object item : items(args.get("positives"))) {
			good.add(item instanceof Collection<?> ? vector(item) : lookupVector(client, args("collection", source, "id", item)));
		}
		for (Object item : items(args.get("negatives"))) {
			bad.add(item instanceof Collection<?> ? vector(item) : lookupVector(client, args("collection", source, "id", item)));
		}
		if (source.get("name").equals(collection.get("name"))) {
			List<Object> examples = new ArrayList<>(items(args.get("positives")));
			examples.addAll(items(args.get("negatives")));
			examples.stream().filter(item -> !(item instanceof Collection<?>)).forEach(item -> excluded.add(recordId(item)));
		}
		List<Double> positive = mean(good);
		List<Double> query = positive;
		if (!bad.isEmpty()) {
			List<Double> negative = mean(bad);
			query = new ArrayList<>();
			for (int i = 0; i < positive.size(); i++) {
				query.add(2 * positive.get(i) - negative.get(i));
			}
		}
		int offset = args.get("offset") == null ? 0 : ((Number) args.get("offset")).intValue();
		int size = ((Number) args.get("limit")).intValue() + offset + excluded.size();
		String key = string(collection, "key");
		List<Hit> found = nearest(client, collection, query, size, args.get("filter"), strings(args.get("output")), Boolean.TRUE.equals(args.get("vectors")),
				Boolean.TRUE.equals(args.get("native"))).stream().filter(hit -> !excluded.contains(recordId(hit.row().get(key)))).toList();
		return hits(collection, found, args);
	}

	/**
	 * A random sample of the matching records, each paired with its nearest neighbours within the sample (as Qdrant's distance
	 * matrix), with primary keys and canonical similarities, sorted by key.
	 */
	public static List<Map<String, Object>> distanceMatrix(Client client, Map<String, Object> args) {
		Map<String, Object> collection = map(args.get("collection"));
		String path = collectionPath(client, collection);
		String key = string(collection, "key");
		List<Object[]> records = new ArrayList<>();
		for (Map<String, Object> page : pages(client, path, args.get("filter"), List.of("metadatas", "embeddings"), null)) {
			List<String> pageIds = strings(page.get("ids"));
			for (int index = 0; index < pageIds.size(); index++) {
				records.add(new Object[] { map(items(page.get("metadatas")).get(index)).get(key), pageIds.get(index), vector(items(page.get("embeddings")).get(index)) });
			}
		}
		Collections.shuffle(records, new Random());
		int sample = args.get("sample") == null ? 10 : ((Number) args.get("sample")).intValue();
		int limit = args.get("limit") == null ? 3 : ((Number) args.get("limit")).intValue();
		List<Object[]> picked = records.subList(0, Math.min(sample, records.size()));
		List<String> ids = picked.stream().map(record -> (String) record[1]).toList();
		List<Map<String, Object>> pairs = new ArrayList<>();
		for (Object[] record : picked) {
			Map<String, Object> body = args("query_embeddings", List.of(record[2]), "n_results", Math.min(limit + 1, ids.size()), "ids", ids, "include",
					List.of("metadatas", "distances"));
			Map<String, Object> result = map(call(client, "POST", path + "/query", body));
			List<String> others = strings(items(result.get("ids")).get(0));
			List<Object> metadatas = items(items(result.get("metadatas")).get(0));
			List<Object> distances = items(items(result.get("distances")).get(0));
			int added = 0;
			for (int index = 0; index < others.size() && added < limit; index++) {
				if (!others.get(index).equals(record[1])) {
					double score = similarity(collection.get("metric"), ((Number) distances.get(index)).doubleValue());
					pairs.add(args("a", record[0], "b", map(metadatas.get(index)).get(key), "score", value(score)));
					added++;
				}
			}
		}
		pairs.sort((x, y) -> compare(x.get("a"), y.get("a")) != 0 ? compare(x.get("a"), y.get("a")) : compare(x.get("b"), y.get("b")));
		return pairs;
	}
}
