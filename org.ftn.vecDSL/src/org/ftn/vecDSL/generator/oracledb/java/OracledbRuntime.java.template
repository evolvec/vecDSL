package {{java.package}};

import java.io.IOException;
import java.io.StringReader;
import java.math.BigDecimal;
import java.math.RoundingMode;
import java.nio.file.Files;
import java.nio.file.Path;
import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.sql.Types;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.Collection;
import java.util.HashSet;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;
import java.util.Set;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

import com.google.gson.Gson;
import com.google.gson.GsonBuilder;
import com.google.gson.JsonParseException;
import com.google.gson.JsonParser;
import com.google.gson.ToNumberPolicy;

/**
 * Runtime support for vecDSL programs generated for Oracle AI Database 26ai, through the JDBC API (java.sql) with the Oracle
 * JDBC thin driver on the class path, and Gson. Generated by vecDSL 7. Do not edit.
 *
 * Every statement arrives as SQL text with positional bind variables (:1, :2, ... in textual order), identical in the Python,
 * TypeScript and Java programs; JDBC takes ? placeholders, so each :n outside quoted text becomes the n-th ?. Lists and objects
 * are bound as JSON text in CLOBs (setClob with a Reader); strings, numbers, booleans and null with the standard setters.
 * Queries return one JSON text per row, decoded with Gson. Each call is one transaction (autocommit off, COMMIT at the end;
 * DDL statements commit by themselves); a failure rolls back.
 */
public final class OracledbRuntime {

	private static final int DIGITS = 6;
	private static final int BATCH = 500;
	private static final int CONNECT_TIMEOUT_SECONDS = 10;
	private static final int CALL_TIMEOUT_SECONDS = 60;
	private static final Set<String> TEXT_RESERVED = Set.of("ABOUT", "ACCUM", "AND", "BT", "BTG", "BTI", "BTP", "EQUIV", "FUZZY", "HASPATH",
			"INPATH", "MDATA", "MINUS", "NEAR", "NOT", "NT", "NTG", "NTI", "NTP", "OR", "PT", "RT", "SQE", "SYN", "TR", "TRSYN", "TT", "WITHIN");
	private static final Pattern WORD = Pattern.compile("[\\p{L}\\p{N}_]+");
	private static final Gson PRETTY = new GsonBuilder().serializeNulls().setPrettyPrinting().create();
	private static final Gson NUMBERS = new GsonBuilder().setObjectToNumberStrategy(ToNumberPolicy.LONG_OR_DOUBLE).create();

	private OracledbRuntime() {
	}

	public static final class UnsupportedFeature extends UnsupportedOperationException {

		private static final long serialVersionUID = 1L;

		UnsupportedFeature(String message) {
			super(message);
		}
	}

	public static RuntimeException unsupported(String vendor, String feature) {
		return new UnsupportedFeature(feature + " is not supported for target " + vendor);
	}

	// ---------------------------------------------------------------- values

	public static Map<String, Object> args(Object... pairs) {
		Map<String, Object> result = new LinkedHashMap<>();
		for (int i = 0; i < pairs.length; i += 2) {
			result.put((String) pairs[i], pairs[i + 1]);
		}
		return result;
	}

	public static List<Object> list(Object... items) {
		return new ArrayList<>(Arrays.asList(items));
	}

	public static String env(String name) {
		String value = System.getenv(name);
		if (value == null) {
			throw new IllegalStateException("environment variable " + name + " is not set");
		}
		return value;
	}

	public static String envOr(String name, String fallback) {
		String value = System.getenv(name);
		return value == null ? fallback : value;
	}

	public static String text(Object value) {
		return value == null ? null : value.toString();
	}

	public static long integer(Object value) {
		return ((Number) value).longValue();
	}

	public static double decimal(Object value) {
		return ((Number) value).doubleValue();
	}

	public static boolean flag(Object value) {
		return (Boolean) value;
	}

	public static List<Float> floats(Object value) {
		return ((Collection<?>) value).stream().map(item -> ((Number) item).floatValue()).toList();
	}

	public static List<String> texts(Object value) {
		return ((Collection<?>) value).stream().map(String::valueOf).toList();
	}

	@SuppressWarnings("unchecked")
	public static List<Map<String, Object>> records(Object value) {
		return (List<Map<String, Object>>) value;
	}

	public static String toJson(Object value) {
		return PRETTY.toJson(value);
	}

	public static Map<String, Object> parameters(Map<String, Object> given, Map<String, Object> defaults, List<String> names) {
		Set<String> unknown = new HashSet<>(given.keySet());
		unknown.removeAll(names);
		if (!unknown.isEmpty()) {
			throw new IllegalArgumentException("unknown program parameters: " + unknown);
		}
		Map<String, Object> values = new LinkedHashMap<>(defaults);
		values.putAll(given);
		List<String> missing = names.stream().filter(name -> !values.containsKey(name)).toList();
		if (!missing.isEmpty()) {
			throw new IllegalArgumentException("missing program parameters: " + missing);
		}
		return values;
	}

	public static Map<String, Object> parseArguments(String[] arguments) {
		Map<String, Object> parameters = new LinkedHashMap<>();
		for (String argument : arguments) {
			int separator = argument.indexOf('=');
			if (separator < 0) {
				throw new IllegalArgumentException("expected name=value, got " + argument);
			}
			String raw = argument.substring(separator + 1);
			Object value;
			try {
				value = NUMBERS.fromJson(JsonParser.parseString(raw), Object.class);
			} catch (JsonParseException e) {
				value = raw;
			}
			parameters.put(argument.substring(0, separator), value);
		}
		return parameters;
	}

	/** Result values in one form for every host language: floats rounded, integral numbers as integers. */
	@SuppressWarnings("unchecked")
	static Object value(Object item) {
		if (item instanceof Float || item instanceof Double) {
			double number = ((Number) item).doubleValue();
			if (!Double.isFinite(number)) {
				return number;
			}
			double rounded = new BigDecimal(number).setScale(DIGITS, RoundingMode.HALF_EVEN).doubleValue();
			return rounded == Math.rint(rounded) && Math.abs(rounded) < 1e15 ? (Object) (long) rounded : (Object) rounded;
		}
		if (item instanceof Number number) {
			return number.longValue();
		}
		if (item instanceof Collection<?> items) {
			return items.stream().map(OracledbRuntime::value).toList();
		}
		if (item instanceof Map<?, ?> map) {
			Map<String, Object> result = new LinkedHashMap<>();
			((Map<String, Object>) map).forEach((key, entry) -> result.put(key, value(entry)));
			return result;
		}
		return item;
	}

	/** JSON text of a list or object parameter, with integral numbers written as integers as in the other languages. */
	static String jsonText(Object value) {
		StringBuilder out = new StringBuilder();
		json(value, out);
		return out.toString();
	}

	private static void json(Object value, StringBuilder out) {
		if (value == null) {
			out.append("null");
		} else if (value instanceof String text) {
			out.append(PRETTY.toJson(text));
		} else if (value instanceof Boolean flag) {
			out.append(flag);
		} else if (value instanceof Float || value instanceof Double) {
			double number = ((Number) value).doubleValue();
			if (number == Math.rint(number) && Math.abs(number) < 1e15) {
				out.append((long) number);
			} else {
				out.append(value instanceof Float single ? Float.toString(single) : Double.toString(number));
			}
		} else if (value instanceof Number number) {
			out.append(number.longValue());
		} else if (value instanceof Map<?, ?> map) {
			out.append('{');
			boolean first = true;
			for (Map.Entry<?, ?> entry : map.entrySet()) {
				if (!first) {
					out.append(',');
				}
				first = false;
				out.append(PRETTY.toJson(String.valueOf(entry.getKey()))).append(':');
				json(entry.getValue(), out);
			}
			out.append('}');
		} else if (value instanceof Collection<?> items) {
			out.append('[');
			boolean first = true;
			for (Object item : items) {
				if (!first) {
					out.append(',');
				}
				first = false;
				json(item, out);
			}
			out.append(']');
		} else {
			throw new IllegalArgumentException("cannot send " + value.getClass().getName() + " as a parameter");
		}
	}

	// ---------------------------------------------------------------- connection

	/** The database endpoint (Easy Connect string), the user and one connection; the password comes from the environment. */
	public static final class Client implements AutoCloseable {

		final String dsn;
		final String user;
		final int callTimeoutSeconds;
		private final String password;
		private Connection current;

		Client(String dsn, String user, String passwordVariable, Double timeout) {
			if (dsn.contains("@") || dsn.contains("://")) {
				throw new IllegalArgumentException("expected an Easy Connect string host:port/service without credentials, got " + dsn);
			}
			this.dsn = dsn;
			this.user = user;
			this.password = System.getenv(passwordVariable);
			if (password == null) {
				throw new IllegalStateException("environment variable " + passwordVariable + " is not set; it holds the password of " + user);
			}
			this.callTimeoutSeconds = timeout == null ? CALL_TIMEOUT_SECONDS : (int) Math.ceil(timeout);
		}

		Connection connection() {
			if (current == null) {
				try {
					DriverManager.setLoginTimeout(CONNECT_TIMEOUT_SECONDS);
					current = DriverManager.getConnection("jdbc:oracle:thin:@//" + dsn, user, password);
					current.setAutoCommit(false);
				} catch (SQLException e) {
					throw new IllegalStateException("cannot connect to " + dsn + " as " + user + ": " + e.getMessage(), e);
				}
			}
			return current;
		}

		@Override
		public void close() {
			if (current != null) {
				try {
					current.close();
				} catch (SQLException e) {
					throw new IllegalStateException(e);
				} finally {
					current = null;
				}
			}
		}
	}

	public static Client connect(Map<String, Object> args) {
		Object variable = args.get("password_variable");
		Object timeout = args.get("timeout");
		return new Client((String) args.get("dsn"), (String) args.get("user"), variable == null ? "VECDSL_ORACLEDB_PASSWORD" : (String) variable,
				timeout == null ? null : ((Number) timeout).doubleValue());
	}

	// ---------------------------------------------------------------- statements

	/** The SQL text with each :n bind variable outside quoted text and identifiers replaced by ?, in order. */
	static String placeholders(String sql) {
		StringBuilder out = new StringBuilder();
		int i = 0;
		while (i < sql.length()) {
			char c = sql.charAt(i);
			if (c == '\'' || c == '"') {
				int end = i + 1;
				while (end < sql.length()) {
					if (sql.charAt(end) == c) {
						if (c == '\'' && end + 1 < sql.length() && sql.charAt(end + 1) == '\'') {
							end += 2;
							continue;
						}
						break;
					}
					end++;
				}
				out.append(sql, i, Math.min(end + 1, sql.length()));
				i = end + 1;
			} else if (c == ':' && i + 1 < sql.length() && Character.isDigit(sql.charAt(i + 1))) {
				int end = i + 1;
				while (end < sql.length() && Character.isDigit(sql.charAt(end))) {
					end++;
				}
				out.append('?');
				i = end;
			} else {
				out.append(c);
				i++;
			}
		}
		return out.toString();
	}

	private static void bind(PreparedStatement statement, int index, Object value) throws SQLException {
		if (value == null) {
			statement.setNull(index, Types.VARCHAR);
		} else if (value instanceof String text) {
			statement.setString(index, text);
		} else if (value instanceof Boolean flag) {
			statement.setBoolean(index, flag);
		} else if (value instanceof Float || value instanceof Double) {
			double number = ((Number) value).doubleValue();
			if (number == Math.rint(number) && Math.abs(number) < 1e15) {
				statement.setLong(index, (long) number);
			} else {
				statement.setDouble(index, number);
			}
		} else if (value instanceof Number number) {
			statement.setLong(index, number.longValue());
		} else {
			statement.setClob(index, new StringReader(jsonText(value)));
		}
	}

	/** Executes one statement: the decoded JSON rows of a query, else the number of rows a DML statement changed. */
	private static Object run(Connection connection, String sql, List<?> params, int timeoutSeconds) throws SQLException {
		try (PreparedStatement statement = connection.prepareStatement(placeholders(sql))) {
			statement.setQueryTimeout(timeoutSeconds);
			for (int i = 0; i < params.size(); i++) {
				bind(statement, i + 1, params.get(i));
			}
			if (!statement.execute()) {
				return (long) statement.getUpdateCount();
			}
			List<Object> rows = new ArrayList<>();
			try (ResultSet result = statement.getResultSet()) {
				while (result.next()) {
					String json = result.getString(1);
					rows.add(json == null ? null : value(NUMBERS.fromJson(JsonParser.parseString(json), Object.class)));
				}
			}
			return rows;
		}
	}

	@SuppressWarnings("unchecked")
	private static List<Object> inTransaction(Client client, List<?> steps, String isolation, Map<String, Object> settings) {
		Connection connection = client.connection();
		Object timeout = settings == null ? null : settings.get("call_timeout");
		int seconds = timeout == null ? client.callTimeoutSeconds : (int) Math.ceil(Double.parseDouble((String) timeout) / 1000.0);
		try {
			try {
				if ("serializable".equals(isolation)) {
					connection.setTransactionIsolation(Connection.TRANSACTION_SERIALIZABLE);
				}
				List<Object> results = new ArrayList<>();
				for (Object step : steps) {
					Map<String, Object> entry = (Map<String, Object>) step;
					Object params = entry.get("params");
					results.add(run(connection, (String) entry.get("sql"), params == null ? List.of() : (List<?>) params, seconds));
				}
				connection.commit();
				return results;
			} catch (SQLException | RuntimeException e) {
				connection.rollback();
				throw e;
			} finally {
				if ("serializable".equals(isolation)) {
					connection.setTransactionIsolation(Connection.TRANSACTION_READ_COMMITTED);
				}
			}
		} catch (SQLException e) {
			throw new IllegalStateException(e.getMessage(), e);
		}
	}

	@SuppressWarnings("unchecked")
	private static Map<String, Object> settings(Map<String, Object> args) {
		return (Map<String, Object>) args.get("settings");
	}

	private static Map<String, Object> counts(Map<String, Object> step, Object outcome) {
		long changed = outcome instanceof Long count ? count : 0L;
		Map<String, Object> result = new LinkedHashMap<>();
		result.put((String) step.get("counter"), changed);
		if (step.get("skipped") != null) {
			List<?> params = (List<?>) step.get("params");
			result.put("skipped", ((Collection<?>) params.get(((Number) step.get("skipped")).intValue())).size() - changed);
		}
		return result;
	}

	/** The JSON values of a query's rows. */
	@SuppressWarnings("unchecked")
	public static List<Object> query(Client client, Map<String, Object> args) {
		Object rows = inTransaction(client, List.of(args), null, settings(args)).get(0);
		return rows instanceof List<?> list ? (List<Object>) list : List.of();
	}

	/** The JSON value of the first row, or null. */
	public static Object value(Client client, Map<String, Object> args) {
		List<Object> rows = query(client, args);
		return rows.isEmpty() ? null : rows.get(0);
	}

	/** Whether the count a query returns is above zero. */
	public static boolean exists(Client client, Map<String, Object> args) {
		Object count = value(client, args);
		return count instanceof Number number && number.longValue() > 0;
	}

	/** A DML statement: {counter: changed rows}, and for an insert that ignores conflicts the records it skipped. */
	public static Map<String, Object> modify(Client client, Map<String, Object> args) {
		return counts(args, inTransaction(client, List.of(args), null, null).get(0));
	}

	/** DDL statements and PL/SQL blocks in order; Oracle commits each DDL statement. */
	public static void execute(Client client, Map<String, Object> args) {
		inTransaction(client, (List<?>) args.get("steps"), null, null);
	}

	/** The statements of a vecDSL transaction in one Oracle transaction; any failure rolls back all of them. */
	@SuppressWarnings("unchecked")
	public static List<Object> transaction(Client client, Map<String, Object> args) {
		List<?> steps = (List<?>) args.get("steps");
		List<Object> outcomes = inTransaction(client, steps, (String) args.get("isolation"), null);
		List<Object> results = new ArrayList<>();
		for (int i = 0; i < steps.size(); i++) {
			Map<String, Object> step = (Map<String, Object>) steps.get(i);
			Object outcome = outcomes.get(i);
			if ("modify".equals(step.get("op"))) {
				results.add(counts(step, outcome));
			} else if ("value".equals(step.get("op"))) {
				results.add(outcome instanceof List<?> rows && !rows.isEmpty() ? rows.get(0) : null);
			} else {
				results.add(outcome);
			}
		}
		return results;
	}

	/** Records of a local JSON array or JSON Lines file (file:// URI or path). */
	@SuppressWarnings("unchecked")
	public static List<Map<String, Object>> readRecords(Client client, Map<String, Object> args) {
		String location = (String) args.get("location");
		Path path = Path.of(location.startsWith("file://") ? location.substring("file://".length()) : location);
		String content;
		try {
			content = Files.readString(path);
		} catch (IOException e) {
			throw new IllegalStateException("cannot read " + location + ": " + e.getMessage(), e);
		}
		if (content.stripLeading().startsWith("[")) {
			return (List<Map<String, Object>>) NUMBERS.fromJson(content, List.class);
		}
		List<Map<String, Object>> records = new ArrayList<>();
		for (String line : content.split("\\r?\\n")) {
			if (!line.isBlank()) {
				records.add((Map<String, Object>) NUMBERS.fromJson(line, Map.class));
			}
		}
		return records;
	}

	/** A local file written in batches by one statement (the batch is the parameter at position rows), in one transaction. */
	@SuppressWarnings("unchecked")
	public static Map<String, Object> importFile(Client client, Map<String, Object> args) {
		List<Map<String, Object>> records = readRecords(client, args);
		int size = args.get("batch_size") == null ? BATCH : ((Number) args.get("batch_size")).intValue();
		int rows = ((Number) args.get("rows")).intValue();
		List<Object> given = (List<Object>) args.get("params");
		List<Object> steps = new ArrayList<>();
		for (int start = 0; start < records.size(); start += size) {
			List<Object> params = new ArrayList<>(given);
			params.set(rows, new ArrayList<>(records.subList(start, Math.min(records.size(), start + size))));
			steps.add(args("sql", args.get("sql"), "params", params));
		}
		long changed = 0;
		for (Object outcome : inTransaction(client, steps, null, null)) {
			changed += outcome instanceof Long count ? count : 0L;
		}
		Map<String, Object> result = new LinkedHashMap<>();
		result.put((String) args.get("counter"), changed);
		return result;
	}

	/**
	 * An Oracle Text query of the words of an input: all (AND), any (ACCUM), a phrase, or the words NEAR each other in order within
	 * span words; fuzzy expands each word of three or more characters with FUZZY. No operator of the input survives.
	 */
	public static String textQuery(Client client, Map<String, Object> args) {
		String text = args.get("text") == null ? "" : (String) args.get("text");
		List<String> words = new ArrayList<>();
		Matcher matcher = WORD.matcher(text);
		while (matcher.find()) {
			words.add(matcher.group());
		}
		if (words.isEmpty()) {
			throw new IllegalArgumentException("a keyword search needs at least one word of letters or digits");
		}
		if ("phrase".equals(args.get("mode"))) {
			if (args.get("span") == null || words.size() == 1) {
				return "{" + String.join(" ", words) + "}";
			}
			return "NEAR((" + String.join(", ", words.stream().map(word -> "{" + word + "}").toList()) + "), "
					+ ((Number) args.get("span")).intValue() + ", TRUE)";
		}
		boolean stem = Boolean.TRUE.equals(args.get("stem"));
		boolean fuzzy = Boolean.TRUE.equals(args.get("fuzzy"));
		List<String> terms = words.stream().map(word -> term(word, stem, fuzzy)).toList();
		return String.join("any".equals(args.get("mode")) ? " ACCUM " : " AND ", terms);
	}

	private static String term(String word, boolean stem, boolean fuzzy) {
		if (TEXT_RESERVED.contains(word.toUpperCase(java.util.Locale.ROOT))) {
			return "{" + word + "}";
		}
		if (fuzzy && word.length() >= 3) {
			return "fuzzy(" + word + ")";
		}
		return stem ? "$" + word : word;
	}

	/** A LIKE pattern (ESCAPE '\\') of a wildcard: * any characters, ? one character, everything else literal. */
	public static String wildcardPattern(Client client, Map<String, Object> args) {
		String pattern = (String) args.get("pattern");
		String escaped = pattern.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_");
		return escaped.replace("*", "%").replace("?", "_");
	}
}
