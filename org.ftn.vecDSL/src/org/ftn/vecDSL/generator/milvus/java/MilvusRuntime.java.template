	/**
	 * Flushes and waits until every channel of the collection has checkpointed past the flush timestamp, because a snapshot
	 * includes only segments behind the channel checkpoint. MilvusClientV2.flush cannot be used: it returns no flush timestamp,
	 * and its wait (UtilityService.waitFlush in milvus-sdk-java 3.0.12) sends GetFlushState without the collection name, so
	 * Milvus 3.0.4 finds no channels and answers "flushed" at once. The SDK's v1 client takes the collection name.
	 */
	private static void flushToCheckpoint(MilvusClientV2 client, String collection) {
		ConnectConfig config = ENDPOINTS.get(client);
		if (config == null) {
			throw new IllegalStateException("the client was not opened with MilvusRuntime.connect, so its endpoint is unknown");
		}
		ConnectParam.Builder connect = ConnectParam.newBuilder().withUri(config.getUri());
		if (config.getToken() != null && !config.getToken().isEmpty()) {
			connect.withToken(config.getToken());
		} else if (config.getUsername() != null && !config.getUsername().isEmpty()) {
			connect.withAuthorization(config.getUsername(), config.getPassword());
		}
		boolean named = config.getDbName() != null && !config.getDbName().isEmpty();
		if (named) {
			connect.withDatabaseName(config.getDbName());
		}
		MilvusServiceClient v1 = new MilvusServiceClient(connect.build());
		try {
			FlushParam.Builder flush = FlushParam.newBuilder().withCollectionNames(List.of(collection)).withSyncFlush(false);
			if (named) {
				flush.withDatabaseName(config.getDbName());
			}
			long deadline = System.currentTimeMillis() + 60000;
			R<FlushResponse> flushed;
			while (true) {
				flushed = v1.flush(flush.build());
				if (flushed.getStatus() == R.Status.Success.getCode()) {
					break;
				}
				if (!String.valueOf(flushed.getMessage()).toLowerCase().matches("(?s).*rate ?limit.*")
						|| System.currentTimeMillis() > deadline) {
					throw new IllegalStateException("flushing " + collection + " failed: " + flushed.getMessage());
				}
				sleep(1000);
			}
			Long flushTs = flushed.getData().getCollFlushTsMap().get(collection);
			if (flushTs == null) {
				return;
			}
			GetFlushStateParam.Builder state = GetFlushStateParam.newBuilder().withCollectionName(collection).withFlushTs(flushTs);
			if (named) {
				state.withDatabaseName(config.getDbName());
			}
			while (true) {
				R<GetFlushStateResponse> reply = v1.getFlushState(state.build());
				if (reply.getStatus() != R.Status.Success.getCode()) {
					throw new IllegalStateException("GetFlushState for " + collection + " failed: " + reply.getMessage());
				}
				if (reply.getData().getFlushed()) {
					return;
				}
				if (System.currentTimeMillis() > deadline) {
					throw new IllegalStateException(collection + " did not reach its flush checkpoint within 60 s");
				}
				sleep(500);
			}
		} finally {
			try {
				v1.close(5);
			} catch (InterruptedException e) {
				Thread.currentThread().interrupt();
			}
		}
	}

	/** Flushes first: a snapshot records sealed segments, so writes and deletes still in memory would be missing. */
	public static void createSnapshot(MilvusClientV2 client, Map<String, Object> args) {
		flushToCheckpoint(client, (String) args.get("collection_name"));
		CreateSnapshotReq.CreateSnapshotReqBuilder request = CreateSnapshotReq.builder()
				.collectionName((String) args.get("collection_name")).snapshotName((String) args.get("snapshot_name"));
		if (args.get("description") != null) {
			request.description((String) args.get("description"));
		}
		client.createSnapshot(request.build());
	}

	private static String snapshotOwner(MilvusClientV2 client, String snapshot) {
		List<String> owners = client.listCollections().getCollectionNames().stream().filter(name -> client.listSnapshots(
				ListSnapshotsReq.builder().collectionName(name).build()).getSnapshots().contains(snapshot)).toList();
		if (owners.size() != 1) {
			throw new IllegalArgumentException("snapshot " + snapshot + " belongs to " + owners.size() + " collections; name its collection");
		}
		return owners.get(0);
	}

	/** Restores a snapshot into a new collection and, when waiting, loads it so it serves queries. */
	public static Map<String, Object> restoreSnapshot(MilvusClientV2 client, Map<String, Object> args) {
		String snapshot = (String) args.get("snapshot_name");
		String target = (String) args.get("collection_name");
		String source = args.get("source_collection_name") != null ? (String) args.get("source_collection_name")
				: snapshotOwner(client, snapshot);
		Long jobId = client.restoreSnapshot(RestoreSnapshotReq.builder().snapshotName(snapshot).sourceCollectionName(source)
				.targetCollectionName(target).build()).getJobId();
		if (Boolean.FALSE.equals(args.get("wait"))) {
			return args("job_id", jobId);
		}
		while (true) {
			RestoreSnapshotJobInfo info = client.getRestoreSnapshotState(GetRestoreSnapshotStateReq.builder().jobId(jobId).build())
					.getJobInfo();
			if ("RestoreSnapshotCompleted".equals(info.getState())) {
				client.loadCollection(LoadCollectionReq.builder().collectionName(target).build());
				return args("job_id", jobId, "state", info.getState());
			}
			if ("RestoreSnapshotFailed".equals(info.getState())) {
				throw new IllegalStateException("restoring " + snapshot + " into " + target + " failed: " + info.getReason());
			}
			sleep(1000);
		}
	}

	public static void dropSnapshot(MilvusClientV2 client, Map<String, Object> args) {
		String snapshot = (String) args.get("snapshot_name");
		String owner = args.get("collection_name") != null ? (String) args.get("collection_name") : snapshotOwner(client, snapshot);
		client.dropSnapshot(DropSnapshotReq.builder().collectionName(owner).snapshotName(snapshot).build());
	}

	/** A materialized copy: a temporary snapshot restored under the new name, then dropped. */
	public static Map<String, Object> cloneCollection(MilvusClientV2 client, Map<String, Object> args) {
		String source = (String) args.get("collection_name");
		String target = (String) args.get("target_name");
		String snapshot = "vecdsl_clone_" + target;
		createSnapshot(client, args("collection_name", source, "snapshot_name", snapshot));
		try {
			restoreSnapshot(client, args("snapshot_name", snapshot, "collection_name", target, "source_collection_name", source));
		} finally {
			dropSnapshot(client, args("snapshot_name", snapshot, "collection_name", source));
		}
		return args("collection", target, "count", count(client, args("collection_name", target)));
	}

	// ------------------------------------------------------------- program entry

	public static Map<String, Object> parameters(Map<String, Object> given, Map<String, Object> defaults, List<String> names) {
		Set<String> unknown = new HashSet<>(given.keySet());
		unknown.removeAll(names);
		if (!unknown.isEmpty()) {
			throw new IllegalArgumentException("unknown program parameters: " + unknown);
		}
		Map<String, Object> values = new LinkedHashMap<>(defaults);
		values.putAll(given);
		List<String> missing = names.stream().filter(name -> !values.containsKey(name)).toList();
		if (!missing.isEmpty()) {
			throw new IllegalArgumentException("missing program parameters: " + missing);
		}
		return values;
	}

	public static Map<String, Object> parseArguments(String[] arguments) {
		Map<String, Object> parameters = new LinkedHashMap<>();
		for (String argument : arguments) {
			int separator = argument.indexOf('=');
			if (separator < 0) {
				throw new IllegalArgumentException("expected name=value, got " + argument);
			}
			String raw = argument.substring(separator + 1);
			Object value;
			try {
				value = GSON.fromJson(JsonParser.parseString(raw), Object.class);
			} catch (JsonParseException e) {
				value = raw;
			}
			parameters.put(argument.substring(0, separator), value);
		}
		return parameters;
	}
