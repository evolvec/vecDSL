	/** Opens a client, waiting for a server that is still starting (for example a fresh docker compose up). */
	public static MilvusClientV2 connect(ConnectConfig config) {
		long deadline = System.currentTimeMillis()
				+ (long) (Double.parseDouble(envOr("VECDSL_CONNECT_TIMEOUT", "120")) * 1000);
		while (true) {
			try {
				MilvusClientV2 client = new MilvusClientV2(config);
				client.getServerVersion();
				ENDPOINTS.put(client, config);
				return client;
			} catch (RuntimeException e) {
				if (System.currentTimeMillis() >= deadline) {
					throw e;
				}
				sleep(2000);
			}
		}
	}

	public static String serverVersion(MilvusClientV2 client) {
		return SERVER_VERSIONS.computeIfAbsent(client, MilvusClientV2::getServerVersion);
