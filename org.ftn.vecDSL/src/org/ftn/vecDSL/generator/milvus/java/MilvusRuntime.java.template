	public static List<Map<String, Object>> getRows(MilvusClientV2 client, Map<String, Object> args) {
		if (args.get("consistency_level") != null) {
			return queryByIds(client, args);
		}
		GetReq.GetReqBuilder request = GetReq.builder().collectionName((String) args.get("collection_name"))
				.ids(objects(args.get("ids"))).outputFields(names(args.get("output_fields")));
		if (args.get("partition_names") != null) {
			request.partitionNames(names(args.get("partition_names")));
		}
		return client.get(request.build()).getGetResults().stream().map(QueryResp.QueryResult::getEntity)
				.map(entity -> (Map<String, Object>) new LinkedHashMap<>(entity)).toList();
	}

	/** GetReq has no consistency level; the same QueryRequest by primary keys is sent through QueryReq, as pymilvus and Node do. */
	private static List<Map<String, Object>> queryByIds(MilvusClientV2 client, Map<String, Object> args) {
		QueryReq.QueryReqBuilder request = QueryReq.builder().collectionName((String) args.get("collection_name"))
				.ids(objects(args.get("ids"))).outputFields(names(args.get("output_fields")))
				.consistencyLevel((ConsistencyLevel) args.get("consistency_level"));
		if (args.get("partition_names") != null) {
			request.partitionNames(names(args.get("partition_names")));
		}
		return client.query(request.build()).getQueryResults().stream().map(QueryResp.QueryResult::getEntity)
				.map(entity -> (Map<String, Object>) new LinkedHashMap<>(entity)).toList();
	}

	private static Set<String> existingIds(MilvusClientV2 client, String collection, String primaryKey, List<Object> ids) {
		Set<String> found = new HashSet<>();
		for (List<Object> chunk : batches(ids, PAGE)) {
			for (Map<String, Object> row : getRows(client, args("collection_name", collection, "ids", chunk,
					"output_fields", List.of(primaryKey)))) {
				found.add(key(row.get(primaryKey)));
			}
		}
		return found;
	}

	@SuppressWarnings("unchecked")
	public static Map<String, Object> insertRows(MilvusClientV2 client, Map<String, Object> args) {
		String collection = (String) args.get("collection_name");
		String primaryKey = (String) args.get("primary_key");
		String onConflict = args.get("on_conflict") == null ? "error" : (String) args.get("on_conflict");
		List<Map<String, Object>> records = withDefaults(rows(args), (Map<String, Object>) args.get("defaults"));
		if (onConflict.equals("update") || onConflict.equals("replace")) {
			Map<String, Object> upsert = new LinkedHashMap<>(args);
			upsert.put("rows", records);
			upsert.remove("defaults");
			return args("insert_count", upsertRows(client, upsert).get("upsert_count"), "skipped", 0L);
		}
		List<Object> ids = records.stream().filter(row -> row.containsKey(primaryKey)).map(row -> row.get(primaryKey)).toList();
		Set<String> duplicates = ids.isEmpty() ? Set.of() : existingIds(client, collection, primaryKey, ids);
		if (!duplicates.isEmpty() && onConflict.equals("error")) {
			throw new IllegalStateException(duplicates.size() + " records already exist in " + collection + ": "
					+ duplicates.stream().limit(10).toList());
		}
		List<Map<String, Object>> fresh = records.stream().filter(row -> !duplicates.contains(key(row.get(primaryKey)))).toList();
		long inserted = 0;
		for (List<Map<String, Object>> chunk : batches(fresh, batchSize(args))) {
			InsertReq.InsertReqBuilder request = InsertReq.builder().collectionName(collection).data(jsonRows(chunk));
			if (args.get("partition_name") != null) {
				request.partitionName((String) args.get("partition_name"));
			}
			inserted += client.insert(request.build()).getInsertCnt();
		}
		return args("insert_count", inserted, "skipped", (long) duplicates.size());
	}

	@SuppressWarnings("unchecked")
	public static Map<String, Object> upsertRows(MilvusClientV2 client, Map<String, Object> args) {
		long upserted = 0;
		for (List<Map<String, Object>> chunk : batches(withDefaults(rows(args), (Map<String, Object>) args.get("defaults")),
				batchSize(args))) {
			UpsertReq.UpsertReqBuilder request = UpsertReq.builder().collectionName((String) args.get("collection_name"))
					.data(jsonRows(chunk));
			if (args.get("partition_name") != null) {
				request.partitionName((String) args.get("partition_name"));
			}
			upserted += client.upsert(request.build()).getUpsertCnt();
		}
		return args("upsert_count", upserted);
	}

	private static Set<String> functionOutputs(MilvusClientV2 client, String collection) {
		CreateCollectionReq.CollectionSchema schema = client
				.describeCollection(DescribeCollectionReq.builder().collectionName(collection).build()).getCollectionSchema();
		Set<String> outputs = new HashSet<>();
		if (schema != null && schema.getFunctionList() != null) {
			schema.getFunctionList().forEach(function -> outputs.addAll(function.getOutputFieldNames()));
		}
		return outputs;
	}

	@SuppressWarnings("unchecked")
	public static Map<String, Object> updateRows(MilvusClientV2 client, Map<String, Object> args) {
		String collection = (String) args.get("collection_name");
		String primaryKey = (String) args.get("primary_key");
		Map<String, Map<String, Object>> replacements = new LinkedHashMap<>();
		if (args.get("rows") != null) {
			rows(args).forEach(row -> replacements.put(key(row.get(primaryKey)), row));
		}
		List<Object> ids = objects(args.get("ids"));
		String filter = (String) args.get("filter");
		if ((ids == null || ids.isEmpty()) && filter == null) {
			if (replacements.isEmpty()) {
				throw new IllegalArgumentException("update requires ids, a filter or records");
			}
			ids = rows(args).stream().map(row -> row.get(primaryKey)).toList();
		}
		List<String> scope = args.get("partition_name") == null ? null : List.of((String) args.get("partition_name"));
		List<Map<String, Object>> current = ids != null && !ids.isEmpty()
				? getRows(client, args("collection_name", collection, "ids", ids, "output_fields", List.of("*"), "partition_names", scope))
				: scroll(client, args("collection_name", collection, "filter", filter, "output_fields", List.of("*"), "partition_names", scope));
		Set<String> derived = functionOutputs(client, collection);
		boolean merge = args.get("mode") == null || args.get("mode").equals("merge");
		List<Map<String, Object>> updated = new ArrayList<>();
		for (Map<String, Object> row : current) {
			Map<String, Object> merged = new LinkedHashMap<>();
			if (merge) {
				row.forEach((name, value) -> {
					if (!derived.contains(name)) {
						merged.put(name, value);
					}
				});
			} else {
				merged.put(primaryKey, row.get(primaryKey));
			}
			merged.putAll(replacements.getOrDefault(key(row.get(primaryKey)), Map.of()));
			if (args.get("values") != null) {
				merged.putAll((Map<String, Object>) args.get("values"));
			}
			if (args.get("remove") != null) {
				names(args.get("remove")).forEach(name -> merged.put(name, null));
			}
			updated.add(merged);
		}
		return upsertRows(client, args("collection_name", collection, "rows", updated, "partition_name", args.get("partition_name")));
	}

