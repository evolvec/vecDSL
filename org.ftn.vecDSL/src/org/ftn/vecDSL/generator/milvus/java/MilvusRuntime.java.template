	public static List<Object> exampleIds(Map<String, Object> args) {
		List<Object> result = new ArrayList<>();
		for (String side : List.of("positives", "negatives")) {
			List<Object> items = objects(args.get(side));
			if (items != null) {
				items.stream().filter(item -> !(item instanceof Collection<?>)).forEach(result::add);
			}
		}
		return result;
	}

	public static List<Float> recommendVector(MilvusClientV2 client, Map<String, Object> args) {
		List<List<Float>> positive = resolve(client, args, objects(args.get("positives")));
		List<List<Float>> negative = resolve(client, args, objects(args.get("negatives")));
		if (positive.isEmpty()) {
			throw new IllegalArgumentException("recommend requires at least one positive example");
		}
		List<Float> centroid = mean(positive);
		if (negative.isEmpty()) {
			return centroid;
		}
		List<Float> anti = mean(negative);
		List<Float> result = new ArrayList<>();
		for (int i = 0; i < centroid.size(); i++) {
			result.add(2 * centroid.get(i) - anti.get(i));
		}
		return result;
	}

	private static List<List<Float>> resolve(MilvusClientV2 client, Map<String, Object> args, List<Object> items) {
		List<List<Float>> vectors = new ArrayList<>();
		if (items == null) {
			return vectors;
		}
		List<Object> keys = new ArrayList<>();
		for (Object item : items) {
			if (item instanceof Collection<?>) {
				vectors.add(floats(item));
			} else {
				keys.add(item);
			}
		}
		if (!keys.isEmpty()) {
			String field = (String) args.get("field");
			getRows(client, args("collection_name", args.get("collection_name"), "ids", keys, "output_fields", List.of(field)))
					.forEach(row -> vectors.add(floats(row.get(field))));
		}
		return vectors;
	}

	private static List<Float> mean(List<List<Float>> vectors) {
		List<Float> result = new ArrayList<>();
		for (int i = 0; i < vectors.get(0).size(); i++) {
			float sum = 0;
			for (List<Float> vector : vectors) {
				sum += vector.get(i);
			}
			result.add(sum / vectors.size());
		}
		return result;
	}

	private static double pairwise(String metric, List<Float> left, List<Float> right) {
		double dot = 0;
		double leftNorm = 0;
		double rightNorm = 0;
		double squared = 0;
		for (int i = 0; i < left.size(); i++) {
			dot += left.get(i) * right.get(i);
			leftNorm += left.get(i) * left.get(i);
			rightNorm += right.get(i) * right.get(i);
			squared += (left.get(i) - right.get(i)) * (left.get(i) - right.get(i));
		}
		return switch (metric) {
		case "L2" -> -Math.sqrt(squared);
		case "COSINE" -> leftNorm == 0 || rightNorm == 0 ? 0 : dot / Math.sqrt(leftNorm * rightNorm);
		case "IP" -> dot;
		default -> throw unsupported("milvus", "distance matrix for metric " + metric);
		};
	}

	public static List<Map<String, Object>> distanceMatrix(MilvusClientV2 client, Map<String, Object> args) {
		String field = (String) args.get("field");
		String primaryKey = (String) args.get("primary_key");
		String metric = (String) args.get("metric");
		long sample = args.get("sample") == null ? 100 : ((Number) args.get("sample")).longValue();
		long limit = args.get("limit") == null ? 10 : ((Number) args.get("limit")).longValue();
		QueryReq.QueryReqBuilder request = QueryReq.builder().collectionName((String) args.get("collection_name"))
				.filter(args.get("filter") == null ? "" : (String) args.get("filter"))
				.outputFields(List.of(primaryKey, field)).limit(sample);
		if (args.get("consistency_level") != null) {
			request.consistencyLevel((ConsistencyLevel) args.get("consistency_level"));
		}
		List<Map<String, Object>> rows = client.query(request.build()).getQueryResults().stream()
				.map(QueryResp.QueryResult::getEntity).toList();
		List<Map<String, Object>> result = new ArrayList<>();
		for (Map<String, Object> row : rows) {
			List<Map<String, Object>> neighbours = rows.stream()
					.filter(other -> !key(other.get(primaryKey)).equals(key(row.get(primaryKey))))
					.map(other -> args("id", other.get(primaryKey), "score", pairwise(metric, floats(row.get(field)), floats(other.get(field)))))
					.sorted(Comparator.comparingDouble((Map<String, Object> entry) -> (Double) entry.get("score")).reversed())
					.limit(limit).toList();
			result.add(args("id", row.get(primaryKey), "neighbours", neighbours));
		}
		return result;
	}

