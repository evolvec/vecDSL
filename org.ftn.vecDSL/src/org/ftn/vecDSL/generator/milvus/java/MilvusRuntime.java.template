	public static String lit(Object value) {
		if (value instanceof Boolean b) {
			return b ? "true" : "false";
		}
		if (value instanceof Number || value instanceof String) {
			return GSON.toJson(value);
		}
		if (value instanceof Collection<?> items) {
			return items.stream().map(MilvusRuntime::lit).collect(Collectors.joining(", ", "[", "]"));
		}
		throw new IllegalArgumentException("cannot use " + value + " in a Milvus filter expression");
	}

	public static String expr(String template, Map<String, Object> values) {
		Matcher matcher = PLACEHOLDER.matcher(template);
		StringBuilder out = new StringBuilder();
		while (matcher.find()) {
			String name = matcher.group(1);
			matcher.appendReplacement(out, Matcher.quoteReplacement(values.containsKey(name) ? lit(values.get(name)) : matcher.group()));
		}
		return matcher.appendTail(out).toString();
	}

	public static double timeValue(Map<String, Object> args) {
		Object value = args.get("value");
		if (value instanceof Number n) {
			return n.doubleValue();
		}
		String text = value.toString().trim();
		if (text.equals("now")) {
			return System.currentTimeMillis() / 1000.0;
		}
		Matcher duration = DURATION.matcher(text);
		if (duration.matches()) {
			return Double.parseDouble(duration.group(1)) * DURATION_SECONDS.get(duration.group(2));
		}
		try {
			return OffsetDateTime.parse(text).toEpochSecond();
		} catch (RuntimeException e) {
			return LocalDateTime.parse(text).toEpochSecond(ZoneOffset.UTC);
		}
	}

	public static double similarity(String metric, double distance) {
		return switch (metric) {
		case "L2" -> -Math.sqrt(Math.max(distance, 0));
		case "HAMMING" -> -distance;
		case "JACCARD" -> 1 - distance;
		default -> distance;
		};
	}

	public static List<Map<String, Object>> hits(Map<String, Object> args) {
		SearchResp results = (SearchResp) args.get("results");
		String metric = (String) args.get("metric");
		boolean nativeScore = Boolean.TRUE.equals(args.get("native"));
		Number maxScore = (Number) args.get("max_score");
		String primaryKey = (String) args.get("primary_key");
		List<Map<String, Object>> rows = new ArrayList<>();
		if (results.getSearchResults().isEmpty()) {
			return rows;
		}
		for (SearchResp.SearchResult hit : results.getSearchResults().get(0)) {
			double score = nativeScore ? hit.getScore() : similarity(metric, hit.getScore());
			if (maxScore != null && score > maxScore.doubleValue()) {
				continue;
			}
			Map<String, Object> row = new LinkedHashMap<>();
			row.put("id", hit.getId());
			row.put("score", score);
			hit.getEntity().forEach((key, value) -> {
				if (!key.equals(primaryKey)) {
					row.put(key, value);
				}
			});
			rows.add(row);
		}
		return rows;
	}

