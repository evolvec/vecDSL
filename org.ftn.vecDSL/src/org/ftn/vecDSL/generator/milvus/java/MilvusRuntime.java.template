	private static List<Map<String, Object>> withDefaults(List<Map<String, Object>> rows, Map<String, Object> defaults) {
		List<Map<String, Object>> result = new ArrayList<>();
		for (Map<String, Object> row : rows) {
			Map<String, Object> merged = new LinkedHashMap<>();
			if (defaults != null) {
				merged.putAll(defaults);
			}
			merged.putAll(row);
			result.add(merged);
		}
		return result;
	}

	private static <T> List<List<T>> batches(List<T> items, int size) {
		List<List<T>> result = new ArrayList<>();
		for (int start = 0; start < items.size(); start += size) {
			result.add(items.subList(start, Math.min(items.size(), start + size)));
		}
		return result;
	}

	private static int batchSize(Map<String, Object> args) {
		Object size = args.get("batch_size");
		return size == null ? PAGE : ((Number) size).intValue();
	}

