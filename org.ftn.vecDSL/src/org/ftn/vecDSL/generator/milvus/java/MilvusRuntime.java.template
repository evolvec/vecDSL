	public static List<Map<String, Object>> readRecords(Map<String, Object> args) {
		String location = (String) args.get("location");
		String path = location.startsWith("file://") ? location.substring("file://".length()) : location;
		if (path.contains("://")) {
			throw unsupported("milvus", "reading records from " + location + "; it requires server-side bulk import");
		}
		String format = (String) args.get("format");
		String kind = (format != null ? format : path.substring(path.lastIndexOf('.') + 1)).toLowerCase();
		try {
			String text = Files.readString(Path.of(path), StandardCharsets.UTF_8).trim();
			java.lang.reflect.Type rowType = new TypeToken<Map<String, Object>>() {
			}.getType();
			switch (kind) {
			case "json", "jsonl", "ndjson" -> {
				if (text.startsWith("[")) {
					return NUMBERS.fromJson(text, new TypeToken<List<Map<String, Object>>>() {
					}.getType());
				}
				List<Map<String, Object>> rows = new ArrayList<>();
				for (String line : text.split("\\R")) {
					if (!line.isBlank()) {
						rows.add(NUMBERS.fromJson(line, rowType));
					}
				}
				return rows;
			}
			case "csv" -> {
				String[] lines = text.split("\\R");
				String[] names = lines[0].split(",");
				List<Map<String, Object>> rows = new ArrayList<>();
				for (int i = 1; i < lines.length; i++) {
					String[] cells = lines[i].split(",", -1);
					Map<String, Object> row = new LinkedHashMap<>();
					for (int c = 0; c < names.length; c++) {
						row.put(names[c], c < cells.length ? cells[c] : null);
					}
					rows.add(row);
				}
				return rows;
			}
			default -> throw unsupported("milvus", "record format " + kind);
			}
		} catch (IOException e) {
			throw new UncheckedIOException(e);
		}
	}

	private static List<JsonObject> jsonRows(List<Map<String, Object>> rows) {
		return rows.stream().map(row -> GSON.toJsonTree(row).getAsJsonObject()).toList();
