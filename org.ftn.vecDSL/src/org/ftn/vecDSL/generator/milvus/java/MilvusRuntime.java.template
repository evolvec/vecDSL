	public static List<Map<String, Object>> scroll(MilvusClientV2 client, Map<String, Object> args) {
		QueryIteratorReq.QueryIteratorReqBuilder request = QueryIteratorReq.builder()
				.collectionName((String) args.get("collection_name"))
				.expr(args.get("filter") == null ? "" : (String) args.get("filter"))
				.outputFields(names(args.get("output_fields")) == null ? List.of() : names(args.get("output_fields")))
				.batchSize(PAGE);
		if (args.get("limit") != null) {
			request.limit(((Number) args.get("limit")).longValue());
		}
		if (args.get("offset") != null) {
			request.offset(((Number) args.get("offset")).longValue());
		}
		if (args.get("partition_names") != null) {
			request.partitionNames(names(args.get("partition_names")));
		}
		QueryIterator iterator = client.queryIterator(request.build());
		List<Map<String, Object>> rows = new ArrayList<>();
		try {
			while (true) {
				List<QueryResultsWrapper.RowRecord> batch = iterator.next();
				if (batch.isEmpty()) {
					return rows;
				}
				batch.forEach(record -> rows.add(new LinkedHashMap<>(record.getFieldValues())));
			}
		} finally {
			iterator.close();
		}
	}

	public static List<Float> lookupVector(MilvusClientV2 client, Map<String, Object> args) {
