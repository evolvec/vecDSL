	public static void useDatabase(MilvusClientV2 client, String name) {
		try {
			client.useDatabase(name);
		} catch (InterruptedException e) {
			Thread.currentThread().interrupt();
			throw new IllegalStateException("interrupted while switching to database " + name, e);
		}
	}

	private static List<Integer> versionTuple(String text) {
		List<Integer> parts = new ArrayList<>();
		for (String token : text.replaceFirst("^v", "").split("[.+\\-]")) {
			if (!token.matches("\\d+")) {
				break;
			}
			parts.add(Integer.parseInt(token));
		}
		return parts;
	}

	private static void sleep(long milliseconds) {
		try {
			Thread.sleep(milliseconds);
		} catch (InterruptedException e) {
			Thread.currentThread().interrupt();
			throw new IllegalStateException(e);
		}
	}

