	public static boolean isLite(MilvusClientV2 client) {
		return serverVersion(client).startsWith("milvus_lite");
	}

	public static String checkServer(MilvusClientV2 client) {
		String found = serverVersion(client);
		List<Integer> expected = versionTuple(SERVER_SERIES);
		List<Integer> actual = versionTuple(found);
		if (!isLite(client) && !actual.subList(0, Math.min(actual.size(), expected.size())).equals(expected)) {
			System.err.println("warning: program generated for Milvus " + SERVER_SERIES + ".x is connected to Milvus " + found);
		}
		return found;
	}

	public static void requireServer(MilvusClientV2 client, String feature) {
