	public static Map<String, Object> compact(MilvusClientV2 client, Map<String, Object> args) {
		Long id = client.compact(CompactReq.builder().collectionName((String) args.get("collection_name")).build()).getCompactionID();
		if (Boolean.FALSE.equals(args.get("wait"))) {
			return args("compaction_id", id);
		}
		while (true) {
			String state = client.getCompactionState(GetCompactionStateReq.builder().compactionID(id).build()).getState().name();
			if (state.equalsIgnoreCase("Completed")) {
				return args("compaction_id", id, "state", state);
			}
			sleep(1000);
		}
	}

	public static Map<String, Object> awaitIndex(MilvusClientV2 client, Map<String, Object> args) {
		String collection = (String) args.get("collection_name");
		String index = (String) args.get("index_name");
		String until = args.get("until") == null ? "ready" : (String) args.get("until");
		Long deadline = args.get("timeout") == null ? null
				: System.currentTimeMillis() + (long) (((Number) args.get("timeout")).doubleValue() * 1000);
		while (true) {
			DescribeIndexResp.IndexDesc info;
			try {
				info = client.describeIndex(DescribeIndexReq.builder().collectionName(collection).indexName(index).build())
						.getIndexDescriptions().get(0);
			} catch (RuntimeException e) {
				info = client.describeIndex(DescribeIndexReq.builder().collectionName(collection)
						.fieldName((String) args.get("field_name")).build()).getIndexDescriptions().get(0);
			}
			String state = String.valueOf(info.getIndexState()).toLowerCase();
			Map<String, Object> result = args("index_name", info.getIndexName(), "state", state, "indexed_rows",
					info.getIndexedRows(), "pending_index_rows", info.getPendingIndexRows());
			if (state.contains("fail")) {
				if (until.equals("failed")) {
					return result;
				}
				throw new IllegalStateException("index " + index + " on " + collection + " failed: " + info.getIndexFailedReason());
			}
			if (until.equals("pending") || until.equals("building") || (state.equals("finished") && info.getPendingIndexRows() == 0)) {
				return result;
			}
			if (deadline != null && System.currentTimeMillis() > deadline) {
				throw new IllegalStateException("index " + index + " on " + collection + " not ready within " + args.get("timeout") + " s");
			}
			sleep(1000);
		}
	}

	public static Map<String, Object> describe(MilvusClientV2 client, Map<String, Object> args) {
		String collection = (String) args.get("collection_name");
		Map<String, Object> result = args("collection",
				client.describeCollection(DescribeCollectionReq.builder().collectionName(collection).build()));
		if (Boolean.TRUE.equals(args.get("stats"))) {
			result.put("stats", client.getCollectionStats(GetCollectionStatsReq.builder().collectionName(collection).build()));
		}
		if (Boolean.TRUE.equals(args.get("index_progress"))) {
			Map<String, Object> indexes = new LinkedHashMap<>();
			for (String name : client.listIndexes(ListIndexesReq.builder().collectionName(collection).build())) {
				indexes.put(name, client.describeIndex(DescribeIndexReq.builder().collectionName(collection).indexName(name).build()));
			}
			result.put("indexes", indexes);
		}
		return result;
	}

	public static List<String> listObjects(MilvusClientV2 client, Map<String, Object> args) {
		String kind = (String) args.get("kind");
		String scope = args.get("scope") == null ? "" : (String) args.get("scope");
		List<String> names = switch (kind) {
		case "collections" -> client.listCollections().getCollectionNames();
		case "databases" -> client.listDatabases().getDatabaseNames();
		case "indexes" -> client.listIndexes(ListIndexesReq.builder().collectionName(scope).build());
		case "partitions" -> client.listPartitions(ListPartitionsReq.builder().collectionName(scope).build());
		case "aliases" -> client.listAliases(ListAliasesReq.builder().collectionName(scope).build()).getAlias();
		case "tenants", "namespaces" -> client.listPartitions(ListPartitionsReq.builder().collectionName(scope).build()).stream()
				.filter(name -> args.get("only") != null && names(args.get("only")).contains(name)).toList();
		case "snapshots" -> {
			List<String> found = new ArrayList<>();
			for (String owner : scope.isEmpty() ? client.listCollections().getCollectionNames() : List.of(scope)) {
				found.addAll(client.listSnapshots(ListSnapshotsReq.builder().collectionName(owner).build()).getSnapshots());
			}
			yield found.stream().sorted().toList();
		}
		default -> throw unsupported("milvus", "listing " + kind);
		};
		String prefix = (String) args.get("prefix");
		List<String> filtered = names.stream().filter(name -> prefix == null || name.startsWith(prefix)).sorted().toList();
		return args.get("limit") == null ? filtered : filtered.stream().limit(((Number) args.get("limit")).longValue()).toList();
	}

