	private static int compareKeys(Object left, Object right) {
		if (left instanceof Number a && right instanceof Number b) {
			return Long.compare(a.longValue(), b.longValue());
		}
		return String.valueOf(left).compareTo(String.valueOf(right));
	}

	private static List<Object> keys(MilvusClientV2 client, String collection, String primaryKey, Object filter, Object partitionNames) {
		Map<String, Object> request = args("collection_name", collection, "filter", filter, "output_fields", List.of(primaryKey));
		if (partitionNames != null) {
			request.put("partition_names", partitionNames);
		}
		List<Object> found = new ArrayList<>();
		for (Map<String, Object> row : scroll(client, request)) {
			found.add(row.get(primaryKey));
		}
		found.sort(MilvusRuntime::compareKeys);
		return found;
	}

	/** Deletes the matching records, or the first n in primary key order: Milvus deletes take no limit. */
	public static Map<String, Object> deleteMatching(MilvusClientV2 client, Map<String, Object> args) {
		String collection = (String) args.get("collection_name");
		Object partition = args.get("partition_name");
		List<Object> found = keys(client, collection, (String) args.get("primary_key"), args.get("filter"),
				partition == null ? null : List.of(partition));
		if (args.get("limit") != null) {
			found = found.subList(0, (int) Math.min(found.size(), integer(args.get("limit"))));
		}
		long deleted = 0;
		for (List<Object> chunk : batches(found, PAGE)) {
			deleted += ((Number) deleteRows(client, args("collection_name", collection, "ids", chunk, "partition_name", partition))
					.get("delete_count")).longValue();
		}
		return args("delete_count", deleted);
	}

	/** Exactly min(size, matches) records: a uniform draw over the matching keys, or the first ones in key order. */
	public static List<Map<String, Object>> sampleRows(MilvusClientV2 client, Map<String, Object> args) {
		String primaryKey = (String) args.get("primary_key");
		List<Object> found = keys(client, (String) args.get("collection_name"), primaryKey, args.get("filter"),
				args.get("partition_names"));
		int size = (int) Math.min(found.size(), integer(args.get("size")));
		List<Object> chosen;
		if (Boolean.TRUE.equals(args.get("first"))) {
			chosen = new ArrayList<>(found.subList(0, size));
		} else {
			List<Object> pool = new ArrayList<>(found);
			Collections.shuffle(pool, RANDOM);
			chosen = new ArrayList<>(pool.subList(0, size));
			chosen.sort(MilvusRuntime::compareKeys);
		}
		if (chosen.isEmpty()) {
			return List.of();
		}
		List<String> output = new ArrayList<>(List.of(primaryKey));
		output.addAll(names(args.get("output_fields")));
		Map<String, Object> request = args("collection_name", args.get("collection_name"), "ids", chosen, "output_fields", output);
		if (args.get("partition_names") != null) {
			request.put("partition_names", args.get("partition_names"));
		}
		Map<String, Map<String, Object>> byKey = new LinkedHashMap<>();
		getRows(client, request).forEach(row -> byKey.put(key(row.get(primaryKey)), row));
		return chosen.stream().map(id -> byKey.get(key(id))).toList();
	}

	/** POST to the Milvus RESTful API v2 at the endpoint the client was opened with (for calls the SDK lacks). */
	private static Map<String, Object> rest(MilvusClientV2 client, String path, Map<String, Object> body) {
		ConnectConfig config = ENDPOINTS.get(client);
		if (config == null) {
			throw new IllegalStateException("the client was not opened with MilvusRuntime.connect, so its REST endpoint is unknown");
		}
		String base = config.getUri().matches("^https?://.*") ? config.getUri() : "http://" + config.getUri();
		Map<String, Object> payload = new LinkedHashMap<>();
		if (config.getDbName() != null && !config.getDbName().isEmpty()) {
			payload.put("dbName", config.getDbName());
		}
		payload.putAll(body);
		HttpRequest.Builder request = HttpRequest.newBuilder(URI.create(base.replaceAll("/+$", "") + "/v2/vectordb" + path))
				.header("Content-Type", "application/json").POST(HttpRequest.BodyPublishers.ofString(NUMBERS.toJson(payload)));
		String token = config.getToken() != null && !config.getToken().isEmpty() ? config.getToken()
				: config.getUsername() != null && !config.getUsername().isEmpty() ? config.getUsername() + ":" + config.getPassword() : null;
		if (token != null) {
			request.header("Authorization", "Bearer " + token);
		}
		try {
			HttpResponse<String> response = HTTP.send(request.build(), HttpResponse.BodyHandlers.ofString(StandardCharsets.UTF_8));
			Map<String, Object> reply = NUMBERS.fromJson(response.body(), new TypeToken<Map<String, Object>>() {
			}.getType());
			if (reply.get("code") instanceof Number code && code.longValue() != 0) {
				throw new IllegalStateException("Milvus REST " + path + " failed: " + reply.get("message"));
			}
			@SuppressWarnings("unchecked")
			Map<String, Object> data = (Map<String, Object>) reply.get("data");
			return data == null ? Map.of() : data;
		} catch (IOException e) {
			throw new UncheckedIOException(e);
		} catch (InterruptedException e) {
			Thread.currentThread().interrupt();
			throw new IllegalStateException("interrupted during Milvus REST " + path, e);
		}
	}

	/** Starts a Milvus import job over files in the server's bucket and, unless asked not to, waits for it. */
	public static Map<String, Object> bulkImport(MilvusClientV2 client, Map<String, Object> args) {
		Map<String, Object> body = args("collectionName", args.get("collection_name"), "files", args.get("files"));
		if (args.get("partition_name") != null) {
			body.put("partitionName", args.get("partition_name"));
		}
		String jobId = String.valueOf(rest(client, "/jobs/import/create", body).get("jobId"));
		if (Boolean.FALSE.equals(args.get("wait"))) {
			return args("job_id", jobId);
		}
		while (true) {
			Map<String, Object> progress = rest(client, "/jobs/import/describe", args("jobId", jobId));
			Object state = progress.get("state");
			if ("Completed".equals(state)) {
				Object imported = progress.get("importedRows");
				return args("job_id", jobId, "state", state, "imported_rows", imported == null ? 0L : ((Number) imported).longValue());
			}
			if ("Failed".equals(state)) {
				throw new IllegalStateException("import job " + jobId + " into " + args.get("collection_name") + " failed: " + progress.get("reason"));
			}
			sleep(1000);
		}
	}

	public static void dropAliases(MilvusClientV2 client, Map<String, Object> args) {
