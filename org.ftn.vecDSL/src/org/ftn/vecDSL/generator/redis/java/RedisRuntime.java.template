/**
 * Runtime support for vecDSL programs generated for Redis Open Source with the Query Engine, through Jedis and Gson. Generated
 * by vecDSL 7. Do not edit.
 *
 * Every statement arrives as Redis command argument arrays built by the generator, identical in the Python, TypeScript and Java
 * programs; values travel as separate arguments or as PARAMS of a query, never inside a query string. Records are JSON documents
 * under the collection's key prefix. Writes read the affected documents under WATCH, compute the new documents and commit them
 * in one MULTI/EXEC, so a write is atomic and fails when another client changed a key in between. Replies are read in RESP2
 * through Jedis.sendCommand, as raw bytes.
 */
public final class RedisRuntime {

	private static final int DIGITS = 6;
	private static final int BATCH = 500;
	private static final int PAGE = 1000;
	private static final int TIMEOUT = 10_000;
	private static final String SCORE = "vecdsl_score";
	private static final String SEPARATORS = " \t,./(){}[]:;~!@#$%^&*-=+|'`\"<>?";
	private static final Pattern MARKER = Pattern.compile("\\{\\{(and|or|fuzzy1|fuzzy2|fuzzy3|prefix|prefixlast|tags):([A-Za-z0-9_]+)\\}\\}");
	/** RediSearch's built-in stop-word list (src/stopwords.h), which an index uses unless STOPWORDS is given. */
	private static final List<String> DEFAULT_STOPWORDS = List.of("a", "is", "the", "an", "and", "are", "as", "at", "be", "but", "by", "for",
			"if", "in", "into", "it", "no", "not", "of", "on", "or", "such", "that", "their", "then", "there", "these", "they", "this", "to",
			"was", "will", "with");
	private static final Gson PRETTY = new GsonBuilder().serializeNulls().setPrettyPrinting().create();
	private static final Gson NUMBERS = new GsonBuilder().setObjectToNumberStrategy(ToNumberPolicy.LONG_OR_DOUBLE).create();

	private RedisRuntime() {
	}

