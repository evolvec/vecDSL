/**
 * Runtime support for vecDSL programs generated for MongoDB, through the synchronous MongoDB Java driver and Gson. Generated by
 * vecDSL 7. Do not edit.
 *
 * Every command document, index definition, filter and aggregation pipeline is built by the generator and arrives here as a
 * value identical in the Python, TypeScript and Java programs; this class sends it with MongoDatabase.runCommand or
 * MongoCollection.aggregate and shapes the answer. Numbers are sent in one BSON form in every language (integral values as
 * int32, or int64 beyond its range, others as double; vectors always as doubles). Search results are eventually consistent:
 * mongot follows mongod through a change stream, so a write that asks for visibility waits until every search index of its
 * collection shows it. The result-shape clauses that MongoDB has no stage for (boost and mmr, and the result clauses of a hybrid
 * search) run in the shared module Shapes over the candidate window.
 */
public final class MongodbRuntime {

	private static final int DIGITS = 6;
	private static final int BATCH = 500;
	private static final long POLL_MILLIS = 250;
	private static final String STAMP = "vecdsl_stamp";
	private static final String VERSION = "vecdsl_version";
	private static final String EXPIRES = "vecdsl_expires";
	private static final Gson PRETTY = new GsonBuilder().serializeNulls().disableHtmlEscaping().setPrettyPrinting().create();
	private static final Gson NUMBERS = new GsonBuilder().setObjectToNumberStrategy(ToNumberPolicy.LONG_OR_DOUBLE).create();
	private static final DateTimeFormatter ISO = DateTimeFormatter.ofPattern("yyyy-MM-dd'T'HH:mm:ss.SSS'Z'").withZone(ZoneOffset.UTC);

	private MongodbRuntime() {
	}

