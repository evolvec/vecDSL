	public static Map<String, Object> parameters(Map<String, Object> given, Map<String, Object> defaults, List<String> names) {
		Set<String> unknown = new HashSet<>(given.keySet());
		unknown.removeAll(names);
		if (!unknown.isEmpty()) {
			throw new IllegalArgumentException("unknown program parameters: " + unknown);
		}
		Map<String, Object> values = new LinkedHashMap<>(defaults);
		values.putAll(given);
		List<String> missing = names.stream().filter(name -> !values.containsKey(name)).toList();
		if (!missing.isEmpty()) {
			throw new IllegalArgumentException("missing program parameters: " + missing);
		}
		return values;
	}

	public static Map<String, Object> parseArguments(String[] arguments) {
		Map<String, Object> parameters = new LinkedHashMap<>();
		for (String argument : arguments) {
			int separator = argument.indexOf('=');
			if (separator < 0) {
				throw new IllegalArgumentException("expected name=value, got " + argument);
			}
			String raw = argument.substring(separator + 1);
			Object value;
			try {
				value = NUMBERS.fromJson(JsonParser.parseString(raw), Object.class);
			} catch (JsonParseException e) {
				value = raw;
			}
			parameters.put(argument.substring(0, separator), value);
		}
		return parameters;
	}

	private static double plain(Number number) {
		return number instanceof Float single ? Double.parseDouble(Float.toString(single)) : number.doubleValue();
	}

	/** A value in the BSON form every runtime sends: integral numbers as int32 (int64 beyond), others as double, {"$date": ISO} as a date. */
	static Object bson(Object value) {
		if (value instanceof Map<?, ?> map) {
			if (map.size() == 1 && map.get("$date") instanceof String iso) {
				return date(iso);
			}
			Document result = new Document();
			map.forEach((key, entry) -> result.put(String.valueOf(key), bson(entry)));
			return result;
		}
		if (value instanceof Collection<?> items) {
			List<Object> result = new ArrayList<>();
			items.forEach(item -> result.add(bson(item)));
			return result;
		}
		if (value instanceof Float || value instanceof Double) {
			double number = plain((Number) value);
			if (Double.isFinite(number) && number == Math.rint(number) && Math.abs(number) < 1e15) {
				return integral((long) number);
			}
			return number;
		}
		if (value instanceof Integer || value instanceof Long || value instanceof Short || value instanceof Byte) {
			return integral(((Number) value).longValue());
		}
		return value;
	}

	private static Object integral(long number) {
		return number >= Integer.MIN_VALUE && number <= Integer.MAX_VALUE ? (Object) (int) number : (Object) number;
	}

	private static Document document(Object value) {
		return (Document) bson(value);
	}

	private static Date date(String text) {
		if (text.matches("\\d{4}-\\d{2}-\\d{2}")) {
			return Date.from(LocalDate.parse(text).atStartOfDay().toInstant(ZoneOffset.UTC));
		}
		try {
			return Date.from(OffsetDateTime.parse(text).toInstant());
		} catch (RuntimeException e) {
			return Date.from(Instant.parse(text.endsWith("Z") ? text : text + "Z"));
		}
	}

	/** Doubles that stay doubles on the wire: bson() sends integral Double values as int32, BsonDouble passes through unchanged. */
	private static List<BsonDouble> exact(List<Double> numbers) {
		return numbers.stream().map(BsonDouble::new).toList();
	}

	private static List<Double> doubles(Object vector) {
		List<Double> result = new ArrayList<>();
		for (Object item : (Collection<?>) vector) {
			result.add(item instanceof BsonDouble exact ? exact.getValue() : plain((Number) item));
		}
		return result;
	}

	/** GeoJSON points from {"$geoPoint": "lat,lon"} (a geo_point value of the script) and from {lat, lon} records. */
	private static Object geo(Object value) {
		if (value instanceof Map<?, ?> marked && marked.size() == 1 && marked.containsKey("$geoPoint")) {
			Object text = marked.get("$geoPoint");
			String[] parts = text instanceof String written ? written.split(",") : new String[0];
			String problem = "a geo_point value is written \"lat,lon\", not " + text;
			if (parts.length != 2) {
				throw new MongodbFailure(problem, null);
			}
			try {
				return new Document("type", "Point").append("coordinates", List.of(Double.parseDouble(parts[1].trim()), Double.parseDouble(parts[0].trim())));
			} catch (NumberFormatException e) {
				throw new MongodbFailure(problem, e);
			}
		}
		if (value instanceof Map<?, ?> map && map.containsKey("lat") && (map.containsKey("lon") || map.containsKey("lng"))) {
			Object longitude = map.containsKey("lon") ? map.get("lon") : map.get("lng");
			return new Document("type", "Point").append("coordinates", List.of(plain((Number) longitude), plain((Number) map.get("lat"))));
		}
		return value;
	}

	private static Document coerce(Map<String, Object> source, List<String> vectors, List<String> dates) {
		Document result = document(source);
		for (String name : vectors) {
			if (result.get(name) != null) {
				result.put(name, exact(doubles(result.get(name))));
			}
		}
		for (String name : dates) {
			if (result.get(name) instanceof String iso) {
				result.put(name, date(iso));
			}
		}
		for (String name : new ArrayList<>(result.keySet())) {
			result.put(name, geo(result.get(name)));
		}
		return result;
	}

	/** Result values in one form for every host language: floats rounded, integral numbers as integers, dates as ISO strings. */
	static Object value(Object item) {
		return value(item, true);
	}

	/** Result values as value gives them; without rounded, the floats as they are (the candidates of the shared result-shape module). */
	@SuppressWarnings("unchecked")
	static Object value(Object item, boolean rounded) {
		if (item instanceof Decimal128 decimal) {
			return value(decimal.bigDecimalValue().doubleValue(), rounded);
		}
		if (item instanceof Float || item instanceof Double) {
			double number = ((Number) item).doubleValue();
			if (!Double.isFinite(number) || !rounded) {
				return number;
			}
			double scaled = new BigDecimal(number).setScale(DIGITS, RoundingMode.HALF_EVEN).doubleValue();
			return scaled == Math.rint(scaled) && Math.abs(scaled) < 1e15 ? (Object) (long) scaled : (Object) scaled;
		}
		if (item instanceof Number number) {
			return number.longValue();
		}
		if (item instanceof Date date) {
			return ISO.format(date.toInstant());
		}
		if (item instanceof ObjectId id) {
			return id.toHexString();
		}
		if (item instanceof Collection<?> items) {
			return items.stream().map(entry -> value(entry, rounded)).toList();
		}
		if (item instanceof Map<?, ?> map) {
			Map<String, Object> result = new LinkedHashMap<>();
			((Map<String, Object>) map).forEach((key, entry) -> result.put(key, value(entry, rounded)));
			return result;
		}
		return item;
	}

	/** A record with the key first and the score second, as every runtime orders them. */
	private static Map<String, Object> record(Map<String, Object> document, String key) {
		if (key == null || !document.containsKey(key)) {
			return document;
		}
		Map<String, Object> ordered = new LinkedHashMap<>();
		ordered.put(key, document.get(key));
		if (document.containsKey("score")) {
			ordered.put("score", document.get("score"));
		}
		document.forEach((name, item) -> ordered.putIfAbsent(name, item));
		return ordered;
	}

	@SuppressWarnings("unchecked")
	private static List<String> strings(Object value) {
		return value == null ? List.of() : (List<String>) value;
	}

	@SuppressWarnings("unchecked")
	private static Map<String, Object> map(Object value) {
		return (Map<String, Object>) value;
	}

	@SuppressWarnings("unchecked")
	private static List<Object> items(Object value) {
		return value == null ? List.of() : (List<Object>) value;
	}

	// ---------------------------------------------------------------- client

	/** The MongoClient of one program; credentials come from the environment only. */
	public static final class Client implements AutoCloseable {

		final MongoClient mongo;
		final String url;

		Client(String url, String user, String userVariable, String passwordVariable, double timeoutSeconds) {
			String authority = url.contains("//") ? url.split("//", 2)[1].split("/", 2)[0] : "";
			if (authority.contains("@")) {
				throw new IllegalArgumentException("the MongoDB URI must not contain credentials; set them in the environment");
			}
			this.url = url;
			long millis = Math.round(timeoutSeconds * 1000);
			MongoClientSettings.Builder settings = MongoClientSettings.builder().applyConnectionString(new ConnectionString(url)).applicationName("vecdsl")
					.applyToClusterSettings(cluster -> cluster.serverSelectionTimeout(millis, TimeUnit.MILLISECONDS))
					.applyToSocketSettings(socket -> socket.connectTimeout(millis, TimeUnit.MILLISECONDS).readTimeout(millis, TimeUnit.MILLISECONDS));
			String name = System.getenv(userVariable);
			if (name == null || name.isEmpty()) {
				name = user;
			}
			if (name != null && !name.isEmpty()) {
				String password = System.getenv(passwordVariable);
				if (password == null) {
					throw new IllegalStateException("environment variable " + passwordVariable + " is not set (the password of user " + name + ")");
				}
				settings.credential(MongoCredential.createCredential(name, "admin", password.toCharArray()));
			}
			this.mongo = MongoClients.create(settings.build());
		}

		@Override
		public void close() {
			mongo.close();
		}
	}

	public static Client connect(Map<String, Object> args) {
		return new Client((String) args.get("url"), (String) args.get("user"), (String) args.getOrDefault("user_variable", "VECDSL_MONGODB_USER"),
				(String) args.getOrDefault("password_variable", "VECDSL_MONGODB_PASSWORD"), ((Number) args.getOrDefault("timeout_seconds", 30)).doubleValue());
	}

	private static MongodbFailure failure(MongoException error, String what) {
		if (error instanceof MongoCommandException command) {
			return new MongodbFailure(what + " failed: " + command.getErrorCodeName() + ": " + command.getErrorMessage(), error);
		}
		return new MongodbFailure(what + " failed (" + error.getClass().getSimpleName() + "): " + error.getMessage(), error);
	}

	private static Document runCommand(Client client, String database, Map<String, Object> command, ClientSession session) {
		Document document = document(command);
		try {
			MongoDatabase db = client.mongo.getDatabase(database);
			return session == null ? db.runCommand(document) : db.runCommand(session, document);
		} catch (MongoException error) {
			throw failure(error, document.keySet().iterator().next() + " on " + database);
		}
	}

	private static Object select(Object item, List<String> path) {
		Object current = item;
		for (String key : path) {
			if (current == null) {
				return null;
			}
			if (current instanceof List<?> list) {
				int index = Integer.parseInt(key);
				current = index < list.size() ? list.get(index) : null;
			} else {
				current = ((Map<?, ?>) current).get(key);
			}
		}
		return current;
	}

	/** One database command; select picks a member of the answer, wrap names it, ignore lists error code names that mean done. */
	public static Object command(Client client, Map<String, Object> args) {
		String database = (String) args.get("database");
		Document command = document(args.get("command"));
		Document answer;
		try {
			answer = client.mongo.getDatabase(database).runCommand(command);
		} catch (MongoCommandException error) {
			if (strings(args.get("ignore")).contains(error.getErrorCodeName())) {
				return null;
			}
			throw failure(error, command.keySet().iterator().next() + " on " + database);
		} catch (MongoException error) {
			throw failure(error, command.keySet().iterator().next() + " on " + database);
		}
		Object result = value(select(answer, strings(args.get("select"))));
		return args.get("wrap") == null ? result : args((String) args.get("wrap"), result);
	}

	public static boolean exists(Client client, Map<String, Object> args) {
		Document answer = runCommand(client, (String) args.get("database"), args("listCollections", 1, "filter", args("name", args("$eq", args.get("collection"))),
				"nameOnly", true), null);
		return !items(((Document) answer.get("cursor")).get("firstBatch")).isEmpty();
	}

	/** The pipeline with every $vectorSearch queryVector as doubles (vector replaces it when given). */
	private static List<Object> queryVectors(List<Object> pipeline, List<Double> vector) {
		List<Object> result = new ArrayList<>();
		for (Object item : pipeline) {
			Map<String, Object> stage = new LinkedHashMap<>(map(item));
			if (stage.containsKey("$vectorSearch")) {
				Map<String, Object> search = new LinkedHashMap<>(map(stage.get("$vectorSearch")));
				search.put("queryVector", exact(vector != null ? vector : doubles(search.get("queryVector"))));
				stage.put("$vectorSearch", search);
			} else if (stage.containsKey("$rankFusion")) {
				Map<String, Object> fusion = new LinkedHashMap<>(map(stage.get("$rankFusion")));
				Map<String, Object> input = new LinkedHashMap<>(map(fusion.get("input")));
				Map<String, Object> pipelines = new LinkedHashMap<>();
				map(input.get("pipelines")).forEach((name, inner) -> pipelines.put(name, queryVectors(items(inner), null)));
				input.put("pipelines", pipelines);
				fusion.put("input", input);
				stage.put("$rankFusion", fusion);
			}
			result.add(stage);
		}
		return result;
	}

	private static List<Map<String, Object>> runAggregate(Client client, String database, String collection, List<Object> pipeline, Map<String, Object> options,
			ClientSession session) {
		List<Document> stages = new ArrayList<>();
		for (Object stage : queryVectors(pipeline, null)) {
			stages.add(document(stage));
		}
		try {
			var target = client.mongo.getDatabase(database).getCollection(collection);
			AggregateIterable<Document> cursor = session == null ? target.aggregate(stages) : target.aggregate(session, stages);
			if (options != null) {
				if (options.get("maxTimeMS") instanceof Number millis) {
					cursor = cursor.maxTime(millis.longValue(), TimeUnit.MILLISECONDS);
				}
				if (options.get("allowDiskUse") instanceof Boolean disk) {
					cursor = cursor.allowDiskUse(disk);
				}
				if (options.get("comment") instanceof String comment) {
					cursor = cursor.comment(comment);
				}
			}
			List<Map<String, Object>> result = new ArrayList<>();
			for (Document document : cursor) {
				result.add(document);
			}
			return result;
		} catch (MongoException error) {
			throw failure(error, "aggregate on " + database + "." + collection);
		}
	}

	/**
	 * A pipeline; its documents as records (key first, score second), or the first document, or a member of it; with candidates,
	 * the records unrounded for the shared result-shape module (see shape).
	 */
	public static Object aggregate(Client client, Map<String, Object> args) {
		List<Map<String, Object>> documents = new ArrayList<>();
		for (Map<String, Object> document : runAggregate(client, (String) args.get("database"), (String) args.get("collection"), items(args.get("pipeline")),
				args.get("options") == null ? null : map(args.get("options")), null)) {
			documents.add(record(document, (String) args.get("key")));
		}
		if (Boolean.TRUE.equals(args.get("candidates"))) {
			return value(documents, false);
		}
		if (!Boolean.TRUE.equals(args.get("first"))) {
			return value(documents);
		}
		Object result = documents.isEmpty() ? null : select(documents.get(0), strings(args.get("select")));
		return value(result == null ? args.get("default") : result);
	}

	/** Creates the search index, or updates its definition when it exists. */
	public static void ensureSearchIndex(Client client, Map<String, Object> args) {
		String database = (String) args.get("database");
		String collection = (String) args.get("collection");
		List<Map<String, Object>> existing = runAggregate(client, database, collection, list(args("$listSearchIndexes", args("name", args.get("index")))), null, null);
		if (!existing.isEmpty()) {
			runCommand(client, database, args("updateSearchIndex", collection, "name", args.get("index"), "definition", args.get("definition")), null);
		} else {
			runCommand(client, database, args("createSearchIndexes", collection, "indexes", list(args("name", args.get("index"), "type", args.get("type"),
					"definition", args.get("definition")))), null);
		}
	}

	private static void pause() {
		try {
			Thread.sleep(POLL_MILLIS);
		} catch (InterruptedException e) {
			Thread.currentThread().interrupt();
			throw new IllegalStateException("interrupted while waiting for MongoDB", e);
		}
	}

	/** The status of a search index once it is READY and queryable, or a clear error after timeout_seconds. */
	public static Object awaitIndex(Client client, Map<String, Object> args) {
		String database = (String) args.get("database");
		String collection = (String) args.get("collection");
		String index = (String) args.get("index");
		double timeout = ((Number) args.get("timeout_seconds")).doubleValue();
		long deadline = System.nanoTime() + (long) (timeout * 1e9);
		String status = "missing";
		while (true) {
			List<Map<String, Object>> found = runAggregate(client, database, collection, list(args("$listSearchIndexes", args("name", index))), null, null);
			if (!found.isEmpty()) {
				status = String.valueOf(found.get(0).getOrDefault("status", "UNKNOWN"));
				if (status.equals("FAILED")) {
					throw new MongodbFailure("search index " + index + " on " + database + "." + collection + " failed to build: " + found.get(0).get("message"), null);
				}
				if (status.equals("READY") && Boolean.TRUE.equals(found.get(0).get("queryable"))) {
					return status;
				}
			}
			if (System.nanoTime() >= deadline) {
				throw new IllegalStateException("search index " + index + " on " + database + "." + collection + " was not queryable within " + timeout
						+ " seconds (status " + status + ")");
			}
			pause();
		}
	}

	private static List<Object> probe(Map<String, Object> probe, Map<String, Object> condition, int limit) {
		if ("vector".equals(probe.get("kind"))) {
			int dims = ((Number) probe.get("dims")).intValue();
			List<Double> query = new ArrayList<>();
			for (int i = 0; i < dims; i++) {
				query.add(i == 0 ? 1.0 : 0.0);
			}
			return list(args("$vectorSearch", args("index", probe.get("index"), "path", probe.get("path"), "queryVector", query, "exact", true, "limit",
					Math.max(1, limit), "filter", condition)), args("$count", "n"));
		}
		Map<String, Object> operator = condition.containsKey("_id") ? args("in", args("path", "_id", "value", map(condition.get("_id")).get("$in")))
				: args("equals", args("path", STAMP, "value", map(condition.get(STAMP)).get("$eq")));
		Map<String, Object> search = args("index", probe.get("index"));
		search.putAll(operator);
		return list(args("$search", search), args("$count", "n"));
	}

	private static int count(List<Map<String, Object>> found) {
		return found.isEmpty() ? 0 : ((Number) found.get(0).get("n")).intValue();
	}

	/** Waits until mongot shows the write in every search index: the stamped documents, or the deleted keys gone. */
	private static void visible(Client client, String database, String collection, Object spec, String stamp, List<Object> deleted) {
		if (spec == null) {
			return;
		}
		Map<String, Object> visible = map(spec);
		double timeout = ((Number) visible.get("timeout_seconds")).doubleValue();
		long deadline = System.nanoTime() + (long) (timeout * 1e9);
		for (Object item : items(visible.get("probes"))) {
			Map<String, Object> probe = map(item);
			Map<String, Object> condition;
			int expected = 0;
			if (deleted != null) {
				if (deleted.isEmpty()) {
					continue;
				}
				condition = args("_id", args("$in", deleted));
			} else {
				condition = args(STAMP, args("$eq", stamp));
				Map<String, Object> stored = new LinkedHashMap<>(condition);
				if ("vector".equals(probe.get("kind"))) {
					stored.put((String) probe.get("path"), args("$type", "array"));
				}
				expected = count(runAggregate(client, database, collection, list(args("$match", stored), args("$count", "n")), null, null));
			}
			while (true) {
				int found = count(runAggregate(client, database, collection, probe(probe, condition, Math.max(expected, deleted == null ? 0 : deleted.size())), null, null));
				if ((deleted != null && found == 0) || (deleted == null && found >= expected)) {
					break;
				}
				if (System.nanoTime() >= deadline) {
					throw new IllegalStateException("search index " + probe.get("index") + " of " + database + "." + collection + " did not show the write within "
							+ timeout + " seconds");
				}
				pause();
			}
		}
	}

	private static List<Document> documents(Map<String, Object> args, String stamp) {
		String key = (String) args.get("key");
		Object ttl = args.get("ttl_seconds");
		Date expires = ttl == null ? null : new Date(System.currentTimeMillis() + Math.round(((Number) ttl).doubleValue() * 1000));
		Map<String, Object> defaults = args.get("defaults") == null ? Map.of() : map(args.get("defaults"));
		Map<String, Object> extra = args.get("extra") == null ? Map.of() : map(args.get("extra"));
		List<Document> result = new ArrayList<>();
		for (Object item : items(args.get("records"))) {
			Map<String, Object> source = map(item);
			if (!source.containsKey(key)) {
				throw new MongodbFailure("a record without the key " + key + ": " + source, null);
			}
			Map<String, Object> body = new LinkedHashMap<>(defaults);
			source.forEach((name, entry) -> {
				if (!name.equals(key)) {
					body.put(name, entry);
				}
			});
			body.putAll(extra);
			Document document = new Document("_id", bson(source.get(key)));
			document.putAll(coerce(body, strings(args.get("vectors")), strings(args.get("dates"))));
			document.put(STAMP, stamp);
			if (Boolean.TRUE.equals(args.get("versioned"))) {
				document.put(VERSION, 1);
			}
			if (expires != null) {
				document.put(EXPIRES, expires);
			}
			result.add(document);
		}
		return result;
	}

	private static Map<String, Object> concern(ClientSession session) {
		return session == null ? args("writeConcern", args("w", "majority")) : args();
	}

	/**
	 * Records written as insert commands (insert), or update commands with upsert: a replacement (replace) or $set (merge), or without
	 * upsert (patch: $set on existing documents only; a missing document is not counted). With only, the records whose key is not
	 * among those keys are left out.
	 */
	public static Map<String, Object> write(Client client, Map<String, Object> args) {
		return write(client, args, null);
	}

	static Map<String, Object> write(Client client, Map<String, Object> args, ClientSession session) {
		String database = (String) args.get("database");
		String collection = (String) args.get("collection");
		String op = (String) args.get("op");
		boolean ignore = Boolean.TRUE.equals(args.get("ignore_conflicts"));
		int size = args.get("batch_size") == null ? BATCH : ((Number) args.get("batch_size")).intValue();
		String stamp = UUID.randomUUID().toString().replace("-", "");
		List<Document> all = documents(args, stamp);
		if (args.get("only") != null) {
			Set<Object> keys = new HashSet<>();
			items(args.get("only")).forEach(value -> keys.add(bson(value)));
			all = all.stream().filter(document -> keys.contains(document.get("_id"))).toList();
		}
		int written = 0;
		int skipped = 0;
		for (int start = 0; start < all.size(); start += size) {
			List<Document> batch = all.subList(start, Math.min(all.size(), start + size));
			Map<String, Object> command;
			if (op.equals("insert")) {
				command = args("insert", collection, "documents", new ArrayList<Object>(batch), "ordered", !ignore);
			} else if (op.equals("patch")) {
				List<Object> updates = new ArrayList<>();
				for (Document document : batch) {
					Document rest = new Document(document);
					rest.remove("_id");
					Map<String, Object> change = args("$set", rest);
					if (rest.remove(VERSION) != null) {
						change.put("$inc", args(VERSION, 1));
					}
					updates.add(args("q", args("_id", args("$eq", document.get("_id"))), "u", change, "upsert", false));
				}
				command = args("update", collection, "updates", updates, "ordered", true);
			} else {
				List<Object> updates = new ArrayList<>();
				for (Document document : batch) {
					Document rest = new Document(document);
					rest.remove("_id");
					updates.add(args("q", args("_id", args("$eq", document.get("_id"))), "u", op.equals("merge") ? args("$set", rest) : rest, "upsert", true));
				}
				command = args("update", collection, "updates", updates, "ordered", true);
			}
			command.putAll(concern(session));
			Document answer = runCommand(client, database, command, session);
			for (Object error : items(answer.get("writeErrors"))) {
				Map<String, Object> failed = map(error);
				if (ignore && ((Number) failed.get("code")).intValue() == 11000) {
					skipped += 1;
				} else {
					throw new MongodbFailure(op + " into " + database + "." + collection + " failed: " + failed.get("code") + ": " + failed.get("errmsg"), null);
				}
			}
			written += ((Number) answer.getOrDefault("n", 0)).intValue();
		}
		if (session == null) {
			visible(client, database, collection, args.get("visible"), stamp, null);
		}
		Map<String, Object> result = ignore ? args((String) args.get("counter"), written, "skipped", skipped) : args((String) args.get("counter"), written);
		if (session != null) {
			result.put("_stamp", stamp);
		}
		return result;
	}

	/** An update command on every matching document; values are operands of $set, $unset, $push, $pull and $inc. */
	public static Map<String, Object> update(Client client, Map<String, Object> args) {
		return update(client, args, null);
	}

	static Map<String, Object> update(Client client, Map<String, Object> args, ClientSession session) {
		String database = (String) args.get("database");
		String collection = (String) args.get("collection");
		String stamp = UUID.randomUUID().toString().replace("-", "");
		Map<String, Object> change = new LinkedHashMap<>();
		map(args.get("update")).forEach((operator, fields) -> change.put(operator, new LinkedHashMap<>(map(fields))));
		Map<String, Object> assignments = change.containsKey("$set") ? map(change.get("$set")) : new LinkedHashMap<>();
		Document set = coerce(assignments, strings(args.get("vectors")), strings(args.get("dates")));
		set.put(STAMP, stamp);
		change.put("$set", set);
		Map<String, Object> command = args("update", collection, "updates", list(args("q", args.get("filter"), "u", change, "multi", true)));
		command.putAll(concern(session));
		Document answer = runCommand(client, database, command, session);
		for (Object error : items(answer.get("writeErrors"))) {
			throw new MongodbFailure("update of " + database + "." + collection + " failed: " + map(error).get("code") + ": " + map(error).get("errmsg"), null);
		}
		if (session == null) {
			visible(client, database, collection, args.get("visible"), stamp, null);
		}
		Map<String, Object> result = args((String) args.getOrDefault("counter", "update_count"), ((Number) answer.getOrDefault("n", 0)).longValue());
		if (session != null) {
			result.put("_stamp", stamp);
		}
		return result;
	}

	/** A delete command; a limit above 1 (or a wait for mongot) first reads the matching keys in key order. */
	public static Map<String, Object> delete(Client client, Map<String, Object> args) {
		return delete(client, args, null);
	}

	static Map<String, Object> delete(Client client, Map<String, Object> args, ClientSession session) {
		String database = (String) args.get("database");
		String collection = (String) args.get("collection");
		Object filter = args.get("filter");
		Integer limit = args.get("limit") == null ? null : ((Number) args.get("limit")).intValue();
		List<Object> keys = null;
		if ((limit != null && limit > 1) || args.get("visible") != null) {
			List<Object> stages = list(args("$match", filter), args("$sort", args("_id", 1)));
			if (limit != null) {
				stages.add(args("$limit", limit));
			}
			stages.add(args("$project", args("_id", 1)));
			keys = new ArrayList<>();
			for (Map<String, Object> document : runAggregate(client, database, collection, stages, null, session)) {
				keys.add(document.get("_id"));
			}
			filter = args("_id", args("$in", keys));
		}
		Map<String, Object> command = args("delete", collection, "deletes", list(args("q", filter, "limit", limit != null && limit == 1 ? 1 : 0)));
		command.putAll(concern(session));
		Document answer = runCommand(client, database, command, session);
		if (session == null) {
			visible(client, database, collection, args.get("visible"), null, keys);
		}
		Map<String, Object> result = args("delete_count", ((Number) answer.getOrDefault("n", 0)).longValue());
		if (session != null) {
			result.put("_deleted", keys);
		}
		return result;
	}

	/** The steps' writes in one multi-document transaction (aborted on any error); waits for mongot after the commit. */
	@SuppressWarnings("unchecked")
	public static Object transaction(Client client, Map<String, Object> args) {
		List<Map<String, Object>> results = new ArrayList<>();
		List<Object> steps = items(args.get("steps"));
		String level = (String) args.getOrDefault("read_concern", "snapshot");
		try (ClientSession session = client.mongo.startSession()) {
			session.startTransaction(TransactionOptions.builder().readConcern(new ReadConcern(ReadConcernLevel.fromString(level)))
					.writeConcern(WriteConcern.MAJORITY).build());
			try {
				for (Object item : steps) {
					Map<String, Object> step = map(item);
					Map<String, Object> stepArgs = map(step.get("args"));
					results.add(switch ((String) step.get("op")) {
					case "write" -> write(client, stepArgs, session);
					case "update" -> update(client, stepArgs, session);
					default -> delete(client, stepArgs, session);
					});
				}
				session.commitTransaction();
			} catch (RuntimeException error) {
				if (session.hasActiveTransaction()) {
					session.abortTransaction();
				}
				throw error;
			}
		}
		for (int position = 0; position < steps.size(); position++) {
			Map<String, Object> step = map(steps.get(position));
			Map<String, Object> stepArgs = map(step.get("args"));
			Map<String, Object> result = results.get(position);
			Object stamp = result.remove("_stamp");
			Object deleted = result.remove("_deleted");
			if (stepArgs.get("visible") != null) {
				visible(client, (String) stepArgs.get("database"), (String) stepArgs.get("collection"), stepArgs.get("visible"), (String) stamp,
						"delete".equals(step.get("op")) ? (deleted == null ? List.of() : (List<Object>) deleted) : null);
			}
		}
		return value(results);
	}

	public static List<Map<String, Object>> readRecords(Client client, Map<String, Object> args) {
		String location = (String) args.get("location");
		Path path = Path.of(location.startsWith("file://") ? location.substring("file://".length()) : location);
		String content;
		try {
			content = Files.readString(path, StandardCharsets.UTF_8);
		} catch (IOException e) {
			throw new MongodbFailure("cannot read " + path, e);
		}
		List<Map<String, Object>> result = new ArrayList<>();
		if (content.stripLeading().startsWith("[")) {
			for (Object item : (List<?>) NUMBERS.fromJson(content, Object.class)) {
				result.add(map(item));
			}
			return result;
		}
		for (String line : content.split("\\r?\\n")) {
			if (!line.isBlank()) {
				result.add(map(NUMBERS.fromJson(line, Object.class)));
			}
		}
		return result;
	}

	public static Map<String, Object> importFile(Client client, Map<String, Object> args) {
		Map<String, Object> writeArgs = new LinkedHashMap<>(args);
		writeArgs.put("records", readRecords(client, args));
		return write(client, writeArgs);
	}

	/** Names: collections, views, databases, search indexes or the distinct values of a field. */
	public static List<String> names(Client client, Map<String, Object> args) {
		String kind = (String) args.get("kind");
		String database = (String) args.get("database");
		Object collection = args.get("collection");
		Set<String> found = new TreeSet<>();
		switch (kind) {
		case "collections" -> {
			Document answer = runCommand(client, database, args("listCollections", 1, "filter", args("type", "collection"), "nameOnly", true), null);
			for (Object entry : items(((Document) answer.get("cursor")).get("firstBatch"))) {
				String name = String.valueOf(map(entry).get("name"));
				if (!name.startsWith("system.")) {
					found.add(name);
				}
			}
		}
		case "views" -> {
			Document answer = runCommand(client, database, args("listCollections", 1, "filter", args("type", "view")), null);
			for (Object entry : items(((Document) answer.get("cursor")).get("firstBatch"))) {
				Map<String, Object> options = map(map(entry).getOrDefault("options", new Document()));
				if (collection == null || collection.equals(options.get("viewOn"))) {
					found.add(String.valueOf(map(entry).get("name")));
				}
			}
		}
		case "databases" -> {
			Document answer = runCommand(client, "admin", args("listDatabases", 1, "nameOnly", true), null);
			for (Object entry : items(answer.get("databases"))) {
				String name = String.valueOf(map(entry).get("name"));
				if (!Set.of("admin", "config", "local").contains(name)) {
					found.add(name);
				}
			}
		}
		case "search_indexes" -> {
			for (Map<String, Object> entry : runAggregate(client, database, String.valueOf(collection), list(args("$listSearchIndexes", args())), null, null)) {
				found.add(String.valueOf(entry.get("name")));
			}
		}
		default -> {
			Document answer = runCommand(client, database, args("distinct", collection, "key", args.get("field"), "query", args()), null);
			for (Object item : items(answer.get("values"))) {
				if (item != null) {
					found.add(String.valueOf(value(item)));
				}
			}
		}
		}
		List<String> result = new ArrayList<>();
		for (String name : found) {
			if (args.get("prefix") == null || name.startsWith((String) args.get("prefix"))) {
				result.add(name);
			}
		}
		return args.get("limit") == null ? result : result.subList(0, Math.min(result.size(), ((Number) args.get("limit")).intValue()));
	}

	private static List<List<Double>> vectors(Client client, String database, String collection, String field, List<Object> keys) {
		List<List<Double>> result = new ArrayList<>();
		if (keys.isEmpty()) {
			return result;
		}
		Map<String, Object> found = new LinkedHashMap<>();
		for (Map<String, Object> document : runAggregate(client, database, collection, list(args("$match", args("_id", args("$in", keys))),
				args("$project", args(field, 1))), null, null)) {
			found.put(String.valueOf(value(document.get("_id"))), document.get(field));
		}
		for (Object key : keys) {
			Object vector = found.get(String.valueOf(value(bson(key))));
			if (vector == null) {
				throw new MongodbFailure("an example of the recommendation has no " + field + " vector in " + database + "." + collection, null);
			}
			result.add(doubles(vector));
		}
		return result;
	}

	private static List<Double> average(List<List<Double>> vectors) {
		List<Double> result = new ArrayList<>();
		for (int column = 0; column < vectors.get(0).size(); column++) {
			double sum = 0;
			for (List<Double> vector : vectors) {
				sum += vector.get(column);
			}
			result.add(sum / vectors.size());
		}
		return result;
	}

	/**
	 * Qdrant's average-vector strategy: avg(positive) + (avg(positive) - avg(negative)) as the queryVector of $vectorSearch; with
	 * candidates, the records unrounded for the shared result-shape module (see shape).
	 */
	public static Object recommend(Client client, Map<String, Object> args) {
		String database = (String) args.get("database");
		String lookup = (String) args.get("lookup");
		String field = (String) args.get("field");
		List<List<Double>> positives = vectors(client, database, lookup, field, items(args.get("positive_ids")));
		for (Object vector : items(args.get("positive_vectors"))) {
			positives.add(doubles(vector));
		}
		List<List<Double>> negatives = vectors(client, database, lookup, field, items(args.get("negative_ids")));
		for (Object vector : items(args.get("negative_vectors"))) {
			negatives.add(doubles(vector));
		}
		List<Double> query = average(positives);
		if (!negatives.isEmpty()) {
			List<Double> avoid = average(negatives);
			List<Double> moved = new ArrayList<>();
			for (int i = 0; i < query.size(); i++) {
				moved.add(2 * query.get(i) - avoid.get(i));
			}
			query = moved;
		}
		List<Map<String, Object>> documents = new ArrayList<>();
		for (Map<String, Object> document : runAggregate(client, database, (String) args.get("collection"), queryVectors(items(args.get("pipeline")), query),
				args.get("options") == null ? null : map(args.get("options")), null)) {
			documents.add(record(document, (String) args.get("key")));
		}
		if (Boolean.TRUE.equals(args.get("candidates"))) {
			return value(documents, false);
		}
		return value(Boolean.TRUE.equals(args.get("first")) && !documents.isEmpty() ? documents.get(0) : documents);
	}

	private static int order(Map<String, Object> left, Map<String, Object> right, String key) {
		int byScore = Double.compare(((Number) right.get("score")).doubleValue(), ((Number) left.get("score")).doubleValue());
		if (byScore != 0) {
			return byScore;
		}
		Object a = left.get(key);
		Object b = right.get(key);
		if (a instanceof Number x && b instanceof Number y) {
			return Double.compare(x.doubleValue(), y.doubleValue());
		}
		if (a instanceof Number) {
			return -1;
		}
		if (b instanceof Number) {
			return 1;
		}
		return String.valueOf(a).compareTo(String.valueOf(b));
	}

	private static boolean within(double score, Object bounds) {
		if (bounds == null) {
			return true;
		}
		Map<String, Object> limits = map(bounds);
		return (limits.get("min") == null || score >= ((Number) limits.get("min")).doubleValue() - 1e-9)
				&& (limits.get("max") == null || score <= ((Number) limits.get("max")).doubleValue() + 1e-9);
	}

	/** Fusion of the legs' records: rrf sums 1/(k + rank), weighted sums weight * similarity, relative_score sums the
	 * weighted min-max normalized similarities; ties by key. With candidates, the fused records come back unrounded for the shared
	 * result-shape module (see shape). */
	@SuppressWarnings("unchecked")
	public static Object hybrid(Client client, Map<String, Object> args) {
		boolean rounded = !Boolean.TRUE.equals(args.get("candidates"));
		String key = (String) args.get("key");
		String fusion = (String) args.get("fusion");
		double k = ((Number) args.get("k")).doubleValue();
		Map<String, Map<String, Object>> fused = new LinkedHashMap<>();
		for (Object item : items(args.get("legs"))) {
			Map<String, Object> leg = map(item);
			double weight = ((Number) leg.get("weight")).doubleValue();
			List<Map<String, Object>> hits = new ArrayList<>();
			for (Map<String, Object> document : runAggregate(client, (String) args.get("database"), (String) args.get("collection"), items(leg.get("pipeline")), null, null)) {
				hits.add(record((Map<String, Object>) value(document, rounded), key));
			}
			double low = hits.stream().mapToDouble(hit -> ((Number) hit.get("score")).doubleValue()).min().orElse(0);
			double high = hits.stream().mapToDouble(hit -> ((Number) hit.get("score")).doubleValue()).max().orElse(0);
			for (int position = 0; position < hits.size(); position++) {
				Map<String, Object> hit = hits.get(position);
				double score = ((Number) hit.get("score")).doubleValue();
				double part = switch (fusion) {
				case "rrf" -> 1 / (k + position + 1);
				case "relative_score" -> weight * (high > low ? (score - low) / (high - low) : 1.0);
				default -> weight * score;
				};
				Map<String, Object> entry = fused.computeIfAbsent(String.valueOf(hit.get(key)), id -> {
					Map<String, Object> copy = new LinkedHashMap<>(hit);
					copy.put("score", 0.0);
					return copy;
				});
				entry.put("score", ((Number) entry.get("score")).doubleValue() + part);
			}
		}
		List<Map<String, Object>> ranked = new ArrayList<>();
		for (Map<String, Object> entry : fused.values()) {
			if (within(((Number) entry.get("score")).doubleValue(), args.get("bounds"))) {
				ranked.add(entry);
			}
		}
		ranked.sort((left, right) -> order(left, right, key));
		int offset = ((Number) args.get("offset")).intValue();
		int size = ((Number) args.get("size")).intValue();
		return value(ranked.subList(Math.min(offset, ranked.size()), Math.min(ranked.size(), offset + size)), rounded);
	}

	/**
	 * The result-shape clauses over a candidate window, by the shared module Shapes: each record becomes a candidate {key, score,
	 * fields, vectors, highlight, explanation} (its highlights as the highlight); the vector fields the candidates carry go to
	 * vectors and stay among the fields only where the output names them.
	 */
	public static Object shape(Client client, Map<String, Object> args) {
		Map<String, Object> spec = map(args.get("spec"));
		String key = (String) spec.get("keyField");
		List<Object> vectors = items(args.get("vectors"));
		List<Object> listed = items(spec.get("output"));
		List<Object> candidates = new ArrayList<>();
		for (Object record : items(args.get("candidates"))) {
			Map<String, Object> item = map(record);
			Map<String, Object> fields = new LinkedHashMap<>();
			item.forEach((name, entry) -> {
				if (!name.equals(key) && !List.of("score", "highlights", "explanation").contains(name) && (!vectors.contains(name) || listed.contains(name))) {
					fields.put(name, entry);
				}
			});
			Map<String, Object> carried = new LinkedHashMap<>();
			for (Object name : vectors) {
				if (item.containsKey((String) name)) {
					carried.put((String) name, item.get((String) name));
				}
			}
			Map<String, Object> candidate = new LinkedHashMap<>();
			candidate.put("key", item.get(key));
			candidate.put("score", item.get("score"));
			candidate.put("fields", fields);
			candidate.put("vectors", carried);
			if (item.containsKey("highlights")) {
				candidate.put("highlight", item.get("highlights"));
			}
			if (item.containsKey("explanation")) {
				candidate.put("explanation", item.get("explanation"));
			}
			candidates.add(candidate);
		}
		try {
			return Shapes.shape(candidates, spec);
		} catch (Shapes.UnsupportedShape e) {
			throw unsupported("mongodb", e.getMessage());
		}
	}
}
