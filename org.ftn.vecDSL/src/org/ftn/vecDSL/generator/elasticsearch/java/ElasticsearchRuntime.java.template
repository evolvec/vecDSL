/**
 * Runtime support for vecDSL programs generated for Elasticsearch, through the low-level REST client of elasticsearch-java
 * (Rest5Client) and Gson. Generated by vecDSL 7. Do not edit.
 *
 * Every request body (index mappings, queries, aggregations, painless scripts with their params) is built by the generator and
 * arrives here as a JSON value, identical in the Python, TypeScript and Java programs; this class sends it and shapes the
 * answer: hits become records with the key, the score in the canonical form of vecDSL and the returned fields; hybrid
 * search fuses its legs here (the rrf and linear retrievers need an enterprise license). Writes go through the _bulk API with
 * refresh=true, so the next statement sees them.
 */
public final class ElasticsearchRuntime {

	private static final int DIGITS = 6;
	private static final int BATCH = 500;
	private static final String KEEP_ALIVE = "1m";
	private static final Gson PRETTY = new GsonBuilder().serializeNulls().disableHtmlEscaping().setPrettyPrinting().create();
	private static final Gson COMPACT = new GsonBuilder().serializeNulls().disableHtmlEscaping().create();
	private static final Gson NUMBERS = new GsonBuilder().setObjectToNumberStrategy(ToNumberPolicy.LONG_OR_DOUBLE).create();
	private static final ContentType NDJSON = ContentType.create("application/x-ndjson", StandardCharsets.UTF_8);

	private ElasticsearchRuntime() {
	}

	public static final class UnsupportedFeature extends UnsupportedOperationException {

		private static final long serialVersionUID = 1L;

		UnsupportedFeature(String message) {
			super(message);
		}
	}

	public static final class ElasticsearchFailure extends RuntimeException {

		private static final long serialVersionUID = 1L;

		ElasticsearchFailure(String message, Throwable cause) {
			super(message, cause);
		}
	}

	public static RuntimeException unsupported(String vendor, String feature) {
		return new UnsupportedFeature(feature + " is not supported for target " + vendor);
	}

	// ---------------------------------------------------------------- values

	public static Map<String, Object> args(Object... pairs) {
		Map<String, Object> result = new LinkedHashMap<>();
		for (int i = 0; i < pairs.length; i += 2) {
			result.put((String) pairs[i], pairs[i + 1]);
		}
		return result;
	}

	public static List<Object> list(Object... items) {
		return new ArrayList<>(Arrays.asList(items));
	}

	public static String env(String name) {
		String value = System.getenv(name);
		if (value == null) {
			throw new IllegalStateException("environment variable " + name + " is not set");
		}
		return value;
	}

	public static String envOr(String name, String fallback) {
		String value = System.getenv(name);
		return value == null ? fallback : value;
	}

	public static String text(Object value) {
		return value == null ? null : value.toString();
	}

	public static long integer(Object value) {
		return ((Number) value).longValue();
	}

	public static double decimal(Object value) {
		return ((Number) value).doubleValue();
	}

	public static boolean flag(Object value) {
		return (Boolean) value;
	}

	public static List<Float> floats(Object value) {
		return ((Collection<?>) value).stream().map(item -> ((Number) item).floatValue()).toList();
	}

	public static List<String> texts(Object value) {
		return ((Collection<?>) value).stream().map(String::valueOf).toList();
	}

	@SuppressWarnings("unchecked")
	public static List<Map<String, Object>> records(Object value) {
		return (List<Map<String, Object>>) value;
	}

	public static String toJson(Object value) {
		return PRETTY.toJson(value);
	}

	public static Map<String, Object> parameters(Map<String, Object> given, Map<String, Object> defaults, List<String> names) {
		Set<String> unknown = new HashSet<>(given.keySet());
		unknown.removeAll(names);
		if (!unknown.isEmpty()) {
			throw new IllegalArgumentException("unknown program parameters: " + unknown);
		}
		Map<String, Object> values = new LinkedHashMap<>(defaults);
		values.putAll(given);
		List<String> missing = names.stream().filter(name -> !values.containsKey(name)).toList();
		if (!missing.isEmpty()) {
			throw new IllegalArgumentException("missing program parameters: " + missing);
		}
		return values;
	}

	public static Map<String, Object> parseArguments(String[] arguments) {
		Map<String, Object> parameters = new LinkedHashMap<>();
		for (String argument : arguments) {
			int separator = argument.indexOf('=');
			if (separator < 0) {
				throw new IllegalArgumentException("expected name=value, got " + argument);
			}
			String raw = argument.substring(separator + 1);
			Object value;
			try {
				value = NUMBERS.fromJson(JsonParser.parseString(raw), Object.class);
			} catch (JsonParseException e) {
				value = raw;
			}
			parameters.put(argument.substring(0, separator), value);
		}
		return parameters;
	}

	/** Result values in one form for every host language: floats rounded, integral numbers as integers. */
	@SuppressWarnings("unchecked")
	static Object value(Object item) {
		if (item instanceof Float || item instanceof Double) {
			double number = ((Number) item).doubleValue();
			if (!Double.isFinite(number)) {
				return number;
			}
			double rounded = new BigDecimal(number).setScale(DIGITS, RoundingMode.HALF_EVEN).doubleValue();
			return rounded == Math.rint(rounded) && Math.abs(rounded) < 1e15 ? (Object) (long) rounded : (Object) rounded;
		}
		if (item instanceof Number number) {
			return number.longValue();
		}
		if (item instanceof Collection<?> items) {
			return items.stream().map(ElasticsearchRuntime::value).toList();
		}
		if (item instanceof Map<?, ?> map) {
			Map<String, Object> result = new LinkedHashMap<>();
			((Map<String, Object>) map).forEach((key, entry) -> result.put(key, value(entry)));
			return result;
		}
		return item;
	}

	/** A request body as JSON text: integral numbers without a fraction, as the Python and TypeScript programs send them. */
	static String json(Object value) {
		StringBuilder out = new StringBuilder();
		json(value, out);
		return out.toString();
	}

	private static void json(Object value, StringBuilder out) {
		if (value == null) {
			out.append("null");
		} else if (value instanceof String text) {
			out.append(COMPACT.toJson(text));
		} else if (value instanceof Boolean flag) {
			out.append(flag);
		} else if (value instanceof Float || value instanceof Double) {
			double number = ((Number) value).doubleValue();
			if (number == Math.rint(number) && Math.abs(number) < 1e15) {
				out.append((long) number);
			} else {
				out.append(value instanceof Float single ? Float.toString(single) : Double.toString(number));
			}
		} else if (value instanceof Number number) {
			out.append(number.longValue());
		} else if (value instanceof Map<?, ?> map) {
			out.append('{');
			boolean first = true;
			for (Map.Entry<?, ?> entry : map.entrySet()) {
				if (!first) {
					out.append(',');
				}
				first = false;
				out.append(COMPACT.toJson(String.valueOf(entry.getKey()))).append(':');
				json(entry.getValue(), out);
			}
			out.append('}');
		} else if (value instanceof Collection<?> items) {
			out.append('[');
			boolean first = true;
			for (Object item : items) {
				if (!first) {
					out.append(',');
				}
				first = false;
				json(item, out);
			}
			out.append(']');
		} else {
			throw new IllegalArgumentException("cannot send " + value.getClass().getName() + " in a request body");
		}
	}

	private static String id(Object value) {
		if (value instanceof String text) {
			return text;
		}
		return json(value);
	}

	// ---------------------------------------------------------------- connection

	/** The Elasticsearch client of one program; credentials come from the environment only. */
	public static final class Client implements AutoCloseable {

		final String url;
		final Rest5Client rest;

		Client(String url, String user, String passwordVariable, String apiKeyVariable, double timeoutSeconds) {
			URI uri = URI.create(url);
			if (uri.getRawUserInfo() != null) {
				throw new IllegalArgumentException("the server URL must not contain credentials; set them in the environment");
			}
			String apiKey = apiKeyVariable == null ? null : System.getenv(apiKeyVariable);
			String authorization;
			if (apiKey != null && !apiKey.isEmpty()) {
				authorization = "ApiKey " + apiKey;
			} else {
				String password = System.getenv(passwordVariable);
				if (password == null) {
					throw new IllegalStateException("environment variable " + passwordVariable + " is not set (the password of user " + user + ")");
				}
				authorization = "Basic " + Base64.getEncoder().encodeToString((user + ":" + password).getBytes(StandardCharsets.UTF_8));
			}
			Timeout timeout = Timeout.ofMilliseconds(Math.round(timeoutSeconds * 1000));
			this.url = url;
			this.rest = Rest5Client.builder(uri).setDefaultHeaders(new Header[] { new BasicHeader("Authorization", authorization) })
					.setRequestConfigCallback(config -> config.setConnectionRequestTimeout(timeout).setResponseTimeout(timeout))
					.setConnectionConfigCallback(config -> config.setConnectTimeout(timeout)).build();
		}

		@Override
		public void close() {
			try {
				rest.close();
			} catch (IOException e) {
				throw new IllegalStateException(e);
			}
		}
	}

	public static Client connect(Map<String, Object> args) {
		Object user = args.get("user");
		Object variable = args.get("password_variable");
		Object timeout = args.get("timeout_seconds");
		return new Client((String) args.get("url"), user == null ? "elastic" : (String) user,
				variable == null ? "VECDSL_ELASTICSEARCH_PASSWORD" : (String) variable, (String) args.get("api_key_variable"),
				timeout == null ? 30 : ((Number) timeout).doubleValue());
	}

	// ---------------------------------------------------------------- requests

	private static Object send(Client client, String method, String path, Map<String, Object> params, Object body, List<?> ignore, String ndjson) {
		Request request = new Request(method, path);
		if (params != null) {
			params.forEach((key, item) -> request.addParameter(key, item instanceof String text ? text : json(item)));
		}
		if (ndjson != null) {
			request.setEntity(new StringEntity(ndjson, NDJSON));
		} else if (body != null) {
			request.setJsonEntity(json(body));
		}
		Response response;
		try {
			response = client.rest.performRequest(request);
		} catch (ResponseException e) {
			response = e.getResponse();
		} catch (IOException e) {
			throw new ElasticsearchFailure("cannot reach Elasticsearch at " + client.url + " within the request timeout: " + e.getMessage(), e);
		}
		int status = response.getStatusCode();
		if ("HEAD".equals(method) && (status == 200 || status == 404)) {
			return status == 200;
		}
		if (ignore != null && ignore.stream().anyMatch(code -> ((Number) code).intValue() == status)) {
			return null;
		}
		Object answer;
		try {
			answer = parse(response.getEntity());
		} catch (IOException e) {
			throw new ElasticsearchFailure(method + " " + path + " answered with status " + status + " and an unreadable body", e);
		}
		if (status >= 300) {
			throw new ElasticsearchFailure(method + " " + path + " failed with status " + status + ": " + reason(answer), null);
		}
		return answer;
	}

	private static Object parse(HttpEntity entity) throws IOException {
		if (entity == null) {
			return null;
		}
		try {
			String text = EntityUtils.toString(entity, StandardCharsets.UTF_8);
			return text.isEmpty() ? null : NUMBERS.fromJson(JsonParser.parseString(text), Object.class);
		} catch (ParseException e) {
			throw new IOException(e);
		}
	}

	private static String reason(Object body) {
		if (map(body).get("error") instanceof Map<?, ?> error) {
			Object causes = error.get("root_cause");
			Map<?, ?> cause = causes instanceof List<?> list && !list.isEmpty() ? (Map<?, ?>) list.get(0) : error;
			return cause.get("type") + ": " + cause.get("reason");
		}
		String text = json(body);
		return text.length() > 500 ? text.substring(0, 500) : text;
	}

	@SuppressWarnings("unchecked")
	private static Map<String, Object> map(Object value) {
		return value instanceof Map<?, ?> ? (Map<String, Object>) value : Map.of();
	}

	@SuppressWarnings("unchecked")
	private static List<Object> items(Object value) {
		return value instanceof List<?> ? (List<Object>) value : List.of();
	}

	@SuppressWarnings("unchecked")
	private static Map<String, Object> params(Map<String, Object> args) {
		return (Map<String, Object>) args.get("params");
	}

	private static List<?> ignored(Map<String, Object> args) {
		return (List<?>) args.get("ignore");
	}

	/** One request; select picks a member of the answer, wrap names it in a one-entry object. */
	public static Object request(Client client, Map<String, Object> args) {
		Object result = send(client, (String) args.get("method"), (String) args.get("path"), params(args), args.get("body"), ignored(args), null);
		for (Object key : items(args.get("select"))) {
			result = result == null ? null : map(result).get((String) key);
		}
		result = value(result);
		Object wrap = args.get("wrap");
		return wrap == null ? result : args((String) wrap, result);
	}

	public static boolean exists(Client client, Map<String, Object> args) {
		return Boolean.TRUE.equals(send(client, "HEAD", (String) args.get("path"), null, null, null, null));
	}

	public static List<Object> ids(Client client, Map<String, Object> args) {
		return items(args.get("values")).stream().map(item -> (Object) id(item)).toList();
	}

	/** The canonical similarity from Elasticsearch's _score (DenseVectorFieldMapper.VectorSimilarity.score). */
	static double similarity(double score, Map<String, Object> form) {
		String kind = (String) form.get("kind");
		Object dims = form.get("dims");
		double dimensions = dims == null ? 0 : ((Number) dims).doubleValue();
		return switch (kind) {
		case "relevance", "native" -> score;
		case "cosine", "dot_product" -> 2 * score - 1;
		case "max_inner_product" -> score >= 1 ? score - 1 : 1 - 1 / score;
		case "l2_norm" -> -Math.sqrt(Math.max(1 / score - 1, 0));
		case "l1_norm" -> -(1 / score - 1);
		case "hamming" -> -(dimensions * (1 - score));
		case "byte_dot_product" -> (score - 0.5) * dimensions * 32768;
		default -> throw new IllegalArgumentException("unknown score form " + kind);
		};
	}

	private static boolean within(double score, Map<String, Object> bounds) {
		Object min = bounds.get("min");
		Object max = bounds.get("max");
		return (min == null || score >= ((Number) min).doubleValue() - 1e-9) && (max == null || score <= ((Number) max).doubleValue() + 1e-9);
	}

	private static Map<String, Object> record(Map<String, Object> hit, String key, Map<String, Object> form) {
		Map<String, Object> source = map(hit.get("_source"));
		Map<String, Object> result = new LinkedHashMap<>();
		result.put(key, source.containsKey(key) ? source.get(key) : hit.get("_id"));
		if (form != null) {
			result.put("score", similarity(((Number) hit.get("_score")).doubleValue(), form));
		}
		source.forEach((name, item) -> {
			if (!name.equals(key)) {
				result.put(name, item);
			}
		});
		if (hit.containsKey("highlight")) {
			result.put("highlight", hit.get("highlight"));
		}
		if (hit.containsKey("_explanation")) {
			result.put("explanation", hit.get("_explanation"));
		}
		return result;
	}

	private static List<Object> records(List<Object> hits, String key, Map<String, Object> form, Map<String, Object> bounds) {
		List<Object> result = new ArrayList<>();
		for (Object hit : hits) {
			Map<String, Object> item = record(map(hit), key, form);
			if (form == null || within((Double) item.get("score"), bounds)) {
				result.add(item);
			}
		}
		return result;
	}

	@SuppressWarnings("unchecked")
	private static Map<String, Object> form(Object score) {
		return (Map<String, Object>) score;
	}

	/** A _search answer; a sliced search runs in a point in time opened for it (slicing needs a scroll or a point in time). */
	private static Map<String, Object> answer(Client client, String index, Map<String, Object> body, Map<String, Object> params) {
		if (!body.containsKey("slice")) {
			return map(send(client, "POST", "/" + index + "/_search", params, body, null, null));
		}
		Object pit = map(send(client, "POST", "/" + index + "/_pit", args("keep_alive", KEEP_ALIVE), null, null, null)).get("id");
		try {
			Map<String, Object> sliced = new LinkedHashMap<>(body);
			sliced.put("pit", args("id", pit, "keep_alive", KEEP_ALIVE));
			return map(send(client, "POST", "/_search", params, sliced, null, null));
		} finally {
			send(client, "DELETE", "/_pit", null, args("id", pit), List.of(404), null);
		}
	}

	/** search_after values of a cursor: the score the search gives the cursor record, then its key; null if it does not match. */
	private static List<Object> after(Client client, String index, Map<String, Object> body, Object after) {
		Map<String, Object> probe = args("query", args("bool", args("must", list(body.get("query")), "filter", list(args("ids", args("values", list(id(after))))))),
				"size", 1, "_source", false);
		List<Object> hits = items(map(map(send(client, "POST", "/" + index + "/_search", null, probe, null, null)).get("hits")).get("hits"));
		return hits.isEmpty() ? null : list(map(hits.get(0)).get("_score"), after);
	}

	/**
	 * A _search request; the hits as records, grouped by the collapse field, with the total and aggregations when asked. A cursor
	 * (after) continues after that record in the order of the search; a cursor the search does not match gives no hits.
	 */
	public static Object search(Client client, Map<String, Object> args) {
		String index = (String) args.get("index");
		Map<String, Object> body = map(args.get("body"));
		String key = (String) args.get("key");
		Map<String, Object> score = form(args.get("score"));
		Map<String, Object> bounds = map(args.get("bounds"));
		if (args.get("after") != null) {
			List<Object> values = after(client, index, body, args.get("after"));
			body = new LinkedHashMap<>(body);
			if (values == null) {
				body.put("size", 0);
			} else {
				body.put("search_after", values);
			}
		}
		Map<String, Object> answer = answer(client, index, body, params(args));
		List<Object> hits = items(map(answer.get("hits")).get("hits"));
		Object group = args.get("group");
		Object result;
		if (group != null) {
			List<Object> groups = new ArrayList<>();
			for (Object hit : hits) {
				Object value = items(map(map(hit).get("fields")).get((String) group)).get(0);
				List<Object> members = items(map(map(map(map(map(hit).get("inner_hits")).get("group")).get("hits"))).get("hits"));
				groups.add(args("group", value, "hits", records(members, key, score, bounds)));
			}
			result = groups;
		} else {
			result = records(hits, key, score, bounds);
		}
		boolean total = Boolean.TRUE.equals(body.get("track_total_hits"));
		if (total || body.containsKey("aggs")) {
			Map<String, Object> shaped = args("hits", result);
			if (total) {
				shaped.put("total", map(map(answer.get("hits")).get("total")).get("value"));
			}
			if (body.containsKey("aggs")) {
				shaped.put("aggregations", answer.get("aggregations"));
			}
			result = shaped;
		}
		return value(result);
	}

	/**
	 * Records by key through _mget, in the order of the keys; missing keys are skipped. Within a tenant, namespace or partition
	 * (filters), an ids query with the slice filter.
	 */
	public static Object fetch(Client client, Map<String, Object> args) {
		String key = (String) args.get("key");
		if (!items(args.get("filters")).isEmpty()) {
			Map<String, Object> source = args("exclude_vectors", !Boolean.TRUE.equals(args.get("vectors")));
			if (args.get("fields") != null) {
				List<Object> includes = new ArrayList<>(List.of(key));
				includes.addAll(items(args.get("fields")));
				source.put("includes", includes);
			}
			List<Object> wanted = ids(client, args);
			List<Object> filters = new ArrayList<>(List.of(args("ids", args("values", wanted))));
			filters.addAll(items(args.get("filters")));
			Map<String, Object> body = args("query", args("bool", args("filter", filters)), "size", wanted.size(), "_source", source);
			Map<String, Map<String, Object>> found = new LinkedHashMap<>();
			for (Object hit : items(map(map(send(client, "POST", "/" + args.get("index") + "/_search", null, body, null, null)).get("hits")).get("hits"))) {
				found.put((String) map(hit).get("_id"), map(hit));
			}
			List<Object> result = new ArrayList<>();
			for (Object value : wanted) {
				if (found.containsKey(value)) {
					result.add(record(found.get(value), key, null));
				}
			}
			return value(result);
		}
		Map<String, Object> params = args("_source_exclude_vectors", !Boolean.TRUE.equals(args.get("vectors")));
		if (args.get("fields") != null) {
			List<String> fields = new ArrayList<>();
			fields.add(key);
			items(args.get("fields")).forEach(field -> fields.add((String) field));
			params.put("_source_includes", String.join(",", fields));
		}
		Map<String, Object> answer = map(send(client, "POST", "/" + args.get("index") + "/_mget", params, args("ids", ids(client, args)), null, null));
		List<Object> result = new ArrayList<>();
		for (Object doc : items(answer.get("docs"))) {
			if (Boolean.TRUE.equals(map(doc).get("found"))) {
				result.add(record(map(doc), key, null));
			}
		}
		return value(result);
	}

	/**
	 * Records written with one _bulk request per batch: create (insert), index (replace), update (merge, created when missing) or
	 * patch (merge into existing documents only; a missing document is not counted). With only, the records whose key is not
	 * among those keys are left out.
	 */
	public static Object write(Client client, Map<String, Object> args) {
		List<Map<String, Object>> rows = records(args.get("records"));
		if (args.get("only") != null) {
			Set<String> keys = new HashSet<>();
			items(args.get("only")).forEach(item -> keys.add(id(item)));
			String key = (String) args.get("key");
			rows = rows.stream().filter(row -> row.containsKey(key) && keys.contains(id(row.get(key)))).toList();
		}
		return write(client, args, rows);
	}

	private static Object write(Client client, Map<String, Object> args, List<Map<String, Object>> rows) {
		String index = (String) args.get("index");
		String key = (String) args.get("key");
		String op = (String) args.get("op");
		String action = "patch".equals(op) ? "update" : op;
		Object size = args.get("batch_size");
		int batch = size == null ? BATCH : ((Number) size).intValue();
		boolean ignoreConflicts = Boolean.TRUE.equals(args.get("ignore_conflicts"));
		long written = 0;
		long skipped = 0;
		for (int start = 0; start < rows.size(); start += batch) {
			StringBuilder lines = new StringBuilder();
			for (Map<String, Object> row : rows.subList(start, Math.min(rows.size(), start + batch))) {
				if (!row.containsKey(key)) {
					throw new ElasticsearchFailure("a record without the key " + key + ": " + json(row), null);
				}
				Map<String, Object> source = new LinkedHashMap<>(map(args.get("defaults")));
				source.putAll(row);
				source.putAll(map(args.get("extra")));
				lines.append(json(args(action, args("_index", index, "_id", id(row.get(key)))))).append('\n');
				Object document = switch (op) {
				case "update" -> args("doc", source, "doc_as_upsert", true);
				case "patch" -> args("doc", source);
				default -> source;
				};
				lines.append(json(document)).append('\n');
			}
			Map<String, Object> answer = map(send(client, "POST", "/_bulk", args("refresh", "true"), null, null, lines.toString()));
			for (Object item : items(answer.get("items"))) {
				Map<String, Object> outcome = map(map(item).get(action));
				int status = outcome.get("status") == null ? 500 : ((Number) outcome.get("status")).intValue();
				if (status < 300) {
					written++;
				} else if (("create".equals(op) && status == 409) || ("patch".equals(op) && status == 404)) {
					skipped++;
				} else {
					throw new ElasticsearchFailure("bulk " + op + " of " + outcome.get("_id") + " failed with status " + status + ": "
							+ reason(args("error", outcome.get("error"))), null);
				}
			}
		}
		if (skipped > 0 && !ignoreConflicts && !"patch".equals(op)) {
			throw new ElasticsearchFailure(skipped + " records of the insert into " + index + " already exist", null);
		}
		String counter = (String) args.get("counter");
		return ignoreConflicts ? args(counter, written, "skipped", skipped) : args(counter, written);
	}

	/** Records of a local JSON array or JSON Lines file (file:// URI or path). */
	@SuppressWarnings("unchecked")
	public static List<Map<String, Object>> readRecords(Client client, Map<String, Object> args) {
		String location = (String) args.get("location");
		Path path = Path.of(location.startsWith("file://") ? location.substring("file://".length()) : location);
		try {
			String text = Files.readString(path, StandardCharsets.UTF_8);
			String stripped = text.stripLeading();
			List<Map<String, Object>> result = new ArrayList<>();
			if (stripped.startsWith("[")) {
				for (Object item : (List<Object>) NUMBERS.fromJson(JsonParser.parseString(stripped), Object.class)) {
					result.add((Map<String, Object>) item);
				}
				return result;
			}
			for (String line : text.split("\\R")) {
				if (!line.isBlank()) {
					result.add((Map<String, Object>) NUMBERS.fromJson(JsonParser.parseString(line), Object.class));
				}
			}
			return result;
		} catch (IOException e) {
			throw new IllegalStateException("cannot read " + location + ": " + e.getMessage(), e);
		}
	}

	public static Object importFile(Client client, Map<String, Object> args) {
		return write(client, args, readRecords(client, args));
	}

	/** An update applied only while the document's sequence number is seq_no (optimistic concurrency control). */
	public static Object updateIfVersion(Client client, Map<String, Object> args) {
		String index = (String) args.get("index");
		String id = URLEncoder.encode(id(args.get("value")), StandardCharsets.UTF_8).replace("+", "%20");
		Map<String, Object> current = map(send(client, "GET", "/" + index + "/_doc/" + id, args("_source", "false"), null, List.of(404), null));
		if (!Boolean.TRUE.equals(current.get("found"))) {
			return args("update_count", 0L);
		}
		Map<String, Object> params = args("if_seq_no", args.get("seq_no"), "if_primary_term", current.get("_primary_term"), "refresh", "true");
		Object updated = send(client, "POST", "/" + index + "/_update/" + id, params, args.get("body"), List.of(409), null);
		return args("update_count", updated == null || "noop".equals(map(updated).get("result")) ? 0L : 1L);
	}

	/** Deletes the indices a wildcard names; destructive actions take explicit names (action.destructive_requires_name). */
	public static Object dropMatching(Client client, Map<String, Object> args) {
		Object rows = send(client, "GET", "/_cat/indices/" + args.get("pattern"), args("format", "json", "h", "index", "expand_wildcards", "all"), null, null, null);
		TreeSet<String> names = new TreeSet<>();
		items(rows).forEach(row -> names.add((String) map(row).get("index")));
		if (!names.isEmpty()) {
			send(client, "DELETE", "/" + String.join(",", names), null, null, null, null);
		}
		return null;
	}

	/** Names read from an answer: indices, database prefixes, aliases, terms of a field, vector fields or snapshots. */
	public static List<Object> names(Client client, Map<String, Object> args) {
		String kind = (String) args.get("kind");
		boolean listing = "indices".equals(kind) || "databases".equals(kind);
		Object body = args.get("body");
		Object answer = send(client, body == null ? "GET" : "POST", (String) args.get("path"), listing ? args("format", "json") : null, body, ignored(args), null);
		List<String> found = new ArrayList<>();
		if (answer != null) {
			switch (kind) {
			case "indices" -> items(answer).forEach(row -> found.add((String) map(row).get("index")));
			case "databases" -> items(answer).forEach(row -> {
				String name = (String) map(row).get("index");
				if (name.replaceFirst("^\\.+", "").contains(".")) {
					found.add(name.substring(0, name.indexOf('.')));
				}
			});
			case "aliases" -> map(answer).values().forEach(entry -> found.addAll(map(map(entry).get("aliases")).keySet()));
			case "terms" -> items(map(map(map(answer).get("aggregations")).get("names")).get("buckets"))
					.forEach(bucket -> found.add(text(map(bucket).get("key"))));
			case "vector_fields" -> map(answer).values().forEach(entry -> map(map(map(entry).get("mappings")).get("properties")).forEach((name, field) -> {
				Object type = map(field).get("type");
				if ("dense_vector".equals(type) || "sparse_vector".equals(type)) {
					found.add(name);
				}
			}));
			case "snapshots" -> items(map(answer).get("snapshots")).forEach(snapshot -> found.add((String) map(snapshot).get("snapshot")));
			default -> throw new IllegalArgumentException("unknown listing " + kind);
			}
		}
		String strip = (String) args.get("strip");
		String prefix = (String) args.get("prefix");
		TreeSet<String> sorted = new TreeSet<>();
		for (String name : found) {
			if (!name.startsWith(".")) {
				sorted.add(strip != null && name.startsWith(strip) ? name.substring(strip.length()) : name);
			}
		}
		List<Object> result = new ArrayList<>();
		for (String name : sorted) {
			if (prefix == null || name.startsWith(prefix)) {
				result.add(name);
			}
		}
		Object limit = args.get("limit");
		return limit == null ? result : new ArrayList<>(result.subList(0, Math.min(result.size(), ((Number) limit).intValue())));
	}

	/** The health of an index once it reaches status, or a clear error after timeout_seconds. */
	public static Object waitHealth(Client client, Map<String, Object> args) {
		String index = (String) args.get("index");
		Object seconds = args.get("timeout_seconds");
		Map<String, Object> params = args("wait_for_status", args.get("status"), "timeout", ((Number) seconds).longValue() + "s");
		Object answer = send(client, "GET", "/_cluster/health/" + index, params, null, List.of(408), null);
		if (answer == null || Boolean.TRUE.equals(map(answer).get("timed_out"))) {
			throw new ElasticsearchFailure("index " + index + " did not reach health " + args.get("status") + " within " + seconds + " seconds", null);
		}
		return map(answer).get("status");
	}

	private static List<List<Double>> vectors(Client client, String index, String field, List<Object> values) {
		List<List<Double>> result = new ArrayList<>();
		if (values.isEmpty()) {
			return result;
		}
		List<Object> keys = values.stream().map(item -> (Object) id(item)).toList();
		Map<String, Object> answer = map(send(client, "POST", "/" + index + "/_mget", args("_source_includes", field, "_source_exclude_vectors", false),
				args("ids", keys), null, null));
		for (Object doc : items(answer.get("docs"))) {
			Object vector = map(map(doc).get("_source")).get(field);
			if (Boolean.TRUE.equals(map(doc).get("found")) && vector != null) {
				result.add(items(vector).stream().map(item -> ((Number) item).doubleValue()).toList());
			}
		}
		if (result.size() != values.size()) {
			throw new ElasticsearchFailure("a record of " + index + " named by the statement has no " + field + " vector", null);
		}
		return result;
	}

	private static List<List<Double>> given(Object vectors) {
		List<List<Double>> result = new ArrayList<>();
		items(vectors).forEach(vector -> result.add(items(vector).stream().map(item -> ((Number) item).doubleValue()).toList()));
		return result;
	}

	private static List<Double> average(List<List<Double>> rows) {
		List<Double> result = new ArrayList<>();
		for (int column = 0; column < rows.get(0).size(); column++) {
			double sum = 0;
			for (List<Double> row : rows) {
				sum += row.get(column);
			}
			result.add(sum / rows.size());
		}
		return result;
	}

	/** The body with the computed vector in every query_vector the generator left empty. */
	private static Object withVector(Object item, List<Double> vector) {
		if (item instanceof Map<?, ?> entries) {
			Map<String, Object> result = new LinkedHashMap<>();
			entries.forEach((name, entry) -> result.put((String) name, "query_vector".equals(name) && entry == null ? vector : withVector(entry, vector)));
			return result;
		}
		if (item instanceof List<?> entries) {
			return entries.stream().map(entry -> withVector(entry, vector)).toList();
		}
		return item;
	}

	/** Qdrant's average-vector strategy: avg(positive) + (avg(positive) - avg(negative)) as the query vector of the search. */
	public static Object recommend(Client client, Map<String, Object> args) {
		String lookup = (String) args.get("lookup");
		String field = (String) args.get("field");
		List<List<Double>> positives = vectors(client, lookup, field, items(args.get("positive_ids")));
		positives.addAll(given(args.get("positive_vectors")));
		List<List<Double>> negatives = vectors(client, lookup, field, items(args.get("negative_ids")));
		negatives.addAll(given(args.get("negative_vectors")));
		List<Double> query = average(positives);
		if (!negatives.isEmpty()) {
			List<Double> avoid = average(negatives);
			List<Double> shifted = new ArrayList<>();
			for (int i = 0; i < query.size(); i++) {
				shifted.add(2 * query.get(i) - avoid.get(i));
			}
			query = shifted;
		}
		return search(client, args("index", args.get("index"), "body", withVector(args.get("body"), query), "key", args.get("key"), "score", args.get("score"),
				"bounds", args.get("bounds"), "group", args.get("group"), "after", args.get("after")));
	}

	private static int compare(Map<String, Object> a, Map<String, Object> b, String key) {
		int byScore = Double.compare((Double) b.get("score"), (Double) a.get("score"));
		if (byScore != 0) {
			return byScore;
		}
		Object x = a.get(key);
		Object y = b.get(key);
		if (x instanceof Number m && y instanceof Number n) {
			return Double.compare(m.doubleValue(), n.doubleValue());
		}
		if (x instanceof Number) {
			return -1;
		}
		if (y instanceof Number) {
			return 1;
		}
		return String.valueOf(x).compareTo(String.valueOf(y));
	}

	/** The canonical similarity between two stored vectors of a field with that similarity. */
	private static double canonical(List<Double> a, List<Double> b, String kind) {
		double dot = 0;
		double left = 0;
		double right = 0;
		double squares = 0;
		double absolute = 0;
		for (int i = 0; i < a.size(); i++) {
			dot += a.get(i) * b.get(i);
			left += a.get(i) * a.get(i);
			right += b.get(i) * b.get(i);
			squares += (a.get(i) - b.get(i)) * (a.get(i) - b.get(i));
			absolute += Math.abs(a.get(i) - b.get(i));
		}
		return switch (kind) {
		case "cosine" -> left == 0 || right == 0 ? 0 : dot / (Math.sqrt(left) * Math.sqrt(right));
		case "dot_product", "max_inner_product" -> dot;
		case "l2_norm" -> -Math.sqrt(squares);
		case "l1_norm" -> -absolute;
		default -> throw new IllegalArgumentException("no similarity for " + kind);
		};
	}

	/**
	 * Maximal marginal relevance over the first window records: lambda * score - (1 - lambda) * the highest similarity to a
	 * record already picked, in pick order; each record keeps its own score.
	 */
	private static List<Map<String, Object>> diverse(Client client, String index, List<Map<String, Object>> ranked, String key, Map<String, Object> mmr, int count) {
		List<Map<String, Object>> pool = ranked.subList(0, Math.min(ranked.size(), ((Number) mmr.get("window")).intValue()));
		List<List<Double>> stored = vectors(client, index, (String) mmr.get("field"), pool.stream().map(item -> item.get(key)).toList());
		double lambda = ((Number) mmr.get("lambda")).doubleValue();
		String kind = (String) mmr.get("kind");
		List<Integer> rest = new ArrayList<>();
		for (int i = 0; i < pool.size(); i++) {
			rest.add(i);
		}
		List<Integer> picked = new ArrayList<>();
		while (!rest.isEmpty() && picked.size() < count) {
			int best = -1;
			double bestValue = Double.NEGATIVE_INFINITY;
			for (int i : rest) {
				double penalty = 0;
				boolean first = true;
				for (int j : picked) {
					double similar = canonical(stored.get(i), stored.get(j), kind);
					penalty = first ? similar : Math.max(penalty, similar);
					first = false;
				}
				double worth = lambda * (Double) pool.get(i).get("score") - (1 - lambda) * penalty;
				if (worth > bestValue) {
					best = i;
					bestValue = worth;
				}
			}
			picked.add(best);
			rest.remove(Integer.valueOf(best));
		}
		return picked.stream().map(pool::get).toList();
	}

	/** The records of a page in the order of the sort clauses, as the server sorts them. */
	private static List<Map<String, Object>> ordered(Client client, String index, List<Map<String, Object>> page, String key, Object sort) {
		if (page.isEmpty()) {
			return page;
		}
		Map<String, Map<String, Object>> byId = new LinkedHashMap<>();
		page.forEach(item -> byId.put(id(item.get(key)), item));
		Map<String, Object> body = args("query", args("ids", args("values", new ArrayList<Object>(byId.keySet()))), "sort", sort, "size", byId.size(), "_source", false);
		List<Map<String, Object>> result = new ArrayList<>();
		for (Object hit : items(map(map(send(client, "POST", "/" + index + "/_search", null, body, null, null)).get("hits")).get("hits"))) {
			result.add(byId.get((String) map(hit).get("_id")));
		}
		return result;
	}

	/**
	 * Fusion of the legs' hits: rrf sums 1/(k + rank), weighted sums weight * similarity, relative_score sums the weighted
	 * min-max normalized similarities; ties by key. The fused records within the bounds are the result set: groups by the group
	 * field's value, a page after the cursor record, maximal marginal relevance, the server's order of the sort clauses on the
	 * page, the total and the aggregations of the set (an ids query).
	 */
	public static Object hybrid(Client client, Map<String, Object> args) {
		String index = (String) args.get("index");
		String key = (String) args.get("key");
		String fusion = (String) args.get("fusion");
		Object group = args.get("group");
		double k = ((Number) args.get("k")).doubleValue();
		List<Object> legs = items(args.get("legs"));
		Map<String, Map<String, Object>> fused = new LinkedHashMap<>();
		Map<String, Object> groups = new LinkedHashMap<>();
		for (int position = 0; position < legs.size(); position++) {
			Map<String, Object> leg = map(legs.get(position));
			Map<String, Object> answer = map(send(client, "POST", "/" + index + "/_search", null, leg.get("body"), null, null));
			List<Object> hits = items(map(answer.get("hits")).get("hits"));
			List<Map<String, Object>> found = new ArrayList<>();
			for (Object hit : hits) {
				found.add(record(map(hit), key, form(leg.get("score"))));
			}
			double low = found.stream().mapToDouble(hit -> (Double) hit.get("score")).min().orElse(0);
			double high = found.stream().mapToDouble(hit -> (Double) hit.get("score")).max().orElse(0);
			double weight = ((Number) leg.get("weight")).doubleValue();
			for (int rank = 1; rank <= found.size(); rank++) {
				Map<String, Object> hit = found.get(rank - 1);
				double score = (Double) hit.get("score");
				double part = switch (fusion) {
				case "rrf" -> 1 / (k + rank);
				case "relative_score" -> weight * (high > low ? (score - low) / (high - low) : 1);
				default -> weight * score;
				};
				String identity = id(hit.get(key));
				Map<String, Object> merged = fused.computeIfAbsent(identity, ignoredKey -> {
					Map<String, Object> fresh = new LinkedHashMap<>(hit);
					fresh.remove("score");
					fresh.remove("highlight");
					fresh.remove("explanation");
					fresh.put("score", 0.0);
					return fresh;
				});
				merged.put("score", (Double) merged.get("score") + part);
				if (hit.containsKey("highlight")) {
					merged.putIfAbsent("highlight", hit.get("highlight"));
				}
				if (hit.containsKey("explanation")) {
					List<Object> explanations = new ArrayList<>(Collections.nCopies(legs.size(), null));
					if (merged.get("explanation") instanceof List<?> earlier) {
						explanations = new ArrayList<>(earlier);
					}
					explanations.set(position, hit.get("explanation"));
					merged.put("explanation", explanations);
				}
				if (group != null && !groups.containsKey(identity)) {
					List<Object> values = items(map(map(hits.get(rank - 1)).get("fields")).get((String) group));
					groups.put(identity, values.isEmpty() ? null : values.get(0));
				}
			}
		}
		Map<String, Object> bounds = map(args.get("bounds"));
		List<Map<String, Object>> ranked = new ArrayList<>(fused.values().stream().filter(item -> within((Double) item.get("score"), bounds)).toList());
		ranked.sort((a, b) -> compare(a, b, key));
		int offset = ((Number) args.get("offset")).intValue();
		int size = ((Number) args.get("size")).intValue();
		Object result;
		if (group != null) {
			Map<Object, List<Map<String, Object>>> members = new LinkedHashMap<>();
			for (Map<String, Object> item : ranked) {
				members.computeIfAbsent(groups.get(id(item.get(key))), ignoredKey -> new ArrayList<>()).add(item);
			}
			int groupSize = args.get("group_size") == null ? 1 : ((Number) args.get("group_size")).intValue();
			List<Object> shown = new ArrayList<>();
			List<Map.Entry<Object, List<Map<String, Object>>>> entries = new ArrayList<>(members.entrySet());
			for (Map.Entry<Object, List<Map<String, Object>>> entry : entries.subList(Math.min(offset, entries.size()), Math.min(entries.size(), offset + size))) {
				shown.add(args("group", entry.getKey(), "hits", entry.getValue().subList(0, Math.min(groupSize, entry.getValue().size()))));
			}
			result = shown;
		} else if (args.get("mmr") != null) {
			List<Map<String, Object>> picked = diverse(client, index, ranked, key, map(args.get("mmr")), offset + size);
			result = picked.subList(Math.min(offset, picked.size()), picked.size());
		} else {
			int start = offset;
			if (args.get("after") != null) {
				String after = id(args.get("after"));
				start = ranked.size();
				for (int i = 0; i < ranked.size(); i++) {
					if (id(ranked.get(i).get(key)).equals(after)) {
						start = i + 1;
						break;
					}
				}
			}
			result = ranked.subList(Math.min(start, ranked.size()), Math.min(ranked.size(), start + size));
		}
		if (!items(args.get("sort")).isEmpty()) {
			@SuppressWarnings("unchecked")
			List<Map<String, Object>> page = (List<Map<String, Object>>) result;
			result = ordered(client, index, page, key, args.get("sort"));
		}
		boolean total = Boolean.TRUE.equals(args.get("total"));
		if (total || args.get("aggs") != null) {
			Map<String, Object> shaped = args("hits", result);
			if (total) {
				shaped.put("total", ranked.size());
			}
			if (args.get("aggs") != null) {
				List<Object> keys = ranked.stream().map(item -> (Object) id(item.get(key))).toList();
				Map<String, Object> body = args("size", 0, "query", args("ids", args("values", keys)), "aggs", args.get("aggs"));
				shaped.put("aggregations", map(send(client, "POST", "/" + index + "/_search", null, body, null, null)).get("aggregations"));
			}
			result = shaped;
		}
		return value(result);
	}

	/** Qdrant's definition: a random sample of the matching documents, each with its nearest neighbours in the sample. */
	public static Object distanceMatrix(Client client, Map<String, Object> args) {
		String index = (String) args.get("index");
		String field = (String) args.get("field");
		String key = (String) args.get("key");
		int limit = ((Number) args.get("limit")).intValue();
		Map<String, Object> body = args("size", args.get("sample"), "_source", args("includes", list(key, field), "exclude_vectors", false), "query",
				args("function_score", args("query", args.get("query"), "random_score", args("seed", ThreadLocalRandom.current().nextInt(1 << 30), "field", "_seq_no"))));
		List<Object> docs = items(map(map(send(client, "POST", "/" + index + "/_search", null, body, null, null)).get("hits")).get("hits"));
		List<Object> members = docs.stream().map(doc -> map(doc).get("_id")).toList();
		List<Object> result = new ArrayList<>();
		for (Object doc : docs) {
			Object self = map(doc).get("_id");
			List<Object> others = members.stream().filter(member -> !member.equals(self)).toList();
			List<Object> neighbours = new ArrayList<>();
			if (!others.isEmpty()) {
				Map<String, Object> knn = args("field", field, "query_vector", map(map(doc).get("_source")).get(field), "k", Math.max(1, Math.min(limit, others.size())),
						"num_candidates", Math.max(Math.max(limit, others.size()), 1), "filter", args("ids", args("values", others)));
				Map<String, Object> answer = map(send(client, "POST", "/" + index + "/_search", null, args("size", limit, "knn", knn, "_source", list(key)), null, null));
				for (Object hit : items(map(answer.get("hits")).get("hits"))) {
					Object found = map(map(hit).get("_source")).get(key);
					neighbours.add(args("id", found == null ? map(hit).get("_id") : found, "score",
							similarity(((Number) map(hit).get("_score")).doubleValue(), form(args.get("score")))));
				}
			}
			Object own = map(map(doc).get("_source")).get(key);
			result.add(args("id", own == null ? self : own, "neighbours", neighbours));
		}
		return value(result);
	}
}
