	private static List<String> returned(Map<String, Object> collection, List<String> output) {
		List<String> result = new ArrayList<>();
		result.add(string(collection, "key_property"));
		result.addAll(output);
		return result;
	}

	private static Map<String, Object> row(Map<String, Object> collection, WeaviateObject<Map<String, Object>> item,
			List<String> output, List<String> vectors) {
		Map<String, Object> properties = item.properties();
		Map<String, Object> result = new LinkedHashMap<>();
		result.put(string(collection, "key"), value(properties.get(string(collection, "key_property"))));
		for (String name : output) {
			result.put(name, value(properties.get(name)));
		}
		if (vectors != null) {
			for (String name : vectors) {
				float[] stored = item.vectors() == null ? null : item.vectors().getSingle(name);
				result.put(name, value(stored == null ? new float[0] : stored));
			}
		}
		return result;
	}

	public static List<Map<String, Object>> getRows(WeaviateClient client, Map<String, Object> args) {
		Map<String, Object> collection = get(args, "collection");
		List<String> output = get(args, "output");
		List<String> vectors = get(args, "vectors");
		List<String> uuids = ((List<?>) get(args, "ids")).stream().map(WeaviateRuntime::objectId).toList();
		var response = handle(client, collection).query.fetchObjects(query -> {
			query.filters(Filter.uuid().containsAny(uuids.toArray(String[]::new))).limit(uuids.size())
					.returnProperties(returned(collection, output));
			if (vectors != null) {
				query.includeVector(vectors);
			}
			return query;
		});
		Map<String, WeaviateObject<Map<String, Object>>> found = new LinkedHashMap<>();
		response.objects().forEach(item -> found.put(item.uuid(), item));
		return uuids.stream().filter(found::containsKey).map(uuid -> row(collection, found.get(uuid), output, vectors)).toList();
	}

	public static long count(WeaviateClient client, Map<String, Object> args) {
		Map<String, Object> filter = get(args, "filter");
		var result = handle(client, get(args, "collection")).aggregate.overAll(aggregation -> {
			aggregation.includeTotalCount(true);
			if (filter != null) {
				aggregation.filters(filter(filter));
			}
			return aggregation;
		});
		return result.totalCount() == null ? 0 : result.totalCount();
	}

	public static List<Map<String, Object>> scroll(WeaviateClient client, Map<String, Object> args) {
		Map<String, Object> collection = get(args, "collection");
		List<String> output = get(args, "output");
		List<String> vectors = get(args, "vectors");
		Map<String, Object> filter = get(args, "filter");
		Integer limit = whole(args, "limit");
		Integer offset = whole(args, "offset");
		var target = handle(client, collection);
		List<Map<String, Object>> rows = new ArrayList<>();
		int position = offset == null ? 0 : offset;
		while (limit == null || rows.size() < limit) {
			int size = limit == null ? PAGE : Math.min(PAGE, limit - rows.size());
			int start = position;
			var response = target.query.fetchObjects(query -> {
				query.limit(size).offset(start).sort(SortBy.property(string(collection, "key_property")))
						.returnProperties(returned(collection, output));
				if (filter != null) {
					query.filters(filter(filter));
				}
				if (vectors != null) {
					query.includeVector(vectors);
				}
				return query;
			});
			response.objects().forEach(item -> rows.add(row(collection, item, output, vectors)));
			position += response.objects().size();
			if (response.objects().size() < size) {
				break;
			}
		}
		return rows;
	}

	private static double similarity(String metric, double distance) {
		return switch (metric) {
		case "cosine" -> 1 - distance;
		case "l2-squared" -> -Math.sqrt(Math.max(distance, 0));
		default -> -distance;
		};
	}

	private static List<Map<String, Object>> hits(Map<String, Object> collection, List<WeaviateObject<Map<String, Object>>> objects,
			List<String> output, List<String> vectors, Function<WeaviateObject<Map<String, Object>>, Double> score, Double scoreMin,
			Double scoreMax) {
		List<Map<String, Object>> result = new ArrayList<>();
		for (WeaviateObject<Map<String, Object>> item : objects) {
			double value = score.apply(item);
			if ((scoreMin != null && value < scoreMin) || (scoreMax != null && value > scoreMax)) {
				continue;
			}
			Map<String, Object> fields = row(collection, item, output, vectors);
			Map<String, Object> hit = new LinkedHashMap<>();
			hit.put("id", fields.remove(string(collection, "key")));
			hit.put("score", value(value));
			hit.putAll(fields);
			result.add(hit);
		}
		return result;
	}

	private static Double optionalDouble(Map<String, Object> args, String key) {
		Object value = args.get(key);
		return value == null ? null : ((Number) value).doubleValue();
	}

	private static Filter where(Filter... conditions) {
		List<Filter> present = Arrays.stream(conditions).filter(condition -> condition != null).toList();
		if (present.isEmpty()) {
			return null;
		}
		return present.size() == 1 ? present.get(0) : Filter.and(new ArrayList<>(present));
	}

	public static List<Map<String, Object>> vectorSearch(WeaviateClient client, Map<String, Object> args) {
		Map<String, Object> collection = get(args, "collection");
		List<String> output = get(args, "output");
		List<String> vectors = get(args, "vectors");
		Map<String, Object> filter = get(args, "filter");
		List<?> exclude = get(args, "exclude");
		String[] excluded = exclude == null ? new String[0]
				: exclude.stream().filter(item -> !isVector(item)).map(WeaviateRuntime::objectId).toArray(String[]::new);
		Filter combined = where(filter == null ? null : filter(filter),
				excluded.length == 0 ? null : Filter.not(Filter.uuid().containsAny(excluded)));
		Integer offset = whole(args, "offset");
		Float maxDistance = real(args, "max_distance");
		Integer autoLimit = whole(args, "auto_limit");
		var response = handle(client, collection).query.nearVector(Target.vector(string(args, "field"), vector(args.get("vector"))), query -> {
			query.limit(whole(args, "limit")).returnProperties(returned(collection, output)).returnMetadata(Metadata.DISTANCE);
			if (offset != null) {
				query.offset(offset);
			}
			if (maxDistance != null) {
				query.distance(maxDistance);
			}
			if (autoLimit != null) {
				query.autolimit(autoLimit);
			}
			if (combined != null) {
				query.filters(combined);
			}
			if (vectors != null) {
				query.includeVector(vectors);
			}
			return query;
		});
		boolean nativeScore = Boolean.TRUE.equals(args.get("native"));
		String metric = string(args, "metric");
		return hits(collection, response.objects(), output, vectors, item -> {
			double distance = item.queryMetadata().distance();
			return nativeScore ? distance : similarity(metric, distance);
		}, optionalDouble(args, "score_min"), optionalDouble(args, "score_max"));
	}

	private static SearchOperator operator(Object name, Integer minimumMatch) {
		if ("and".equals(name)) {
			return SearchOperator.and();
		}
		return minimumMatch == null ? null : SearchOperator.or(minimumMatch);
	}

