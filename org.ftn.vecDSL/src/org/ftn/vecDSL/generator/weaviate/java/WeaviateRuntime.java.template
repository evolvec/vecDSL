	public static List<Float> lookupVector(WeaviateClient client, Map<String, Object> args) {
		Map<String, Object> collection = get(args, "collection");
		String field = string(args, "field");
		var item = handle(client, collection).query.fetchObjectById(objectId(args.get("id")), query -> query.includeVector(field))
				.orElseThrow(() -> new IllegalArgumentException("record " + args.get("id") + " not found in " + collection.get("name")));
		return boxed(item.vectors().getSingle(field));
	}

	private static List<Float> boxed(float[] vector) {
		List<Float> result = new ArrayList<>();
		for (float component : vector) {
			result.add(component);
		}
		return result;
	}

	public static List<Float> recommendVector(WeaviateClient client, Map<String, Object> args) {
		Map<String, Object> collection = get(args, "collection");
		String field = string(args, "field");
		List<?> positives = get(args, "positives");
		List<?> negatives = args.get("negatives") == null ? List.of() : get(args, "negatives");
		List<Object> keys = new ArrayList<>();
		for (Object item : positives) {
			if (!isVector(item)) {
				keys.add(item);
			}
		}
		for (Object item : negatives) {
			if (!isVector(item)) {
				keys.add(item);
			}
		}
		Map<String, float[]> stored = new LinkedHashMap<>();
		if (!keys.isEmpty()) {
			String[] uuids = keys.stream().map(WeaviateRuntime::objectId).toArray(String[]::new);
			var response = handle(client, collection).query.fetchObjects(query -> query.filters(Filter.uuid().containsAny(uuids))
					.limit(uuids.length).includeVector(field));
			response.objects().forEach(item -> stored.put(item.uuid(), item.vectors().getSingle(field)));
		}
		List<double[]> positive = resolve(positives, stored, collection);
		List<double[]> negative = resolve(negatives, stored, collection);
		if (positive.isEmpty()) {
			throw new IllegalArgumentException("recommend requires at least one positive example");
		}
		double[] centroid = mean(positive);
		if (!negative.isEmpty()) {
			double[] anti = mean(negative);
			for (int i = 0; i < centroid.length; i++) {
				centroid[i] = 2 * centroid[i] - anti[i];
			}
		}
		List<Float> result = new ArrayList<>();
		for (double component : centroid) {
			result.add((float) component);
		}
		return result;
	}

	private static List<double[]> resolve(List<?> items, Map<String, float[]> stored, Map<String, Object> collection) {
		List<double[]> result = new ArrayList<>();
		for (Object item : items) {
			if (isVector(item)) {
				result.add(((Collection<?>) item).stream().mapToDouble(component -> ((Number) component).doubleValue()).toArray());
				continue;
			}
			float[] vector = stored.get(objectId(item));
			if (vector == null) {
				throw new IllegalArgumentException("record " + item + " not found in " + collection.get("name"));
			}
			double[] widened = new double[vector.length];
			for (int i = 0; i < vector.length; i++) {
				widened[i] = vector[i];
			}
			result.add(widened);
		}
		return result;
	}

	private static double[] mean(List<double[]> vectors) {
		double[] result = new double[vectors.get(0).length];
		for (double[] vector : vectors) {
			for (int i = 0; i < result.length; i++) {
				result[i] += vector[i] / vectors.size();
			}
		}
		return result;
	}

	// ---------------------------------------------------------------- REST

	private record Endpoint(String base, String apiKey) {
	}

	/** Calls a REST endpoint that the client SDK does not cover, on the server the client was opened for. */
	private static Object rest(WeaviateClient client, String method, String path, Object body) {
		Endpoint endpoint = ENDPOINTS.get(client);
		if (endpoint == null) {
			throw new IllegalStateException("REST operations need a client opened with connect()");
		}
		HttpRequest.Builder request = HttpRequest.newBuilder(URI.create(endpoint.base() + "/v1" + path))
				.header("Content-Type", "application/json")
				.method(method, body == null ? HttpRequest.BodyPublishers.noBody() : HttpRequest.BodyPublishers.ofString(GSON.toJson(body)));
		if (endpoint.apiKey() != null) {
			request.header("Authorization", "Bearer " + endpoint.apiKey());
		}
		try {
			HttpResponse<String> response = HTTP.send(request.build(), HttpResponse.BodyHandlers.ofString());
			if (response.statusCode() >= 400) {
				throw new IllegalStateException(method + " " + path + " failed with " + response.statusCode() + ": " + response.body());
			}
			return response.body().isBlank() ? null : REST_JSON.fromJson(response.body(), Object.class);
		} catch (IOException e) {
			throw new UncheckedIOException(e);
		} catch (InterruptedException e) {
			Thread.currentThread().interrupt();
			throw new IllegalStateException(e);
		}
	}

	@SuppressWarnings("unchecked")
	private static Map<String, Object> restMap(WeaviateClient client, String method, String path, Object body) {
		Object result = rest(client, method, path, body);
		return result == null ? new LinkedHashMap<>() : (Map<String, Object>) result;
	}

	// ---------------------------------------------------------------- schema evolution

	/** A named vector in the REST schema format, which the SDK reads into its typed configuration. */
	private static Map<String, Object> vectorJson(Map<String, Object> spec) {
		Map<String, Object> index = new LinkedHashMap<>();
		index.put("distance", spec.get("distance"));
		if (spec.containsKey("max_connections")) {
			index.put("maxConnections", spec.get("max_connections"));
		}
		if (spec.containsKey("ef_construction")) {
			index.put("efConstruction", spec.get("ef_construction"));
		}
		if (spec.containsKey("ef")) {
			index.put("ef", spec.get("ef"));
		}
		Map<String, Object> quantizer = get(spec, "quantizer");
		if (quantizer != null) {
			String type = string(quantizer, "type");
			if ("none".equals(type)) {
				index.put("skipDefaultQuantization", true);
			} else {
				Map<String, Object> settings = new LinkedHashMap<>();
				settings.put("enabled", true);
				if (quantizer.containsKey("segments")) {
					settings.put("segments", quantizer.get("segments"));
				}
				index.put(type, settings);
			}
		}
		Map<String, Object> vectorizer = get(spec, "vectorizer");
		Map<String, Object> module = new LinkedHashMap<>();
		if (vectorizer == null) {
			module.put("none", new LinkedHashMap<>());
		} else {
			Map<String, Object> config = new LinkedHashMap<>(get(vectorizer, "config"));
			if (vectorizer.containsKey("source_properties")) {
				config.put("properties", vectorizer.get("source_properties"));
			}
			module.put(string(vectorizer, "module"), config);
		}
		Map<String, Object> result = new LinkedHashMap<>();
		result.put("vectorizer", module);
		result.put("vectorIndexType", "flat".equals(spec.get("index")) ? "flat" : "hnsw");
		result.put("vectorIndexConfig", index);
		return result;
	}

