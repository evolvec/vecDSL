	public static void createRole(WeaviateClient client, Map<String, Object> args) {
		List<Map<String, Object>> permissions = get(args, "permissions");
		List<Permission> granted = new ArrayList<>();
		for (Map<String, Object> permission : permissions) {
			String collection = string(permission, "collection");
			List<String> actions = get(permission, "actions");
			List<CollectionsPermission.Action> schema = new ArrayList<>();
			List<DataPermission.Action> data = new ArrayList<>();
			for (String action : actions) {
				switch (action) {
				case "create_collections" -> schema.add(CollectionsPermission.Action.CREATE);
				case "read_collections" -> schema.add(CollectionsPermission.Action.READ);
				case "update_collections" -> schema.add(CollectionsPermission.Action.UPDATE);
				case "delete_collections" -> schema.add(CollectionsPermission.Action.DELETE);
				case "create_data" -> data.add(DataPermission.Action.CREATE);
				case "read_data" -> data.add(DataPermission.Action.READ);
				case "update_data" -> data.add(DataPermission.Action.UPDATE);
				case "delete_data" -> data.add(DataPermission.Action.DELETE);
				default -> throw new IllegalArgumentException("unknown action " + action);
				}
			}
			if (!schema.isEmpty()) {
				granted.add(Permission.collections(collection, schema.toArray(CollectionsPermission.Action[]::new)));
			}
			if (!data.isEmpty()) {
				granted.add(Permission.data(collection, data.toArray(DataPermission.Action[]::new)));
			}
		}
		try {
			client.roles.create(string(args, "role"), granted);
		} catch (IOException e) {
			throw new UncheckedIOException(e);
		}
	}

