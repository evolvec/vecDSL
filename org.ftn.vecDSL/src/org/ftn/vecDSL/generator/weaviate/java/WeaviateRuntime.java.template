	private static CollectionHandle<Map<String, Object>> handle(WeaviateClient client, Map<String, Object> collection) {
		CollectionHandle<Map<String, Object>> named = client.collections.use(string(collection, "name"));
		String tenant = string(collection, "tenant");
		CollectionHandle<Map<String, Object>> handle = tenant == null ? named : named.withTenant(tenant);
		String level = string(collection, "consistency");
		return level == null ? handle : handle.withConsistencyLevel(ConsistencyLevel.valueOf(level));
	}

	private static <T> List<List<T>> batches(List<T> items, int size) {
		List<List<T>> result = new ArrayList<>();
		for (int start = 0; start < items.size(); start += size) {
			result.add(items.subList(start, Math.min(items.size(), start + size)));
		}
		return result;
	}

