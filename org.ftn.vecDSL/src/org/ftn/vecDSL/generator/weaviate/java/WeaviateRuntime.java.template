	private static ObjectTtl ttl(Map<String, Object> spec) {
		return ObjectTtl.of(ttl -> {
			if (spec.containsKey("date_property")) {
				ttl.deleteByDateProperty(string(spec, "date_property"));
			} else {
				ttl.deleteByCreationTime();
			}
			if (spec.containsKey("seconds")) {
				ttl.defaultTtlSeconds(whole(spec, "seconds"));
			}
			ttl.filterExpiredObjects(Boolean.TRUE.equals(spec.get("filter_expired")));
			return ttl;
		});
	}

	public static void updateCollection(WeaviateClient client, Map<String, Object> args) {
		String description = string(args, "description");
		Map<String, Object> spec = get(args, "ttl");
		try {
			client.collections.use(string(args, "name")).config.update(update -> {
				if (description != null) {
					update.description(description);
				}
				if (spec != null) {
					update.objectTtl(ttl(spec));
				}
				return update;
			});
		} catch (IOException e) {
			throw new UncheckedIOException(e);
		}
	}

