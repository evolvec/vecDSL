	// ---------------------------------------------------------------- connection

	/** Opens a client, waiting for a server that is still starting (for example a fresh docker compose up). */
	public static WeaviateClient connect(Map<String, Object> args) {
		URI uri = URI.create(string(args, "uri"));
		boolean secure = "https".equals(uri.getScheme());
		String host = uri.getHost() == null ? "localhost" : uri.getHost();
		int port = uri.getPort() > 0 ? uri.getPort() : secure ? 443 : 80;
		int grpcPort = whole(args, "grpc_port");
		String apiKey = string(args, "api_key");
		Object timeout = args.get("timeout");
		long deadline = System.currentTimeMillis() + (long) (Double.parseDouble(envOr("VECDSL_CONNECT_TIMEOUT", "120")) * 1000);
		while (true) {
			try {
				WeaviateClient client = WeaviateClient.connectToCustom(config -> {
					config.scheme(secure ? "https" : "http").httpHost(host).httpPort(port).grpcHost(host).grpcPort(grpcPort);
					if (apiKey != null) {
						config.authentication(Authentication.apiKey(apiKey));
					}
					if (timeout != null) {
						config.timeout((int) Math.ceil(((Number) timeout).doubleValue()));
					}
					return config;
				});
				ENDPOINTS.put(client, new Endpoint(string(args, "uri").replaceAll("/+$", ""), apiKey));
				return client;
			} catch (RuntimeException e) {
				if (System.currentTimeMillis() >= deadline) {
					throw e;
				}
				pause();
			}
		}
	}

	private static void pause() {
		try {
			Thread.sleep(2000);
		} catch (InterruptedException e) {
			Thread.currentThread().interrupt();
			throw new IllegalStateException(e);
		}
	}

	public static String checkServer(WeaviateClient client) {
		String found;
		try {
			found = client.meta().version();
		} catch (IOException e) {
			throw new UncheckedIOException(e);
		}
		String series = found.replaceFirst("^v", "").replaceFirst("^(\\d+\\.\\d+).*", "$1");
		if (!series.equals(SERVER_SERIES)) {
			System.err.println("warning: program generated for Weaviate " + SERVER_SERIES + ".x is connected to Weaviate " + found);
		}
		return found;
	}

