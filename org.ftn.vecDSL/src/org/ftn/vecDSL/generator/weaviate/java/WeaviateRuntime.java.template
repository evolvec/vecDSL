	/**
	 * Vector indexing state over all shards, read through REST: client6 6.3.1 maps the queue length to
	 * "vectorQueueLenght" (cluster/Shard.java), which the server never sends.
	 */
	private static Map<String, Object> indexing(WeaviateClient client, String name) {
		Map<String, Object> nodes = restMap(client, "GET", "/nodes/" + name + "?output=verbose", null);
		Set<String> statuses = new HashSet<>();
		long queue = 0;
		List<Map<String, Object>> found = get(nodes, "nodes");
		for (Map<String, Object> node : found == null ? List.<Map<String, Object>>of() : found) {
			List<Map<String, Object>> shards = get(node, "shards");
			for (Map<String, Object> shard : shards == null ? List.<Map<String, Object>>of() : shards) {
				statuses.add(String.valueOf(shard.get("vectorIndexingStatus")));
				Object length = shard.get("vectorQueueLength");
				queue += length == null ? 0 : ((Number) length).longValue();
			}
		}
		boolean ready = statuses.stream().allMatch("READY"::equals) && queue == 0;
		return args("state", ready ? "ready" : "building", "queue", queue);
	}

	public static Map<String, Object> describe(WeaviateClient client, Map<String, Object> args) {
		Map<String, Object> collection = get(args, "collection");
		String name = string(collection, "name");
		Map<String, Object> schema = restMap(client, "GET", "/schema/" + name, null);
		List<Map<String, Object>> properties = get(schema, "properties");
		Map<String, Object> vectors = get(schema, "vectorConfig");
		Map<String, Object> tenancy = get(schema, "multiTenancyConfig");
		Map<String, Object> result = new LinkedHashMap<>();
		result.put("name", schema.get("class"));
		result.put("description", schema.get("description"));
		result.put("properties", (properties == null ? List.<Map<String, Object>>of() : properties).stream()
				.map(property -> String.valueOf(property.get("name"))).sorted().toList());
		result.put("vectors", vectors == null ? List.of() : new TreeSet<>(vectors.keySet()).stream().toList());
		boolean multiTenant = tenancy != null && Boolean.TRUE.equals(tenancy.get("enabled"));
		result.put("multi_tenancy", multiTenant);
		if (Boolean.TRUE.equals(args.get("stats"))) {
			long total = 0;
			if (multiTenant) {
				for (String tenant : setTenantsNames(client, name)) {
					Map<String, Object> scoped = new LinkedHashMap<>(collection);
					scoped.put("tenant", tenant);
					total += count(client, args("collection", scoped));
				}
			} else {
				total = count(client, args("collection", collection));
			}
			result.put("count", total);
		}
		if (Boolean.TRUE.equals(args.get("index_progress"))) {
			result.put("indexing", indexing(client, name));
		}
		return result;
	}

	private static List<String> setTenantsNames(WeaviateClient client, String name) {
		return client.collections.use(name).tenants.list().stream().map(Tenant::name).sorted().toList();
	}

	private static final List<String> STATES = List.of("pending", "building", "ready");

	private static String propertyIndexState(WeaviateClient client, String name, String property, String index) {
		Map<String, Object> status = restMap(client, "GET", "/schema/" + name + "/indexes", null);
		List<Map<String, Object>> properties = get(status, "properties");
		for (Map<String, Object> entry : properties == null ? List.<Map<String, Object>>of() : properties) {
			if (!property.equals(entry.get("name"))) {
				continue;
			}
			List<Map<String, Object>> indexes = get(entry, "indexes");
			for (Map<String, Object> item : indexes == null ? List.<Map<String, Object>>of() : indexes) {
				if (index.equals(item.get("type"))) {
					String found = item.get("status") == null ? "ready" : String.valueOf(item.get("status"));
					return switch (found) {
					case "indexing" -> "building";
					case "cancelled" -> "failed";
					default -> found;
					};
				}
			}
		}
		throw new IllegalStateException("no " + index + " index on " + name + "." + property);
	}

	public static Map<String, Object> awaitIndex(WeaviateClient client, Map<String, Object> args) {
		String name = string(args, "name");
		String property = string(args, "property");
		String target = property != null ? property : string(args, "vector");
		String until = args.containsKey("until") ? string(args, "until") : "ready";
		Object timeout = args.get("timeout");
		long deadline = timeout == null ? Long.MAX_VALUE : System.currentTimeMillis() + (long) (((Number) timeout).doubleValue() * 1000);
		while (true) {
			String state = property != null ? propertyIndexState(client, name, property, string(args, "index"))
					: string(indexing(client, name), "state");
			if ("failed".equals(state)) {
				if ("failed".equals(until)) {
					return args("index", target, "state", state);
				}
				throw new IllegalStateException("index on " + name + "." + target + " failed");
			}
			if (!"failed".equals(until) && STATES.indexOf(state) >= STATES.indexOf(until)) {
				return args("index", target, "state", state);
			}
			if (System.currentTimeMillis() > deadline) {
				throw new IllegalStateException("index on " + name + "." + target + " not " + until + " within " + timeout + " s");
			}
			sleep(POLL);
		}
	}

	private static void sleep(long millis) {
		try {
			Thread.sleep(millis);
		} catch (InterruptedException e) {
			Thread.currentThread().interrupt();
			throw new IllegalStateException(e);
		}
	}

	private static Map<String, Object> backupResult(Backup backup) {
		return args("backup_id", backup.id(), "status", backup.status().name());
	}

	private static Backup finished(WeaviateClient client, Backup backup, boolean wait) {
		if (!wait) {
			return backup;
		}
		try {
			return backup.waitForCompletion(client);
		} catch (IOException e) {
			throw new UncheckedIOException(e);
		} catch (TimeoutException e) {
			throw new IllegalStateException(e);
		}
	}

	public static Map<String, Object> createBackup(WeaviateClient client, Map<String, Object> args) {
		String backend = string(args, "backend");
		List<String> collections = get(args, "collections");
		String base = null;
		try {
			if (Boolean.TRUE.equals(args.get("incremental"))) {
				List<Backup> done = client.backup.list(backend, list -> list.sortByStartingTimeAsc(true)).stream()
						.filter(item -> item.status() == BackupStatus.SUCCESS
								&& (collections == null || item.includesCollections().containsAll(collections)))
						.toList();
				if (done.isEmpty()) {
					throw new IllegalStateException("an incremental backup needs a finished backup of "
							+ (collections == null ? "all collections" : collections) + " on " + backend);
				}
				base = done.get(done.size() - 1).id();
			}
			String incremental = base;
			Backup started = client.backup.create(string(args, "backup_id"), backend, request -> {
				if (collections != null) {
					request.includeCollections(collections);
				}
				if (incremental != null) {
					request.prefixIncremental(incremental);
				}
				if (args.containsKey("bucket")) {
					request.bucket(string(args, "bucket"));
				}
				if (args.containsKey("path")) {
					request.path(string(args, "path"));
				}
				return request;
			});
			return backupResult(finished(client, started, !Boolean.FALSE.equals(args.get("wait"))));
		} catch (IOException e) {
			throw new UncheckedIOException(e);
		}
	}

	public static Map<String, Object> restoreBackup(WeaviateClient client, Map<String, Object> args) {
		List<String> collections = get(args, "collections");
		try {
			Backup started = client.backup.restore(string(args, "backup_id"), string(args, "backend"), request -> {
				if (collections != null) {
					request.includeCollections(collections);
				}
				if (args.containsKey("bucket")) {
					request.bucket(string(args, "bucket"));
				}
				if (args.containsKey("path")) {
					request.path(string(args, "path"));
				}
				return request;
			});
			return backupResult(finished(client, started, !Boolean.FALSE.equals(args.get("wait"))));
		} catch (IOException e) {
			throw new UncheckedIOException(e);
		}
	}

	/** Copies the collection definition through the REST schema API, then every object with its named vectors. */
	public static Map<String, Object> cloneCollection(WeaviateClient client, Map<String, Object> args) {
		Map<String, Object> source = get(args, "source");
		String target = string(args, "target");
		List<String> vectors = get(args, "vectors");
		Map<String, Object> definition = restMap(client, "GET", "/schema/" + string(source, "name"), null);
		definition.put("class", target);
		rest(client, "POST", "/schema", definition);
		var destination = client.collections.use(target);
		long copied = 0;
		List<Prepared> chunk = new ArrayList<>();
		String after = null;
		while (true) {
			String cursor = after;
			var page = handle(client, source).query.fetchObjects(query -> {
				query.limit(PAGE);
				if (cursor != null) {
					query.after(cursor);
				}
				if (vectors != null && !vectors.isEmpty()) {
					query.includeVector(vectors);
				}
				return query;
			});
			for (WeaviateObject<Map<String, Object>> item : page.objects()) {
				Map<String, float[]> stored = new LinkedHashMap<>();
				for (String name : vectors == null ? List.<String>of() : vectors) {
					float[] values = item.vectors() == null ? null : item.vectors().getSingle(name);
					if (values != null) {
						stored.put(name, values);
					}
				}
				chunk.add(new Prepared(item.uuid(), item.properties(), stored));
				if (chunk.size() == BATCH) {
					copied += insert(destination, chunk, BATCH);
					chunk = new ArrayList<>();
				}
			}
			if (page.objects().size() < PAGE) {
				break;
			}
			after = page.objects().get(page.objects().size() - 1).uuid();
		}
		copied += insert(destination, chunk, BATCH);
		return args("copy_count", copied);
	}

	/** Deletes every object: no object of a collection has the nil UUID, so the filter matches all of them. */
	public static Map<String, Object> truncate(WeaviateClient client, Map<String, Object> args) {
		Map<String, Object> collection = get(args, "collection");
		List<Map<String, Object>> scopes = new ArrayList<>();
		if (Boolean.TRUE.equals(args.get("all_tenants"))) {
			for (String tenant : setTenantsNames(client, string(collection, "name"))) {
				Map<String, Object> scoped = new LinkedHashMap<>(collection);
				scoped.put("tenant", tenant);
				scopes.add(scoped);
			}
		} else {
			scopes.add(collection);
		}
		long deleted = 0;
		for (Map<String, Object> scoped : scopes) {
			var target = handle(client, scoped);
			while (true) {
				var result = target.data.deleteMany(Filter.uuid().ne(NIL_UUID));
				deleted += result.successful();
				if (result.matches() == 0) {
					break;
				}
			}
		}
		return args("delete_count", deleted);
	}

	/** Deletes at most limit matching objects, the first ones in key order. */
	public static Map<String, Object> deleteLimited(WeaviateClient client, Map<String, Object> args) {
		Map<String, Object> collection = get(args, "collection");
		List<Object> ids = get(args, "ids");
		Map<String, Object> filter = get(args, "filter");
		var target = handle(client, collection);
		Filter where = where(ids == null || ids.isEmpty() ? null
				: Filter.uuid().containsAny(ids.stream().map(WeaviateRuntime::objectId).toArray(String[]::new)),
				filter == null ? null : filter(filter));
		var response = target.query.fetchObjects(query -> {
			query.limit(whole(args, "limit")).sort(SortBy.property(string(collection, "key_property")))
					.returnProperties(string(collection, "key_property"));
			if (where != null) {
				query.filters(where);
			}
			return query;
		});
		String[] uuids = response.objects().stream().map(WeaviateObject::uuid).toArray(String[]::new);
		if (uuids.length == 0) {
			return args("delete_count", 0L);
		}
		return args("delete_count", target.data.deleteMany(Filter.uuid().containsAny(uuids)).successful());
	}

	public static List<String> listObjects(WeaviateClient client, Map<String, Object> args) {
		String kind = string(args, "kind");
		String collection = string(args, "collection");
		List<String> names = new ArrayList<>();
		try {
			switch (kind) {
			case "collections" -> client.collections.list().forEach(item -> names.add(item.collectionName()));
			case "aliases" -> client.alias.list().stream().filter(item -> collection == null || collection.equals(item.collection()))
					.forEach(item -> names.add(item.alias()));
			case "tenants", "namespaces" -> names.addAll(setTenantsNames(client, collection));
			case "indexes" -> {
				Map<String, Object> schema = restMap(client, "GET", "/schema/" + collection, null);
				Map<String, Object> vectors = get(schema, "vectorConfig");
				if (vectors != null) {
					names.addAll(vectors.keySet());
				}
				List<Map<String, Object>> properties = get(schema, "properties");
				for (Map<String, Object> property : properties == null ? List.<Map<String, Object>>of() : properties) {
					for (String index : List.of("filterable", "searchable", "rangeFilters")) {
						String flag = "index" + Character.toUpperCase(index.charAt(0)) + index.substring(1);
						if (Boolean.TRUE.equals(property.get(flag))) {
							names.add(property.get("name") + "." + index);
						}
					}
				}
			}
			case "snapshots" -> client.backup.list("filesystem").stream()
					.filter(item -> collection == null || item.includesCollections().contains(collection))
					.forEach(item -> names.add(item.id()));
			default -> throw new UnsupportedFeature("listing " + kind);
			}
		} catch (IOException e) {
			throw new UncheckedIOException(e);
		}
		String prefix = string(args, "prefix");
		Integer limit = whole(args, "limit");
		List<String> result = names.stream().filter(name -> prefix == null || name.startsWith(prefix)).sorted().toList();
		return limit == null ? result : result.subList(0, Math.min(limit, result.size()));
	}

	@SuppressWarnings("unchecked")
	private static List<Map<String, Object>> readRecords(String location) {
		String path = location.startsWith("file://") ? location.substring("file://".length()) : location;
		String text;
		try {
			text = Files.readString(Path.of(path), StandardCharsets.UTF_8);
		} catch (IOException e) {
			throw new UncheckedIOException(e);
		}
		if (text.stripLeading().startsWith("[")) {
			return (List<Map<String, Object>>) GSON.fromJson(text, List.class);
		}
		return text.lines().filter(line -> !line.isBlank()).map(line -> (Map<String, Object>) GSON.fromJson(line, Map.class)).toList();
	}

	/** Client-side batch import of a JSON array or JSON Lines file; Weaviate reports errors per object. */
	public static Map<String, Object> importFile(WeaviateClient client, Map<String, Object> args) {
		Map<String, Object> request = new LinkedHashMap<>(args);
		request.put("rows", readRecords(string(args, "location")));
		Object policy = args.get("on_conflict");
		return "update".equals(policy) || "replace".equals(policy) ? upsertRows(client, request) : insertRows(client, request);
	}

	// ---------------------------------------------------------------- generative search, matrices, samples

	public static Map<String, Object> generate(WeaviateClient client, Map<String, Object> args) {
		Map<String, Object> collection = get(args, "collection");
		List<String> output = get(args, "output");
		List<String> vectors = get(args, "vectors");
		Map<String, Object> filter = get(args, "filter");
		String singlePrompt = string(args, "single_prompt");
		String groupedTask = string(args, "grouped_task");
		List<String> groupedProperties = get(args, "grouped_properties");
		String field = string(args, "field");
		int limit = whole(args, "limit");
		var target = handle(client, collection);
		Function<GenerativeTask.Builder, ObjectBuilder<GenerativeTask>> task = generative -> {
			if (singlePrompt != null) {
				generative.singlePrompt(singlePrompt);
			}
			if (groupedTask != null) {
				generative.groupedTask(groupedTask, grouped -> groupedProperties == null ? grouped : grouped.properties(groupedProperties));
			}
			return generative;
		};
		GenerativeResponse<Map<String, Object>> response;
		if (args.containsKey("vector")) {
			response = target.generate.nearVector(Target.vector(field, vector(args.get("vector"))), query -> {
				query.limit(limit).returnProperties(returned(collection, output));
				if (filter != null) {
					query.filters(filter(filter));
				}
				if (vectors != null) {
					query.includeVector(vectors);
				}
				return query;
			}, task);
		} else if (args.containsKey("query")) {
			response = target.generate.nearText(Target.text(field, string(args, "query")), query -> {
				query.limit(limit).returnProperties(returned(collection, output));
				if (filter != null) {
					query.filters(filter(filter));
				}
				if (vectors != null) {
					query.includeVector(vectors);
				}
				return query;
			}, task);
		} else {
			response = target.generate.fetchObjects(query -> {
				query.limit(limit).sort(SortBy.property(string(collection, "key_property"))).returnProperties(returned(collection, output));
				if (filter != null) {
					query.filters(filter(filter));
				}
				if (vectors != null) {
					query.includeVector(vectors);
				}
				return query;
			}, task);
		}
		List<Map<String, Object>> hits = new ArrayList<>();
		for (GenerativeObject<Map<String, Object>> item : response.objects()) {
			Map<String, Object> fields = generativeRow(collection, item, output, vectors);
			Map<String, Object> hit = new LinkedHashMap<>();
			hit.put("id", fields.remove(string(collection, "key")));
			hit.put("generated", item.generative() == null ? null : item.generative().text());
			hit.putAll(fields);
			hits.add(hit);
		}
		Object grouped = groupedTask == null || response.generative() == null ? null : response.generative().text();
		return args("generated", grouped, "hits", hits);
	}

	private static Map<String, Object> generativeRow(Map<String, Object> collection, GenerativeObject<Map<String, Object>> item,
			List<String> output, List<String> vectors) {
		Map<String, Object> properties = item.properties();
		Map<String, Object> result = new LinkedHashMap<>();
		result.put(string(collection, "key"), value(properties.get(string(collection, "key_property"))));
		for (String name : output) {
			result.put(name, value(properties.get(name)));
		}
		if (vectors != null) {
			for (String name : vectors) {
				float[] stored = item.vectors() == null ? null : item.vectors().getSingle(name);
				result.put(name, value(stored == null ? new float[0] : stored));
			}
		}
		return result;
	}

	private static double pairwise(String metric, float[] a, float[] b) {
		double dot = 0;
		double left = 0;
		double right = 0;
		double squared = 0;
		double absolute = 0;
		double differing = 0;
		for (int i = 0; i < a.length; i++) {
			dot += (double) a[i] * b[i];
			left += (double) a[i] * a[i];
			right += (double) b[i] * b[i];
			squared += ((double) a[i] - b[i]) * ((double) a[i] - b[i]);
			absolute += Math.abs((double) a[i] - b[i]);
			differing += a[i] != b[i] ? 1 : 0;
		}
		return switch (metric) {
		case "cosine" -> left == 0 || right == 0 ? 0 : dot / (Math.sqrt(left) * Math.sqrt(right));
		case "dot" -> dot;
		case "l2-squared" -> -Math.sqrt(squared);
		case "manhattan" -> -absolute;
		default -> -differing;
		};
	}

	/** Canonical similarity between every pair of the first sample objects in key order. */
	public static List<Map<String, Object>> distanceMatrix(WeaviateClient client, Map<String, Object> args) {
		Map<String, Object> collection = get(args, "collection");
		String field = string(args, "field");
		String metric = string(args, "metric");
		Map<String, Object> filter = get(args, "filter");
		int sample = args.containsKey("sample") ? whole(args, "sample") : 100;
		int limit = args.containsKey("limit") ? whole(args, "limit") : 10;
		String keyProperty = string(collection, "key_property");
		var response = handle(client, collection).query.fetchObjects(query -> {
			query.limit(sample).sort(SortBy.property(keyProperty)).returnProperties(keyProperty).includeVector(List.of(field));
			if (filter != null) {
				query.filters(filter(filter));
			}
			return query;
		});
		List<Map<String, Object>> result = new ArrayList<>();
		for (var item : response.objects()) {
			Object key = value(item.properties().get(keyProperty));
			float[] vector = item.vectors().getSingle(field);
			List<Map<String, Object>> scored = new ArrayList<>();
			for (var other : response.objects()) {
				Object otherKey = value(other.properties().get(keyProperty));
				if (!otherKey.equals(key)) {
					scored.add(args("id", otherKey, "score", value(pairwise(metric, vector, other.vectors().getSingle(field)))));
				}
			}
			scored.sort((x, y) -> {
				int byScore = Double.compare(((Number) y.get("score")).doubleValue(), ((Number) x.get("score")).doubleValue());
				return byScore != 0 ? byScore : String.valueOf(x.get("id")).compareTo(String.valueOf(y.get("id")));
			});
			result.add(args("id", key, "neighbours", scored.subList(0, Math.min(limit, scored.size()))));
		}
		return result;
	}

	/** 'first' takes the first objects in key order; 'random' draws uniformly among all matching objects. */
	public static List<Map<String, Object>> sample(WeaviateClient client, Map<String, Object> args) {
		Map<String, Object> collection = get(args, "collection");
		Map<String, Object> filter = get(args, "filter");
		int size = whole(args, "size");
		if ("first".equals(args.get("method"))) {
			Map<String, Object> request = new LinkedHashMap<>(args);
			request.put("limit", size);
			return scroll(client, request);
		}
		Map<String, Object> found = matching(handle(client, collection), collection, filter == null ? Filter.uuid().ne(NIL_UUID) : filter(filter));
		List<String> uuids = new ArrayList<>(new TreeSet<>(found.keySet()));
		Collections.shuffle(uuids, RANDOM);
		List<String> chosen = new ArrayList<>(new TreeSet<>(uuids.subList(0, Math.min(size, uuids.size()))));
		Map<String, Object> request = new LinkedHashMap<>(args);
		request.put("ids", chosen.stream().map(found::get).toList());
		return getRows(client, request);
	}

	// ---------------------------------------------------------------- filters

	private static String wildcard(String pattern) {
		return pattern.replace('%', '*').replace('_', '?');
	}

	@SuppressWarnings("unchecked")
	static Filter filter(Map<String, Object> node) {
		if (node.containsKey("and")) {
			return Filter.and(operands((List<Map<String, Object>>) node.get("and")));
		}
		if (node.containsKey("or")) {
			return Filter.or(operands((List<Map<String, Object>>) node.get("or")));
		}
		if (node.containsKey("not")) {
			return Filter.not(filter((Map<String, Object>) node.get("not")));
		}
		String op = string(node, "op");
		String path = string(node, "path");
		Object value = node.get("value");
		boolean number = Boolean.TRUE.equals(node.get("number"));
		if (op.equals("length")) {
			return compare(Filter.propertyLen(path), string(node, "compare"), ((Number) value).longValue());
		}
		var property = Filter.property(path);
		return switch (op) {
		case "geo" -> property.withinGeoRange(real(node, "latitude"), real(node, "longitude"), real(node, "distance"));
		case "eq", "neq", "gt", "gte", "lt", "lte" -> compare(property, op, scalar(value, number));
		case "contains_any", "contains_all", "contains_none" -> contains(property, op, (List<?>) value, number);
		case "like" -> property.like(wildcard((String) value));
		case "wildcard" -> property.like((String) value);
		case "any_terms" -> property.containsAny(terms(value));
		case "all_terms" -> property.containsAll(terms(value));
		case "is_null" -> property.isNull(Boolean.TRUE.equals(value));
		default -> throw new IllegalArgumentException("unknown filter operator " + op);
		};
	}

	private static List<FilterOperand> operands(List<Map<String, Object>> nodes) {
		List<FilterOperand> result = new ArrayList<>();
		nodes.forEach(node -> result.add(filter(node)));
		return result;
	}

	private static String[] terms(Object value) {
		return Arrays.stream(String.valueOf(value).trim().split("\\s+")).filter(term -> !term.isEmpty()).toArray(String[]::new);
	}

	private static Object scalar(Object value, boolean number) {
		if (value instanceof Number n) {
			if (number || n instanceof Float || n instanceof Double && n.doubleValue() != Math.rint(n.doubleValue())) {
				return n.doubleValue();
			}
			return n.longValue();
		}
		return value;
	}

	private static Filter compare(Filter.FilterBuilder property, String op, Object value) {
		return switch (op) {
		case "eq" -> property.eq(value);
		case "neq" -> property.ne(value);
		case "gt" -> property.gt(value);
		case "gte" -> property.gte(value);
		case "lt" -> property.lt(value);
		case "lte" -> property.lte(value);
		default -> throw new IllegalArgumentException("unknown comparison " + op);
		};
	}

	private static Filter contains(Filter.FilterBuilder property, String op, List<?> values, boolean number) {
		if (values.stream().allMatch(item -> item instanceof String)) {
			String[] typed = values.stream().map(String.class::cast).toArray(String[]::new);
			return switch (op) {
			case "contains_any" -> property.containsAny(typed);
			case "contains_all" -> property.containsAll(typed);
			default -> property.containsNone(typed);
			};
		}
		if (values.stream().allMatch(item -> item instanceof Boolean)) {
			Boolean[] typed = values.stream().map(Boolean.class::cast).toArray(Boolean[]::new);
			return switch (op) {
			case "contains_any" -> property.containsAny(typed);
			case "contains_all" -> property.containsAll(typed);
			default -> property.containsNone(typed);
			};
		}
		boolean integral = !number && values.stream().allMatch(item -> scalar(item, false) instanceof Long);
		if (integral) {
			Long[] typed = values.stream().map(item -> ((Number) item).longValue()).toArray(Long[]::new);
			return switch (op) {
			case "contains_any" -> property.containsAny(typed);
			case "contains_all" -> property.containsAll(typed);
			default -> property.containsNone(typed);
			};
		}
		Double[] typed = values.stream().map(item -> ((Number) item).doubleValue()).toArray(Double[]::new);
		return switch (op) {
		case "contains_any" -> property.containsAny(typed);
		case "contains_all" -> property.containsAll(typed);
		default -> property.containsNone(typed);
		};
	}
}
