	private static List<String> setTenants(WeaviateClient client, String name, boolean active) {
		var target = client.collections.use(name);
		List<String> names = target.tenants.list().stream().map(Tenant::name).sorted().toList();
		if (!names.isEmpty()) {
			try {
				target.tenants.update(names.stream().map(tenant -> active ? Tenant.active(tenant) : Tenant.inactive(tenant)).toList());
			} catch (IOException e) {
