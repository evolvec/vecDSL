	public static void createCollection(WeaviateClient client, Map<String, Object> args) {
		List<Map<String, Object>> properties = get(args, "properties");
		List<Map<String, Object>> vectors = get(args, "vectors");
		Map<String, Object> inverted = get(args, "inverted_index");
		String description = string(args, "description");
		Map<String, Object> tenancy = get(args, "multi_tenancy");
		Map<String, Object> expiry = get(args, "ttl");
		Map<String, Object> replication = get(args, "replication");
		Map<String, Object> sharding = get(args, "sharding");
		Map<String, Object> generative = get(args, "generative");
		try {
			client.collections.create(string(args, "name"), config -> {
				if (description != null) {
					config.description(description);
				}
				if (tenancy != null) {
					config.multiTenancy(mt -> mt.autoTenantCreation(Boolean.TRUE.equals(tenancy.get("auto_tenant_creation"))));
				}
				if (expiry != null) {
					config.objectTtl(ttl(expiry));
				}
				if (replication != null) {
					config.replication(r -> r.replicationFactor(whole(replication, "factor")));
				}
				if (sharding != null) {
					config.sharding(sh -> sh.desiredCount(whole(sharding, "desired_count")));
				}
				if (generative != null) {
					config.generativeModule(JSON.deserialize(GSON.toJson(Map.of(string(generative, "module"), generative.get("config"))), Generative.class));
				}
				config.properties(properties.stream().map(WeaviateRuntime::property).toList());
				if (!vectors.isEmpty()) {
					Map<String, VectorConfig> named = new LinkedHashMap<>();
					vectors.forEach(spec -> {
						Map.Entry<String, VectorConfig> entry = namedVector(spec);
						named.put(entry.getKey(), entry.getValue());
					});
					config.vectorConfig(named);
				}
				if (inverted != null) {
					config.invertedIndex(index -> invertedIndex(index, inverted));
				}
				return config;
			});
		} catch (IOException e) {
			throw new UncheckedIOException(e);
		}
	}

	private static Property property(Map<String, Object> spec) {
		Property.Builder builder = new Property.Builder(string(spec, "name"), string(spec, "data_type"));
		if (spec.containsKey("description")) {
			builder.description(string(spec, "description"));
		}
		if (spec.containsKey("tokenization")) {
			builder.tokenization(Tokenization.valueOf(string(spec, "tokenization").toUpperCase()));
		}
		if (spec.containsKey("index_filterable")) {
			builder.indexFilterable((Boolean) spec.get("index_filterable"));
		}
		if (spec.containsKey("index_searchable")) {
			builder.indexSearchable((Boolean) spec.get("index_searchable"));
		}
		if (spec.containsKey("index_range_filters")) {
			builder.indexRangeFilters((Boolean) spec.get("index_range_filters"));
		}
		if (spec.containsKey("nested_properties")) {
			List<Map<String, Object>> nested = get(spec, "nested_properties");
			builder.nestedProperties(nested.stream().map(WeaviateRuntime::property).toList());
		}
		if (Boolean.TRUE.equals(spec.get("ascii_fold"))) {
			builder.textAnalyzer(TextAnalyzer.of(analyzer -> analyzer.foldAscii(true)));
		}
		return builder.build();
	}

	private static Map.Entry<String, VectorConfig> namedVector(Map<String, Object> spec) {
		Distance distance = switch (string(spec, "distance")) {
		case "cosine" -> Distance.COSINE;
		case "dot" -> Distance.DOT;
		case "l2-squared" -> Distance.L2_SQUARED;
		case "manhattan" -> Distance.MANHATTAN;
		case "hamming" -> Distance.HAMMING;
		default -> throw new IllegalArgumentException("unknown distance " + spec.get("distance"));
		};
		if (spec.containsKey("vectorizer") || spec.containsKey("quantizer")) {
			return Map.entry(string(spec, "name"), JSON.deserialize(GSON.toJson(vectorJson(spec)), VectorConfig.class));
		}
		if ("flat".equals(spec.get("index"))) {
			return VectorConfig.selfProvided(string(spec, "name"), vectorizer -> vectorizer.vectorIndex(Flat.of()));
		}
		Hnsw index = Hnsw.of(hnsw -> {
			hnsw.distance(distance);
			if (spec.containsKey("max_connections")) {
				hnsw.maxConnections(whole(spec, "max_connections"));
			}
			if (spec.containsKey("ef_construction")) {
				hnsw.efConstruction(whole(spec, "ef_construction"));
			}
			if (spec.containsKey("ef")) {
				hnsw.ef(whole(spec, "ef"));
			}
			return hnsw;
		});
		return VectorConfig.selfProvided(string(spec, "name"), vectorizer -> vectorizer.vectorIndex(index));
	}

	private static InvertedIndex.Builder invertedIndex(InvertedIndex.Builder index, Map<String, Object> spec) {
		if (spec.containsKey("bm25_k1") || spec.containsKey("bm25_b")) {
			float k1 = spec.containsKey("bm25_k1") ? real(spec, "bm25_k1") : BM25_K1;
			float b = spec.containsKey("bm25_b") ? real(spec, "bm25_b") : BM25_B;
			index.bm25(bm25 -> bm25.k1(k1).b(b));
		}
		if (spec.containsKey("stopwords_preset")) {
			index.stopwords(stopwords -> stopwords.preset(string(spec, "stopwords_preset")));
		}
		if (Boolean.TRUE.equals(spec.get("index_timestamps"))) {
			index.indexTimestamps(true);
		}
		if (Boolean.TRUE.equals(spec.get("index_null_state"))) {
			index.indexNulls(true);
		}
		if (Boolean.TRUE.equals(spec.get("index_property_length"))) {
			index.indexPropertyLength(true);
		}
		return index;
	}

	// ---------------------------------------------------------------- writes

	private record Prepared(String uuid, Map<String, Object> properties, Map<String, float[]> vectors) {
	}

	private static void check(Map<String, Object> collection, Map<String, Object> record) {
		Map<String, Map<String, Object>> limits = get(collection, "limits");
		if (limits == null) {
			return;
		}
		limits.forEach((field, limit) -> {
			Object value = record.get(field);
			if (value == null) {
				return;
			}
			if (limit.containsKey("dim") && ((Collection<?>) value).size() != whole(limit, "dim")) {
				throw new IllegalArgumentException(field + " has " + ((Collection<?>) value).size() + " dimensions; "
						+ collection.get("name") + " declares " + whole(limit, "dim"));
			}
			if (limit.containsKey("max_items") && ((Collection<?>) value).size() > whole(limit, "max_items")) {
				throw new IllegalArgumentException(field + " has " + ((Collection<?>) value).size() + " items; at most "
						+ whole(limit, "max_items") + " are allowed");
			}
			if (limit.containsKey("max_length")) {
				Collection<?> texts = value instanceof Collection<?> items ? items : List.of(value);
				for (Object text : texts) {
					if (text instanceof String s && s.length() > whole(limit, "max_length")) {
						throw new IllegalArgumentException(field + " is longer than " + whole(limit, "max_length") + " characters");
					}
				}
			}
		});
	}

	/** Weaviate properties and named vectors of a record; the key is stored under the key property. */
	private static Prepared parts(Map<String, Object> collection, String uuid, Map<String, Object> record, Object key) {
		check(collection, record);
		List<String> vectorNames = get(collection, "vectors");
		Map<String, Object> properties = new LinkedHashMap<>();
		Map<String, float[]> vectors = new LinkedHashMap<>();
		record.forEach((name, value) -> {
			if (value == null || name.equals(collection.get("key"))) {
				return;
			}
			if (vectorNames != null && vectorNames.contains(name)) {
				vectors.put(name, vector(value));
			} else {
				properties.put(name, value);
			}
		});
		properties.put(string(collection, "key_property"), key);
		return new Prepared(uuid, properties, vectors);
	}

	private static Object recordKey(Map<String, Object> collection, Map<String, Object> record) {
		Object key = record.get(string(collection, "key"));
		if (key == null) {
			throw new IllegalArgumentException("record without primary key " + collection.get("key") + ": " + record);
		}
		return key;
	}

	private static List<Prepared> prepare(Map<String, Object> collection, List<Map<String, Object>> rows) {
		Map<String, Object> defaults = get(collection, "defaults");
		List<Prepared> result = new ArrayList<>();
		for (Map<String, Object> row : rows) {
			Map<String, Object> record = new LinkedHashMap<>(defaults == null ? Map.of() : defaults);
			record.putAll(row);
			Object key = recordKey(collection, record);
			result.add(parts(collection, objectId(key), record, key));
		}
		return result;
	}

	private static Vectors[] vectors(Prepared item) {
		return item.vectors().entrySet().stream().map(entry -> Vectors.of(entry.getKey(), entry.getValue())).toArray(Vectors[]::new);
	}

	private static WeaviateObject<Map<String, Object>> object(Prepared item) {
		return WeaviateObject.<Map<String, Object>>of(object -> {
			object.uuid(item.uuid()).properties(item.properties());
			if (!item.vectors().isEmpty()) {
				object.vectors(vectors(item));
			}
			return object;
		});
	}

	private static Set<String> existing(CollectionHandle<Map<String, Object>> target, List<String> uuids) {
		Set<String> found = new HashSet<>();
		for (List<String> chunk : batches(uuids, PAGE)) {
			var response = target.query.fetchObjects(query -> query
					.filters(Filter.uuid().containsAny(chunk.toArray(String[]::new))).limit(chunk.size()));
			response.objects().forEach(item -> found.add(item.uuid()));
		}
		return found;
	}

	private static long insert(CollectionHandle<Map<String, Object>> target, List<Prepared> objects, int batchSize) {
		long inserted = 0;
		for (List<Prepared> chunk : batches(objects, batchSize)) {
			InsertManyResponse result = target.data.insertMany(chunk.stream().map(WeaviateRuntime::object).toList());
			if (result.errors() != null && !result.errors().isEmpty()) {
				throw new IllegalStateException("Weaviate rejected " + result.errors().size() + " objects: "
						+ String.join("; ", new TreeSet<>(result.errors())));
			}
			inserted += chunk.size();
		}
		return inserted;
	}

	public static Map<String, Object> insertRows(WeaviateClient client, Map<String, Object> args) {
		Map<String, Object> collection = get(args, "collection");
		var target = handle(client, collection);
		List<Prepared> objects = prepare(collection, get(args, "rows"));
		Set<String> found = existing(target, objects.stream().map(Prepared::uuid).toList());
		if (!found.isEmpty() && "error".equals(args.getOrDefault("on_conflict", "error"))) {
			throw new IllegalStateException(found.size() + " records already exist in " + collection.get("name"));
		}
		List<Prepared> fresh = objects.stream().filter(item -> !found.contains(item.uuid())).toList();
		Integer batchSize = whole(args, "batch_size");
		return args("insert_count", insert(target, fresh, batchSize == null ? BATCH : batchSize), "skipped",
				(long) (objects.size() - fresh.size()));
	}

	public static Map<String, Object> upsertRows(WeaviateClient client, Map<String, Object> args) {
		Map<String, Object> collection = get(args, "collection");
		var target = handle(client, collection);
		List<Prepared> objects = prepare(collection, get(args, "rows"));
		Set<String> found = existing(target, objects.stream().map(Prepared::uuid).toList());
		for (Prepared item : objects) {
			if (found.contains(item.uuid())) {
				replace(target, item);
			}
		}
		Integer batchSize = whole(args, "batch_size");
		insert(target, objects.stream().filter(item -> !found.contains(item.uuid())).toList(), batchSize == null ? BATCH : batchSize);
		return args("upsert_count", (long) objects.size());
	}

	private static void replace(CollectionHandle<Map<String, Object>> target, Prepared item) {
		try {
			target.data.replace(item.uuid(), request -> {
				request.properties(item.properties());
				if (!item.vectors().isEmpty()) {
					request.vectors(vectors(item));
				}
				return request;
			});
		} catch (IOException e) {
			throw new UncheckedIOException(e);
		}
	}

	private static void update(CollectionHandle<Map<String, Object>> target, Prepared item) {
		try {
			target.data.update(item.uuid(), request -> {
				request.properties(item.properties());
				if (!item.vectors().isEmpty()) {
					request.vectors(vectors(item));
				}
				return request;
			});
		} catch (IOException e) {
			throw new UncheckedIOException(e);
		}
	}

	private static Map<String, Object> matching(CollectionHandle<Map<String, Object>> target, Map<String, Object> collection, Filter where) {
		String keyProperty = string(collection, "key_property");
		Map<String, Object> found = new LinkedHashMap<>();
		for (int offset = 0;; offset += PAGE) {
			int position = offset;
			var response = target.query.fetchObjects(query -> query.filters(where).limit(PAGE).offset(position)
					.sort(SortBy.property(keyProperty)).returnProperties(keyProperty));
			response.objects().forEach(item -> found.put(item.uuid(), item.properties().get(keyProperty)));
			if (response.objects().size() < PAGE) {
				return found;
			}
		}
	}

	public static Map<String, Object> updateRows(WeaviateClient client, Map<String, Object> args) {
		Map<String, Object> collection = get(args, "collection");
		String key = string(collection, "key");
		var target = handle(client, collection);
		List<Map<String, Object>> rows = get(args, "rows");
		Map<String, Map<String, Object>> replacements = new LinkedHashMap<>();
		for (Map<String, Object> row : rows == null ? List.<Map<String, Object>>of() : rows) {
			replacements.put(objectId(recordKey(collection, row)), row);
		}
		List<Object> ids = get(args, "ids");
		Map<String, Object> filter = get(args, "filter");
		Map<String, Object> targets = new LinkedHashMap<>();
		if (ids != null && !ids.isEmpty()) {
			Map<String, Object> keys = new LinkedHashMap<>();
			ids.forEach(id -> keys.put(objectId(id), id));
			Set<String> found = existing(target, new ArrayList<>(keys.keySet()));
			Map<String, Object> filtered = filter == null ? null : matching(target, collection, filter(filter));
			keys.forEach((uuid, id) -> {
				if (found.contains(uuid) && (filtered == null || filtered.containsKey(uuid))) {
					targets.put(uuid, id);
				}
			});
		} else if (filter != null) {
			targets.putAll(matching(target, collection, filter(filter)));
		} else if (!replacements.isEmpty()) {
			Set<String> found = existing(target, new ArrayList<>(replacements.keySet()));
			replacements.forEach((uuid, row) -> {
				if (found.contains(uuid)) {
					targets.put(uuid, row.get(key));
				}
			});
		} else {
			throw new IllegalArgumentException("update requires ids, a filter or records");
		}
		Map<String, Object> values = get(args, "values");
		targets.forEach((uuid, id) -> {
			Map<String, Object> record = new LinkedHashMap<>(replacements.getOrDefault(uuid, Map.of()));
			if (values != null) {
				record.putAll(values);
			}
			if (record.containsKey(key) && !sameKey(record.get(key), id)) {
				throw new IllegalArgumentException("update cannot change the primary key " + key);
			}
			Prepared item = parts(collection, uuid, record, id);
			if ("replace".equals(args.get("mode"))) {
				replace(target, item);
			} else {
				update(target, item);
			}
		});
		return args("update_count", (long) targets.size());
	}

	private static boolean sameKey(Object left, Object right) {
		return objectId(left).equals(objectId(right));
	}

	public static Map<String, Object> deleteRows(WeaviateClient client, Map<String, Object> args) {
		List<Filter> conditions = new ArrayList<>();
		List<Object> ids = get(args, "ids");
		if (ids != null && !ids.isEmpty()) {
			conditions.add(Filter.uuid().containsAny(ids.stream().map(WeaviateRuntime::objectId).toArray(String[]::new)));
		}
		Map<String, Object> filter = get(args, "filter");
		if (filter != null) {
			conditions.add(filter(filter));
		}
		var result = handle(client, get(args, "collection")).data
				.deleteMany(conditions.size() == 1 ? conditions.get(0) : Filter.and(new ArrayList<>(conditions)));
		return args("delete_count", result.successful());
	}

