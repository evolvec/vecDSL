	public static void createTenants(WeaviateClient client, Map<String, Object> args) {
		var target = client.collections.use(string(args, "name"));
		List<String> tenants = get(args, "tenants");
		boolean ifNotExists = Boolean.TRUE.equals(args.get("if_not_exists"));
		try {
