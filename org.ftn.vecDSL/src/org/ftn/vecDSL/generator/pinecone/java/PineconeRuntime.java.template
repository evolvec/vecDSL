/**
 * Runtime support for vecDSL programs generated for Pinecone. The Java SDK {{sdk.java.group}}:{{sdk.java.artifact}}
 * {{sdk.java.version}} targets API {{sdk.java.api.version}} and has no Documents API, so this runtime sends the documented
 * REST requests of API {{api.version}} with java.net.http. Generated by vecDSL 7. Do not edit.
 */
public final class PineconeRuntime {

	static final String API_VERSION = "{{api.version}}";
	static final String DEFAULT_NAMESPACE = "{{namespace}}";
	static final String DEFAULT_CLOUD = "{{deployment.cloud}}";
	static final String DEFAULT_REGION = "{{deployment.region}}";

	private static final int PAGE = 1000;
	private static final int LIST_PAGE = 100;
	private static final int BATCH = 100;
	private static final int SETTLE = 50;
	private static final int DIGITS = 6;
	private static final int MAX_ID = 512;
	private static final int RETRIES = 3;
	private static final Set<Integer> RETRIED = Set.of(429, 500, 502, 503, 504);
	private static final int EMBEDDED_BATCH = 96;
	private static final Set<String> OPERATORS = Set.of("and", "or", "not");
	private static final Gson GSON = new GsonBuilder().setObjectToNumberStrategy(ToNumberPolicy.LONG_OR_DOUBLE).create();
	private static final Gson PRETTY = new GsonBuilder().serializeNulls().setPrettyPrinting().create();

	private PineconeRuntime() {
	}

	public static final class UnsupportedFeature extends UnsupportedOperationException {

		private static final long serialVersionUID = 1L;

		UnsupportedFeature(String message) {
			super(message);
		}
	}

	/** A Pinecone API response with a status other than 2xx. */
	public static final class PineconeException extends RuntimeException {

		private static final long serialVersionUID = 1L;

		final int status;

		PineconeException(int status, String message) {
			super(message);
			this.status = status;
		}
	}

	public static RuntimeException unsupported(String vendor, String feature) {
		return new UnsupportedFeature(feature + " is not supported for target " + vendor);
	}

	// ---------------------------------------------------------------- values

	public static Map<String, Object> args(Object... pairs) {
		Map<String, Object> result = new LinkedHashMap<>();
		for (int i = 0; i < pairs.length; i += 2) {
			result.put((String) pairs[i], pairs[i + 1]);
		}
		return result;
	}

	public static List<Object> list(Object... items) {
		return new ArrayList<>(Arrays.asList(items));
	}

	public static String env(String name) {
		String value = System.getenv(name);
		if (value == null) {
			throw new IllegalStateException("environment variable " + name + " is not set");
		}
		return value;
	}

	public static String envOr(String name, String fallback) {
		String value = System.getenv(name);
		return value == null ? fallback : value;
	}

	public static String text(Object value) {
		return value == null ? null : value.toString();
	}

	public static long integer(Object value) {
		return ((Number) value).longValue();
	}

	public static double decimal(Object value) {
		return ((Number) value).doubleValue();
	}

	public static boolean flag(Object value) {
		return (Boolean) value;
	}

	public static List<Float> floats(Object value) {
		return ((Collection<?>) value).stream().map(item -> ((Number) item).floatValue()).toList();
	}

	public static List<String> texts(Object value) {
		return ((Collection<?>) value).stream().map(String::valueOf).toList();
	}

	@SuppressWarnings("unchecked")
	public static List<Map<String, Object>> records(Object value) {
		return (List<Map<String, Object>>) value;
	}

	public static String toJson(Object value) {
		return PRETTY.toJson(value);
	}

	public static Map<String, Object> parameters(Map<String, Object> given, Map<String, Object> defaults, List<String> names) {
		Set<String> unknown = new HashSet<>(given.keySet());
		unknown.removeAll(names);
		if (!unknown.isEmpty()) {
			throw new IllegalArgumentException("unknown program parameters: " + unknown);
		}
		Map<String, Object> values = new LinkedHashMap<>(defaults);
		values.putAll(given);
		List<String> missing = names.stream().filter(name -> !values.containsKey(name)).toList();
		if (!missing.isEmpty()) {
			throw new IllegalArgumentException("missing program parameters: " + missing);
		}
		return values;
	}

	public static Map<String, Object> parseArguments(String[] arguments) {
		Map<String, Object> parameters = new LinkedHashMap<>();
		for (String argument : arguments) {
			int separator = argument.indexOf('=');
			if (separator < 0) {
				throw new IllegalArgumentException("expected name=value, got " + argument);
			}
			String raw = argument.substring(separator + 1);
			Object value;
			try {
				value = GSON.fromJson(JsonParser.parseString(raw), Object.class);
			} catch (JsonParseException e) {
				value = raw;
			}
			parameters.put(argument.substring(0, separator), value);
		}
		return parameters;
	}

	/** Result values in one form for every host language: floats rounded, integral numbers as integers. */
	@SuppressWarnings("unchecked")
	static Object value(Object item) {
		if (item instanceof Float || item instanceof Double) {
			double number = ((Number) item).doubleValue();
			if (!Double.isFinite(number)) {
				return number;
			}
			double rounded = new BigDecimal(number).setScale(DIGITS, RoundingMode.HALF_EVEN).doubleValue();
			return rounded == Math.rint(rounded) && Math.abs(rounded) < 1e15 ? (Object) (long) rounded : (Object) rounded;
		}
		if (item instanceof Number number) {
			return number.longValue();
		}
		if (item instanceof Collection<?> items) {
			return items.stream().map(PineconeRuntime::value).toList();
		}
		if (item instanceof Map<?, ?> map) {
			Map<String, Object> result = new LinkedHashMap<>();
			((Map<String, Object>) map).forEach((key, entry) -> result.put(key, value(entry)));
			return result;
		}
		return item;
	}

	/** Pinecone document id of a primary key: the decimal text of an integer, or the text itself. */
	public static String documentId(Object key) {
		String text;
		if (key instanceof Integer || key instanceof Long || key instanceof Short || key instanceof Byte || key instanceof BigInteger) {
			text = key.toString();
		} else if ((key instanceof Double || key instanceof Float) && ((Number) key).doubleValue() == Math.rint(((Number) key).doubleValue())
				&& Double.isFinite(((Number) key).doubleValue())) {
			text = new BigDecimal(((Number) key).doubleValue()).toBigInteger().toString();
		} else if (key instanceof String string) {
			text = string;
		} else {
			throw new IllegalArgumentException("cannot use " + key + " as a Pinecone primary key");
		}
		if (text.isEmpty() || text.length() > MAX_ID || text.chars().anyMatch(c -> c == 0 || c > 127)) {
			throw new IllegalArgumentException("Pinecone document ids are 1 to " + MAX_ID + " ASCII characters: " + text);
		}
		return text;
	}

	private static Object keyOf(Map<String, Object> layout, String id) {
		return "int".equals(layout.get("key_type")) ? (Object) Long.parseLong(id) : id;
	}

	/** Ids in key order; every id is checked against the key type first, as the other runtimes do. */
	private static void sortIds(Map<String, Object> layout, List<String> ids) {
		ids.forEach(id -> keyOf(layout, id));
		ids.sort(idOrder(layout));
	}

	private static Comparator<String> idOrder(Map<String, Object> layout) {
		return "int".equals(layout.get("key_type")) ? Comparator.comparing(BigInteger::new) : Comparator.naturalOrder();
	}

	@SuppressWarnings("unchecked")
	private static Map<String, Object> map(Object value) {
		return (Map<String, Object>) value;
	}

	@SuppressWarnings("unchecked")
	private static List<Object> items(Object value) {
		return value == null ? List.of() : new ArrayList<>((Collection<Object>) value);
	}

	private static List<String> strings(Object value) {
		return items(value).stream().map(String::valueOf).toList();
	}

	private static double number(Object value) {
		return ((Number) value).doubleValue();
	}

	private static Double optionalNumber(Map<String, Object> args, String key) {
		return args.get(key) == null ? null : number(args.get(key));
	}

	private static int whole(Map<String, Object> args, String key, int fallback) {
		return args.get(key) == null ? fallback : ((Number) args.get(key)).intValue();
	}

	private static double seconds(String name, double fallback) {
		return Double.parseDouble(envOr(name, String.valueOf(fallback)));
	}

	private static <T> List<List<T>> chunks(List<T> items, int size) {
		List<List<T>> result = new ArrayList<>();
		for (int start = 0; start < items.size(); start += size) {
			result.add(items.subList(start, Math.min(items.size(), start + size)));
		}
		return result;
	}

	/** Documents per upsert or update: at most 96 on an index that embeds a field. */
	private static int batch(Map<String, Object> layout, int size) {
		return Math.min(size, whole(layout, "max_batch", size));
	}

	private static void pause(long millis) {
		try {
			Thread.sleep(millis);
		} catch (InterruptedException e) {
			Thread.currentThread().interrupt();
			throw new IllegalStateException(e);
		}
	}

	// ---------------------------------------------------------------- transport

	/** HTTP client, API key and data-plane hosts of the indexes a program uses, and the last response's log positions. */
	public static final class Client implements AutoCloseable {

		final HttpClient http;
		final String control;
		final String apiKey;
		final String indexHost;
		final Duration timeout;
		final Map<String, String> hosts = new HashMap<>();
		final Map<String, Set<String>> schemas = new HashMap<>();
		Long committed;
		Long reconciled;

		Client(String control, String apiKey, String indexHost, Duration timeout) {
			this.http = HttpClient.newBuilder().connectTimeout(Duration.ofSeconds(30)).build();
			this.control = control.replaceAll("/+$", "");
			this.apiKey = apiKey;
			this.indexHost = indexHost == null || indexHost.isBlank() ? null : indexHost;
			this.timeout = timeout;
		}

		@Override
		public void close() {
			hosts.clear();
			schemas.clear();
		}
	}

	public static Client connect(Map<String, Object> args) {
		Object timeout = args.get("timeout");
		return new Client((String) args.get("uri"), (String) args.get("api_key"), (String) args.get("index_host"),
				Duration.ofMillis((long) ((timeout == null ? 30 : number(timeout)) * 1000)));
	}

	/**
	 * One REST request; 429 and 5xx are retried three times with backoff from 0.5 s, and so is a dropped connection when the
	 * request can be repeated (reads, deletes and document writes, whose bodies carry absolute values).
	 */
	private static Object send(Client client, String method, String url, Object body) {
		HttpRequest.Builder request = HttpRequest.newBuilder(URI.create(url)).timeout(client.timeout)
				.header("Api-Key", client.apiKey).header("X-Pinecone-Api-Version", API_VERSION).header("Accept", "application/json");
		if (body == null) {
			request.method(method, HttpRequest.BodyPublishers.noBody());
		} else {
			request.header("Content-Type", "application/json").method(method, HttpRequest.BodyPublishers.ofString(GSON.toJson(body)));
		}
		boolean repeatable = !method.equals("POST") || url.contains("/documents/");
		for (int attempt = 0;; attempt++) {
			HttpResponse<String> response;
			try {
				response = client.http.send(request.build(), HttpResponse.BodyHandlers.ofString(StandardCharsets.UTF_8));
			} catch (IOException e) {
				if (repeatable && attempt < RETRIES) {
					pause(500L << attempt);
					continue;
				}
				throw new UncheckedIOException(e);
			} catch (InterruptedException e) {
				Thread.currentThread().interrupt();
				throw new IllegalStateException(e);
			}
			int status = response.statusCode();
			if (RETRIED.contains(status) && attempt < RETRIES) {
				pause(500L << attempt);
				continue;
			}
			if (status < 200 || status >= 300) {
				throw new PineconeException(status, method + " " + url + " returned " + status + ": " + response.body());
			}
			client.committed = position(response, "x-pinecone-request-lsn", "x-pinecone-lsn-committed");
			client.reconciled = position(response, "x-pinecone-max-indexed-lsn", "x-pinecone-lsn-reconciled");
			return response.body().isBlank() ? null : GSON.fromJson(JsonParser.parseString(response.body()), Object.class);
		}
	}

	private static Long position(HttpResponse<String> response, String... names) {
		for (String name : names) {
			Optional<String> header = response.headers().firstValue(name);
			if (header.isPresent() && header.get().trim().matches("\\d+")) {
				return Long.parseLong(header.get().trim());
			}
		}
		return null;
	}

	private static String segment(String name) {
		return URLEncoder.encode(name, StandardCharsets.UTF_8).replace("+", "%20");
	}

	private static Map<String, Object> describeIndex(Client client, String name) {
		return map(send(client, "GET", client.control + "/indexes/" + segment(name), null));
	}

	private static String host(Client client, String name) {
		String found = client.indexHost;
		if (found == null) {
			found = client.hosts.get(name);
		}
		if (found == null) {
			found = (String) describeIndex(client, name).get("host");
			client.hosts.put(name, found);
		}
		return found.contains("://") ? found.replaceAll("/+$", "") : "https://" + found;
	}

	private static Map<String, Object> documents(Client client, Map<String, Object> layout, String operation, Object body) {
		String url = host(client, (String) layout.get("name")) + "/namespaces/" + segment((String) layout.get("namespace"))
				+ "/documents/" + operation;
		return map(send(client, "POST", url, body));
	}

	// ---------------------------------------------------------------- indexes

	private static double indexTimeout() {
		return seconds("VECDSL_PINECONE_INDEX_TIMEOUT", 300);
	}

	public static boolean hasCollection(Client client, Map<String, Object> args) {
		try {
			describeIndex(client, (String) args.get("name"));
			return true;
		} catch (PineconeException e) {
			if (e.status == 404) {
				return false;
			}
			throw e;
		}
	}

	/** Deletes the index and, unless VECDSL_PINECONE_INDEX_TIMEOUT is 0, waits until it is gone. */
	public static void dropCollection(Client client, Map<String, Object> args) {
		String name = (String) args.get("name");
		client.hosts.remove(name);
		client.schemas.remove(name);
		try {
			send(client, "DELETE", client.control + "/indexes/" + segment(name), null);
		} catch (PineconeException e) {
			if (e.status == 404) {
				return;
			}
			throw e;
		}
		double limit = indexTimeout();
		long deadline = System.currentTimeMillis() + (long) (limit * 1000);
		while (limit > 0 && hasCollection(client, args)) {
			if (System.currentTimeMillis() > deadline) {
				throw new IllegalStateException("index " + name + " still exists after " + limit + " s");
			}
			pause(1000);
		}
	}

	/** Creates the index and, unless VECDSL_PINECONE_INDEX_TIMEOUT is 0, waits until it is ready. */
	public static void createCollection(Client client, Map<String, Object> args) {
		String name = (String) args.get("name");
		Map<String, Object> deployment = args("deployment_type", "managed", "cloud", envOr("VECDSL_PINECONE_CLOUD", DEFAULT_CLOUD),
				"region", envOr("VECDSL_PINECONE_REGION", DEFAULT_REGION));
		if (args.get("deployment") != null) {
			deployment.putAll(map(args.get("deployment")));
		}
		Map<String, Object> body = args("name", name, "schema", args("fields", args.get("fields")), "deployment", deployment);
		if (args.get("deletion_protection") != null) {
			body.put("deletion_protection", args.get("deletion_protection"));
		}
		if (args.get("tags") != null && !map(args.get("tags")).isEmpty()) {
			body.put("tags", args.get("tags"));
		}
		send(client, "POST", client.control + "/indexes", body);
		double limit = indexTimeout();
		long deadline = System.currentTimeMillis() + (long) (limit * 1000);
		while (limit > 0 && !ready(client, name)) {
			if (System.currentTimeMillis() > deadline) {
				throw new IllegalStateException("index " + name + " is not ready after " + limit + " s");
			}
			pause(1000);
		}
	}

	private static boolean ready(Client client, String name) {
		Object status = describeIndex(client, name).get("status");
		return status != null && Boolean.TRUE.equals(map(status).get("ready"));
	}

	private static String control(Client client) {
		return client.control;
	}

	private static Object data(Client client, String name, String method, String path, Object body) {
		return send(client, method, host(client, name) + path, body);
	}

	private static String query(Object... pairs) {
		List<String> parts = new ArrayList<>();
		for (int i = 0; i < pairs.length; i += 2) {
			if (pairs[i + 1] != null) {
				parts.add(URLEncoder.encode((String) pairs[i], StandardCharsets.UTF_8) + "="
						+ URLEncoder.encode(String.valueOf(pairs[i + 1]), StandardCharsets.UTF_8));
			}
		}
		return parts.isEmpty() ? "" : "?" + String.join("&", parts);
	}

	/** Every item of a paginated listing; a repeated token ends the listing. */
	private static List<Map<String, Object>> paged(Function<String, Object> page, String items) {
		List<Map<String, Object>> found = new ArrayList<>();
		Set<String> seen = new HashSet<>();
		String token = null;
		for (;;) {
			Object response = page.apply(token);
			Map<String, Object> body = response == null ? Map.of() : map(response);
			items(body.get(items)).forEach(item -> found.add(map(item)));
			String following = body.get("pagination") == null ? null : (String) map(body.get("pagination")).get("next");
			if (following == null || following.isEmpty() || !seen.add(following)) {
				return found;
			}
			token = following;
		}
	}

	/** Polls every second until done holds, for at most limit seconds; a limit of 0 skips the wait (API mock). */
	private static void poll(BooleanSupplier done, String what, double limit) {
		if (limit <= 0) {
			return;
		}
		long deadline = System.currentTimeMillis() + (long) (limit * 1000);
		while (!done.getAsBoolean()) {
			if (System.currentTimeMillis() > deadline) {
				throw new IllegalStateException(what + " after " + limit + " s");
			}
			pause(1000);
		}
	}

	public static void requireCollection(Client client, Map<String, Object> args) {
		if (!hasCollection(client, args)) {
			throw new IllegalArgumentException("index " + args.get("name") + " does not exist");
		}
	}

	/** configure_index: tags (replace_tags clears the tags not given, which Pinecone removes when set to "") and deletion protection. */
	public static void configureCollection(Client client, Map<String, Object> args) {
		String name = (String) args.get("name");
		Map<String, Object> body = new LinkedHashMap<>();
		if (args.get("tags") != null) {
			Map<String, Object> tags = new LinkedHashMap<>();
			if (Boolean.TRUE.equals(args.get("replace_tags"))) {
				Object current = describeIndex(client, name).get("tags");
				for (String key : current == null ? Set.<String>of() : map(current).keySet()) {
					if (!map(args.get("tags")).containsKey(key)) {
						tags.put(key, "");
					}
				}
			}
			tags.putAll(map(args.get("tags")));
			body.put("tags", tags);
		}
		if (args.get("deletion_protection") != null) {
			body.put("deletion_protection", args.get("deletion_protection"));
		}
		send(client, "PATCH", control(client) + "/indexes/" + segment(name), body);
		poll(() -> ready(client, name), "index " + name + " is not ready", indexTimeout());
	}

	public static boolean hasNamespace(Client client, Map<String, Object> args) {
		try {
			data(client, (String) args.get("name"), "GET", "/namespaces/" + segment((String) args.get("namespace")), null);
			return true;
		} catch (PineconeException e) {
			if (e.status == 404) {
				return false;
			}
			throw e;
		}
	}

	public static void createNamespace(Client client, Map<String, Object> args) {
		data(client, (String) args.get("name"), "POST", "/namespaces", args("name", args.get("namespace")));
	}

	/** Deletes a namespace with its documents and waits until it is gone. */
	public static void dropNamespace(Client client, Map<String, Object> args) {
		data(client, (String) args.get("name"), "DELETE", "/namespaces/" + segment((String) args.get("namespace")), null);
		poll(() -> !hasNamespace(client, args), "namespace " + args.get("namespace") + " of " + args.get("name") + " still exists", indexTimeout());
	}

	/** A hosted embedding or reranking model (GET /models/{model}); unknown models fail with 404. */
	public static void requireModel(Client client, Map<String, Object> args) {
		send(client, "GET", control(client) + "/models/" + segment((String) args.get("model")), null);
	}

	private static List<Map<String, Object>> schedules(Client client, String name) {
		return paged(token -> send(client, "GET", control(client) + "/indexes/" + segment(name) + "/backup-schedules"
				+ query("paginationToken", token), null), "data");
	}

	public static boolean hasBackupSchedule(Client client, Map<String, Object> args) {
		return schedules(client, (String) args.get("name")).stream().anyMatch(item -> args.get("schedule").equals(item.get("name")));
	}

	public static void createBackupSchedule(Client client, Map<String, Object> args) {
		send(client, "POST", control(client) + "/indexes/" + segment((String) args.get("name")) + "/backup-schedules",
				args("name", args.get("schedule"), "schedule", args("type", "time-based", "frequency", args.get("frequency")),
						"retention", args("expire_after_days", whole(args, "expire_after_days", 1))));
	}

	public static void dropBackupSchedule(Client client, Map<String, Object> args) {
		List<Map<String, Object>> found = schedules(client, (String) args.get("name")).stream()
				.filter(item -> args.get("schedule").equals(item.get("name"))).toList();
		if (found.isEmpty()) {
			throw new IllegalArgumentException("backup schedule " + args.get("schedule") + " of " + args.get("name") + " does not exist");
		}
		for (Map<String, Object> item : found) {
			send(client, "DELETE", control(client) + "/backup-schedules/" + segment((String) item.get("schedule_id")), null);
		}
	}

	// ---------------------------------------------------------------- writes

	private static void check(Map<String, Object> layout, Map<String, Object> record) {
		Map<String, Object> limits = layout.get("limits") == null ? Map.of() : map(layout.get("limits"));
		for (Map.Entry<String, Object> entry : limits.entrySet()) {
			Object item = record.get(entry.getKey());
			if (item == null) {
				continue;
			}
			Map<String, Object> limit = map(entry.getValue());
			String field = entry.getKey();
			if (limit.containsKey("dim") && items(item).size() != (int) number(limit.get("dim"))) {
				throw new IllegalArgumentException(field + " has " + items(item).size() + " dimensions; " + layout.get("name")
						+ " declares " + (int) number(limit.get("dim")));
			}
			if (limit.containsKey("max_items") && items(item).size() > (int) number(limit.get("max_items"))) {
				throw new IllegalArgumentException(field + " has " + items(item).size() + " items; at most "
						+ (int) number(limit.get("max_items")) + " are allowed");
			}
			if (limit.containsKey("max_length")) {
				for (Object text : item instanceof Collection<?> ? items(item) : List.of(item)) {
					if (text instanceof String string && string.length() > (int) number(limit.get("max_length"))) {
						throw new IllegalArgumentException(field + " is longer than " + (int) number(limit.get("max_length")) + " characters");
					}
				}
			}
		}
	}

	/** Document fields of a record; Pinecone stores no nulls, so absent and null are the same. */
	private static Map<String, Object> fields(Map<String, Object> layout, Map<String, Object> record) {
		check(layout, record);
		Map<String, Object> result = new LinkedHashMap<>();
		record.forEach((name, item) -> {
			if (item != null) {
				result.put(name, item);
			}
		});
		return result;
	}

	private static Map<String, Object> document(Map<String, Object> layout, Map<String, Object> row) {
		Map<String, Object> record = new LinkedHashMap<>(layout.get("defaults") == null ? Map.of() : map(layout.get("defaults")));
		record.putAll(row);
		Object key = record.get((String) layout.get("key"));
		if (key == null) {
			throw new IllegalArgumentException("record without primary key " + layout.get("key") + ": " + row);
		}
		Map<String, Object> result = new LinkedHashMap<>();
		result.put("_id", documentId(key));
		result.putAll(fields(layout, record));
		return result;
	}

	private static Long latest(List<Long> positions) {
		return positions.stream().filter(item -> item != null).max(Long::compare).orElse(null);
	}

	/**
	 * Waits until searches see a write (the index's reconciled log position reaches the write's) and then until
	 * filtered fetches see it too.
	 */
	private static void awaitWrite(Client client, Map<String, Object> layout, Long target, List<Map<String, Object>> written,
			List<String> deleted) {
		long deadline = System.currentTimeMillis() + (long) (seconds("VECDSL_PINECONE_WAIT_SECONDS", 60) * 1000);
		if (target != null) {
			awaitPosition(client, layout, target, deadline);
		}
		settle(client, layout, written, deleted, deadline);
	}

	private static void awaitPosition(Client client, Map<String, Object> layout, long target, long deadline) {
		Map<String, Object> probe = map(layout.get("probe"));
		Map<String, Object> clause = args("type", probe.get("type"), "field", probe.get("field"));
		if ("dense_vector".equals(probe.get("type"))) {
			List<Double> values = new ArrayList<>();
			for (int i = 0; i < (int) number(probe.get("dim")); i++) {
				values.add(i == 0 ? 1.0 : 0.0);
			}
			clause.put("values", values);
		} else {
			clause.put("query", "vecdsl");
		}
		for (;;) {
			documents(client, layout, "search", args("score_by", List.of(clause), "top_k", 1));
			if (client.reconciled != null && client.reconciled >= target) {
				return;
			}
			if (System.currentTimeMillis() > deadline) {
				throw new IllegalStateException(layout.get("name") + " did not reach log position " + target);
			}
			pause(500);
		}
	}

	/** Names of the fields an index declares (vectors and full-text text); every other field is metadata. */
	private static Set<String> schemaFields(Client client, String name) {
		return client.schemas.computeIfAbsent(name, key -> {
			Object schema = describeIndex(client, key).get("schema");
			Object fields = schema == null ? null : map(schema).get("fields");
			return fields == null ? Set.of() : new HashSet<>(map(fields).keySet());
		});
	}

	/** A filter that matches a written document only once filtering sees its metadata as written. */
	private static Map<String, Object> condition(Map<String, Object> layout, Set<String> declared, Map<String, Object> document) {
		String key = (String) layout.get("key");
		List<Object> parts = new ArrayList<>();
		parts.add(args(key, args("$eq", keyOf(layout, (String) document.get("_id")))));
		document.forEach((name, value) -> {
			if (!name.startsWith("_") && !name.equals(key) && !declared.contains(name)
					&& (value instanceof Boolean || value instanceof Number || value instanceof String)) {
				parts.add(args(name, args("$eq", value)));
			}
		});
		for (Object name : items(document.get("_remove_fields"))) {
			if (!declared.contains(name)) {
				parts.add(args((String) name, args("$exists", false)));
			}
		}
		return parts.size() == 1 ? map(parts.get(0)) : args("$and", parts);
	}

	/**
	 * Filtered fetches see writes seconds after searches and report no log position, so the written documents are
	 * fetched by filter until all match as written and none of the deleted ones is found.
	 */
	private static void settle(Client client, Map<String, Object> layout, List<Map<String, Object>> written, List<String> deleted,
			long deadline) {
		if (written.isEmpty() && deleted.isEmpty()) {
			return;
		}
		Set<String> declared = schemaFields(client, (String) layout.get("name"));
		Map<String, Map<String, Object>> latestById = new LinkedHashMap<>();
		written.forEach(document -> latestById.put((String) document.get("_id"), document));
		List<Map.Entry<Map<String, Object>, Integer>> checks = new ArrayList<>();
		for (List<Map<String, Object>> chunk : chunks(new ArrayList<>(latestById.values()), SETTLE)) {
			List<Object> conditions = new ArrayList<>();
			chunk.forEach(document -> conditions.add(condition(layout, declared, document)));
			checks.add(Map.entry(conditions.size() == 1 ? map(conditions.get(0)) : args("$or", conditions), chunk.size()));
		}
		for (List<String> chunk : chunks(new ArrayList<>(new LinkedHashSet<>(deleted)), SETTLE)) {
			List<Object> keys = new ArrayList<>();
			chunk.forEach(id -> keys.add(keyOf(layout, id)));
			checks.add(Map.entry(args((String) layout.get("key"), args("$in", keys)), 0));
		}
		for (;;) {
			checks.removeIf(check -> matching(client, layout, check.getKey()).size() == check.getValue());
			if (checks.isEmpty()) {
				return;
			}
			if (System.currentTimeMillis() > deadline) {
				throw new IllegalStateException("filtered reads of " + layout.get("name") + " do not see the last write yet");
			}
			pause(500);
		}
	}

	private static Set<String> existing(Client client, Map<String, Object> layout, List<String> ids) {
		Set<String> found = new HashSet<>();
		for (List<String> chunk : chunks(ids, PAGE)) {
			found.addAll(map(documents(client, layout, "fetch", args("ids", chunk, "include_fields", List.of(layout.get("key"))))
					.get("documents")).keySet());
		}
		return found;
	}

	/** Ids of every document that matches a filter, through paginated fetches. */
	private static List<String> matching(Client client, Map<String, Object> layout, Object filter) {
		Set<String> found = new LinkedHashSet<>();
		String token = null;
		for (;;) {
			Map<String, Object> body = args("filter", filter, "include_fields", List.of(layout.get("key")), "limit", PAGE);
			if (token != null) {
				body.put("pagination_token", token);
			}
			Map<String, Object> response = documents(client, layout, "fetch", body);
			found.addAll(map(response.get("documents")).keySet());
			String following = response.get("pagination") == null ? null : (String) map(response.get("pagination")).get("next");
			if (following == null || following.isEmpty() || following.equals(token)) {
				return new ArrayList<>(found);
			}
			token = following;
		}
	}

	private static List<String> allIds(Client client, Map<String, Object> layout) {
		List<String> found = new ArrayList<>();
		Set<String> seen = new HashSet<>();
		String token = null;
		for (;;) {
			Map<String, Object> body = args("limit", LIST_PAGE);
			if (token != null) {
				body.put("pagination_token", token);
			}
			Map<String, Object> response = documents(client, layout, "list", body);
			for (Object item : items(response.get("documents"))) {
				found.add((String) map(item).get("_id"));
			}
			token = response.get("pagination") == null ? null : (String) map(response.get("pagination")).get("next");
			if (token == null || token.isEmpty() || !seen.add(token)) {
				return found;
			}
		}
	}

	private static List<String> targets(Client client, Map<String, Object> layout, Object ids, Object filter) {
		if (ids != null && !items(ids).isEmpty()) {
			List<String> wanted = new ArrayList<>(new LinkedHashSet<>(items(ids).stream().map(PineconeRuntime::documentId).toList()));
			Set<String> present = existing(client, layout, wanted);
			List<String> selected = new ArrayList<>(wanted.stream().filter(present::contains).toList());
			if (filter != null) {
				Set<String> matched = new HashSet<>(matching(client, layout, filter));
				selected.removeIf(id -> !matched.contains(id));
			}
			return selected;
		}
		if (filter != null) {
			return matching(client, layout, filter);
		}
		throw new IllegalArgumentException("the statement selects no records");
	}

	private static Long upsert(Client client, Map<String, Object> layout, List<Map<String, Object>> documents, int batchSize) {
		List<Long> positions = new ArrayList<>();
		for (List<Map<String, Object>> chunk : chunks(documents, batch(layout, batchSize))) {
			documents(client, layout, "upsert", args("documents", chunk));
			positions.add(client.committed);
		}
		return latest(positions);
	}

	public static Map<String, Object> insertRows(Client client, Map<String, Object> args) {
		Map<String, Object> layout = map(args.get("collection"));
		List<Map<String, Object>> documents = items(args.get("rows")).stream().map(row -> document(layout, map(row))).toList();
		Set<String> present = existing(client, layout, documents.stream().map(document -> (String) document.get("_id")).toList());
		if (!present.isEmpty() && "error".equals(args.getOrDefault("on_conflict", "error"))) {
			throw new IllegalArgumentException(present.size() + " records already exist in " + layout.get("name"));
		}
		List<Map<String, Object>> fresh = documents.stream().filter(document -> !present.contains(document.get("_id"))).toList();
		Long committed = upsert(client, layout, fresh, whole(args, "batch_size", BATCH));
		if (Boolean.TRUE.equals(args.get("wait"))) {
			awaitWrite(client, layout, committed, fresh, List.of());
		}
		return args("insert_count", (long) fresh.size(), "skipped", (long) (documents.size() - fresh.size()));
	}

	public static Map<String, Object> upsertRows(Client client, Map<String, Object> args) {
		Map<String, Object> layout = map(args.get("collection"));
		List<Map<String, Object>> documents = items(args.get("rows")).stream().map(row -> document(layout, map(row))).toList();
		Long committed = upsert(client, layout, documents, whole(args, "batch_size", BATCH));
		if (Boolean.TRUE.equals(args.get("wait"))) {
			awaitWrite(client, layout, committed, documents, List.of());
		}
		return args("upsert_count", (long) documents.size());
	}

	public static Map<String, Object> updateRows(Client client, Map<String, Object> args) {
		Map<String, Object> layout = map(args.get("collection"));
		String key = (String) layout.get("key");
		Map<String, Map<String, Object>> replacements = new LinkedHashMap<>();
		for (Object row : items(args.get("rows"))) {
			replacements.put(documentId(map(row).get(key)), map(row));
		}
		List<String> selected;
		if (!items(args.get("ids")).isEmpty() || args.get("filter") != null) {
			selected = targets(client, layout, args.get("ids"), args.get("filter"));
		} else if (!replacements.isEmpty()) {
			Set<String> present = existing(client, layout, new ArrayList<>(replacements.keySet()));
			selected = replacements.keySet().stream().filter(present::contains).toList();
		} else {
			throw new IllegalArgumentException("update requires ids, a filter or records");
		}
		boolean replace = "replace".equals(args.get("mode"));
		List<String> append = strings(args.get("append"));
		List<String> arrays = new ArrayList<>(append);
		arrays.addAll(strings(args.get("remove_items")));
		Map<String, Map<String, Object>> stored = arrays.isEmpty() ? Map.of() : fetch(client, layout, selected, arrays);
		List<Map<String, Object>> patches = new ArrayList<>();
		for (String id : selected) {
			Map<String, Object> record = new LinkedHashMap<>(replacements.getOrDefault(id, Map.of()));
			if (args.get("values") != null) {
				record.putAll(map(args.get("values")));
			}
			List<String> dropped = new ArrayList<>(strings(args.get("remove")));
			for (String name : arrays) {
				List<Object> current = items(stored.getOrDefault(id, Map.of()).get(name));
				List<Object> given = items(record.get(name));
				List<Object> merged = new ArrayList<>(current);
				if (append.contains(name)) {
					merged.addAll(given);
				} else {
					merged.removeIf(given::contains);
				}
				if (merged.isEmpty()) {
					record.remove(name);
					dropped.add(name);
				} else {
					record.put(name, merged);
				}
			}
			Object given = record.get(key);
			if (given != null && !documentId(given).equals(id)) {
				throw new IllegalArgumentException("update cannot change the primary key " + key);
			}
			record.put(key, keyOf(layout, id));
			if (replace) {
				patches.add(document(layout, record));
				continue;
			}
			Map<String, Object> patch = new LinkedHashMap<>();
			patch.put("_id", id);
			patch.putAll(fields(layout, record));
			if (!dropped.isEmpty()) {
				patch.put("_remove_fields", new ArrayList<>(new LinkedHashSet<>(dropped)));
			}
			patches.add(patch);
		}
		List<Long> positions = new ArrayList<>();
		for (List<Map<String, Object>> chunk : chunks(patches, batch(layout, PAGE))) {
			documents(client, layout, replace ? "upsert" : "update", args("documents", chunk));
			positions.add(client.committed);
		}
		if (Boolean.TRUE.equals(args.get("wait"))) {
			awaitWrite(client, layout, latest(positions), patches, List.of());
		}
		return args("update_count", (long) selected.size());
	}

	public static Map<String, Object> deleteRows(Client client, Map<String, Object> args) {
		Map<String, Object> layout = map(args.get("collection"));
		List<String> selected;
		List<Long> positions = new ArrayList<>();
		if (args.get("limit") != null) {
			boolean everything = Boolean.TRUE.equals(args.get("delete_all")) && args.get("filter") == null && items(args.get("ids")).isEmpty();
			List<String> all = new ArrayList<>(everything ? allIds(client, layout) : targets(client, layout, args.get("ids"), args.get("filter")));
			sortIds(layout, all);
			selected = all.subList(0, Math.min(all.size(), whole(args, "limit", 0)));
			for (List<String> chunk : chunks(selected, PAGE)) {
				documents(client, layout, "delete", args("ids", chunk));
				positions.add(client.committed);
			}
		} else if (Boolean.TRUE.equals(args.get("delete_all"))) {
			selected = allIds(client, layout);
			if (!selected.isEmpty()) {
				documents(client, layout, "delete", args("delete_all", true));
				positions.add(client.committed);
			}
		} else {
			selected = targets(client, layout, args.get("ids"), args.get("filter"));
			for (List<String> chunk : chunks(selected, PAGE)) {
				documents(client, layout, "delete", args("ids", chunk));
				positions.add(client.committed);
			}
		}
		if (Boolean.TRUE.equals(args.get("wait"))) {
			awaitWrite(client, layout, latest(positions), List.of(), selected);
		}
		return args("delete_count", (long) selected.size());
	}

	/** Moves a metadata value to a new key in every document that has it: Pinecone renames no metadata keys. */
	public static Map<String, Object> renameField(Client client, Map<String, Object> args) {
		Map<String, Object> layout = map(args.get("collection"));
		String field = (String) args.get("field");
		List<String> selected = matching(client, layout, args(field, args("$exists", true)));
		Map<String, Map<String, Object>> stored = fetch(client, layout, selected, List.of(field));
		List<Map<String, Object>> patches = new ArrayList<>();
		for (String id : selected) {
			if (stored.containsKey(id) && stored.get(id).get(field) != null) {
				patches.add(args("_id", id, (String) args.get("new_name"), stored.get(id).get(field), "_remove_fields", List.of(field)));
			}
		}
		List<Long> positions = new ArrayList<>();
		for (List<Map<String, Object>> chunk : chunks(patches, batch(layout, PAGE))) {
			documents(client, layout, "update", args("documents", chunk));
			positions.add(client.committed);
		}
		if (Boolean.TRUE.equals(args.get("wait"))) {
			awaitWrite(client, layout, latest(positions), patches, List.of());
		}
		return args("update_count", (long) patches.size());
	}

	/** Records of a local JSON array or JSON Lines file (file:// URI or path). */
	public static List<Map<String, Object>> readRecords(Client client, Map<String, Object> args) {
		String location = (String) args.get("location");
		String text;
		try {
			text = Files.readString(Path.of(location.startsWith("file://") ? location.substring("file://".length()) : location), StandardCharsets.UTF_8);
		} catch (IOException e) {
			throw new UncheckedIOException(e);
		}
		if (text.stripLeading().startsWith("[")) {
			return items(GSON.fromJson(text, Object.class)).stream().map(PineconeRuntime::map).toList();
		}
		return text.lines().filter(line -> !line.isBlank()).map(line -> map(GSON.fromJson(line, Object.class))).toList();
	}

	/** A local file written as an insert (on-conflict error, ignore) or an upsert (update, replace). */
	public static Map<String, Object> importFile(Client client, Map<String, Object> args) {
		Map<String, Object> write = args("collection", args.get("collection"), "rows", readRecords(client, args("location", args.get("location"))));
		if (args.get("batch_size") != null) {
			write.put("batch_size", args.get("batch_size"));
		}
		if (args.get("wait") != null) {
			write.put("wait", args.get("wait"));
		}
		Object conflict = args.get("on_conflict");
		if ("update".equals(conflict) || "replace".equals(conflict)) {
			return upsertRows(client, write);
		}
		write.put("on_conflict", conflict == null ? "error" : conflict);
		return insertRows(client, write);
	}

	/** Bulk import of JSON Lines documents from object storage (paid plans); unless in the background, waits until it ends. */
	public static Map<String, Object> startImport(Client client, Map<String, Object> args) {
		String name = (String) map(args.get("collection")).get("name");
		String job = (String) map(data(client, name, "POST", "/bulk/imports", args("uri", args.get("uri"), "errorMode", args("onError", "abort")))).get("id");
		Function<String, Map<String, Object>> status = ignored -> map(data(client, name, "GET", "/bulk/imports/" + segment(job), null));
		if (!Boolean.TRUE.equals(args.get("background"))) {
			poll(() -> List.of("Completed", "Failed", "Cancelled").contains(status.apply(job).get("status")), "import " + job + " has not finished",
					seconds("VECDSL_PINECONE_IMPORT_TIMEOUT", 3600));
		}
		Map<String, Object> last = status.apply(job);
		if ("Failed".equals(last.get("status")) || "Cancelled".equals(last.get("status"))) {
			throw new IllegalStateException("import " + job + " ended " + last.get("status") + ": " + last.get("error"));
		}
		return args("import", job, "status", last.get("status"), "records", last.get("recordsImported") == null ? null : value(last.get("recordsImported")));
	}

	// ---------------------------------------------------------------- reads

	private static List<String> included(Map<String, Object> layout, Object output, Object vectors) {
		Set<String> names = new LinkedHashSet<>();
		names.add((String) layout.get("key"));
		names.addAll(strings(output));
		names.addAll(strings(vectors));
		return new ArrayList<>(names);
	}

	private static Map<String, Object> row(Map<String, Object> layout, String id, Map<String, Object> document, Object output,
			Object vectors) {
		Map<String, Object> row = new LinkedHashMap<>();
		row.put((String) layout.get("key"), keyOf(layout, id));
		for (String name : strings(output)) {
			row.put(name, value(document.get(name)));
		}
		for (String name : strings(vectors)) {
			row.put(name, value(document.get(name)));
		}
		return row;
	}

	private static Map<String, Map<String, Object>> fetch(Client client, Map<String, Object> layout, List<String> ids, List<String> names) {
		Map<String, Map<String, Object>> found = new HashMap<>();
		for (List<String> chunk : chunks(ids, PAGE)) {
			map(documents(client, layout, "fetch", args("ids", chunk, "include_fields", names)).get("documents"))
					.forEach((id, document) -> found.put(id, map(document)));
		}
		return found;
	}

	public static List<Map<String, Object>> getRows(Client client, Map<String, Object> args) {
		Map<String, Object> layout = map(args.get("collection"));
		List<String> ids = new ArrayList<>(new LinkedHashSet<>(items(args.get("ids")).stream().map(PineconeRuntime::documentId).toList()));
		Map<String, Map<String, Object>> found = fetch(client, layout, ids, included(layout, args.get("output"), args.get("vectors")));
		return ids.stream().filter(found::containsKey).map(id -> row(layout, id, found.get(id), args.get("output"), args.get("vectors"))).toList();
	}

	public static long count(Client client, Map<String, Object> args) {
		Map<String, Object> layout = map(args.get("collection"));
		return args.get("filter") == null ? allIds(client, layout).size() : matching(client, layout, args.get("filter")).size();
	}

	@SuppressWarnings({ "unchecked", "rawtypes" })
	private static int compareValues(Object a, Object b) {
		if (a instanceof Number x && b instanceof Number y) {
			return Double.compare(x.doubleValue(), y.doubleValue());
		}
		if (a instanceof Comparable x && a.getClass().equals(b.getClass())) {
			return x.compareTo(b);
		}
		return String.valueOf(a).compareTo(String.valueOf(b));
	}

	/** Stable sorts from the last sort key to the first; documents without a value come last for every key. */
	private static List<String> sortedBy(List<String> ids, Map<String, Map<String, Object>> stored, List<Object> order) {
		List<String> result = ids;
		List<Object> clauses = new ArrayList<>(order);
		Collections.reverse(clauses);
		for (Object item : clauses) {
			Map<String, Object> clause = map(item);
			String key = (String) clause.get("key");
			int sign = "desc".equals(clause.get("direction")) ? -1 : 1;
			List<String> present = new ArrayList<>(result.stream().filter(id -> stored.getOrDefault(id, Map.of()).get(key) != null).toList());
			present.sort((a, b) -> sign * compareValues(stored.get(a).get(key), stored.get(b).get(key)));
			List<String> merged = new ArrayList<>(present);
			merged.addAll(result.stream().filter(id -> stored.getOrDefault(id, Map.of()).get(key) == null).toList());
			result = merged;
		}
		return result;
	}

	/** Records in primary-key order, or by the sort keys and then the key; Pinecone lists ids only, so the runtime sorts. */
	public static List<Map<String, Object>> scroll(Client client, Map<String, Object> args) {
		Map<String, Object> layout = map(args.get("collection"));
		List<String> all = new ArrayList<>(args.get("filter") == null ? allIds(client, layout) : matching(client, layout, args.get("filter")));
		sortIds(layout, all);
		if (!items(args.get("order")).isEmpty()) {
			List<String> keys = items(args.get("order")).stream().map(clause -> (String) map(clause).get("key")).toList();
			all = sortedBy(all, fetch(client, layout, all, keys), items(args.get("order")));
		}
		int offset = Math.min(all.size(), whole(args, "offset", 0));
		List<String> ids = all.subList(offset, all.size());
		if (args.get("limit") != null) {
			ids = ids.subList(0, Math.min(ids.size(), whole(args, "limit", 0)));
		}
		Map<String, Map<String, Object>> found = fetch(client, layout, ids, included(layout, args.get("output"), args.get("vectors")));
		return ids.stream().filter(found::containsKey).map(id -> row(layout, id, found.get(id), args.get("output"), args.get("vectors"))).toList();
	}

	/** Canonical similarity of a Pinecone score; euclidean scores are squared distances. */
	private static double similarity(Object metric, double score) {
		return "euclidean".equals(metric) ? -Math.sqrt(Math.max(score, 0)) : score;
	}

	private static List<Map<String, Object>> search(Client client, Map<String, Object> layout, Map<String, Object> clause, int topK,
			List<String> names, Object filter) {
		Map<String, Object> body = args("score_by", List.of(clause), "top_k", topK, "include_fields", names);
		if (filter != null) {
			body.put("filter", filter);
		}
		return items(documents(client, layout, "search", body).get("matches")).stream().map(PineconeRuntime::map).toList();
	}

	private static Map<String, Object> hit(Map<String, Object> layout, Map<String, Object> match, double score, Object output, Object vectors) {
		Map<String, Object> row = row(layout, (String) match.get("_id"), match, output, vectors);
		Map<String, Object> result = new LinkedHashMap<>();
		result.put("id", row.remove((String) layout.get("key")));
		result.put("score", value(score));
		result.putAll(row);
		return result;
	}

	private static boolean within(double score, Double min, Double max) {
		return (min == null || score >= min) && (max == null || score <= max);
	}

	private static <T> List<T> page(List<T> hits, int limit, int offset) {
		return hits.subList(Math.min(hits.size(), offset), Math.min(hits.size(), offset + limit));
	}

	private static List<Double> vector(Object value) {
		return items(value).stream().map(PineconeRuntime::number).toList();
	}

	/** A stored or literal vector as Pinecone takes it: dense values, or the indices and values of a sparse vector. */
	private static Object vectorOf(Object value) {
		if (value instanceof Map<?, ?> sparse) {
			return args("indices", items(sparse.get("indices")).stream().map(index -> ((Number) index).longValue()).toList(), "values",
					vector(sparse.get("values")));
		}
		return vector(value);
	}

	/**
	 * The scoring clause of a vector search: dense_vector, sparse_vector, or embed and sparse_embed with the query text
	 * of a field Pinecone embeds.
	 */
	private static Map<String, Object> vectorClause(Object field, Object vector, Object embed) {
		if (embed != null) {
			return args("type", embed, "field", field, "query", vector);
		}
		Object values = vectorOf(vector);
		return values instanceof Map<?, ?> ? args("type", "sparse_vector", "field", field, "sparse_values", values)
				: args("type", "dense_vector", "field", field, "values", values);
	}

	/** The fields a search returns, with the rank field of a rerank clause. */
	private static List<String> ranked(List<String> names, Object rerank) {
		if (rerank == null) {
			return names;
		}
		Set<String> result = new LinkedHashSet<>(names);
		result.add((String) map(rerank).get("field"));
		return new ArrayList<>(result);
	}

	private record Hit(Map<String, Object> match, Map<String, Object> hit) {
	}

	/**
	 * Hits in the order of Pinecone Inference rerank: the rank field of each hit scored against the query text; a hit's
	 * score becomes the reranker's relevance.
	 */
	private static List<Map<String, Object>> reranked(Client client, Object rerank, List<Hit> scored) {
		if (rerank == null || scored.isEmpty()) {
			return scored.stream().map(Hit::hit).toList();
		}
		Map<String, Object> clause = map(rerank);
		String field = (String) clause.get("field");
		List<Map<String, Object>> documents = scored.stream().map(entry -> args("id", entry.match().get("_id"), field,
				entry.match().get(field) == null ? "" : String.valueOf(entry.match().get(field)))).toList();
		Map<String, Object> body = args("model", clause.get("model"), "query", clause.get("query"), "rank_fields", List.of(field),
				"return_documents", false, "documents", documents);
		if (clause.get("top_n") != null) {
			body.put("top_n", Math.min(whole(clause, "top_n", 0), scored.size()));
		}
		if (clause.get("parameters") != null) {
			body.put("parameters", clause.get("parameters"));
		}
		List<Map<String, Object>> result = new ArrayList<>();
		for (Object item : items(map(send(client, "POST", control(client) + "/rerank", body)).get("data"))) {
			Map<String, Object> hit = new LinkedHashMap<>(scored.get(whole(map(item), "index", 0)).hit());
			hit.put("score", value(number(map(item).get("score"))));
			result.add(hit);
		}
		return result;
	}

	public static List<Map<String, Object>> vectorSearch(Client client, Map<String, Object> args) {
		Map<String, Object> layout = map(args.get("collection"));
		int limit = whole(args, "limit", 10);
		int offset = whole(args, "offset", 0);
		Map<String, Object> clause = vectorClause(args.get("field"), args.get("vector"), args.get("embed"));
		boolean nativeScore = Boolean.TRUE.equals(args.get("native"));
		List<Hit> scored = new ArrayList<>();
		for (Map<String, Object> match : search(client, layout, clause, limit + offset,
				ranked(included(layout, args.get("output"), args.get("vectors")), args.get("rerank")), args.get("filter"))) {
			double raw = number(match.get("_score"));
			double score = nativeScore ? raw : similarity(args.get("metric"), raw);
			if (within(score, optionalNumber(args, "score_min"), optionalNumber(args, "score_max"))) {
				scored.add(new Hit(match, hit(layout, match, score, args.get("output"), args.get("vectors"))));
			}
		}
		return page(reranked(client, args.get("rerank"), scored), limit, offset);
	}

	/**
	 * The terms of a query text, lowercased: runs of letters and decimal digits; every other character separates terms, since
	 * Pinecone's query_string syntax documents no escape character.
	 */
	private static List<String> terms(String text) {
		List<String> result = new ArrayList<>();
		StringBuilder current = new StringBuilder();
		text.toLowerCase(Locale.ROOT).codePoints().forEach(point -> {
			if (Character.isLetter(point) || Character.isDigit(point)) {
				current.appendCodePoint(point);
			} else if (current.length() > 0) {
				result.add(current.toString());
				current.setLength(0);
			}
		});
		if (current.length() > 0) {
			result.add(current.toString());
		}
		return result;
	}

	/**
	 * The Pinecone query_string of a rewritten text query: one clause per field, joined by OR, a boosted field as
	 * (field:(...))^w; phrase "..."~slop, phrase prefix "..."*, terms with a fuzzy suffix, a required + per term, a regular
	 * expression /pattern/, or the query_string text itself. The words and, or and not are quoted, not read as operators.
	 */
	public static String queryStringText(String query, List<String> fields, Map<String, Object> rewrite) {
		String kind = (String) rewrite.get("type");
		String body;
		if (kind.equals("regexp")) {
			if (query.contains("/")) {
				throw new IllegalArgumentException("the regular expression \"" + query + "\" contains '/', which Pinecone query_string cannot escape");
			}
			body = "/" + query + "/";
		} else if (kind.equals("query_string")) {
			body = "(" + query + ")";
		} else {
			List<String> words = terms(query);
			if (words.isEmpty()) {
				throw new IllegalArgumentException("the query \"" + query + "\" has no terms");
			}
			if (kind.equals("phrase") || kind.equals("phrase_prefix")) {
				if (kind.equals("phrase_prefix") && words.size() < 2) {
					throw new IllegalArgumentException("a phrase prefix needs at least two terms on Pinecone: \"" + query + "\"");
				}
				String suffix = kind.equals("phrase_prefix") ? "*" : "";
				if (rewrite.get("slop") != null) {
					suffix += "~" + whole(rewrite, "slop", 0);
				}
				body = "(\"" + String.join(" ", words) + "\"" + suffix + ")";
			} else {
				String sign = Boolean.TRUE.equals(rewrite.get("required")) ? "+" : "";
				String fuzzy = rewrite.get("fuzzy") == null ? "" : (String) rewrite.get("fuzzy");
				body = "(" + String.join(" ", words.stream().map(word -> sign + (OPERATORS.contains(word) ? "\"" + word + "\"" : word + fuzzy)).toList()) + ")";
			}
		}
		Map<String, Object> boosts = rewrite.get("boosts") == null ? Map.of() : map(rewrite.get("boosts"));
		List<String> clauses = new ArrayList<>();
		for (String field : fields) {
			clauses.add(boosts.containsKey(field) ? "(" + field + ":" + body + ")^" + boosts.get(field) : field + ":" + body);
		}
		return String.join(" OR ", clauses);
	}

	private static Map<String, Object> textClause(Object query, Object fields, boolean queryString, Object rewrite) {
		if (rewrite != null) {
			return args("type", "query_string", "query", queryStringText((String) query, strings(fields), map(rewrite)));
		}
		return queryString ? args("type", "query_string", "query", query) : args("type", "text", "fields", strings(fields), "query", query);
	}

	public static List<Map<String, Object>> keywordSearch(Client client, Map<String, Object> args) {
		Map<String, Object> layout = map(args.get("collection"));
		int limit = whole(args, "limit", 10);
		int offset = whole(args, "offset", 0);
		Map<String, Object> clause = textClause(args.get("query"), args.get("fields"), Boolean.TRUE.equals(args.get("query_string")), args.get("rewrite"));
		List<Hit> scored = new ArrayList<>();
		for (Map<String, Object> match : search(client, layout, clause, limit + offset,
				ranked(included(layout, args.get("output"), args.get("vectors")), args.get("rerank")), args.get("filter"))) {
			double score = number(match.get("_score"));
			if (within(score, optionalNumber(args, "score_min"), optionalNumber(args, "score_max"))) {
				scored.add(new Hit(match, hit(layout, match, score, args.get("output"), args.get("vectors"))));
			}
		}
		return page(reranked(client, args.get("rerank"), scored), limit, offset);
	}

	private record Scored(Map<String, Object> match, double score) {
	}

	private static List<Scored> legScores(Client client, Map<String, Object> layout, Map<String, Object> leg, int topK, List<String> names) {
		if ("vector".equals(leg.get("kind"))) {
			Map<String, Object> clause = vectorClause(leg.get("field"), leg.get("vector"), leg.get("embed"));
			return search(client, layout, clause, topK, names, leg.get("filter")).stream()
					.map(match -> new Scored(match, similarity(leg.get("metric"), number(match.get("_score")))))
					.filter(entry -> within(entry.score(), optionalNumber(leg, "score_min"), optionalNumber(leg, "score_max"))).toList();
		}
		Map<String, Object> clause = textClause(leg.get("query"), leg.get("fields"), Boolean.TRUE.equals(leg.get("query_string")), leg.get("rewrite"));
		return search(client, layout, clause, topK, names, leg.get("filter")).stream()
				.map(match -> new Scored(match, number(match.get("_score")))).toList();
	}

	/** Contribution of one leg: 1/(k + rank), weight * similarity, or weight * min-max normalized score. */
	private static Map<String, Double> fused(Object fusion, int k, double weight, List<Scored> ranked) {
		Map<String, Double> result = new LinkedHashMap<>();
		double low = ranked.stream().mapToDouble(Scored::score).min().orElse(0);
		double high = ranked.stream().mapToDouble(Scored::score).max().orElse(0);
		for (int rank = 0; rank < ranked.size(); rank++) {
			Scored entry = ranked.get(rank);
			double part;
			if ("rrf".equals(fusion)) {
				part = 1.0 / (k + rank + 1);
			} else if ("weighted".equals(fusion)) {
				part = weight * entry.score();
			} else {
				part = weight * (high > low ? (entry.score() - low) / (high - low) : 1.0);
			}
			result.put((String) entry.match().get("_id"), part);
		}
		return result;
	}

	/** Fuses the legs' searches in the runtime; a Pinecone search scores by one dense clause or text clauses. */
	public static List<Map<String, Object>> hybridSearch(Client client, Map<String, Object> args) {
		Map<String, Object> layout = map(args.get("collection"));
		int limit = whole(args, "limit", 10);
		int offset = whole(args, "offset", 0);
		List<String> names = ranked(included(layout, args.get("output"), args.get("vectors")), args.get("rerank"));
		Map<String, Double> totals = new LinkedHashMap<>();
		Map<String, Map<String, Object>> matched = new HashMap<>();
		for (Object item : items(args.get("legs"))) {
			Map<String, Object> leg = map(item);
			List<Scored> ranked = legScores(client, layout, leg, whole(leg, "limit", limit + offset), names);
			ranked.forEach(entry -> matched.putIfAbsent((String) entry.match().get("_id"), entry.match()));
			double weight = leg.get("weight") == null ? 1.0 : number(leg.get("weight"));
			fused(args.get("fusion"), whole(args, "k", 60), weight, ranked).forEach((id, part) -> totals.merge(id, part, Double::sum));
		}
		Comparator<String> order = idOrder(layout);
		List<String> ranking = new ArrayList<>(totals.keySet());
		ranking.sort((a, b) -> {
			int byScore = Double.compare(totals.get(b), totals.get(a));
			return byScore != 0 ? byScore : order.compare(a, b);
		});
		List<Hit> scored = ranking.stream()
				.filter(id -> within(totals.get(id), optionalNumber(args, "score_min"), optionalNumber(args, "score_max")))
				.map(id -> new Hit(matched.get(id), hit(layout, matched.get(id), totals.get(id), args.get("output"), args.get("vectors")))).toList();
		return page(reranked(client, args.get("rerank"), scored), limit, offset);
	}

	public static Object lookupVector(Client client, Map<String, Object> args) {
		Map<String, Object> layout = map(args.get("collection"));
		String id = documentId(args.get("id"));
		Map<String, Object> document = fetch(client, layout, List.of(id), List.of((String) args.get("field"))).get(id);
		if (document == null) {
			throw new IllegalArgumentException("record " + args.get("id") + " not found in " + layout.get("name"));
		}
		return vectorOf(document.get((String) args.get("field")));
	}

	/** A query text embedded by Pinecone Inference embed: dense values, or the indices and values of a sparse model. */
	public static Object embedQuery(Client client, Map<String, Object> args) {
		Map<String, Object> body = args("model", args.get("model"), "parameters", args.get("parameters"), "inputs", List.of(args("text", args.get("text"))));
		Map<String, Object> data = map(items(map(send(client, "POST", control(client) + "/embed", body)).get("data")).get(0));
		if ("sparse".equals(data.get("vector_type"))) {
			return vectorOf(args("indices", data.get("sparse_indices"), "values", data.get("sparse_values")));
		}
		return vector(data.get("values"));
	}

	/** Centroid of the positive examples, moved away from the centroid of the negatives: 2p - n. */
	public static Object recommendVector(Client client, Map<String, Object> args) {
		Map<String, Object> layout = map(args.get("collection"));
		String field = (String) args.get("field");
		List<Object> positives = items(args.get("positives"));
		List<Object> negatives = items(args.get("negatives"));
		List<String> keys = new ArrayList<>();
		for (Object item : concat(positives, negatives)) {
			if (!(item instanceof Collection<?>) && !(item instanceof Map<?, ?>)) {
				keys.add(documentId(item));
			}
		}
		Map<String, Map<String, Object>> found = keys.isEmpty() ? Map.of() : fetch(client, layout, keys, List.of(field));
		List<Object> positive = resolve(positives, found, field, layout);
		List<Object> negative = resolve(negatives, found, field, layout);
		if (positive.isEmpty()) {
			throw new IllegalArgumentException("recommend requires at least one positive example");
		}
		if (positive.get(0) instanceof Map<?, ?>) {
			return sparseCentroid(positive, negative);
		}
		return denseCentroid(positive.stream().map(PineconeRuntime::vector).toList(), negative.stream().map(PineconeRuntime::vector).toList());
	}

	private static List<Double> denseCentroid(List<List<Double>> positive, List<List<Double>> negative) {
		List<Double> centroid = mean(positive);
		if (negative.isEmpty()) {
			return centroid;
		}
		List<Double> anti = mean(negative);
		List<Double> result = new ArrayList<>();
		for (int i = 0; i < centroid.size(); i++) {
			result.add(2 * centroid.get(i) - anti.get(i));
		}
		return result;
	}

	private static List<Object> concat(List<Object> first, List<Object> second) {
		List<Object> result = new ArrayList<>(first);
		result.addAll(second);
		return result;
	}

	private static List<Object> resolve(List<Object> examples, Map<String, Map<String, Object>> found, String field,
			Map<String, Object> layout) {
		List<Object> result = new ArrayList<>();
		for (Object item : examples) {
			if (item instanceof Collection<?> || item instanceof Map<?, ?>) {
				result.add(vectorOf(item));
				continue;
			}
			Map<String, Object> document = found.get(documentId(item));
			if (document == null) {
				throw new IllegalArgumentException("record " + item + " not found in " + layout.get("name"));
			}
			result.add(vectorOf(document.get(field)));
		}
		return result;
	}

	private static Map<Long, Double> sparseMean(List<Object> vectors) {
		Map<Long, Double> total = new LinkedHashMap<>();
		for (Object vector : vectors) {
			List<Object> indices = items(map(vector).get("indices"));
			List<Object> weights = items(map(vector).get("values"));
			for (int i = 0; i < indices.size(); i++) {
				total.merge(((Number) indices.get(i)).longValue(), number(weights.get(i)), Double::sum);
			}
		}
		Map<Long, Double> result = new LinkedHashMap<>();
		total.forEach((index, weight) -> result.put(index, weight / vectors.size()));
		return result;
	}

	/** The sparse form of 2p - n, in ascending index order without zero weights. */
	private static Map<String, Object> sparseCentroid(List<Object> positive, List<Object> negative) {
		Map<Long, Double> centroid = sparseMean(positive);
		if (!negative.isEmpty()) {
			Map<Long, Double> anti = sparseMean(negative);
			Map<Long, Double> moved = new LinkedHashMap<>();
			Set<Long> indices = new LinkedHashSet<>(centroid.keySet());
			indices.addAll(anti.keySet());
			for (Long index : indices) {
				moved.put(index, 2 * centroid.getOrDefault(index, 0.0) - anti.getOrDefault(index, 0.0));
			}
			centroid = moved;
		}
		List<Long> indices = new ArrayList<>(new TreeSet<>(centroid.keySet()));
		Map<Long, Double> weights = centroid;
		indices.removeIf(index -> weights.get(index) == 0);
		return args("indices", indices, "values", indices.stream().map(weights::get).toList());
	}

	private static List<Double> mean(List<List<Double>> vectors) {
		List<Double> result = new ArrayList<>();
		for (int i = 0; i < vectors.get(0).size(); i++) {
			double sum = 0;
			for (List<Double> vector : vectors) {
				sum += vector.get(i);
			}
			result.add(sum / vectors.size());
		}
		return result;
	}

	private static <T> List<T> randomSample(List<T> items, int size) {
		List<T> pool = new ArrayList<>(items);
		Collections.shuffle(pool);
		return new ArrayList<>(pool.subList(0, Math.min(size, pool.size())));
	}

	/** A random sample (or the first records in key order) of the matching records, returned in key order. */
	public static List<Map<String, Object>> sampleRows(Client client, Map<String, Object> args) {
		Map<String, Object> layout = map(args.get("collection"));
		List<String> all = new ArrayList<>(args.get("filter") == null ? allIds(client, layout) : matching(client, layout, args.get("filter")));
		sortIds(layout, all);
		int size = whole(args, "size", 0);
		List<String> picked = Boolean.TRUE.equals(args.get("first")) ? all.subList(0, Math.min(size, all.size())) : randomSample(all, size);
		sortIds(layout, picked);
		Map<String, Map<String, Object>> found = fetch(client, layout, picked, included(layout, args.get("output"), null));
		return picked.stream().filter(found::containsKey).map(id -> row(layout, id, found.get(id), args.get("output"), null)).toList();
	}

	/**
	 * A random sample of the matching records, each paired with its nearest neighbours within the sample (as Qdrant's distance
	 * matrix); a record without the vector has no pairs.
	 */
	public static List<Map<String, Object>> distanceMatrix(Client client, Map<String, Object> args) {
		Map<String, Object> layout = map(args.get("collection"));
		String field = (String) args.get("field");
		int limit = whole(args, "limit", 3);
		List<String> all = args.get("filter") == null ? allIds(client, layout) : matching(client, layout, args.get("filter"));
		List<String> picked = randomSample(all, whole(args, "sample", 10));
		Map<String, Map<String, Object>> stored = fetch(client, layout, picked, List.of(field));
		List<Object> keys = picked.stream().map(id -> keyOf(layout, id)).toList();
		List<Map<String, Object>> pairs = new ArrayList<>();
		for (String id : picked) {
			if (stored.get(id) == null || stored.get(id).get(field) == null) {
				continue;
			}
			Map<String, Object> clause = vectorClause(field, stored.get(id).get(field), null);
			List<Map<String, Object>> matches = search(client, layout, clause, Math.min(limit + 1, picked.size()), List.of((String) layout.get("key")),
					args((String) layout.get("key"), args("$in", keys)));
			matches.stream().filter(match -> !id.equals(match.get("_id"))).limit(limit).forEach(match -> pairs.add(args("a", keyOf(layout, id), "b",
					keyOf(layout, (String) match.get("_id")), "score", value(similarity(args.get("metric"), number(match.get("_score")))))));
		}
		pairs.sort((x, y) -> {
			int first = compareValues(x.get("a"), y.get("a"));
			return first != 0 ? first : compareValues(x.get("b"), y.get("b"));
		});
		return pairs;
	}

	// ---------------------------------------------------------------- operations

	/** Name, schema field types, the dense field's dimension and metric, deletion protection and tags; stats and index progress on request. */
	public static Map<String, Object> describe(Client client, Map<String, Object> args) {
		String name = (String) args.get("name");
		Map<String, Object> found = describeIndex(client, name);
		Map<String, Object> schemaFields = found.get("schema") == null || map(found.get("schema")).get("fields") == null ? Map.of()
				: map(map(found.get("schema")).get("fields"));
		Map<String, Object> types = new LinkedHashMap<>();
		new TreeSet<>(schemaFields.keySet()).forEach(key -> types.put(key, map(schemaFields.get(key)).get("type")));
		List<String> tags = new ArrayList<>(found.get("tags") == null ? Set.<String>of() : map(found.get("tags")).keySet());
		Collections.sort(tags);
		Map<String, Object> result = args("name", found.get("name"), "fields", types, "deletion_protection", found.get("deletion_protection"), "tags", tags);
		for (Object config : schemaFields.values()) {
			if ("dense_vector".equals(map(config).get("type"))) {
				result.put("dimension", value(map(config).get("dimension")));
				result.put("metric", map(config).get("metric"));
			}
		}
		if (Boolean.TRUE.equals(args.get("stats"))) {
			Object stats = data(client, name, "POST", "/describe_index_stats", Map.of());
			Map<String, Object> namespaces = stats == null || map(stats).get("namespaces") == null ? Map.of() : map(map(stats).get("namespaces"));
			Map<String, Object> counts = new LinkedHashMap<>();
			long total = 0;
			for (String key : new TreeSet<>(namespaces.keySet())) {
				Object summary = namespaces.get(key);
				long count = summary == null || map(summary).get("vectorCount") == null ? 0 : (long) number(map(summary).get("vectorCount"));
				counts.put(key, count);
				total += count;
			}
			result.put("count", total);
			result.put("namespaces", counts);
		}
		if (Boolean.TRUE.equals(args.get("index_progress"))) {
			result.put("index_progress", progress(found));
		}
		return result;
	}

	private static String progress(Map<String, Object> index) {
		Map<String, Object> status = index.get("status") == null ? Map.of() : map(index.get("status"));
		return Boolean.TRUE.equals(status.get("ready")) ? "ready" : String.valueOf(status.getOrDefault("state", "")).toLowerCase(Locale.ROOT);
	}

	/** Waits until the index reports ready; Pinecone indexes every write itself, so readiness is the build state. */
	public static String awaitIndex(Client client, Map<String, Object> args) {
		String name = (String) args.get("name");
		poll(() -> ready(client, name), "index " + name + " is not ready", args.get("timeout") == null ? indexTimeout() : number(args.get("timeout")));
		return progress(describeIndex(client, name));
	}

	private static List<Map<String, Object>> backups(Client client, String name) {
		String path = name == null ? "/backups" : "/indexes/" + segment(name) + "/backups";
		return paged(token -> send(client, "GET", control(client) + path + query("paginationToken", token), null), "data");
	}

	/** Sorted names: the project's indexes, an index's namespaces, or the backups of an index or the project. */
	public static List<String> listObjects(Client client, Map<String, Object> args) {
		Object kind = args.get("kind");
		List<String> found = new ArrayList<>();
		if ("collections".equals(kind)) {
			Object listing = send(client, "GET", control(client) + "/indexes", null);
			items(listing == null ? null : map(listing).get("indexes")).forEach(index -> found.add((String) map(index).get("name")));
		} else if ("namespaces".equals(kind)) {
			String name = (String) map(args.get("scope")).get("name");
			paged(token -> data(client, name, "GET", "/namespaces" + query("limit", 100, "paginationToken", token), null), "namespaces")
					.forEach(item -> found.add((String) item.get("name")));
		} else {
			String name = args.get("scope") == null ? null : (String) map(args.get("scope")).get("name");
			backups(client, name).stream().filter(backup -> backup.get("name") != null).forEach(backup -> found.add((String) backup.get("name")));
		}
		String prefix = (String) args.get("prefix");
		List<String> names = new ArrayList<>(new TreeSet<>(found.stream().filter(item -> prefix == null || item.startsWith(prefix)).toList()));
		return args.get("limit") == null ? names : names.subList(0, Math.min(names.size(), whole(args, "limit", 0)));
	}

	/** A backup of every namespace of the index (paid plans); waits until it is ready. */
	public static Map<String, Object> createBackup(Client client, Map<String, Object> args) {
		Map<String, Object> body = args("name", args.get("backup"));
		if (args.get("description") != null) {
			body.put("description", args.get("description"));
		}
		String id = (String) map(send(client, "POST", control(client) + "/indexes/" + segment((String) args.get("name")) + "/backups", body)).get("backup_id");
		Function<String, String> status = ignored -> String.valueOf(map(send(client, "GET", control(client) + "/backups/" + segment(id), null)).get("status"));
		poll(() -> List.of("Ready", "InitializationFailed").contains(status.apply(id)), "backup " + args.get("backup") + " is not ready", indexTimeout());
		String last = status.apply(id);
		if ("InitializationFailed".equals(last)) {
			throw new IllegalStateException("backup " + args.get("backup") + " of " + args.get("name") + " failed");
		}
		return args("backup", args.get("backup"), "status", last);
	}

	/** Replaces the index with one created from the newest ready backup of that name (paid plans). */
	public static Map<String, Object> restoreBackup(Client client, Map<String, Object> args) {
		String name = (String) args.get("name");
		Map<String, Object> source = backups(client, null).stream()
				.filter(item -> args.get("backup").equals(item.get("name")) && "Ready".equals(item.get("status")))
				.max(Comparator.comparing(item -> String.valueOf(item.getOrDefault("created_at", ""))))
				.orElseThrow(() -> new IllegalArgumentException("no ready backup named " + args.get("backup")));
		if (hasCollection(client, args("name", name))) {
			dropCollection(client, args("name", name));
		}
		String job = (String) map(send(client, "POST", control(client) + "/backups/" + segment((String) source.get("backup_id")) + "/create-index",
				args("name", name))).get("restore_job_id");
		Function<String, String> status = ignored -> String.valueOf(map(send(client, "GET", control(client) + "/restore-jobs/" + segment(job), null)).get("status"));
		if (!Boolean.TRUE.equals(args.get("background"))) {
			poll(() -> List.of("Completed", "Failed", "Cancelled").contains(status.apply(job)), "restore of " + name + " has not finished", indexTimeout());
			poll(() -> ready(client, name), "index " + name + " is not ready", indexTimeout());
		}
		String last = status.apply(job);
		if ("Failed".equals(last) || "Cancelled".equals(last)) {
			throw new IllegalStateException("restore of " + name + " from " + args.get("backup") + " ended " + last);
		}
		return args("restored", name, "status", last);
	}

	public static Map<String, Object> dropBackup(Client client, Map<String, Object> args) {
		List<Map<String, Object>> found = backups(client, null).stream().filter(item -> args.get("backup").equals(item.get("name"))).toList();
		if (found.isEmpty()) {
			throw new IllegalArgumentException("no backup named " + args.get("backup"));
		}
		for (Map<String, Object> item : found) {
			send(client, "DELETE", control(client) + "/backups/" + segment((String) item.get("backup_id")), null);
		}
		return args("deleted", (long) found.size());
	}

	private static final Map<String, List<String>> SCHEMA_KEYS = Map.of("dense_vector", List.of("type", "dimension", "metric", "description"),
			"sparse_vector", List.of("type", "description"), "string", List.of("type", "description", "full_text_search", "embed", "sparse_embed", "store_text"));
	private static final List<String> TEXT_KEYS = List.of("language", "stemming", "stop_words", "ngram");

	/** The schema of a described index in the form create accepts: server-set keys (lowercase, max_term_len) removed. */
	private static Map<String, Object> createSchema(Map<String, Object> described) {
		Map<String, Object> result = new LinkedHashMap<>();
		for (String name : new TreeSet<>(described.keySet())) {
			Map<String, Object> config = described.get(name) == null ? Map.of() : map(described.get(name));
			List<String> keys = SCHEMA_KEYS.get(String.valueOf(config.get("type")));
			if (keys == null) {
				continue;
			}
			Map<String, Object> entry = new LinkedHashMap<>();
			for (String key : keys) {
				if (config.get(key) != null) {
					entry.put(key, config.get(key));
				}
			}
			if (entry.get("full_text_search") != null) {
				Map<String, Object> text = new LinkedHashMap<>();
				map(entry.get("full_text_search")).forEach((key, item) -> {
					if (TEXT_KEYS.contains(key) && item != null) {
						text.put(key, item);
					}
				});
				entry.put("full_text_search", text);
			}
			result.put(name, entry);
		}
		return result;
	}

	private static List<String> listIds(Client client, String name, String namespace) {
		String path = "/namespaces/" + segment(namespace) + "/documents/list";
		return paged(token -> {
			Map<String, Object> body = args("limit", LIST_PAGE);
			if (token != null) {
				body.put("pagination_token", token);
			}
			return data(client, name, "POST", path, body);
		}, "documents").stream().map(item -> (String) item.get("_id")).toList();
	}

	/** A new index with the source's schema, deployment and tags, filled with a copy of every namespace. */
	public static Map<String, Object> cloneCollection(Client client, Map<String, Object> args) {
		String sourceName = (String) map(args.get("collection")).get("name");
		String target = (String) args.get("target");
		Map<String, Object> source = describeIndex(client, sourceName);
		Map<String, Object> deployment = args("deployment_type", "managed", "cloud", envOr("VECDSL_PINECONE_CLOUD", DEFAULT_CLOUD),
				"region", envOr("VECDSL_PINECONE_REGION", DEFAULT_REGION));
		if (source.get("deployment") != null) {
			map(source.get("deployment")).forEach((key, item) -> {
				if (key.equals("cloud") || key.equals("region")) {
					deployment.put(key, item);
				}
			});
		}
		if (args.get("deployment") != null) {
			deployment.putAll(map(args.get("deployment")));
		}
		Map<String, Object> described = source.get("schema") == null || map(source.get("schema")).get("fields") == null ? Map.of()
				: map(map(source.get("schema")).get("fields"));
		Map<String, Object> body = args("name", target, "schema", args("fields", createSchema(described)), "deployment", deployment);
		if (source.get("tags") != null && !map(source.get("tags")).isEmpty()) {
			body.put("tags", source.get("tags"));
		}
		send(client, "POST", control(client) + "/indexes", body);
		poll(() -> ready(client, target), "index " + target + " is not ready", indexTimeout());
		Set<String> namespaces = new TreeSet<>(listObjects(client, args("kind", "namespaces", "scope", args("name", sourceName))));
		namespaces.add(DEFAULT_NAMESPACE);
		int size = described.values().stream().anyMatch(config -> config != null && (map(config).containsKey("embed") || map(config).containsKey("sparse_embed")))
				? EMBEDDED_BATCH : BATCH;
		long copied = 0;
		Map<String, Long> positions = new LinkedHashMap<>();
		Map<String, List<Map<String, Object>>> copies = new LinkedHashMap<>();
		for (String namespace : namespaces) {
			String path = "/namespaces/" + segment(namespace) + "/documents/";
			for (List<String> chunk : chunks(listIds(client, sourceName, namespace), size)) {
				Object fetched = data(client, sourceName, "POST", path + "fetch", args("ids", chunk));
				Map<String, Object> documents = fetched == null || map(fetched).get("documents") == null ? Map.of() : map(map(fetched).get("documents"));
				List<Map<String, Object>> copy = new ArrayList<>();
				for (String id : chunk) {
					if (documents.get(id) != null) {
						Map<String, Object> document = new LinkedHashMap<>(map(documents.get(id)));
						document.remove("_score");
						copy.add(document);
					}
				}
				if (!copy.isEmpty()) {
					data(client, target, "POST", path + "upsert", args("documents", copy));
					positions.put(namespace, client.committed);
					copies.computeIfAbsent(namespace, key -> new ArrayList<>()).addAll(copy);
					copied += copy.size();
				}
			}
		}
		Map<String, Object> probe = probeClause(createSchema(described));
		Map<String, Object> layout = map(args.get("collection"));
		positions.forEach((namespace, position) -> {
			awaitRest(client, target, namespace, probe, position);
			settle(client, args("name", target, "namespace", namespace, "key", layout.get("key"), "key_type", layout.get("key_type")),
					copies.get(namespace), List.of(), System.currentTimeMillis() + (long) (seconds("VECDSL_PINECONE_WAIT_SECONDS", 60) * 1000));
		});
		return args("copied", copied);
	}

	/** A search clause that observes the log position of an index: its dense field, else a full-text field. */
	private static Map<String, Object> probeClause(Map<String, Object> fields) {
		for (Map.Entry<String, Object> field : fields.entrySet()) {
			Map<String, Object> config = map(field.getValue());
			if ("dense_vector".equals(config.get("type"))) {
				List<Double> values = new ArrayList<>();
				for (int i = 0; i < (int) number(config.get("dimension")); i++) {
					values.add(i == 0 ? 1.0 : 0.0);
				}
				return args("type", "dense_vector", "field", field.getKey(), "values", values);
			}
		}
		for (Map.Entry<String, Object> field : fields.entrySet()) {
			Map<String, Object> config = map(field.getValue());
			if ("string".equals(config.get("type")) && config.get("full_text_search") != null) {
				return args("type", "text", "field", field.getKey(), "query", "vecdsl");
			}
		}
		return null;
	}

	/** The REST form of awaitPosition: searches until the reconciled log position reaches the write's. */
	private static void awaitRest(Client client, String name, String namespace, Map<String, Object> probe, Long target) {
		if (probe == null || target == null) {
			return;
		}
		long deadline = System.currentTimeMillis() + (long) (seconds("VECDSL_PINECONE_WAIT_SECONDS", 60) * 1000);
		for (;;) {
			data(client, name, "POST", "/namespaces/" + segment(namespace) + "/documents/search", args("score_by", List.of(probe), "top_k", 1));
			if (client.reconciled != null && client.reconciled >= target) {
				return;
			}
			if (System.currentTimeMillis() > deadline) {
				throw new IllegalStateException(name + " did not reach log position " + target);
			}
			pause(500);
		}
	}
}
