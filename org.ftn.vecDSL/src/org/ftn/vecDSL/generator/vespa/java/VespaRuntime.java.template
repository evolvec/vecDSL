/**
 * Runtime support for vecDSL programs generated for Vespa, over its HTTP APIs with java.net.http and Gson. Generated by vecDSL 7.
 * Do not edit.
 *
 * Every statement arrives as application package files, YQL texts and query request bodies built by the generator, identical in
 * the Python, TypeScript and Java programs; values travel as request parameters that the YQL references with @name, never inside
 * the YQL text. DDL statements deploy the whole package through the deploy API of the config server and wait until the
 * application has converged and serves queries; writes go through document/v1 with the document id id:vecdsl:<type>::<key>;
 * reads use the query API.
 */
public final class VespaRuntime {

	private static final String NAMESPACE = "vecdsl";
	private static final String CLUSTER = "vecdsl";
	private static final String EXPIRES = "vecdsl_expires";
	private static final String VERSION = "vecdsl_version";
	private static final long NO_EXPIRY = 253402300799L;
	private static final int DIGITS = 6;
	private static final int PAGE = 1000;
	private static final String HIGHLIGHT = "vecdsl_hl_";
	private static final double DEPLOY_TIMEOUT = 600;
	private static final double READY_TIMEOUT = 300;
	private static final long POLL_MILLIS = 2000;
	private static final double RETRY_TIMEOUT = 60;
	private static final String UNTIL = "{" + "{until}}";
	private static final String APPLICATION = "/application/v2/tenant/default/application/default";
	private static final String INSTANCE = APPLICATION + "/environment/prod/region/default/instance/default";
	private static final Gson PRETTY = new GsonBuilder().serializeNulls().setPrettyPrinting().disableHtmlEscaping().create();
	private static final Gson COMPACT = new GsonBuilder().serializeNulls().disableHtmlEscaping().create();
	private static final Gson NUMBERS = new GsonBuilder().setObjectToNumberStrategy(ToNumberPolicy.LONG_OR_DOUBLE).create();

	private VespaRuntime() {
	}

	public static final class UnsupportedFeature extends UnsupportedOperationException {

		private static final long serialVersionUID = 1L;

		UnsupportedFeature(String message) {
			super(message);
		}
	}

	public static final class ConflictException extends IllegalStateException {

		private static final long serialVersionUID = 1L;

		ConflictException(String message) {
			super(message);
		}
	}

	public static final class VespaException extends IllegalStateException {

		private static final long serialVersionUID = 1L;

		VespaException(String message) {
			super(message);
		}
	}

	public static RuntimeException unsupported(String vendor, String feature) {
		return new UnsupportedFeature(feature + " is not supported for target " + vendor);
	}

	// ---------------------------------------------------------------- program values

	public static Map<String, Object> args(Object... pairs) {
		Map<String, Object> result = new LinkedHashMap<>();
		for (int i = 0; i < pairs.length; i += 2) {
			result.put((String) pairs[i], pairs[i + 1]);
		}
		return result;
	}

	public static List<Object> list(Object... items) {
		return new ArrayList<>(Arrays.asList(items));
	}

	public static String env(String name) {
		String value = System.getenv(name);
		if (value == null) {
			throw new IllegalStateException("environment variable " + name + " is not set");
		}
		return value;
	}

	public static String envOr(String name, String fallback) {
		String value = System.getenv(name);
		return value == null ? fallback : value;
	}

	public static String text(Object value) {
		return value == null ? null : value.toString();
	}

	public static long integer(Object value) {
		return ((Number) value).longValue();
	}

	public static double decimal(Object value) {
		return ((Number) value).doubleValue();
	}

	public static boolean flag(Object value) {
		return (Boolean) value;
	}

	public static List<Float> floats(Object value) {
		return ((Collection<?>) value).stream().map(item -> ((Number) item).floatValue()).toList();
	}

	public static List<String> texts(Object value) {
		return ((Collection<?>) value).stream().map(String::valueOf).toList();
	}

	@SuppressWarnings("unchecked")
	public static List<Map<String, Object>> records(Object value) {
		return (List<Map<String, Object>>) value;
	}

	public static String toJson(Object value) {
		return PRETTY.toJson(value);
	}

	public static Map<String, Object> parameters(Map<String, Object> given, Map<String, Object> defaults, List<String> names) {
		Set<String> unknown = new HashSet<>(given.keySet());
		unknown.removeAll(names);
		if (!unknown.isEmpty()) {
			throw new IllegalArgumentException("unknown program parameters: " + unknown);
		}
		Map<String, Object> values = new LinkedHashMap<>(defaults);
		values.putAll(given);
		List<String> missing = names.stream().filter(name -> !values.containsKey(name)).toList();
		if (!missing.isEmpty()) {
			throw new IllegalArgumentException("missing program parameters: " + missing);
		}
		return values;
	}

	public static Map<String, Object> parseArguments(String[] arguments) {
		Map<String, Object> parameters = new LinkedHashMap<>();
		for (String argument : arguments) {
			int separator = argument.indexOf('=');
			if (separator < 0) {
				throw new IllegalArgumentException("expected name=value, got " + argument);
			}
			String raw = argument.substring(separator + 1);
			Object value;
			try {
				value = NUMBERS.fromJson(JsonParser.parseString(raw), Object.class);
			} catch (JsonParseException e) {
				value = raw;
			}
			parameters.put(argument.substring(0, separator), value);
		}
		return parameters;
	}

	// ---------------------------------------------------------------- values

	/** A number as text in one form for every host language: integers without a fraction, others in plain decimal notation. */
	public static String plain(Number value) {
		double number = value.doubleValue();
		if (!Double.isFinite(number)) {
			throw new IllegalArgumentException("JSON has no infinite or NaN numbers");
		}
		if (number == Math.rint(number) && Math.abs(number) < 1e15) {
			return Long.toString((long) number);
		}
		String shortest = value instanceof Float single ? Float.toString(single) : Double.toString(number);
		return new BigDecimal(shortest).stripTrailingZeros().toPlainString();
	}

	/** Compact JSON with numbers written by plain(), so that the three runtimes send identical bodies. */
	public static String dumps(Object value) {
		StringBuilder out = new StringBuilder();
		json(value, out);
		return out.toString();
	}

	private static void json(Object value, StringBuilder out) {
		if (value == null) {
			out.append("null");
		} else if (value instanceof String text) {
			out.append(COMPACT.toJson(text));
		} else if (value instanceof Boolean flag) {
			out.append(flag);
		} else if (value instanceof Number number) {
			out.append(plain(number));
		} else if (value instanceof Map<?, ?> map) {
			out.append('{');
			boolean first = true;
			for (Map.Entry<?, ?> entry : map.entrySet()) {
				if (!first) {
					out.append(',');
				}
				first = false;
				out.append(COMPACT.toJson(String.valueOf(entry.getKey()))).append(':');
				json(entry.getValue(), out);
			}
			out.append('}');
		} else if (value instanceof Collection<?> items) {
			out.append('[');
			boolean first = true;
			for (Object item : items) {
				if (!first) {
					out.append(',');
				}
				first = false;
				json(item, out);
			}
			out.append(']');
		} else {
			throw new IllegalArgumentException("cannot write " + value.getClass().getSimpleName() + " as JSON");
		}
	}

	/** Result values in one form for every host language: floats rounded, integral numbers as integers. */
	@SuppressWarnings("unchecked")
	static Object value(Object item) {
		if (item instanceof Float || item instanceof Double) {
			double number = ((Number) item).doubleValue();
			if (!Double.isFinite(number)) {
				return number;
			}
			double rounded = new BigDecimal(number).setScale(DIGITS, RoundingMode.HALF_EVEN).doubleValue();
			return rounded == Math.rint(rounded) && Math.abs(rounded) < 1e15 ? (Object) (long) rounded : (Object) rounded;
		}
		if (item instanceof Number number) {
			return number.longValue();
		}
		if (item instanceof Collection<?> items) {
			return items.stream().map(VespaRuntime::value).toList();
		}
		if (item instanceof Map<?, ?> map) {
			Map<String, Object> result = new LinkedHashMap<>();
			((Map<String, Object>) map).forEach((key, entry) -> result.put(key, value(entry)));
			return result;
		}
		return item;
	}

	public static String keyText(Object identifier) {
		if (identifier instanceof Number number) {
			return plain(number);
		}
		if (identifier instanceof String text) {
			return text;
		}
		throw new IllegalArgumentException("invalid record key " + identifier);
	}

	private static int compareIds(Object left, Object right) {
		boolean leftNumber = left instanceof Number;
		boolean rightNumber = right instanceof Number;
		if (leftNumber != rightNumber) {
			return leftNumber ? -1 : 1;
		}
		if (leftNumber) {
			return Double.compare(((Number) left).doubleValue(), ((Number) right).doubleValue());
		}
		return String.valueOf(left).compareTo(String.valueOf(right));
	}

	@SuppressWarnings("unchecked")
	private static Map<String, Object> map(Object value) {
		return value instanceof Map<?, ?> found ? (Map<String, Object>) found : new LinkedHashMap<>();
	}

	@SuppressWarnings("unchecked")
	private static List<Object> items(Object value) {
		return value instanceof List<?> found ? (List<Object>) found : new ArrayList<>();
	}

	private static List<String> strings(Object value) {
		return items(value).stream().map(String::valueOf).toList();
	}

	private static long now() {
		return System.currentTimeMillis() / 1000;
	}

	private static double monotonic() {
		return System.nanoTime() / 1e9;
	}

	private static void sleep(long millis) {
		try {
			Thread.sleep(millis);
		} catch (InterruptedException e) {
			Thread.currentThread().interrupt();
			throw new IllegalStateException("interrupted while waiting", e);
		}
	}

	// ---------------------------------------------------------------- connection

	/** The query and document API (url) and the config server (configUrl) of one Vespa application; an optional bearer token. */
	public static final class Client implements AutoCloseable {

		final String url;
		final String configUrl;
		final String token;
		final double timeout;
		final HttpClient http;

		Client(String url, String configUrl, String token, double timeout) {
			this.url = url.replaceAll("/+$", "");
			this.configUrl = configUrl.replaceAll("/+$", "");
			this.token = token;
			this.timeout = timeout;
			this.http = HttpClient.newBuilder().connectTimeout(Duration.ofMillis((long) (timeout * 1000))).build();
		}

		/** One HTTP request; returns the status and the decoded JSON (or text) of the answer, for every status. */
		Answer request(String method, String base, String path, Map<String, Object> query, byte[] body, String contentType, Double seconds) {
			String address = base + path;
			if (query != null && !query.isEmpty()) {
				address += "?" + query.entrySet().stream().map(entry -> URLEncoder.encode(entry.getKey(), StandardCharsets.UTF_8) + "="
						+ URLEncoder.encode(parameter(entry.getValue()), StandardCharsets.UTF_8)).collect(Collectors.joining("&"));
			}
			HttpRequest.Builder builder = HttpRequest.newBuilder(URI.create(address))
					.timeout(Duration.ofMillis((long) ((seconds == null ? timeout : seconds) * 1000)))
					.method(method, body == null ? HttpRequest.BodyPublishers.noBody() : HttpRequest.BodyPublishers.ofByteArray(body));
			if (body != null) {
				builder.header("Content-Type", contentType == null ? "application/json" : contentType);
			}
			if (token != null && !token.isEmpty()) {
				builder.header("Authorization", "Bearer " + token);
			}
			try {
				HttpResponse<String> response = http.send(builder.build(), HttpResponse.BodyHandlers.ofString(StandardCharsets.UTF_8));
				return new Answer(response.statusCode(), decode(response.body()));
			} catch (IOException e) {
				throw new VespaException(method + " " + address + " failed: " + e);
			} catch (InterruptedException e) {
				Thread.currentThread().interrupt();
				throw new VespaException(method + " " + address + " was interrupted");
			}
		}

		@Override
		public void close() {
			http.close();
		}
	}

	record Answer(int status, Object body) {
	}

	private static String parameter(Object value) {
		if (value instanceof Boolean flag) {
			return flag ? "true" : "false";
		}
		return value instanceof Number number ? plain(number) : String.valueOf(value);
	}

	private static Object decode(String text) {
		if (text == null || text.isBlank()) {
			return null;
		}
		try {
			return NUMBERS.fromJson(JsonParser.parseString(text), Object.class);
		} catch (JsonParseException e) {
			return text;
		}
	}

	public static Client connect(Map<String, Object> args) {
		String token = System.getenv((String) args.getOrDefault("token_variable", "VECDSL_VESPA_TOKEN"));
		return new Client((String) args.get("url"), (String) args.get("config_url"), token == null || token.isEmpty() ? null : token,
				((Number) args.getOrDefault("timeout", 30)).doubleValue());
	}

	/** A request repeated while the server answers 429 or 503 (too many operations, or a cluster still starting), at most 60 s. */
	private static Answer retried(Client client, String method, String base, String path, Map<String, Object> query, byte[] body,
			Double seconds) {
		double deadline = monotonic() + RETRY_TIMEOUT;
		long delay = 200;
		while (true) {
			Answer answer = client.request(method, base, path, query, body, null, seconds);
			if ((answer.status() != 429 && answer.status() != 503) || monotonic() > deadline) {
				return answer;
			}
			sleep(delay);
			delay = Math.min(delay * 2, 2000);
		}
	}

	private static RuntimeException fail(String what, Answer answer) {
		Object message = answer.body() instanceof Map<?, ?> found && found.containsKey("message") ? found.get("message") : answer.body();
		return new VespaException(what + " failed with HTTP " + answer.status() + ": " + (message instanceof String text ? text : dumps(message)));
	}

	private static byte[] utf8(String text) {
		return text.getBytes(StandardCharsets.UTF_8);
	}

	// ---------------------------------------------------------------- deployment

	/** The document types of the active application (its schema files), or null without an application. */
	private static List<String> deployed(Client client) {
		Answer answer = client.request("GET", client.configUrl, "/application/v2/tenant/default/application/", null, null, null, null);
		if (answer.status() != 200) {
			throw fail("listing the applications", answer);
		}
		if (items(answer.body()).isEmpty()) {
			return null;
		}
		answer = client.request("GET", client.configUrl, INSTANCE + "/content/schemas/", null, null, null, null);
		if (answer.status() == 404) {
			return new ArrayList<>();
		}
		if (answer.status() != 200) {
			throw fail("reading the deployed schemas", answer);
		}
		return new ArrayList<>(new TreeSet<>(strings(answer.body()).stream().map(entry -> entry.replaceAll("/+$", ""))
				.map(entry -> entry.substring(entry.lastIndexOf('/') + 1)).filter(name -> name.endsWith(".sd"))
				.map(name -> name.substring(0, name.length() - 3)).toList()));
	}

	/** The package as a zip archive with fixed timestamps, stored (not compressed). */
	private static byte[] zip(Map<String, String> files) {
		ByteArrayOutputStream buffer = new ByteArrayOutputStream();
		try (ZipOutputStream archive = new ZipOutputStream(buffer)) {
			for (Map.Entry<String, String> file : files.entrySet()) {
				byte[] data = utf8(file.getValue());
				CRC32 checksum = new CRC32();
				checksum.update(data);
				ZipEntry entry = new ZipEntry(file.getKey());
				entry.setMethod(ZipEntry.STORED);
				entry.setSize(data.length);
				entry.setCompressedSize(data.length);
				entry.setCrc(checksum.getValue());
				entry.setTime(315532800000L);
				archive.putNextEntry(entry);
				archive.write(data);
				archive.closeEntry();
			}
		} catch (IOException e) {
			throw new UncheckedIOException(e);
		}
		return buffer.toByteArray();
	}

	/**
	 * Deploys the package as the program's statements leave it. A created type that is already deployed fails the statement (or,
	 * with skip_existing, leaves the application as it is); a dropped type that is not deployed fails it unless ignore_missing; the
	 * documents of a deployed dropped type are deleted first. No files: the application is removed.
	 */
	public static void deploy(Client client, Map<String, Object> args) {
		List<String> present = deployed(client);
		List<String> types = present == null ? List.of() : present;
		for (String name : strings(args.get("created"))) {
			if (types.contains(name)) {
				if (Boolean.TRUE.equals(args.get("skip_existing"))) {
					return;
				}
				throw new ConflictException("collection " + name + " already exists");
			}
		}
		for (String name : strings(args.get("dropped"))) {
			if (!types.contains(name) && !Boolean.TRUE.equals(args.get("ignore_missing"))) {
				throw new VespaException("collection " + name + " does not exist");
			}
		}
		for (String name : strings(args.get("dropped"))) {
			if (types.contains(name)) {
				deleteAll(client, name);
			}
		}
		Map<String, String> files = new LinkedHashMap<>();
		map(args.get("files")).forEach((name, content) -> files.put(name, (String) content));
		if (files.isEmpty()) {
			if (present != null) {
				Answer answer = client.request("DELETE", client.configUrl, APPLICATION, null, null, null, DEPLOY_TIMEOUT);
				if (answer.status() != 200 && answer.status() != 404) {
					throw fail("removing the application", answer);
				}
			}
			return;
		}
		Map<String, String> packageFiles = new LinkedHashMap<>(files);
		if (args.get("overrides") instanceof String overrides) {
			String until = LocalDate.now(ZoneOffset.UTC).plusDays(1).toString();
			packageFiles.put("validation-overrides.xml", overrides.replace(UNTIL, until));
		}
		Answer answer = client.request("POST", client.configUrl, "/application/v2/tenant/default/prepareandactivate", null, zip(packageFiles),
				"application/zip", DEPLOY_TIMEOUT);
		if (answer.status() != 200) {
			throw fail("deploying the application package", answer);
		}
		long session = Long.parseLong(String.valueOf(map(answer.body()).get("session-id")));
		awaitConverged(client, session, monotonic() + DEPLOY_TIMEOUT);
		List<String> schemaTypes = files.keySet().stream().filter(name -> name.startsWith("schemas/") && name.endsWith(".sd"))
				.map(name -> name.substring("schemas/".length(), name.length() - 3)).toList();
		awaitServing(client, schemaTypes, monotonic() + READY_TIMEOUT);
	}

	/** Polls serviceconverge until every service runs the deployed session's config generation. */
	private static void awaitConverged(Client client, long session, double deadline) {
		while (true) {
			Answer answer = client.request("GET", client.configUrl, INSTANCE + "/serviceconverge", null, null, null, null);
			Map<String, Object> state = map(answer.body());
			if (answer.status() == 200 && Boolean.TRUE.equals(state.get("converged"))
					&& ((Number) state.getOrDefault("currentGeneration", 0L)).longValue() >= session) {
				return;
			}
			if (monotonic() > deadline) {
				throw new IllegalStateException("the application did not converge on session " + session + " within " + (long) DEPLOY_TIMEOUT
						+ " s (serviceconverge: " + dumps(answer.body()) + ")");
			}
			sleep(POLL_MILLIS);
		}
	}

	/** Waits until the container answers /status.html and each document type answers a query and a document lookup. */
	private static void awaitServing(Client client, List<String> types, double deadline) {
		List<String> pending = new ArrayList<>();
		pending.add("/status.html");
		pending.addAll(types);
		while (!pending.isEmpty()) {
			String target = pending.get(0);
			boolean ready;
			Object last;
			try {
				if (target.equals("/status.html")) {
					Answer answer = client.request("GET", client.url, "/status.html", null, null, null, null);
					ready = answer.status() == 200;
					last = answer.body();
				} else {
					Answer answer = client.request("POST", client.url, "/search/", null,
							utf8(dumps(args("yql", "select * from " + target + " where true", "hits", 0))), null, null);
					ready = answer.status() == 200 && map(map(answer.body()).get("root")).get("errors") == null;
					last = answer.body();
					if (ready) {
						Answer probe = client.request("GET", client.url, path(target, "vecdsl-readiness-probe"),
								args("format.tensors", "short-value"), null, null, null);
						ready = probe.status() == 200 || probe.status() == 404;
						last = probe.body();
					}
				}
			} catch (VespaException e) {
				ready = false;
				last = e.getMessage();
			}
			if (ready) {
				pending.remove(0);
				continue;
			}
			if (monotonic() > deadline) {
				throw new IllegalStateException("the application did not serve " + target + " within " + (long) READY_TIMEOUT
						+ " s (last answer: " + dumps(last) + ")");
			}
			sleep(POLL_MILLIS);
		}
	}

	/** Waits until the deployment has converged and the document type serves queries, at most timeout seconds. */
	public static Object awaitReady(Client client, Map<String, Object> args) {
		String type = (String) args.get("document_type");
		double deadline = monotonic() + ((Number) args.getOrDefault("timeout", READY_TIMEOUT)).doubleValue();
		Answer answer = client.request("GET", client.configUrl, APPLICATION, null, null, null, null);
		if (answer.status() != 200) {
			throw fail("reading the application", answer);
		}
		awaitConverged(client, ((Number) map(answer.body()).getOrDefault("generation", 0L)).longValue(), deadline);
		awaitServing(client, List.of(type), deadline);
		return args("collection", type, "state", "ready");
	}

	public static void requireCollection(Client client, Map<String, Object> args) {
		String type = (String) args.get("document_type");
		List<String> present = deployed(client);
		if (present == null || !present.contains(type)) {
			throw new VespaException("collection " + type + " does not exist");
		}
	}

	/** Triggers reindexing of the document type and polls the reindexing status until it succeeds, at most timeout seconds. */
	public static Object reindex(Client client, Map<String, Object> args) {
		String type = (String) args.get("document_type");
		requireCollection(client, args);
		double timeout = ((Number) args.getOrDefault("timeout", DEPLOY_TIMEOUT)).doubleValue();
		Answer answer = client.request("POST", client.configUrl, INSTANCE + "/reindex", args("clusterId", CLUSTER, "documentType", type), null,
				null, null);
		if (answer.status() != 200) {
			throw fail("triggering reindexing", answer);
		}
		double deadline = monotonic() + timeout;
		while (true) {
			answer = client.request("GET", client.configUrl, INSTANCE + "/reindexing", null, null, null, null);
			Object state = answer.status() == 200
					? map(map(map(map(map(answer.body()).get("clusters")).get(CLUSTER)).get("ready")).get(type)).get("state")
					: null;
			if ("successful".equals(state)) {
				return args("collection", type, "state", state);
			}
			if ("failed".equals(state)) {
				throw new VespaException("reindexing " + type + " failed: " + dumps(answer.body()));
			}
			if (monotonic() > deadline) {
				throw new IllegalStateException("reindexing " + type + " did not finish within " + (long) timeout + " s (state " + state + ")");
			}
			sleep(POLL_MILLIS);
		}
	}

	/** The deployed schema of the collection, its document count on request, and whether the deployment has converged. */
	public static Object describe(Client client, Map<String, Object> args) {
		String type = (String) args.get("document_type");
		Answer answer = client.request("GET", client.configUrl, INSTANCE + "/content/schemas/" + type + ".sd", null, null, null, null);
		if (answer.status() != 200) {
			throw fail("reading the schema of " + type, answer);
		}
		Map<String, Object> result = args("name", type, "schema", answer.body());
		if (args.get("stats") != null) {
			result.put("count", count(client, map(args.get("stats"))));
		}
		if (Boolean.TRUE.equals(args.get("progress"))) {
			Answer converge = client.request("GET", client.configUrl, INSTANCE + "/serviceconverge", null, null, null, null);
			result.put("converged", converge.status() == 200 && Boolean.TRUE.equals(map(converge.body()).get("converged")));
		}
		return result;
	}

	/** collections and databases (the deployed schemas), the program's index names, and the values of a slice attribute (grouping). */
	public static List<String> names(Client client, Map<String, Object> args) {
		String kind = (String) args.get("kind");
		List<String> found = new ArrayList<>();
		if (kind.equals("collections") || kind.equals("databases")) {
			List<String> present = deployed(client);
			List<String> types = present == null ? List.of() : present;
			String database = (String) args.get("database");
			if (kind.equals("databases")) {
				found.addAll(new TreeSet<>(types.stream().filter(name -> name.contains("_")).map(name -> name.split("_", 2)[0]).toList()));
			} else if (database != null) {
				types.stream().filter(name -> name.startsWith(database + "_")).forEach(name -> found.add(name.substring(database.length() + 1)));
			} else {
				found.addAll(types);
			}
		} else if (kind.equals("indexes")) {
			found.addAll(strings(args.get("names")));
		} else {
			Map<String, Object> root = query(client, args("body", map(args.get("body"))));
			for (Object groupList : items(root.get("children"))) {
				for (Object listNode : items(map(groupList).get("children"))) {
					for (Object group : items(map(listNode).get("children"))) {
						Object value = map(group).get("value");
						// a document without the slice has the empty string in the attribute, which is not a slice name
						if (value != null && !"".equals(value)) {
							found.add(value instanceof Number number ? plain(number) : String.valueOf(value));
						}
					}
				}
			}
		}
		String prefix = (String) args.get("prefix");
		List<String> result = found.stream().filter(name -> prefix == null || name.startsWith(prefix)).sorted().toList();
		return args.get("limit") == null ? result : result.subList(0, Math.min(result.size(), ((Number) args.get("limit")).intValue()));
	}

	// ---------------------------------------------------------------- documents

	private static String path(String type, Object key) {
		return "/document/v1/" + NAMESPACE + "/" + type + "/docid/" + URLEncoder.encode(keyText(key), StandardCharsets.UTF_8).replace("+", "%20");
	}

	private static Map<String, Object> fieldsOf(Map<String, Object> row, String key, Map<String, Object> vectors, Map<String, Object> slices) {
		if (row.get(key) == null) {
			throw new IllegalArgumentException("a record without its key field " + key);
		}
		Map<String, Object> fields = new LinkedHashMap<>();
		row.forEach((name, item) -> {
			if (item != null) {
				fields.put(name, item);
			}
		});
		for (Map.Entry<String, Object> vector : vectors.entrySet()) {
			if (fields.get(vector.getKey()) instanceof List<?> cells && cells.size() != ((Number) vector.getValue()).intValue()) {
				throw new IllegalArgumentException("vector field " + vector.getKey() + " has " + cells.size() + " dimensions, the schema expects "
						+ vector.getValue());
			}
		}
		fields.putAll(slices);
		return fields;
	}

	private static Map<String, Object> getFields(Client client, String type, Object key) {
		Answer answer = retried(client, "GET", client.url, path(type, key), args("format.tensors", "short-value"), null, null);
		if (answer.status() == 404) {
			return null;
		}
		if (answer.status() != 200) {
			throw fail("reading document " + keyText(key), answer);
		}
		return map(map(answer.body()).get("fields"));
	}

	private static boolean expired(Map<String, Object> fields, long at) {
		return fields.get(EXPIRES) instanceof Number expiry && expiry.longValue() <= at;
	}

	/**
	 * Puts each record as a document. error: every id is read first and any existing one fails the write before anything is written;
	 * error and ignore then put with the condition false and create (an existing document answers 412); replace puts unconditionally.
	 */
	public static Map<String, Object> write(Client client, Map<String, Object> args) {
		String type = (String) args.get("document_type");
		String key = (String) args.get("key");
		String policy = (String) args.get("policy");
		long at = now();
		List<Object[]> documents = new ArrayList<>();
		for (Object row : items(args.get("records"))) {
			Map<String, Object> fields = fieldsOf(map(row), key, map(args.get("vectors")), map(args.get("slices")));
			if (Boolean.TRUE.equals(args.get("expiring"))) {
				fields.put(EXPIRES, args.get("ttl") == null ? NO_EXPIRY : at + ((Number) args.get("ttl")).longValue());
			}
			if (Boolean.TRUE.equals(args.get("versioned"))) {
				fields.put(VERSION, 1);
			}
			documents.add(new Object[] { map(row).get(key), fields });
		}
		if (policy.equals("error")) {
			List<String> existing = new ArrayList<>();
			for (Object[] document : documents) {
				Map<String, Object> found = getFields(client, type, document[0]);
				if (found != null && !expired(found, at)) {
					existing.add(keyText(document[0]));
				}
			}
			if (!existing.isEmpty()) {
				throw new ConflictException("records with these ids exist already: " + String.join(", ", existing) + "; nothing was written");
			}
		}
		long written = 0;
		for (Object[] document : documents) {
			Map<String, Object> operation = policy.equals("error") || policy.equals("ignore")
					? args("condition", "false", "create", true, "fields", document[1])
					: args("fields", document[1]);
			Answer answer = retried(client, "POST", client.url, path(type, document[0]), null, utf8(dumps(operation)), null);
			if (answer.status() == 412) {
				if (policy.equals("ignore")) {
					continue;
				}
				throw new ConflictException("record " + keyText(document[0]) + " exists already");
			}
			if (answer.status() != 200) {
				throw fail("writing document " + keyText(document[0]), answer);
			}
			written += 1;
		}
		return args((String) args.get("counter"), written);
	}

	@SuppressWarnings("unchecked")
	public static List<Map<String, Object>> readRecords(Client client, Map<String, Object> args) {
		String location = (String) args.get("location");
		Path file = Path.of(location.startsWith("file://") ? location.substring("file://".length()) : location);
		String content;
		try {
			content = Files.readString(file, StandardCharsets.UTF_8);
		} catch (IOException e) {
			throw new UncheckedIOException(e);
		}
		if (content.stripLeading().startsWith("[")) {
			return (List<Map<String, Object>>) NUMBERS.fromJson(content, List.class);
		}
		List<Map<String, Object>> rows = new ArrayList<>();
		for (String line : content.split("\\r?\\n")) {
			if (!line.isBlank()) {
				rows.add((Map<String, Object>) NUMBERS.fromJson(line, Map.class));
			}
		}
		return rows;
	}

	public static Map<String, Object> importFile(Client client, Map<String, Object> args) {
		Map<String, Object> writeArgs = new LinkedHashMap<>(args);
		writeArgs.put("records", readRecords(client, args));
		return write(client, writeArgs);
	}

	/** The keys of the documents a query selects, in key order: every page, or the first limit keys. */
	private static List<Object> selected(Client client, String key, Map<String, Object> select, Integer limit) {
		List<Object> keys = new ArrayList<>();
		while (true) {
			int wanted = limit == null ? PAGE : Math.min(PAGE, limit - keys.size());
			Map<String, Object> page = new LinkedHashMap<>(select);
			Map<String, Object> body = new LinkedHashMap<>(map(select.get("body")));
			body.put("hits", wanted);
			body.put("offset", keys.size());
			page.put("body", body);
			List<Object> found = hitsOf(query(client, page)).stream().map(hit -> map(hit.get("fields")).get(key)).toList();
			keys.addAll(found);
			if (found.size() < wanted || (limit != null && keys.size() >= limit)) {
				return keys;
			}
		}
	}

	/** Partial updates by id, each conditional on the document existing (or on its version), so missing documents are not counted. */
	public static Map<String, Object> update(Client client, Map<String, Object> args) {
		String type = (String) args.get("document_type");
		String key = (String) args.get("key");
		String condition = args.get("version") != null ? type + "." + VERSION + "==" + plain((Number) args.get("version")) : type;
		List<Object[]> changes = new ArrayList<>();
		if (args.get("records") != null) {
			for (Object row : items(args.get("records"))) {
				Map<String, Object> fields = fieldsOf(map(row), key, map(args.get("vectors")), Map.of());
				Map<String, Object> operations = new LinkedHashMap<>();
				fields.forEach((name, item) -> {
					if (!name.equals(key)) {
						operations.put(name, args("assign", item));
					}
				});
				changes.add(new Object[] { map(row).get(key), operations });
			}
		} else {
			Map<String, Object> operations = new LinkedHashMap<>();
			Map<String, Object> vectors = map(args.get("vectors"));
			map(args.get("set")).forEach((name, item) -> {
				if (vectors.containsKey(name) && item instanceof List<?> cells && cells.size() != ((Number) vectors.get(name)).intValue()) {
					throw new IllegalArgumentException("vector field " + name + " has " + cells.size() + " dimensions, the schema expects " + vectors.get(name));
				}
				operations.put(name, args("assign", item));
			});
			map(args.get("append")).forEach((name, item) -> operations.put(name, args("add", item)));
			map(args.get("remove")).forEach((name, item) -> operations.put(name, args("remove", item)));
			for (String name : strings(args.get("clear"))) {
				operations.put(name, args("assign", null));
			}
			List<Object> targets = args.get("ids") != null ? items(args.get("ids")) : selected(client, key, map(args.get("select")), null);
			for (Object identifier : targets) {
				changes.add(new Object[] { identifier, operations });
			}
		}
		long updated = 0;
		for (Object[] change : changes) {
			Map<String, Object> fields = new LinkedHashMap<>(map(change[1]));
			if (Boolean.TRUE.equals(args.get("versioned"))) {
				fields.put(VERSION, args("increment", 1));
			}
			Answer answer = retried(client, "PUT", client.url, path(type, change[0]), null, utf8(dumps(args("condition", condition, "fields", fields))), null);
			if (answer.status() == 412) {
				continue;
			}
			if (answer.status() != 200) {
				throw fail("updating document " + keyText(change[0]), answer);
			}
			updated += 1;
		}
		return args("update_count", updated);
	}

	/** Removes documents by id (conditional on the type, so missing ids are not counted), selected by a query, or every document. */
	public static Map<String, Object> delete(Client client, Map<String, Object> args) {
		String type = (String) args.get("document_type");
		if (Boolean.TRUE.equals(args.get("all"))) {
			return args("delete_count", deleteAll(client, type));
		}
		Integer limit = args.get("limit") == null ? null : ((Number) args.get("limit")).intValue();
		List<Object> targets = args.get("ids") != null ? items(args.get("ids")) : selected(client, (String) args.get("key"), map(args.get("select")), limit);
		long deleted = 0;
		for (Object identifier : targets) {
			Answer answer = retried(client, "DELETE", client.url, path(type, identifier), args("condition", type), null, null);
			if (answer.status() == 412) {
				continue;
			}
			if (answer.status() != 200) {
				throw fail("deleting document " + keyText(identifier), answer);
			}
			deleted += 1;
		}
		return args("delete_count", deleted);
	}

	/** Delete where the selection is true over the type's documents, chunk by chunk; returns how many there were. */
	private static long deleteAll(Client client, String type) {
		long total = count(client, args("body", args("yql", "select * from " + type + " where true", "hits", 0)));
		String continuation = null;
		while (true) {
			Map<String, Object> query = args("selection", "true", "cluster", CLUSTER);
			if (continuation != null) {
				query.put("continuation", continuation);
			}
			Answer answer = retried(client, "DELETE", client.url, "/document/v1/" + NAMESPACE + "/" + type + "/docid", query, null, DEPLOY_TIMEOUT);
			if (answer.status() != 200) {
				throw fail("deleting the documents of " + type, answer);
			}
			Object next = map(answer.body()).get("continuation");
			continuation = next instanceof String text && !text.isEmpty() ? text : null;
			if (continuation == null) {
				return total;
			}
		}
	}

	/** Sets the expiry time of every existing document (an update where the selection is true); returns how many there were. */
	public static Map<String, Object> expire(Client client, Map<String, Object> args) {
		String type = (String) args.get("document_type");
		long total = count(client, args("body", args("yql", "select * from " + type + " where true", "hits", 0)));
		byte[] body = utf8(dumps(args("fields", args(EXPIRES, args("assign", now() + ((Number) args.get("seconds")).longValue())))));
		String continuation = null;
		while (true) {
			Map<String, Object> query = args("selection", "true", "cluster", CLUSTER);
			if (continuation != null) {
				query.put("continuation", continuation);
			}
			Answer answer = retried(client, "PUT", client.url, "/document/v1/" + NAMESPACE + "/" + type + "/docid", query, body, DEPLOY_TIMEOUT);
			if (answer.status() != 200) {
				throw fail("setting the expiry of " + type, answer);
			}
			Object next = map(answer.body()).get("continuation");
			continuation = next instanceof String text && !text.isEmpty() ? text : null;
			if (continuation == null) {
				return args("expire_count", total);
			}
		}
	}

	/** Documents by id, in the order of the ids; missing documents, documents outside the slices and expired ones are skipped. */
	public static List<Object> get(Client client, Map<String, Object> args) {
		String type = (String) args.get("document_type");
		long at = now();
		List<Object> hits = new ArrayList<>();
		for (Object identifier : items(args.get("ids"))) {
			Map<String, Object> fields = getFields(client, type, identifier);
			if (fields == null || (Boolean.TRUE.equals(args.get("expiring")) && expired(fields, at))) {
				continue;
			}
			boolean outside = map(args.get("slices")).entrySet().stream()
					.anyMatch(slice -> !items(slice.getValue()).contains(fields.get(slice.getKey())));
			if (outside) {
				continue;
			}
			hits.add(project(fields, (String) args.get("key"), strings(args.get("output")), strings(args.get("vectors")), null));
		}
		return hits;
	}

	// ---------------------------------------------------------------- queries

	private static Map<String, Object> project(Map<String, Object> fields, String key, List<String> output, List<String> vectors, Double score) {
		return project(fields, key, output, vectors, score, List.of(), null);
	}

	private static Map<String, Object> project(Map<String, Object> fields, String key, List<String> output, List<String> vectors, Double score,
			List<String> highlight, Object explanation) {
		Map<String, Object> hit = new LinkedHashMap<>();
		hit.put("id", fields.get(key));
		if (score != null) {
			hit.put("score", score);
		}
		for (String name : output) {
			hit.put(name, fields.get(name));
		}
		for (String name : vectors) {
			hit.put(name, fields.get(name));
		}
		if (!highlight.isEmpty()) {
			Map<String, Object> marked = new LinkedHashMap<>();
			for (String name : highlight) {
				Object text = fields.get(HIGHLIGHT + name);
				if (marked(text)) {
					marked.put(name, List.of(text));
				}
			}
			hit.put("highlight", marked);
		}
		if (explanation != null) {
			hit.put("explanation", explanation);
		}
		@SuppressWarnings("unchecked")
		Map<String, Object> result = (Map<String, Object>) value(hit);
		return result;
	}

	/** POST /search/ with the generated body and the bound values, each checked against the type its @reference expects. */
	private static Map<String, Object> query(Client client, Map<String, Object> search) {
		Map<String, Object> request = new LinkedHashMap<>(map(search.get("body")));
		map(search.get("texts")).forEach((name, item) -> {
			if (!(item instanceof String)) {
				throw new IllegalArgumentException("query parameter " + name + " must be a string, not " + item);
			}
			request.put(name, item);
		});
		map(search.get("numbers")).forEach((name, item) -> {
			if (!(item instanceof Number number) || !Double.isFinite(number.doubleValue())) {
				throw new IllegalArgumentException("query parameter " + name + " must be a finite number, not " + item);
			}
			request.put(name, item);
		});
		map(search.get("flags")).forEach((name, item) -> {
			if (!(item instanceof Boolean)) {
				throw new IllegalArgumentException("query parameter " + name + " must be a boolean, not " + item);
			}
			request.put(name, item);
		});
		if (Boolean.TRUE.equals(search.get("clock"))) {
			request.put("vecdsl_now", now());
		}
		Answer answer = retried(client, "POST", client.url, "/search/", null, utf8(dumps(request)), null);
		Map<String, Object> root = map(map(answer.body()).get("root"));
		if (answer.status() != 200 || root.get("errors") != null) {
			throw fail("the query", new Answer(answer.status(), root.get("errors") != null ? root.get("errors") : answer.body()));
		}
		return root;
	}

	/** A highlight fragment counts only with a bolded term: Vespa also returns the bolded summary field, unmarked, in hits that matched no term. */
	private static boolean marked(Object text) {
		return text instanceof String value && value.contains("<hi>");
	}

	private static List<Map<String, Object>> hitsOf(Map<String, Object> root) {
		List<Map<String, Object>> hits = new ArrayList<>();
		for (Object child : items(root.get("children"))) {
			Map<String, Object> node = map(child);
			// A hit filled from a document summary without documentid has an id index:<cluster>/<part>/<gid>, not id:...; only grouping nodes are left out.
			if (node.containsKey("fields") && !String.valueOf(node.get("id")).startsWith("group:")) {
				hits.add(node);
			}
		}
		return hits;
	}

	private static List<Double> vectorOf(Client client, String type, String field, Object identifier) {
		Map<String, Object> fields = getFields(client, type, identifier);
		if (fields == null || !(fields.get(field) instanceof List<?> cells)) {
			throw new IllegalArgumentException("no vector " + field + " stored for id " + keyText(identifier) + " in " + type);
		}
		return cells.stream().map(cell -> ((Number) cell).doubleValue()).toList();
	}

	private static List<Double> average(List<List<Double>> vectors) {
		List<Double> mean = new ArrayList<>();
		for (int i = 0; i < vectors.get(0).size(); i++) {
			double sum = 0;
			for (List<Double> vector : vectors) {
				sum += vector.get(i);
			}
			mean.add(sum / vectors.size());
		}
		return mean;
	}

	/** The body with input.query(vecdsl_q): given, a stored document's vector, or 2 avg(positive) - avg(negative) of the examples. */
	private static Map<String, Object> queryVector(Client client, Map<String, Object> body, Map<String, Object> lookup) {
		if (lookup.isEmpty()) {
			return body;
		}
		String type = (String) lookup.get("document_type");
		String field = (String) lookup.get("field");
		List<List<Double>> positives = new ArrayList<>();
		List<List<Double>> negatives = new ArrayList<>();
		for (Object vector : items(lookup.get("positive_vectors"))) {
			positives.add(items(vector).stream().map(cell -> ((Number) cell).doubleValue()).toList());
		}
		for (Object vector : items(lookup.get("negative_vectors"))) {
			negatives.add(items(vector).stream().map(cell -> ((Number) cell).doubleValue()).toList());
		}
		for (Object identifier : items(lookup.get("positive_ids"))) {
			positives.add(vectorOf(client, type, field, identifier));
		}
		for (Object identifier : items(lookup.get("negative_ids"))) {
			negatives.add(vectorOf(client, type, field, identifier));
		}
		if (positives.isEmpty()) {
			throw new IllegalArgumentException("no positive example to search with");
		}
		List<Double> mean = average(positives);
		if (!negatives.isEmpty()) {
			List<Double> negative = average(negatives);
			List<Double> combined = new ArrayList<>();
			for (int i = 0; i < mean.size(); i++) {
				combined.add(2 * mean.get(i) - negative.get(i));
			}
			mean = combined;
		}
		Map<String, Object> result = new LinkedHashMap<>(body);
		Map<String, Object> inputs = new LinkedHashMap<>(map(result.get("input")));
		inputs.put("query(vecdsl_q)", mean);
		result.put("input", inputs);
		return result;
	}

	/** Canonical similarity from a Vespa distance: cosine from the angle, the negated distance for euclidean and hamming, dot from -dot. */
	private static double similarity(double distance, String metric) {
		return "cosine".equals(metric) ? Math.cos(distance) : -distance;
	}

	/** The distance from the relevance of a hit ranked by a generated vecdsl_nn_ profile (first phase closeness = 1 / (1 + distance)).
	 *  Grouping hits (output(summary())) carry no match features, only the relevance. */
	private static Double closenessDistance(Map<String, Object> hit, Map<String, Object> search) {
		Object profile = map(map(search.get("body")).get("ranking")).get("profile");
		Object relevance = hit.get("relevance");
		if (!(profile instanceof String name) || !name.startsWith("vecdsl_nn_") || !List.of("cosine", "euclidean", "hamming").contains(search.get("metric"))
				|| !(relevance instanceof Number number) || number.doubleValue() <= 0) {
			return null;
		}
		return 1.0 / number.doubleValue() - 1.0;
	}

	/** The canonical score of a hit (from the distance match feature), the native relevance, or no score. */
	private static Double scoreOf(Map<String, Object> hit, Map<String, Object> search) {
		if (Boolean.FALSE.equals(search.get("scores"))) {
			return null;
		}
		String feature = (String) search.get("feature");
		if (feature != null && !Boolean.TRUE.equals(search.get("native"))) {
			Object distance = map(map(hit.get("fields")).get("matchfeatures")).get(feature);
			if (!(distance instanceof Number)) {
				distance = closenessDistance(hit, search);
			}
			if (!(distance instanceof Number number)) {
				throw new VespaException("hit " + hit.get("id") + " has no match feature " + feature);
			}
			return similarity(number.doubleValue(), (String) search.get("metric"));
		}
		return ((Number) hit.getOrDefault("relevance", 0.0)).doubleValue();
	}

	private static Map<String, Object> rootOf(Client client, Map<String, Object> search) {
		Map<String, Object> request = new LinkedHashMap<>(search);
		request.put("body", queryVector(client, map(search.get("body")), map(search.get("lookup"))));
		return query(client, request);
	}

	/** The hits of one query, best first, with their canonical score (or the native relevance), or no score. */
	private static List<Object[]> scored(Client client, Map<String, Object> search) {
		List<Object[]> result = new ArrayList<>();
		for (Map<String, Object> hit : hitsOf(rootOf(client, search))) {
			result.add(new Object[] { map(hit.get("fields")), scoreOf(hit, search) });
		}
		return result;
	}

	/** The groups of a query whose YQL ends in all(group(f) max(n) each(max(m) each(output(summary())))), in Vespa's order. */
	private static List<Object[]> groupsOf(Client client, Map<String, Object> search) {
		List<Object[]> groups = new ArrayList<>();
		for (Object top : items(rootOf(client, search).get("children"))) {
			if (!String.valueOf(map(top).get("id")).startsWith("group:root")) {
				continue;
			}
			for (Object groupList : items(map(top).get("children"))) {
				for (Object group : items(map(groupList).get("children"))) {
					List<Object[]> hits = new ArrayList<>();
					for (Object hitList : items(map(group).get("children"))) {
						for (Object hit : items(map(hitList).get("children"))) {
							if (map(hit).containsKey("fields")) {
								hits.add(new Object[] { map(map(hit).get("fields")), scoreOf(map(hit), search) });
							}
						}
					}
					groups.add(new Object[] { map(group).get("value"), hits });
				}
			}
		}
		return groups;
	}

	private static int compareValues(Object left, Object right) {
		if (left instanceof String a && right instanceof String b) {
			return a.compareTo(b);
		}
		if (left instanceof String || right instanceof String) {
			return left instanceof String ? 1 : -1;
		}
		return Double.compare(sortNumber(left), sortNumber(right));
	}

	private static double sortNumber(Object value) {
		return value instanceof Boolean flag ? (flag ? 1 : 0) : ((Number) value).doubleValue();
	}

	/** Hits ordered by the sort keys (null names the score), missing values last, the earlier order breaking ties. */
	private static List<Object[]> sortedHits(List<Object[]> found, List<Object> order) {
		List<Object[]> result = new ArrayList<>(found);
		result.sort((left, right) -> {
			for (Object clause : order) {
				List<Object> pair = items(clause);
				String field = (String) pair.get(0);
				Object a = field == null ? left[1] : map(left[0]).get(field);
				Object b = field == null ? right[1] : map(right[0]).get(field);
				if (a == null || b == null) {
					if ((a == null) != (b == null)) {
						return a == null ? 1 : -1;
					}
					continue;
				}
				int difference = compareValues(a, b) * ("desc".equals(pair.get(1)) ? -1 : 1);
				if (difference != 0) {
					return difference;
				}
			}
			return 0;
		});
		return result;
	}

	/** Slice i of n: the first 28 bits of the md5 of the key text, modulo n, are i (the same slices on every target). */
	private static boolean inSlice(Object identifier, List<Object> part) {
		try {
			byte[] digest = MessageDigest.getInstance("MD5").digest(keyText(identifier).getBytes(StandardCharsets.UTF_8));
			StringBuilder hex = new StringBuilder();
			for (byte item : digest) {
				hex.append(String.format("%02x", item));
			}
			return Long.parseLong(hex.substring(0, 7), 16) % ((Number) part.get(1)).longValue() == ((Number) part.get(0)).longValue();
		} catch (NoSuchAlgorithmException e) {
			throw new IllegalStateException(e);
		}
	}

	/** Pages of a query in result order: every page, or the hits after the cursor record and in the slice, offset and limit applied. */
	private static List<Object[]> stream(Client client, Map<String, Object> args) {
		Map<String, Object> body = map(args.get("body"));
		String key = (String) args.get("key");
		Object after = args.get("after");
		List<Object> part = args.get("slice") == null ? null : items(args.get("slice"));
		boolean every = Boolean.TRUE.equals(args.get("every"));
		Integer limit = args.get("limit") == null ? null : ((Number) args.get("limit")).intValue();
		int offset = args.get("offset") == null ? 0 : ((Number) args.get("offset")).intValue();
		int size = ((Number) body.get("hits")).intValue();
		boolean plainPages = after == null && part == null;
		int start = plainPages ? ((Number) body.getOrDefault("offset", 0)).intValue() : 0;
		boolean passed = after == null;
		List<Object[]> found = new ArrayList<>();
		while (true) {
			Map<String, Object> page = new LinkedHashMap<>(args);
			Map<String, Object> pageBody = new LinkedHashMap<>(body);
			pageBody.put("offset", start);
			page.put("body", pageBody);
			List<Object[]> batch = scored(client, page);
			start += batch.size();
			for (Object[] item : batch) {
				Object identifier = map(item[0]).get(key);
				if (!passed) {
					passed = keyText(identifier).equals(keyText(after));
				} else if (part == null || inSlice(identifier, part)) {
					found.add(item);
				}
			}
			if (batch.size() < size || (!every && limit != null && found.size() >= offset + limit)) {
				break;
			}
		}
		if (plainPages) {
			return found;
		}
		int from = Math.min(offset, found.size());
		return limit == null ? found.subList(from, found.size()) : found.subList(from, Math.min(offset + limit, found.size()));
	}

	private static boolean within(Double score, Object low, Object high) {
		return score == null || ((low == null || score >= ((Number) low).doubleValue()) && (high == null || score <= ((Number) high).doubleValue()));
	}

	/**
	 * A query built by the generator: the hits (id, score, output fields, vector fields), or {hits, total} with total; every: all pages;
	 * after: the hits after the cursor record; slice: [i, n]; order: sort keys over the selected hits; groups: Vespa's groups.
	 */
	@SuppressWarnings("unchecked")
	public static Object search(Client client, Map<String, Object> args) {
		String key = (String) args.get("key");
		List<String> highlight = strings(args.get("highlight"));
		List<Object> result = new ArrayList<>();
		if (args.get("groups") != null) {
			List<Object[]> groups = groupsOf(client, args);
			int skip = ((Number) map(args.get("groups")).getOrDefault("offset", 0)).intValue();
			for (Object[] group : groups.subList(Math.min(skip, groups.size()), groups.size())) {
				List<Object> hits = new ArrayList<>();
				for (Object[] item : (List<Object[]>) group[1]) {
					if (within((Double) item[1], args.get("low"), args.get("high"))) {
						Map<String, Object> fields = (Map<String, Object>) item[0];
						hits.add(project(fields, key, strings(args.get("output")), strings(args.get("vectors")), (Double) item[1], highlight,
								fields.get("rankfeatures")));
					}
				}
				result.add(args("group", value(group[0]), "hits", hits));
			}
		} else {
			boolean streamed = Boolean.TRUE.equals(args.get("every")) || args.get("after") != null || args.get("slice") != null;
			List<Object[]> found = new ArrayList<>();
			for (Object[] item : streamed ? stream(client, args) : scored(client, args)) {
				if (within((Double) item[1], args.get("low"), args.get("high"))) {
					found.add(item);
				}
			}
			if (!items(args.get("order")).isEmpty()) {
				found = sortedHits(found, items(args.get("order")));
			}
			for (Object[] item : found) {
				Map<String, Object> fields = (Map<String, Object>) item[0];
				result.add(project(fields, key, strings(args.get("output")), strings(args.get("vectors")), (Double) item[1], highlight,
						fields.get("rankfeatures")));
			}
		}
		return args.get("total") == null ? result : args("hits", result, "total", count(client, map(args.get("total"))));
	}

	/**
	 * Legs queried one by one and fused as vecDSL defines rrf (sum of 1/(k + rank)), weighted and relative_score; ties by key. after: the hits
	 * after the cursor record; groups: the fused hits grouped by a field; explain: each leg's rank features; total: {hits, total}.
	 */
	@SuppressWarnings("unchecked")
	public static Object hybrid(Client client, Map<String, Object> args) {
		String fusion = (String) args.get("fusion");
		String key = (String) args.get("key");
		List<Object> legs = items(args.get("legs"));
		List<Object> weights = args.get("weights") == null ? null : items(args.get("weights"));
		int k = args.get("k") == null ? 60 : ((Number) args.get("k")).intValue();
		Map<String, Double> fused = new LinkedHashMap<>();
		Map<String, Map<String, Object>> documents = new LinkedHashMap<>();
		Map<String, List<Object>> explained = new LinkedHashMap<>();
		boolean explain = Boolean.TRUE.equals(args.get("explain"));
		for (int index = 0; index < legs.size(); index++) {
			List<Object[]> values = new ArrayList<>();
			for (Object[] item : scored(client, map(legs.get(index)))) {
				values.add(new Object[] { item[0], item[1] == null ? 0.0 : (Double) item[1] });
			}
			if (fusion.equals("relative_score") && !values.isEmpty()) {
				double least = values.stream().mapToDouble(item -> (Double) item[1]).min().orElse(0);
				double most = values.stream().mapToDouble(item -> (Double) item[1]).max().orElse(0);
				for (Object[] item : values) {
					item[1] = most == least ? 1.0 : ((Double) item[1] - least) / (most - least);
				}
			}
			double weight = weights == null ? 1.0 : ((Number) weights.get(index)).doubleValue();
			int rank = 0;
			for (Object[] item : values) {
				rank += 1;
				Map<String, Object> fields = (Map<String, Object>) item[0];
				String name = keyText(fields.get(key));
				Map<String, Object> merged = documents.computeIfAbsent(name, missing -> new LinkedHashMap<>());
				// the keyword leg's bolded fragment wins over the vector leg's unmarked one
				fields.forEach((fieldName, fieldValue) -> {
					if (fieldName.startsWith(HIGHLIGHT) && marked(fieldValue)) {
						merged.put(fieldName, fieldValue);
					} else {
						merged.putIfAbsent(fieldName, fieldValue);
					}
				});
				if (explain) {
					List<Object> perLeg = explained.computeIfAbsent(name, missing -> new ArrayList<>(Arrays.asList(new Object[legs.size()])));
					perLeg.set(index, fields.get("rankfeatures"));
				}
				double part = fusion.equals("rrf") ? 1.0 / (k + rank) : weight * (Double) item[1];
				fused.merge(name, part, Double::sum);
			}
		}
		List<String> ranked = new ArrayList<>(documents.keySet());
		ranked.sort(Comparator.<String>comparingDouble(name -> -fused.get(name))
				.thenComparing((left, right) -> compareIds(documents.get(left).get(key), documents.get(right).get(key))));
		ranked.removeIf(name -> !within(fused.get(name), args.get("low"), args.get("high")));
		if (args.get("after") != null) {
			int position = ranked.indexOf(keyText(args.get("after")));
			ranked = position < 0 ? new ArrayList<>() : new ArrayList<>(ranked.subList(position + 1, ranked.size()));
		}
		int offset = args.get("offset") == null ? 0 : ((Number) args.get("offset")).intValue();
		int limit = ((Number) args.get("limit")).intValue();
		List<String> highlight = strings(args.get("highlight"));
		List<Object> result = new ArrayList<>();
		if (args.get("groups") != null) {
			Map<String, Object> grouping = map(args.get("groups"));
			String field = (String) grouping.get("field");
			int size = ((Number) grouping.getOrDefault("size", 1)).intValue();
			Map<String, List<String>> members = new LinkedHashMap<>();
			Map<String, Object> labels = new LinkedHashMap<>();
			for (String name : ranked) {
				Object label = documents.get(name).get(field);
				if (label == null) {
					continue;
				}
				String group = dumps(label);
				labels.putIfAbsent(group, label);
				List<String> names = members.computeIfAbsent(group, missing -> new ArrayList<>());
				if (names.size() < size) {
					names.add(name);
				}
			}
			List<String> groups = new ArrayList<>(members.keySet());
			for (String group : groups.subList(Math.min(offset, groups.size()), Math.min(offset + limit, groups.size()))) {
				List<Object> hits = new ArrayList<>();
				for (String name : members.get(group)) {
					hits.add(project(documents.get(name), key, strings(args.get("output")), strings(args.get("vectors")), fused.get(name), highlight,
							explained.get(name)));
				}
				result.add(args("group", value(labels.get(group)), "hits", hits));
			}
		} else {
			List<Object[]> page = new ArrayList<>();
			for (String name : ranked.subList(Math.min(offset, ranked.size()), Math.min(offset + limit, ranked.size()))) {
				page.add(new Object[] { documents.get(name), fused.get(name) });
			}
			if (!items(args.get("order")).isEmpty()) {
				page = sortedHits(page, items(args.get("order")));
			}
			for (Object[] item : page) {
				String name = keyText(map(item[0]).get(key));
				result.add(project(documents.get(name), key, strings(args.get("output")), strings(args.get("vectors")), fused.get(name), highlight,
						explained.get(name)));
			}
		}
		return args.get("total") == null ? result : args("hits", result, "total", count(client, map(args.get("total"))));
	}

	/** The totalCount of a query without hits (exact for filters; a count never uses nearestNeighbor). */
	public static long count(Client client, Map<String, Object> args) {
		return ((Number) map(query(client, args).get("fields")).getOrDefault("totalCount", 0L)).longValue();
	}

	/** Each sampled record with its nearest neighbours among the sample (canonical similarity, computed in the runtime). */
	@SuppressWarnings("unchecked")
	public static Object distanceMatrix(Client client, Map<String, Object> args) {
		String field = (String) args.get("field");
		String key = (String) args.get("key");
		String metric = (String) args.get("metric");
		int limit = ((Number) args.get("limit")).intValue();
		Map<String, Object> search = new LinkedHashMap<>(args);
		search.put("scores", false);
		List<Map<String, Object>> sample = new ArrayList<>();
		for (Object[] item : scored(client, search)) {
			Map<String, Object> fields = (Map<String, Object>) item[0];
			if (!items(fields.get(field)).isEmpty()) {
				sample.add(fields);
			}
		}
		List<Object> pairs = new ArrayList<>();
		for (Map<String, Object> left : sample) {
			List<Object[]> scores = new ArrayList<>();
			for (Map<String, Object> right : sample) {
				if (right == left) {
					continue;
				}
				List<Object> u = items(left.get(field));
				List<Object> v = items(right.get(field));
				double value = 0;
				if (metric.equals("euclidean")) {
					for (int i = 0; i < u.size(); i++) {
						double difference = ((Number) u.get(i)).doubleValue() - ((Number) v.get(i)).doubleValue();
						value += difference * difference;
					}
					value = -Math.sqrt(value);
				} else if (metric.equals("dot")) {
					for (int i = 0; i < u.size(); i++) {
						value += ((Number) u.get(i)).doubleValue() * ((Number) v.get(i)).doubleValue();
					}
				} else if (metric.equals("hamming")) {
					for (int i = 0; i < u.size(); i++) {
						value -= Integer.bitCount((((Number) u.get(i)).intValue() ^ ((Number) v.get(i)).intValue()) & 0xff);
					}
				} else {
					double dot = 0;
					double left2 = 0;
					double right2 = 0;
					for (int i = 0; i < u.size(); i++) {
						double a = ((Number) u.get(i)).doubleValue();
						double b = ((Number) v.get(i)).doubleValue();
						dot += a * b;
						left2 += a * a;
						right2 += b * b;
					}
					double norms = Math.sqrt(left2) * Math.sqrt(right2);
					value = norms == 0 ? 0 : dot / norms;
				}
				scores.add(new Object[] { value, right });
			}
			scores.sort(Comparator.<Object[]>comparingDouble(item -> -(Double) item[0])
					.thenComparing((a, b) -> compareIds(((Map<String, Object>) a[1]).get(key), ((Map<String, Object>) b[1]).get(key))));
			for (Object[] item : scores.subList(0, Math.min(limit, scores.size()))) {
				pairs.add(args("a", left.get(key), "b", ((Map<String, Object>) item[1]).get(key), "score", item[0]));
			}
		}
		return value(pairs);
	}
}
