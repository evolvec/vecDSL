	/** The SDK client over gRPC, and the REST endpoint and key for the calls the gRPC API lacks. */
	public static final class Client implements AutoCloseable {

		final QdrantClient qdrant;
		final String rest;
		final String key;

		Client(QdrantClient qdrant, String rest, String key) {
			this.qdrant = qdrant;
			this.rest = rest;
			this.key = key;
		}

		@Override
		public void close() {
			qdrant.close();
		}
	}

	/** gRPC client on the host of the REST URI and the given gRPC port; https selects TLS. */
	public static Client connect(Map<String, Object> args) {
		URI uri = URI.create(text(args.get("uri")));
		boolean tls = "https".equalsIgnoreCase(uri.getScheme());
		QdrantGrpcClient.Builder builder = QdrantGrpcClient.newBuilder(uri.getHost(), whole(args, "grpc_port", 6334), tls);
		String key = text(args.get("api_key"));
		if (key != null && !key.isBlank()) {
			builder.withApiKey(key);
		}
		if (args.get("timeout") != null) {
			builder.withTimeout(Duration.ofMillis(Math.round(number(args.get("timeout")) * 1000)));
		}
		String rest = text(args.get("uri"));
		return new Client(new QdrantClient(builder.build()), rest.endsWith("/") ? rest.substring(0, rest.length() - 1) : rest, key);
	}

