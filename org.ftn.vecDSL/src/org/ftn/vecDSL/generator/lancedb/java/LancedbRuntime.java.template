	/** The table at its latest version, or checked out at a version number or tag (time travel, read only). */
	private static Dataset read(Client client, Map<String, Object> table, Object version) {
		Dataset dataset = client.open(table);
		if (version == null) {
			return dataset;
		}
		try (dataset) {
			return version instanceof String tag ? dataset.checkoutTag(tag) : dataset.checkoutVersion(((Number) version).longValue());
		}
	}

	// ---------------------------------------------------------------- writes

	private static Object key(Object value) {
		if (value instanceof Double || value instanceof Float) {
			double number = ((Number) value).doubleValue();
			return number == Math.rint(number) ? (Object) (long) number : value;
		}
		return value instanceof Number number ? (Object) number.longValue() : value;
	}

	private static String keyList(Map<String, Object> table, Collection<?> keys) {
		return quote((String) table.get("key")) + " IN (" + String.join(", ", keys.stream().map(k -> literal(key(k))).toList()) + ")";
	}

	private static long write(Client client, Map<String, Object> table, Object schema, List<Map<String, Object>> rows, String conflict,
			Object defaults, Object slice, Integer batchSize) {
		long total = 0;
		int size = batchSize == null ? BATCH : batchSize;
		for (int start = 0; start < rows.size(); start += size) {
			List<Map<String, Object>> batch = rows.subList(start, Math.min(rows.size(), start + size));
			List<Object> keys = batch.stream().map(row -> key(row.get(table.get("key")))).toList();
			if (new HashSet<>(keys).size() != keys.size()) {
				throw new IllegalArgumentException("duplicate keys in one insert into " + table.get("name"));
			}
			try (Dataset dataset = client.open(table)) {
				if (conflict.equals("error")) {
					long existing = dataset.countRows(keyList(table, keys));
					if (existing > 0) {
						throw new IllegalStateException(existing + " of the keys already exist in " + table.get("name"));
					}
				}
				MergeInsertParams params = new MergeInsertParams(List.of((String) table.get("key")));
				if (conflict.equals("update") || conflict.equals("replace")) {
					params.withMatchedUpdateAll();
				}
				try (ArrowArrayStream data = stream(client, schema, batch, defaults, slice)) {
					MergeInsertResult result = dataset.mergeInsert(params, data);
					result.dataset().close();
					total += result.stats().numInsertedRows() + result.stats().numUpdatedRows();
				}
			}
		}
		return total;
	}

	/**
	 * Inserts records keyed by the primary key: a merge insert that only inserts, after a check for existing keys
	 * (on-conflict error), or that also updates matches (update, replace); Lance itself has no primary-key constraint.
	 */
	public static Map<String, Object> insert(Client client, Map<String, Object> args) {
		String conflict = args.get("on_conflict") == null ? "error" : (String) args.get("on_conflict");
		return args("insert_count", write(client, map(args.get("table")), args.get("schema"), records(args.get("rows")), conflict,
				args.get("defaults"), args.get("slice"), number(args, "batch_size")));
	}

	public static Map<String, Object> upsert(Client client, Map<String, Object> args) {
		return args("upsert_count", write(client, map(args.get("table")), args.get("schema"), records(args.get("rows")), "update",
				args.get("defaults"), args.get("slice"), number(args, "batch_size")));
	}

	/** Records of a local JSON array or JSON Lines file (file:// URIs and paths). */
	public static List<Map<String, Object>> readRecords(Client client, Map<String, Object> args) {
		String location = (String) args.get("location");
		Path path = Path.of(location.startsWith("file://") ? location.substring("file://".length()) : location);
		try {
			String content = Files.readString(path);
			if (content.stripLeading().startsWith("[")) {
				return records(NUMBERS.fromJson(content, List.class));
			}
			List<Map<String, Object>> rows = new ArrayList<>();
			for (String line : content.split("\\r?\\n")) {
				if (!line.isBlank()) {
					rows.add(map(NUMBERS.fromJson(line, Map.class)));
				}
			}
			return rows;
		} catch (IOException e) {
			throw new UncheckedIOException(e);
		}
	}

	public static Map<String, Object> importFile(Client client, Map<String, Object> args) {
		String conflict = args.get("on_conflict") == null ? "error" : (String) args.get("on_conflict");
		return args("import_count", write(client, map(args.get("table")), args.get("schema"), readRecords(client, args), conflict,
				args.get("defaults"), args.get("slice"), number(args, "batch_size")));
	}

	/** An UPDATE with generated SQL expressions (literals, array_concat, array_remove_all) on the rows of a where string. */
	public static Map<String, Object> update(Client client, Map<String, Object> args) {
		Map<String, String> values = new LinkedHashMap<>();
		map(args.get("values")).forEach((name, expression) -> values.put(name, (String) expression));
		try (Dataset dataset = client.open(map(args.get("table")))) {
			UpdateResult result = dataset.update(new UpdateParams(values).withWhere((String) args.get("where")));
			result.getDataset().close();
			return args("update_count", result.getNumRowsUpdated());
		}
	}

	private static List<Map<String, Object>> select(Client client, Map<String, Object> table, String where, List<String> columns) {
		ScanOptions.Builder options = new ScanOptions.Builder().columns(columns);
		if (where != null) {
			options.filter(where);
		}
		try (Dataset dataset = client.open(table)) {
			return scan(dataset, options.build());
		}
	}

	/** Update mode replace: every matching record is rewritten with the given values and nulls (or defaults) elsewhere; vectors and slice columns are kept. */
	public static Map<String, Object> replaceRows(Client client, Map<String, Object> args) {
		Map<String, Object> table = map(args.get("table"));
		List<String> kept = new ArrayList<>(List.of((String) table.get("key")));
		for (Object field : items(args.get("schema"))) {
			Map<String, Object> spec = map(field);
			String name = (String) spec.get("name");
			if ("vector".equals(spec.get("type")) || "multivector".equals(spec.get("type")) || name.startsWith("vecdsl_")) {
				kept.add(name);
			}
		}
		List<Map<String, Object>> found = select(client, table, (String) args.get("where"), kept);
		if (found.isEmpty()) {
			return args("update_count", 0);
		}
		List<Map<String, Object>> rows = new ArrayList<>();
		for (Map<String, Object> row : found) {
			Map<String, Object> changed = new LinkedHashMap<>(row);
			changed.putAll(map(args.get("values")));
			rows.add(changed);
		}
		write(client, table, args.get("schema"), rows, "update", args.get("defaults"), null, null);
		return args("update_count", found.size());
	}

	/** Vector, list and struct values: the matching rows are read, changed and written back by a merge insert on the key. */
	public static Map<String, Object> patchRows(Client client, Map<String, Object> args) {
		Map<String, Object> table = map(args.get("table"));
		List<String> columns = items(args.get("schema")).stream().map(field -> (String) map(field).get("name")).toList();
		List<Map<String, Object>> found = select(client, table, (String) args.get("where"), columns);
		if (found.isEmpty()) {
			return args("update_count", 0);
		}
		List<Map<String, Object>> rows = new ArrayList<>();
		for (Map<String, Object> row : found) {
			Map<String, Object> changed = new LinkedHashMap<>(row);
			changed.putAll(map(args.get("values")));
			rows.add(changed);
		}
		return args("update_count", write(client, table, args.get("schema"), rows, "update", null, null, null));
	}

	/** Update from records: a merge insert that updates the matching keys (optionally only rows of a where string). */
	public static Map<String, Object> updateFrom(Client client, Map<String, Object> args) {
		Map<String, Object> table = map(args.get("table"));
		String key = (String) table.get("key");
		List<Map<String, Object>> given = records(args.get("rows"));
		if (given.isEmpty()) {
			return args("update_count", 0);
		}
		List<String> columns = items(args.get("schema")).stream().map(field -> (String) map(field).get("name")).toList();
		String condition = keyList(table, given.stream().map(row -> row.get(key)).toList())
				+ (args.get("where") == null ? "" : " AND (" + args.get("where") + ")");
		Map<Object, Map<String, Object>> current = new LinkedHashMap<>();
		for (Map<String, Object> row : select(client, table, condition, columns)) {
			current.put(key(row.get(key)), row);
		}
		List<Map<String, Object>> rows = new ArrayList<>();
		for (Map<String, Object> row : given) {
			Map<String, Object> stored = current.get(key(row.get(key)));
			if (stored != null) {
				Map<String, Object> merged = new LinkedHashMap<>(stored);
				merged.putAll(row);
				rows.add(merged);
			}
		}
		return args("update_count", rows.isEmpty() ? 0 : write(client, table, args.get("schema"), rows, "update", null, null, null));
	}

	/** The distinct values of a slice column (tenants, namespaces, partitions), sorted. */
	public static List<String> listValues(Client client, Map<String, Object> args) {
		String column = (String) args.get("column");
		List<String> values = select(client, map(args.get("table")), null, List.of(column)).stream().map(row -> (String) row.get(column))
				.filter(item -> item != null && (args.get("prefix") == null || item.startsWith((String) args.get("prefix")))).distinct().sorted().toList();
		return head(values, number(args, "limit"));
	}

	/** Deletes the rows of a where string; a limit deletes the first rows in key order (Lance's delete has no limit). */
	public static Map<String, Object> delete(Client client, Map<String, Object> args) {
		Map<String, Object> table = map(args.get("table"));
		String where = (String) args.get("where");
		Integer limit = number(args, "limit");
		if (limit != null) {
			String key = (String) table.get("key");
			List<Object> keys = select(client, table, where, List.of(key)).stream().map(row -> row.get(key)).sorted(LancedbRuntime::compare)
					.limit(limit).toList();
			if (keys.isEmpty()) {
				return args("delete_count", 0);
			}
			where = keyList(table, keys);
		}
		try (Dataset dataset = client.open(table)) {
			long before = dataset.countRows(where);
			dataset.delete(where);
			return args("delete_count", before);
		}
	}

	public static Map<String, Object> truncate(Client client, Map<String, Object> args) {
		return delete(client, args("table", args.get("table"), "where", args.get("where") == null ? "true" : args.get("where")));
	}

	// ---------------------------------------------------------------- reads

	/** Every row of a scan as plain values (lists, maps, strings, numbers). */
	private static List<Map<String, Object>> scan(Dataset dataset, ScanOptions options) {
		List<Map<String, Object>> rows = new ArrayList<>();
		LanceScanner scanner = dataset.newScan(options);
		try (ArrowReader reader = scanner.scanBatches()) {
			while (reader.loadNextBatch()) {
				VectorSchemaRoot root = reader.getVectorSchemaRoot();
				for (int i = 0; i < root.getRowCount(); i++) {
					Map<String, Object> row = new LinkedHashMap<>();
					for (FieldVector vector : root.getFieldVectors()) {
						row.put(vector.getName(), plain(vector.getObject(i), vector.getField()));
					}
					rows.add(row);
				}
			}
		} catch (IOException e) {
			throw new UncheckedIOException(e);
		} finally {
			close(scanner);
		}
		return rows;
	}

	private static void close(LanceScanner scanner) {
		try {
			scanner.close();
		} catch (Exception e) {
			throw new IllegalStateException("closing a scanner failed", e);
		}
	}

	@SuppressWarnings("unchecked")
	private static Object plain(Object item, Field field) {
		if (item == null) {
			return null;
		}
		if (item instanceof Text text) {
			return text.toString();
		}
		if (item instanceof byte[] bytes) {
			return new String(bytes, StandardCharsets.UTF_8);
		}
		if (item instanceof LocalDateTime time) {
			return time.toString();
		}
		if (field.getType() instanceof ArrowType.Date && item instanceof Integer days) {
			return LocalDate.ofEpochDay(days).toString();
		}
		if (item instanceof List<?> values) {
			Field child = field.getChildren().isEmpty() ? field : field.getChildren().get(0);
			return values.stream().map(value -> plain(value, child)).toList();
		}
		if (item instanceof Map<?, ?> values) {
			Map<String, Object> result = new LinkedHashMap<>();
			for (Field child : field.getChildren()) {
				result.put(child.getName(), plain(((Map<String, Object>) values).get(child.getName()), child));
			}
			return result;
		}
		return item;
	}

	private static int compare(Object a, Object b) {
		int rankA = a == null ? 2 : a instanceof Number ? 0 : 1;
		int rankB = b == null ? 2 : b instanceof Number ? 0 : 1;
		if (rankA != rankB) {
			return Integer.compare(rankA, rankB);
		}
		if (a instanceof Number x && b instanceof Number y) {
			return Double.compare(x.doubleValue(), y.doubleValue());
		}
		return a == null ? 0 : String.valueOf(a).compareTo(String.valueOf(b));
	}

	/** Canonical similarity of Lance's _distance: l2 is the squared Euclidean distance, cosine 1 - cos, dot 1 - x.y. */
	public static double similarity(String metric, double distance) {
		return switch (metric) {
		case "l2" -> -Math.sqrt(Math.max(distance, 0));
		case "hamming" -> -distance;
		default -> 1 - distance;
		};
	}

	private static boolean within(double score, Object min, Object max) {
		return (min == null || score >= ((Number) min).doubleValue() - 1e-9) && (max == null || score <= ((Number) max).doubleValue() + 1e-9);
	}

	private static List<String> columns(Map<String, Object> table, Object output, Object vectors, Object order) {
		List<String> columns = new ArrayList<>();
		columns.add((String) table.get("key"));
		for (String name : strings(output)) {
			if (!columns.contains(name)) {
				columns.add(name);
			}
		}
		List<String> extra = Boolean.TRUE.equals(vectors) ? (table.get("vectors") == null ? List.of() : new ArrayList<>(map(table.get("vectors")).keySet()))
				: vectors instanceof List<?> ? strings(vectors) : List.of();
		for (String name : extra) {
			if (!columns.contains(name)) {
				columns.add(name);
			}
		}
		for (Object clause : items(order)) {
			String key = (String) map(clause).get("key");
			String root = key.split("\\.")[0];
			if (!key.equals("score") && !columns.contains(root)) {
				columns.add(root);
			}
		}
		return columns;
	}

	/** The columns a search reads: those of columns(...) and the root of the group key. */
	private static List<String> columns(Map<String, Object> table, Object output, Object vectors, Object order, Object group) {
		List<String> columns = columns(table, output, vectors, order);
		if (group != null) {
			String root = ((String) map(group).get("key")).split("\\.")[0];
			if (!columns.contains(root)) {
				columns.add(root);
			}
		}
		return columns;
	}

	private static Map<String, Object> record(Map<String, Object> table, Map<String, Object> row, List<String> shown, Double score) {
		Map<String, Object> result = new LinkedHashMap<>();
		result.put("id", value(row.get(table.get("key"))));
		if (score != null) {
			result.put("score", value(score));
		}
		for (String name : shown) {
			if (!name.equals(table.get("key"))) {
				result.put(name, value(row.get(name)));
			}
		}
		return result;
	}

	private static Object path(Map<String, Object> row, String key) {
		Object current = row;
		for (String part : key.split("\\.")) {
			current = current instanceof Map<?, ?> nested ? nested.get(part) : null;
		}
		return current;
	}

	private record Hit(Map<String, Object> row, double score, double distance) {
	}

	/** Stable sorts by the sort clauses, last clause first; nulls last in both directions. */
	private static <T> List<T> ordered(List<T> items, Object order, BiFunction<T, String, Object> get) {
		List<T> result = new ArrayList<>(items);
		List<Object> clauses = new ArrayList<>(items(order));
		Collections.reverse(clauses);
		for (Object clause : clauses) {
			String key = (String) map(clause).get("key");
			boolean descending = "desc".equals(map(clause).get("direction"));
			List<T> present = new ArrayList<>(result.stream().filter(item -> get.apply(item, key) != null).toList());
			List<T> missing = result.stream().filter(item -> get.apply(item, key) == null).toList();
			Comparator<T> comparator = (a, b) -> compare(value(get.apply(a, key)), value(get.apply(b, key)));
			present.sort(descending ? comparator.reversed() : comparator);
			result = new ArrayList<>(present);
			result.addAll(missing);
		}
		return result;
	}

	private static List<Map<String, Object>> page(Map<String, Object> table, List<Hit> hits, List<String> shown, Map<String, Object> args) {
		int offset = args.get("offset") == null ? 0 : number(args, "offset");
		int limit = number(args, "limit");
		if (args.get("group") != null) {
			return groups(table, hits, shown, limit, offset, args);
		}
		List<Hit> window = hits.stream().filter(hit -> within(hit.score(), args.get("score_min"), args.get("score_max"))).limit(offset + limit).toList();
		window = ordered(window, args.get("order"), (hit, key) -> key.equals("score") ? (Object) hit.score() : path(hit.row(), key));
		return window.stream().skip(offset).map(hit -> record(table, hit.row(), shown, hit.score())).toList();
	}

	/**
	 * Hits grouped by the value of the group key: the groups whose best hit ranks highest (offset and limit count groups), each
	 * with its best size hits within the score bounds; a group left without a hit is dropped.
	 */
	private static List<Map<String, Object>> groups(Map<String, Object> table, List<Hit> hits, List<String> shown, int limit, int offset,
			Map<String, Object> args) {
		Map<String, Object> group = map(args.get("group"));
		String key = (String) group.get("key");
		int size = group.get("size") == null ? 1 : number(group, "size");
		Map<String, List<Hit>> members = new LinkedHashMap<>();
		for (Hit hit : hits) {
			members.computeIfAbsent(COMPACT.toJson(value(path(hit.row(), key))), ignored -> new ArrayList<>()).add(hit);
		}
		List<Map<String, Object>> result = new ArrayList<>();
		for (List<Hit> grouped : members.values().stream().skip(offset).limit(limit).toList()) {
			List<Hit> kept = grouped.stream().limit(size).filter(hit -> within(hit.score(), args.get("score_min"), args.get("score_max"))).toList();
			if (!kept.isEmpty()) {
				Map<String, Object> entry = new LinkedHashMap<>();
				entry.put("group", value(path(kept.get(0).row(), key)));
				entry.put("hits", kept.stream().map(hit -> record(table, hit.row(), shown, hit.score())).toList());
				result.add(entry);
			}
		}
		return result;
	}

	/** Candidates a search ranks: limit plus offset, or every row the where string selects when the hits are grouped. */
	private static int window(Client client, Map<String, Object> table, Map<String, Object> plan, Map<String, Object> args) {
		if (args.get("group") == null) {
			return number(args, "limit") + (args.get("offset") == null ? 0 : number(args, "offset"));
		}
		return (int) Math.max(count(client, args("table", table, "where", plan.get("where"), "version", args.get("version"))), 1);
	}

	private static Comparator<Hit> byScore(Map<String, Object> table) {
		return (a, b) -> {
			int order = Double.compare(b.score(), a.score());
			return order != 0 ? order : compare(value(a.row().get(table.get("key"))), value(b.row().get(table.get("key"))));
		};
	}

	private static float[] floatArray(Object vector) {
		List<?> values = items(vector);
		float[] result = new float[values.size()];
		for (int i = 0; i < result.length; i++) {
			result[i] = ((Number) values.get(i)).floatValue();
		}
		return result;
	}

	/** Rows nearest to a vector with their canonical similarity and Lance distance, best first, ties by key. */
	private static List<Hit> nearest(Client client, Map<String, Object> table, Map<String, Object> plan, Object vector, int limit,
			List<String> columns, Object version) {
		Query.Builder query = new Query.Builder().setColumn((String) plan.get("column")).setK(limit).setDistanceType(distance(plan.get("metric")))
				.setUseIndex(!Boolean.TRUE.equals(plan.get("exact")));
		boolean multivector = Boolean.TRUE.equals(plan.get("multivector"));
		if (multivector) {
			List<?> vectors = items(vector);
			float[][] keys = new float[vectors.size()][];
			for (int i = 0; i < keys.length; i++) {
				keys[i] = floatArray(vectors.get(i));
			}
			query.setKeys(keys);
		} else {
			if (Boolean.TRUE.equals(plan.get("bits"))) {
				throw unsupported("lancedb", "hamming search over binary vectors in Java; Query.Builder.setKey takes float[] and Lance compares a "
						+ "query of the column's element type (uint8)");
			}
			query.setKey(floatArray(vector));
		}
		if (plan.get("nprobes") != null) {
			query.setNprobes(number(plan, "nprobes"));
		}
		if (plan.get("refine_factor") != null) {
			query.setRefineFactor(number(plan, "refine_factor"));
		}
		if (plan.get("ef") != null) {
			query.setEf(number(plan, "ef"));
		}
		ScanOptions.Builder options = new ScanOptions.Builder().nearest(query.build()).columns(columns);
		if (plan.get("where") != null) {
			options.filter((String) plan.get("where")).prefilter(!Boolean.FALSE.equals(plan.get("prefilter")));
		}
		List<Map<String, Object>> rows;
		try (Dataset dataset = read(client, table, version)) {
			rows = scan(dataset, options.build());
		}
		int queries = multivector ? items(vector).size() : 0;
		List<Hit> result = new ArrayList<>();
		for (Map<String, Object> row : rows) {
			double distance = ((Number) row.get("_distance")).doubleValue();
			result.add(new Hit(row, multivector ? queries - distance : similarity((String) plan.get("metric"), distance), distance));
		}
		result.sort(byScore(table));
		return result;
	}

	private static List<Hit> scored(List<Hit> hits, boolean nativeScore) {
		return nativeScore ? hits.stream().map(hit -> new Hit(hit.row(), hit.distance(), hit.distance())).toList() : hits;
	}

	public static List<Map<String, Object>> vectorSearch(Client client, Map<String, Object> args) {
		Map<String, Object> table = map(args.get("table"));
		int window = window(client, table, map(args.get("plan")), args);
		List<String> columns = columns(table, args.get("output"), args.get("vectors"), args.get("order"), args.get("group"));
		List<Hit> hits = nearest(client, table, map(args.get("plan")), args.get("vector"), window, columns, args.get("version"));
		return page(table, scored(hits, Boolean.TRUE.equals(args.get("native"))), columns(table, args.get("output"), args.get("vectors"), null), args);
	}

	public static List<Object> lookupVector(Client client, Map<String, Object> args) {
		Map<String, Object> table = map(args.get("table"));
		String column = (String) args.get("column");
		List<Map<String, Object>> rows = select(client, table, keyList(table, List.of(args.get("id"))), List.of(column));
		if (rows.isEmpty()) {
			throw new IllegalStateException("record " + args.get("id") + " not found in " + table.get("name"));
		}
		return new ArrayList<>(items(rows.get(0).get(column)));
	}

	private static FullTextQuery textQuery(Map<String, Object> plan, String query) {
		List<String> columns = strings(plan.get("columns"));
		FullTextQuery.Operator operator = "and".equals(plan.get("operator")) ? FullTextQuery.Operator.AND : FullTextQuery.Operator.OR;
		Map<String, Object> boosts = plan.get("boosts") == null ? Map.of() : map(plan.get("boosts"));
		if ("phrase".equals(plan.get("kind"))) {
			if (columns.size() != 1) {
				throw unsupported("lancedb", "a phrase query over several fields");
			}
			return FullTextQuery.phrase(query, columns.get(0), plan.get("slop") == null ? 0 : number(plan, "slop"));
		}
		if (columns.size() == 1) {
			float boost = boosts.get(columns.get(0)) == null ? 1.0f : ((Number) boosts.get(columns.get(0))).floatValue();
			Optional<Integer> fuzziness = Optional.of(plan.get("fuzziness") == null ? 0 : number(plan, "fuzziness"));
			return FullTextQuery.match(query, columns.get(0), boost, fuzziness, 50, operator, 0);
		}
		List<Float> weights = columns.stream().map(column -> boosts.get(column) == null ? 1.0f : ((Number) boosts.get(column)).floatValue()).toList();
		return FullTextQuery.multiMatch(query, columns, weights, operator);
	}

	private static List<Hit> matches(Client client, Map<String, Object> table, Map<String, Object> plan, String query, int limit,
			List<String> columns, Object version) {
		ScanOptions.Builder options = new ScanOptions.Builder().fullTextQuery(textQuery(plan, query)).limit(limit).columns(columns);
		if (plan.get("where") != null) {
			options.filter((String) plan.get("where")).prefilter(!Boolean.FALSE.equals(plan.get("prefilter")));
		}
		List<Map<String, Object>> rows;
		try (Dataset dataset = read(client, table, version)) {
			rows = scan(dataset, options.build());
		}
		List<Hit> hits = new ArrayList<>();
		for (Map<String, Object> row : rows) {
			double score = ((Number) row.get("_score")).doubleValue();
			hits.add(new Hit(row, score, score));
		}
		hits.sort(byScore(table));
		return hits;
	}

	public static List<Map<String, Object>> keywordSearch(Client client, Map<String, Object> args) {
		Map<String, Object> table = map(args.get("table"));
		int window = window(client, table, map(args.get("plan")), args);
		List<String> columns = columns(table, args.get("output"), args.get("vectors"), args.get("order"), args.get("group"));
		List<Hit> hits = matches(client, table, map(args.get("plan")), (String) args.get("text"), window, columns, args.get("version"));
		return page(table, hits, columns(table, args.get("output"), args.get("vectors"), null), args);
	}

	/** Contribution of one leg: 1/(k + rank), weight * similarity, or weight * min-max normalized score. */
	private static Map<String, Double> contribution(String fusion, int k, double weight, List<Map.Entry<String, Double>> ranked) {
		Map<String, Double> result = new LinkedHashMap<>();
		if (fusion.equals("rrf")) {
			for (int rank = 0; rank < ranked.size(); rank++) {
				result.put(ranked.get(rank).getKey(), 1.0 / (k + rank + 1));
			}
			return result;
		}
		if (fusion.equals("weighted")) {
			ranked.forEach(entry -> result.put(entry.getKey(), weight * entry.getValue()));
			return result;
		}
		double low = ranked.stream().mapToDouble(Map.Entry::getValue).min().orElse(0);
		double high = ranked.stream().mapToDouble(Map.Entry::getValue).max().orElse(0);
		ranked.forEach(entry -> result.put(entry.getKey(), weight * (high > low ? (entry.getValue() - low) / (high - low) : 1.0)));
		return result;
	}

	public static List<Map<String, Object>> hybridSearch(Client client, Map<String, Object> args) {
		Map<String, Object> table = map(args.get("table"));
		int limit = number(args, "limit");
		int offset = args.get("offset") == null ? 0 : number(args, "offset");
		int k = args.get("k") == null ? 60 : number(args, "k");
		List<String> columns = columns(table, args.get("output"), args.get("vectors"), args.get("order"), args.get("group"));
		Map<String, Double> totals = new LinkedHashMap<>();
		Map<String, Map<String, Object>> rows = new LinkedHashMap<>();
		for (Object item : items(args.get("legs"))) {
			Map<String, Object> leg = map(item);
			int window = leg.get("limit") == null ? limit + offset : number(leg, "limit");
			List<Hit> hits = "vector".equals(leg.get("kind")) ? nearest(client, table, leg, leg.get("vector"), window, columns, args.get("version"))
					: matches(client, table, leg, (String) leg.get("text"), window, columns, args.get("version"));
			List<Map.Entry<String, Double>> ranked = new ArrayList<>();
			for (Hit hit : hits) {
				if (within(hit.score(), leg.get("score_min"), leg.get("score_max"))) {
					String key = COMPACT.toJson(value(hit.row().get(table.get("key"))));
					rows.putIfAbsent(key, hit.row());
					ranked.add(Map.entry(key, hit.score()));
				}
			}
			double weight = leg.get("weight") == null ? 1.0 : ((Number) leg.get("weight")).doubleValue();
			contribution((String) args.get("fusion"), k, weight, ranked).forEach((key, part) -> totals.merge(key, part, Double::sum));
		}
		List<Hit> fused = new ArrayList<>();
		totals.forEach((key, total) -> fused.add(new Hit(rows.get(key), total, total)));
		fused.sort(byScore(table));
		return page(table, fused, columns(table, args.get("output"), args.get("vectors"), null), args);
	}

	/** Searches from 2 * mean(positives) - mean(negatives) (mean(positives) without negatives); example ids are left out. */
	public static List<Map<String, Object>> recommend(Client client, Map<String, Object> args) {
		Map<String, Object> table = map(args.get("table"));
		Map<String, Object> plan = map(args.get("plan"));
		Map<String, Object> source = args.get("lookup") == null ? table : map(args.get("lookup"));
		List<double[]> positive = new ArrayList<>();
		for (Object item : items(args.get("positives"))) {
			positive.add(example(client, source, plan, item));
		}
		List<double[]> negative = new ArrayList<>();
		for (Object item : items(args.get("negatives"))) {
			negative.add(example(client, source, plan, item));
		}
		double[] towards = mean(positive);
		double[] away = negative.isEmpty() ? null : mean(negative);
		List<Double> query = new ArrayList<>();
		for (int i = 0; i < towards.length; i++) {
			query.add(away == null ? towards[i] : 2 * towards[i] - away[i]);
		}
		Set<String> examples = new HashSet<>();
		if (args.get("lookup") == null) {
			Stream.concat(items(args.get("positives")).stream(), items(args.get("negatives")).stream()).filter(item -> !(item instanceof List<?>))
					.forEach(item -> examples.add(COMPACT.toJson(value(key(item)))));
		}
		int window = window(client, table, plan, args) + examples.size();
		List<String> columns = columns(table, args.get("output"), args.get("vectors"), args.get("order"), args.get("group"));
		List<Hit> hits = nearest(client, table, plan, query, window, columns, args.get("version")).stream()
				.filter(hit -> !examples.contains(COMPACT.toJson(value(hit.row().get(table.get("key")))))).toList();
		return page(table, scored(hits, Boolean.TRUE.equals(args.get("native"))), columns(table, args.get("output"), args.get("vectors"), null), args);
	}

	private static double[] example(Client client, Map<String, Object> source, Map<String, Object> plan, Object item) {
		List<?> values = item instanceof List<?> list ? list : lookupVector(client, args("table", source, "column", plan.get("column"), "id", item));
		return values.stream().mapToDouble(x -> ((Number) x).doubleValue()).toArray();
	}

	private static double[] mean(List<double[]> vectors) {
		double[] result = new double[vectors.get(0).length];
		for (double[] vector : vectors) {
			for (int i = 0; i < result.length; i++) {
				result[i] += vector[i] / vectors.size();
			}
		}
		return result;
	}

	/** Records by key, in the order of the ids; missing keys are left out. */
	public static List<Map<String, Object>> getRows(Client client, Map<String, Object> args) {
		Map<String, Object> table = map(args.get("table"));
		List<?> ids = items(args.get("ids"));
		if (ids.isEmpty()) {
			return List.of();
		}
		List<String> columns = columns(table, args.get("output"), args.get("vectors"), null);
		String condition = keyList(table, ids) + (args.get("where") == null ? "" : " AND (" + args.get("where") + ")");
		List<Map<String, Object>> rows;
		try (Dataset dataset = read(client, table, args.get("version"))) {
			rows = scan(dataset, new ScanOptions.Builder().filter(condition).columns(columns).build());
		}
		Map<Object, Map<String, Object>> found = new LinkedHashMap<>();
		rows.forEach(row -> found.put(value(row.get(table.get("key"))), row));
		return ids.stream().map(id -> found.get(value(key(id)))).filter(row -> row != null).map(row -> record(table, row, columns, null)).toList();
	}

	public static long count(Client client, Map<String, Object> args) {
		try (Dataset dataset = read(client, map(args.get("table")), args.get("version"))) {
			return args.get("where") == null ? dataset.countRows() : dataset.countRows((String) args.get("where"));
		}
	}

	/** A slice of the key space: the key's JSON text hashed with FNV-1a 32, modulo the slice count (the same in every runtime). */
	private static int bucket(Object key, int total) {
		int hash = 0x811c9dc5;
		for (byte b : COMPACT.toJson(value(key)).getBytes(StandardCharsets.UTF_8)) {
			hash = (hash ^ (b & 0xff)) * 0x01000193;
		}
		return (int) (Integer.toUnsignedLong(hash) % total);
	}

	/** Rows in key order (or the sort clauses, then the key), paged by offset and limit after the order is applied. */
	public static List<Map<String, Object>> scroll(Client client, Map<String, Object> args) {
		Map<String, Object> table = map(args.get("table"));
		List<String> columns = columns(table, args.get("output"), args.get("vectors"), args.get("order"));
		ScanOptions.Builder options = new ScanOptions.Builder().columns(columns);
		if (args.get("where") != null) {
			options.filter((String) args.get("where"));
		}
		List<Map<String, Object>> rows;
		try (Dataset dataset = read(client, table, args.get("version"))) {
			rows = new ArrayList<>(scan(dataset, options.build()));
		}
		rows.sort((a, b) -> compare(value(a.get(table.get("key"))), value(b.get(table.get("key")))));
		rows = ordered(rows, args.get("order"), LancedbRuntime::path);
		if (args.get("slice") != null) {
			Map<String, Object> slice = map(args.get("slice"));
			int index = number(slice, "index");
			int total = number(slice, "total");
			rows = rows.stream().filter(row -> bucket(row.get(table.get("key")), total) == index).toList();
		}
		int offset = args.get("offset") == null ? 0 : number(args, "offset");
		Integer limit = number(args, "limit");
		List<String> shown = columns(table, args.get("output"), args.get("vectors"), null);
		return rows.stream().skip(offset).limit(limit == null ? Long.MAX_VALUE : limit).map(row -> record(table, row, shown, null)).toList();
	}

	/** A random sample of the matching records (first: the first records in key order). */
	public static List<Map<String, Object>> sample(Client client, Map<String, Object> args) {
		Map<String, Object> table = map(args.get("table"));
		List<String> columns = columns(table, args.get("output"), false, null);
		ScanOptions.Builder options = new ScanOptions.Builder().columns(columns);
		if (args.get("where") != null) {
			options.filter((String) args.get("where"));
		}
		List<Map<String, Object>> rows;
		try (Dataset dataset = read(client, table, args.get("version"))) {
			rows = new ArrayList<>(scan(dataset, options.build()));
		}
		rows.sort((a, b) -> compare(value(a.get(table.get("key"))), value(b.get(table.get("key")))));
		if (!Boolean.TRUE.equals(args.get("first"))) {
			Collections.shuffle(rows, RANDOM);
		}
		return rows.stream().limit(number(args, "size")).map(row -> record(table, row, columns, null)).toList();
	}

	private static double similarityOf(String metric, List<?> x, List<?> y) {
		double dot = 0;
		double normX = 0;
		double normY = 0;
		double squared = 0;
		int differing = 0;
		for (int i = 0; i < x.size(); i++) {
			double a = ((Number) x.get(i)).doubleValue();
			double b = ((Number) y.get(i)).doubleValue();
			dot += a * b;
			normX += a * a;
			normY += b * b;
			squared += (a - b) * (a - b);
			differing += a != b ? 1 : 0;
		}
		return switch (metric) {
		case "cosine" -> normX == 0 || normY == 0 ? 0 : dot / (Math.sqrt(normX) * Math.sqrt(normY));
		case "dot" -> dot;
		case "hamming" -> -differing;
		default -> -Math.sqrt(squared);
		};
	}

	/** A random sample with, for each sampled record, its nearest neighbours among the sample (canonical similarity). */
	public static List<Map<String, Object>> distanceMatrix(Client client, Map<String, Object> args) {
		Map<String, Object> table = map(args.get("table"));
		Map<String, Object> plan = map(args.get("plan"));
		String column = (String) plan.get("column");
		ScanOptions.Builder options = new ScanOptions.Builder().columns(List.of((String) table.get("key"), column));
		if (args.get("where") != null) {
			options.filter((String) args.get("where"));
		}
		List<Map<String, Object>> rows;
		try (Dataset dataset = read(client, table, args.get("version"))) {
			rows = new ArrayList<>(scan(dataset, options.build()));
		}
		Collections.shuffle(rows, RANDOM);
		List<Map<String, Object>> chosen = rows.subList(0, Math.min(rows.size(), args.get("sample") == null ? 10 : number(args, "sample")));
		int limit = args.get("limit") == null ? 3 : number(args, "limit");
		List<Map<String, Object>> result = new ArrayList<>();
		for (Map<String, Object> row : chosen) {
			List<Hit> others = new ArrayList<>();
			for (Map<String, Object> other : chosen) {
				if (other != row) {
					double score = similarityOf((String) plan.get("metric"), items(row.get(column)), items(other.get(column)));
					others.add(new Hit(other, score, score));
				}
			}
			others.sort(byScore(table));
			result.add(args("id", value(row.get(table.get("key"))), "neighbours", others.stream().limit(limit)
					.map(hit -> args("id", value(hit.row().get(table.get("key"))), "score", value(hit.score()))).toList()));
		}
		result.sort((a, b) -> compare(a.get("id"), b.get("id")));
		return result;
	}
}
