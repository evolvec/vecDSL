/**
 * Runtime support for vecDSL programs generated for LanceDB (embedded, open source) with the Lance Java SDK (lance-core
 * {{lance.version}}), the same Lance format the lancedb Python and TypeScript SDKs write. Generated by vecDSL 7. Do not edit.
 * The generator builds every table schema, where string, index parameter set and write plan; this class only calls the
 * SDK, converts records to the declared Arrow schema and reports results in one form for every host language.
 */
public final class LancedbRuntime {

	private static final int DIGITS = 6;
	private static final int BATCH = 1000;
	private static final String SUFFIX = ".lance";
	private static final Gson PRETTY = new GsonBuilder().serializeNulls().setPrettyPrinting().create();
	private static final Gson COMPACT = new GsonBuilder().serializeNulls().create();
	private static final Gson NUMBERS = new GsonBuilder().setObjectToNumberStrategy(ToNumberPolicy.LONG_OR_DOUBLE).create();
	private static final Pattern PLACEHOLDER = Pattern.compile("\\{([A-Za-z0-9_]+)(:list)?\\}");
	private static final Random RANDOM = new Random();

	private LancedbRuntime() {
	}

	public static final class UnsupportedFeature extends UnsupportedOperationException {

		private static final long serialVersionUID = 1L;

		UnsupportedFeature(String message) {
			super(message);
		}
	}

	public static RuntimeException unsupported(String vendor, String feature) {
		return new UnsupportedFeature(feature + " is not supported for target " + vendor);
	}

