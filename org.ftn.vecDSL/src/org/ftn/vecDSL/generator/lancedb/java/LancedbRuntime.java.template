	public static String toJson(Object value) {
		return PRETTY.toJson(value);
	}

	public static Map<String, Object> parameters(Map<String, Object> given, Map<String, Object> defaults, List<String> names) {
		Set<String> unknown = new HashSet<>(given.keySet());
		unknown.removeAll(names);
		if (!unknown.isEmpty()) {
			throw new IllegalArgumentException("unknown program parameters: " + unknown);
		}
		Map<String, Object> values = new LinkedHashMap<>(defaults);
		values.putAll(given);
		List<String> missing = names.stream().filter(name -> !values.containsKey(name)).toList();
		if (!missing.isEmpty()) {
			throw new IllegalArgumentException("missing program parameters: " + missing);
		}
		return values;
	}

	public static Map<String, Object> parseArguments(String[] arguments) {
		Map<String, Object> parameters = new LinkedHashMap<>();
		for (String argument : arguments) {
			int separator = argument.indexOf('=');
			if (separator < 0) {
				throw new IllegalArgumentException("expected name=value, got " + argument);
			}
			String raw = argument.substring(separator + 1);
			Object value;
			try {
				value = NUMBERS.fromJson(JsonParser.parseString(raw), Object.class);
			} catch (JsonParseException e) {
				value = raw;
			}
			parameters.put(argument.substring(0, separator), value);
		}
		return parameters;
	}

	/** Result values in one form for every host language: floats rounded, integral numbers as integers. */
	@SuppressWarnings("unchecked")
	static Object value(Object item) {
		if (item instanceof Float || item instanceof Double) {
			double number = ((Number) item).doubleValue();
			if (!Double.isFinite(number)) {
				return null;
			}
			double rounded = new BigDecimal(number).setScale(DIGITS, RoundingMode.HALF_EVEN).doubleValue();
			return rounded == Math.rint(rounded) && Math.abs(rounded) < 1e15 ? (Object) (long) rounded : (Object) rounded;
		}
		if (item instanceof Number number) {
			return number.longValue();
		}
		if (item instanceof Collection<?> items) {
			return items.stream().map(LancedbRuntime::value).toList();
		}
		if (item instanceof Map<?, ?> map) {
			Map<String, Object> result = new LinkedHashMap<>();
			((Map<String, Object>) map).forEach((key, entry) -> result.put(key, value(entry)));
			return result;
		}
		return item;
	}

	@SuppressWarnings("unchecked")
	private static Map<String, Object> map(Object value) {
		return (Map<String, Object>) value;
	}

	private static List<?> items(Object value) {
		return value == null ? List.of() : (List<?>) value;
	}

	private static List<String> strings(Object value) {
		return items(value).stream().map(String::valueOf).toList();
	}

	private static Integer number(Map<String, Object> args, String key) {
		Object value = args.get(key);
		return value == null ? null : ((Number) value).intValue();
	}

	private static <T> List<T> head(List<T> values, Integer limit) {
		return limit == null ? values : values.subList(0, Math.min(limit, values.size()));
	}

	// ---------------------------------------------------------------- where strings

	/** A generated where template with each {name} replaced by the SQL literal of a program parameter. */
	public static String sql(String template, Map<String, Object> values) {
		Matcher matcher = PLACEHOLDER.matcher(template);
		StringBuilder out = new StringBuilder();
		while (matcher.find()) {
			Object value = values.get(matcher.group(1));
			String replacement;
			if (matcher.group(2) != null) {
				if (!(value instanceof Collection<?> collection) || collection.isEmpty()) {
					throw new IllegalArgumentException("in and not_in need a non-empty list, got " + value);
				}
				replacement = "(" + String.join(", ", collection.stream().map(LancedbRuntime::literal).toList()) + ")";
			} else {
				replacement = literal(value);
			}
			matcher.appendReplacement(out, Matcher.quoteReplacement(replacement));
		}
		return matcher.appendTail(out).toString();
	}

	/** The SQL literal of a value: strings in single quotes with quotes doubled, lists as array literals. */
	public static String literal(Object value) {
		if (value == null) {
			return "NULL";
		}
		if (value instanceof Boolean flag) {
			return flag ? "TRUE" : "FALSE";
		}
		if (value instanceof Float || value instanceof Double) {
			double number = ((Number) value).doubleValue();
			if (!Double.isFinite(number)) {
				throw new IllegalArgumentException("cannot use " + value + " in a filter");
			}
			if (number == Math.rint(number) && Math.abs(number) < 1e15) {
				return Long.toString((long) number);
			}
			return python(number);
		}
		if (value instanceof Number number) {
			return Long.toString(number.longValue());
		}
		if (value instanceof String text) {
			return "'" + text.replace("'", "''") + "'";
		}
		if (value instanceof Collection<?> collection) {
			return "[" + String.join(", ", collection.stream().map(LancedbRuntime::literal).toList()) + "]";
		}
		throw new IllegalArgumentException("cannot use " + value + " in a filter");
	}

	/** A double as Python's repr writes it: the shortest round-trip digits, with an exponent from 1e16 and below 1e-4. */
	private static String python(double number) {
		BigDecimal exact = new BigDecimal(Double.toString(number)).stripTrailingZeros();
		double magnitude = Math.abs(number);
		if (magnitude >= 1e16 || magnitude < 1e-4) {
			String digits = exact.unscaledValue().abs().toString();
			int exponent = exact.precision() - exact.scale() - 1;
			String mantissa = digits.length() == 1 ? digits : digits.charAt(0) + "." + digits.substring(1);
			return (number < 0 ? "-" : "") + mantissa + "e" + (exponent < 0 ? "-" : "+") + String.format("%02d", Math.abs(exponent));
		}
		String plain = exact.toPlainString();
		return plain.contains(".") ? plain : plain + ".0";
	}

	public static String quote(String name) {
		return String.join(".", Stream.of(name.split("\\.")).map(part -> "`" + part.replace("`", "``") + "`").toList());
	}

	// ---------------------------------------------------------------- connection

	/** The storage URI of the program's database; a logical database is a sub-directory, a table a Lance dataset in it. */
	public static final class Client implements AutoCloseable {

		final String uri;
		final BufferAllocator allocator = new RootAllocator(Long.MAX_VALUE);

		Client(String uri) {
			this.uri = uri;
		}

		String root(Object database) {
			String base = uri.replaceAll("[/\\\\]+$", "");
			return database == null ? base : base + "/" + database;
		}

		String path(Map<String, Object> table) {
			return root(table.get("database")) + "/" + table.get("name") + SUFFIX;
		}

		Dataset open(Map<String, Object> table) {
			return Dataset.open().allocator(allocator).uri(path(table)).build();
		}

		@Override
		public void close() {
			allocator.close();
		}
	}

	public static Client connect(Map<String, Object> args) {
		return new Client((String) args.get("uri"));
	}

	private static boolean local(String uri) {
		return !uri.contains("://") || uri.startsWith("file://");
	}

	private static Path directory(String uri) {
		return Path.of(uri.startsWith("file://") ? uri.substring("file://".length()) : uri);
	}

	private static List<String> folders(Path folder, boolean tables) {
		if (!Files.isDirectory(folder)) {
			return List.of();
		}
		try (Stream<Path> entries = Files.list(folder)) {
			return entries.filter(Files::isDirectory).map(entry -> entry.getFileName().toString()).filter(name -> name.endsWith(SUFFIX) == tables)
					.map(name -> tables ? name.substring(0, name.length() - SUFFIX.length()) : name).sorted().toList();
		} catch (IOException e) {
			throw new UncheckedIOException(e);
		}
	}

	private static List<String> tableNames(Client client, Object database) {
		String root = client.root(database);
		if (!local(root)) {
			throw unsupported("lancedb", "listing tables of an object-store URI with the Lance Java SDK (it opens datasets by path)");
		}
		return folders(directory(root), true);
	}

	public static boolean hasTable(Client client, Map<String, Object> args) {
		Map<String, Object> table = map(args.get("table"));
		return tableNames(client, table.get("database")).contains((String) table.get("name"));
	}

	public static void createDatabase(Client client, Map<String, Object> args) {
		String root = client.root(args.get("database"));
		if (local(root)) {
			try {
				Files.createDirectories(directory(root));
			} catch (IOException e) {
				throw new UncheckedIOException(e);
			}
		}
	}

	public static void requireTable(Client client, Map<String, Object> args) {
		if (!hasTable(client, args)) {
			throw new IllegalStateException("table " + map(args.get("table")).get("name") + " does not exist");
		}
	}

	/** Opens the table and reads its index list; lance-core 14.0.2 has no prewarm call (lancedb's prewarm_index). */
	public static void loadTable(Client client, Map<String, Object> args) {
		try (Dataset dataset = client.open(map(args.get("table")))) {
			dataset.listIndexes();
		}
	}

	// ---------------------------------------------------------------- schema

	private static ArrowType scalar(String type) {
		return switch (type) {
		case "int8" -> new ArrowType.Int(8, true);
		case "int32" -> new ArrowType.Int(32, true);
		case "int64" -> new ArrowType.Int(64, true);
		case "uint8" -> new ArrowType.Int(8, false);
		case "float16" -> new ArrowType.FloatingPoint(FloatingPointPrecision.HALF);
		case "float32" -> new ArrowType.FloatingPoint(FloatingPointPrecision.SINGLE);
		case "float64" -> new ArrowType.FloatingPoint(FloatingPointPrecision.DOUBLE);
		case "bool" -> ArrowType.Bool.INSTANCE;
		case "utf8" -> ArrowType.Utf8.INSTANCE;
		case "binary" -> ArrowType.Binary.INSTANCE;
		case "date" -> new ArrowType.Date(DateUnit.DAY);
		case "timestamp" -> new ArrowType.Timestamp(TimeUnit.MICROSECOND, null);
		case "timestamptz" -> new ArrowType.Timestamp(TimeUnit.MICROSECOND, "UTC");
		default -> null;
		};
	}

	static Field arrowField(Map<String, Object> spec) {
		String name = spec.get("name") == null ? "item" : (String) spec.get("name");
		boolean nullable = !Boolean.FALSE.equals(spec.get("nullable"));
		Map<String, String> metadata = null;
		if (spec.get("metadata") != null) {
			metadata = new LinkedHashMap<>();
			for (Map.Entry<String, Object> entry : map(spec.get("metadata")).entrySet()) {
				metadata.put(entry.getKey(), entry.getValue() instanceof String text ? text : COMPACT.toJson(entry.getValue()));
			}
		}
		String type = (String) spec.get("type");
		ArrowType scalar = scalar(type);
		if (scalar != null) {
			return new Field(name, new FieldType(nullable, scalar, null, metadata), null);
		}
		return switch (type) {
		case "list" -> {
			Map<String, Object> element = new LinkedHashMap<>(map(spec.get("element")));
			element.put("name", "item");
			yield new Field(name, new FieldType(nullable, ArrowType.List.INSTANCE, null, metadata), List.of(arrowField(element)));
		}
		case "struct" -> new Field(name, new FieldType(nullable, ArrowType.Struct.INSTANCE, null, metadata),
				items(spec.get("fields")).stream().map(child -> arrowField(map(child))).toList());
		case "vector" -> new Field(name, new FieldType(nullable, new ArrowType.FixedSizeList(((Number) spec.get("dim")).intValue()), null, metadata),
				List.of(new Field("item", FieldType.nullable(scalar((String) spec.get("element"))), null)));
		case "multivector" -> new Field(name, new FieldType(nullable, ArrowType.List.INSTANCE, null, metadata), List.of(new Field("item",
				FieldType.nullable(new ArrowType.FixedSizeList(((Number) spec.get("dim")).intValue())),
				List.of(new Field("item", FieldType.nullable(scalar((String) spec.get("element"))), null)))));
		default -> throw new IllegalArgumentException("unknown field type " + type);
		};
	}

	static Schema arrowSchema(Object fields) {
		return new Schema(items(fields).stream().map(field -> arrowField(map(field))).toList());
	}

	/** Writes one value into a vector at an index; null leaves the slot null. */
	private static void set(FieldVector vector, int index, Object value) {
		if (value == null) {
			return;
		}
		switch (vector) {
		case TinyIntVector v -> v.setSafe(index, ((Number) value).byteValue());
		case IntVector v -> v.setSafe(index, ((Number) value).intValue());
		case BigIntVector v -> v.setSafe(index, ((Number) value).longValue());
		case UInt1Vector v -> v.setSafe(index, ((Number) value).intValue());
		case Float2Vector v -> v.setSafeWithPossibleTruncate(index, ((Number) value).floatValue());
		case Float4Vector v -> v.setSafe(index, ((Number) value).floatValue());
		case Float8Vector v -> v.setSafe(index, ((Number) value).doubleValue());
		case BitVector v -> v.setSafe(index, Boolean.TRUE.equals(value) ? 1 : 0);
		case VarCharVector v -> v.setSafe(index, value.toString().getBytes(StandardCharsets.UTF_8));
		case VarBinaryVector v -> v.setSafe(index, value instanceof byte[] bytes ? bytes : value.toString().getBytes(StandardCharsets.UTF_8));
		case DateDayVector v -> v.setSafe(index, (int) LocalDate.parse(value.toString()).toEpochDay());
		case TimeStampMicroTZVector v -> v.setSafe(index, micros(value.toString()));
		case TimeStampMicroVector v -> v.setSafe(index, micros(value.toString()));
		case FixedSizeListVector v -> {
			List<?> values = v.getDataVector() instanceof UInt1Vector && items(value).size() != v.getListSize() ? pack(items(value)) : items(value);
			FieldVector child = v.getDataVector();
			int size = v.getListSize();
			if (values.size() != size) {
				throw new IllegalArgumentException("vector of " + values.size() + " values in a column of dim " + size);
			}
			v.setNotNull(index);
			for (int i = 0; i < size; i++) {
				set(child, index * size + i, values.get(i));
			}
			child.setValueCount(Math.max(child.getValueCount(), (index + 1) * size));
		}
		case ListVector v -> {
			List<?> values = items(value);
			int start = v.startNewValue(index);
			FieldVector child = v.getDataVector();
			for (int i = 0; i < values.size(); i++) {
				set(child, start + i, values.get(i));
			}
			child.setValueCount(Math.max(child.getValueCount(), start + values.size()));
			v.endValue(index, values.size());
		}
		case StructVector v -> {
			Map<String, Object> record = map(value);
			v.setIndexDefined(index);
			for (FieldVector child : v.getChildrenFromFields()) {
				set(child, index, record.get(child.getName()));
				child.setValueCount(Math.max(child.getValueCount(), index + 1));
			}
		}
		default -> throw new IllegalArgumentException("unsupported column type " + vector.getField());
		}
	}

	/** A binary vector of 0 and 1 values packed into bytes, most significant bit first (numpy.packbits order). */
	static List<Integer> pack(List<?> bits) {
		List<Integer> result = new ArrayList<>();
		for (int start = 0; start < bits.size(); start += 8) {
			int end = Math.min(bits.size(), start + 8);
			int value = 0;
			for (int i = start; i < end; i++) {
				value = (value << 1) | (((Number) bits.get(i)).intValue() != 0 ? 1 : 0);
			}
			result.add(value << (8 - (end - start)));
		}
		return result;
	}

	private static long micros(String value) {
		Instant instant = value.length() == 10 ? LocalDate.parse(value).atStartOfDay().toInstant(ZoneOffset.UTC)
				: Instant.parse(value.endsWith("Z") || value.matches(".*[+-]\\d\\d:\\d\\d$") ? value : value + "Z");
		return ChronoUnit.MICROS.between(Instant.EPOCH, instant);
	}

	/** Records as an Arrow stream of the declared schema: defaults for absent fields, slice columns, unknown names rejected. */
	private static ArrowArrayStream stream(Client client, Object fields, List<Map<String, Object>> rows, Object defaults, Object slice) {
		Schema schema = arrowSchema(fields);
		Set<String> known = new LinkedHashSet<>(schema.getFields().stream().map(Field::getName).toList());
		ByteArrayOutputStream out = new ByteArrayOutputStream();
		try (VectorSchemaRoot root = VectorSchemaRoot.create(schema, client.allocator)) {
			root.allocateNew();
			for (int index = 0; index < rows.size(); index++) {
				Map<String, Object> row = rows.get(index);
				Set<String> unknown = new HashSet<>(row.keySet());
				unknown.removeAll(known);
				if (!unknown.isEmpty()) {
					throw new IllegalArgumentException("unknown fields " + unknown.stream().sorted().toList());
				}
				Map<String, Object> record = new LinkedHashMap<>(defaults == null ? Map.of() : map(defaults));
				record.putAll(row);
				if (slice != null) {
					record.putAll(map(slice));
				}
				for (FieldVector vector : root.getFieldVectors()) {
					set(vector, index, record.get(vector.getName()));
				}
			}
			root.setRowCount(rows.size());
			try (ArrowStreamWriter writer = new ArrowStreamWriter(root, null, out)) {
				writer.start();
				writer.writeBatch();
				writer.end();
			}
		} catch (IOException e) {
			throw new UncheckedIOException(e);
		}
		ArrowStreamReader reader = new ArrowStreamReader(new ByteArrayInputStream(out.toByteArray()), client.allocator);
		ArrowArrayStream stream = ArrowArrayStream.allocateNew(client.allocator);
		Data.exportArrayStream(client.allocator, reader, stream);
		return stream;
	}

	// ---------------------------------------------------------------- DDL

	public static void createTable(Client client, Map<String, Object> args) {
		Map<String, Object> table = map(args.get("table"));
		if (Boolean.TRUE.equals(args.get("exist_ok")) && hasTable(client, args)) {
			return;
		}
		createDatabase(client, args("database", table.get("database")));
		try (Dataset dataset = Dataset.write().allocator(client.allocator).uri(client.path(table)).schema(arrowSchema(args.get("schema")))
				.mode(WriteParams.WriteMode.CREATE).execute()) {
			for (Object index : items(args.get("indexes"))) {
				createIndexOn(dataset, map(index));
			}
		}
	}

	public static void dropTable(Client client, Map<String, Object> args) {
		if (Boolean.TRUE.equals(args.get("missing_ok")) && !hasTable(client, args)) {
			return;
		}
		Dataset.drop(client.path(map(args.get("table"))), Map.of());
	}

	/** Drops every table of the logical database and removes its sub-directory when that is left empty. */
	public static void dropDatabase(Client client, Map<String, Object> args) {
		for (String name : tableNames(client, args.get("database"))) {
			Dataset.drop(client.path(args("name", name, "database", args.get("database"))), Map.of());
		}
		Path folder = directory(client.root(args.get("database")));
		if (local(client.uri) && Files.isDirectory(folder)) {
			try (Stream<Path> entries = Files.list(folder)) {
				if (entries.findAny().isEmpty()) {
					Files.delete(folder);
				}
			} catch (IOException e) {
				throw new UncheckedIOException(e);
			}
		}
	}

	public static List<String> listDatabases(Client client, Map<String, Object> args) {
		if (!local(client.uri)) {
			throw unsupported("lancedb", "listing logical databases of an object-store URI");
		}
		return folders(directory(client.root(null)), false);
	}

	private static long copy(Client client, Map<String, Object> source, Map<String, Object> target, Object schema, Object indexes, Object version) {
		List<Map<String, Object>> rows;
		try (Dataset dataset = read(client, source, version)) {
			rows = scan(dataset, new ScanOptions.Builder().build());
		}
		createTable(client, args("table", target, "schema", schema, "indexes", indexes));
		if (!rows.isEmpty()) {
			// clone and rename pass the table without its key: the merge insert joins on the primary key, the schema's
			// non-nullable field (else its first), so that every key does not read as null
			Map<String, Object> keyed = new LinkedHashMap<>(target);
			if (keyed.get("key") == null) {
				List<?> fields = items(schema);
				Object primary = fields.stream().map(LancedbRuntime::map).filter(field -> Boolean.FALSE.equals(field.get("nullable")))
						.map(field -> field.get("name")).findFirst().orElse(map(fields.get(0)).get("name"));
				keyed.put("key", primary);
			}
			write(client, keyed, schema, rows, "error", null, null, null);
		}
		try (Dataset dataset = client.open(target)) {
			return dataset.countRows();
		}
	}

	/** LanceDB OSS has no rename: copies rows, schema and declared indexes into the new table, then drops the old one. */
	public static void renameTable(Client client, Map<String, Object> args) {
		Map<String, Object> table = map(args.get("table"));
		Map<String, Object> target = new LinkedHashMap<>(table);
		target.put("name", args.get("new_name"));
		copy(client, table, target, args.get("schema"), args.get("indexes"), null);
		Dataset.drop(client.path(table), Map.of());
	}

	/** A shallow clone references the source's files at a version or tag; a full clone copies the rows. */
	public static Map<String, Object> cloneTable(Client client, Map<String, Object> args) {
		Map<String, Object> table = map(args.get("table"));
		Map<String, Object> target = new LinkedHashMap<>(table);
		target.put("name", args.get("target"));
		Object version = args.get("version");
		if (Boolean.TRUE.equals(args.get("shallow"))) {
			Ref ref = version instanceof String tag ? Ref.ofTag(tag) : version == null ? Ref.ofMain() : Ref.ofMain(((Number) version).longValue());
			try (Dataset dataset = client.open(table); Dataset clone = dataset.shallowClone(client.path(target), ref)) {
				return args("cloned_count", clone.countRows());
			}
		}
		return args("cloned_count", copy(client, table, target, args.get("schema"), args.get("indexes"), version));
	}

	public static List<String> listTables(Client client, Map<String, Object> args) {
		List<String> names = tableNames(client, args.get("database")).stream()
				.filter(name -> args.get("prefix") == null || name.startsWith((String) args.get("prefix"))).toList();
		return head(names, number(args, "limit"));
	}

	/** New columns: null-filled from their Arrow fields, or computed from generated SQL expressions (defaults), made nullable again for later writes that omit them. */
	public static void addColumns(Client client, Map<String, Object> args) {
		Map<String, Object> values = args.get("values") == null ? Map.of() : map(args.get("values"));
		try (Dataset dataset = client.open(map(args.get("table")))) {
			List<Field> plain = items(args.get("fields")).stream().map(LancedbRuntime::map).filter(field -> !values.containsKey(field.get("name")))
					.map(LancedbRuntime::arrowField).toList();
			if (!plain.isEmpty()) {
				dataset.addColumns(plain);
			}
			if (!values.isEmpty()) {
				SqlExpressions.Builder expressions = new SqlExpressions.Builder();
				values.forEach((name, expression) -> expressions.withExpression(name, (String) expression));
				dataset.addColumns(expressions.build(), Optional.empty());
				dataset.alterColumns(values.keySet().stream().map(name -> new ColumnAlteration.Builder(name).nullable(true).build()).toList());
			}
		}
	}

	public static void dropColumns(Client client, Map<String, Object> args) {
		try (Dataset dataset = client.open(map(args.get("table")))) {
			dataset.dropColumns(strings(args.get("names")));
		}
	}

	public static void renameColumn(Client client, Map<String, Object> args) {
		try (Dataset dataset = client.open(map(args.get("table")))) {
			dataset.alterColumns(List.of(new ColumnAlteration.Builder((String) args.get("name")).rename((String) args.get("new_name")).build()));
		}
	}

	/** Collection properties live in the metadata of the key column: an UpdateConfig transaction with field metadata updates. */
	public static void setMetadata(Client client, Map<String, Object> args) {
		Map<String, Object> table = map(args.get("table"));
		Map<String, String> metadata = new LinkedHashMap<>();
		map(args.get("metadata")).forEach((name, item) -> metadata.put(name, item instanceof String text ? text : COMPACT.toJson(item)));
		try (Dataset dataset = client.open(table)) {
			int id = dataset.getLanceSchema().fields().stream().filter(field -> field.getName().equals(table.get("key"))).findFirst()
					.orElseThrow(() -> new IllegalStateException("no key column " + table.get("key"))).getId();
			UpdateConfig operation = UpdateConfig.builder()
					.fieldMetadataUpdates(Map.of(id, UpdateMap.builder().updates(metadata).replace(false).build())).build();
			try (SourcedTransaction transaction = dataset.newTransactionBuilder().operation(operation).build()) {
				transaction.commit().close();
			}
		}
	}

	private static DistanceType distance(Object metric) {
		return switch ((String) metric) {
		case "l2" -> DistanceType.L2;
		case "cosine" -> DistanceType.Cosine;
		case "dot" -> DistanceType.Dot;
		case "hamming" -> DistanceType.Hamming;
		default -> throw new IllegalArgumentException("unknown metric " + metric);
		};
	}

	private static IndexParams ftsParams(Map<String, Object> index) {
		InvertedIndexParams.Builder fts = InvertedIndexParams.builder();
		if (index.get("base_tokenizer") != null) {
			fts.baseTokenizer((String) index.get("base_tokenizer"));
		}
		if (index.get("language") != null) {
			fts.language((String) index.get("language"));
		}
		if (index.get("with_position") != null) {
			fts.withPosition((Boolean) index.get("with_position"));
		}
		if (index.get("stem") != null) {
			fts.stem((Boolean) index.get("stem"));
		}
		if (index.get("remove_stop_words") != null) {
			fts.removeStopWords((Boolean) index.get("remove_stop_words"));
		}
		if (index.get("lower_case") != null) {
			fts.lowerCase((Boolean) index.get("lower_case"));
		}
		if (index.get("ascii_folding") != null) {
			fts.asciiFolding((Boolean) index.get("ascii_folding"));
		}
		if (index.get("max_token_length") != null) {
			fts.maxTokenLength(number(index, "max_token_length"));
		}
		return IndexParams.builder().setScalarIndexParams(fts.build()).build();
	}

	private static IndexParams vectorParams(Map<String, Object> index, String kind) {
		IvfBuildParams.Builder ivf = new IvfBuildParams.Builder();
		if (index.get("num_partitions") != null) {
			ivf.setNumPartitions(number(index, "num_partitions"));
		}
		VectorIndexParams.Builder vector = new VectorIndexParams.Builder(ivf.build()).setDistanceType(distance(index.get("metric")));
		HnswBuildParams.Builder hnsw = new HnswBuildParams.Builder();
		if (index.get("m") != null) {
			hnsw.setM(number(index, "m"));
		}
		if (index.get("ef_construction") != null) {
			hnsw.setEfConstruction(number(index, "ef_construction"));
		}
		PQBuildParams.Builder pq = new PQBuildParams.Builder();
		if (index.get("num_sub_vectors") != null) {
			pq.setNumSubVectors(number(index, "num_sub_vectors"));
		}
		if (index.get("num_bits") != null) {
			pq.setNumBits(number(index, "num_bits"));
		}
		switch (kind) {
		case "ivf_pq" -> vector.setPqParams(pq.build());
		case "ivf_rq" -> vector.setRqParams(new RQBuildParams.Builder().build());
		case "ivf_hnsw_sq" -> vector.setHnswParams(hnsw.build()).setSqParams(new SQBuildParams.Builder().build());
		case "ivf_hnsw_pq" -> vector.setHnswParams(hnsw.build()).setPqParams(pq.build());
		default -> {
		}
		}
		return IndexParams.builder().setVectorIndexParams(vector.build()).build();
	}

	private static void createIndexOn(Dataset dataset, Map<String, Object> index) {
		String kind = (String) index.get("kind");
		IndexType type = switch (kind) {
		case "btree" -> IndexType.BTREE;
		case "bitmap" -> IndexType.BITMAP;
		case "label_list" -> IndexType.LABEL_LIST;
		case "fts" -> IndexType.INVERTED;
		case "ivf_flat" -> IndexType.IVF_FLAT;
		case "ivf_pq" -> IndexType.IVF_PQ;
		case "ivf_rq" -> IndexType.IVF_RQ;
		case "ivf_hnsw_sq" -> IndexType.IVF_HNSW_SQ;
		case "ivf_hnsw_pq" -> IndexType.IVF_HNSW_PQ;
		default -> throw new IllegalArgumentException("unknown index kind " + kind);
		};
		IndexParams params = switch (kind) {
		case "btree" -> IndexParams.builder().setScalarIndexParams(BTreeIndexParams.builder().build()).build();
		case "bitmap" -> IndexParams.builder().setScalarIndexParams(BitmapIndexParams.builder().build()).build();
		case "label_list" -> IndexParams.builder().setScalarIndexParams(LabelListIndexParams.builder().build()).build();
		case "fts" -> ftsParams(index);
		default -> vectorParams(index, kind);
		};
		dataset.createIndex(IndexOptions.builder(List.of((String) index.get("column")), type, params).replace(true)
				.withIndexName((String) index.get("name")).build());
	}

	public static void createIndex(Client client, Map<String, Object> args) {
		try (Dataset dataset = client.open(map(args.get("table")))) {
			createIndexOn(dataset, map(args.get("index")));
		}
	}

	public static void dropIndex(Client client, Map<String, Object> args) {
		try (Dataset dataset = client.open(map(args.get("table")))) {
			dataset.dropIndex((String) args.get("name"));
		}
	}

	/** Retrains the index over every row: createIndex with replace. */
	public static void rebuildIndex(Client client, Map<String, Object> args) {
		createIndex(client, args);
	}

	private static Map<String, Object> indexProgress(Dataset dataset, String name) {
		Map<String, Object> statistics = dataset.getIndexStatistics(name);
		return args("indexed_rows", value(statistics.get("num_indexed_rows")), "unindexed_rows", value(statistics.get("num_unindexed_rows")));
	}

	/** Index builds finish inside createIndex in the open-source library; the statistics report the index's coverage. */
	public static Map<String, Object> awaitIndex(Client client, Map<String, Object> args) {
		try (Dataset dataset = client.open(map(args.get("table")))) {
			String name = (String) args.get("name");
			if (!dataset.listIndexes().contains(name)) {
				throw new IllegalStateException("index " + name + " does not exist");
			}
			Map<String, Object> result = args("index", name);
			result.putAll(indexProgress(dataset, name));
			return result;
		}
	}

	public static List<String> listIndexes(Client client, Map<String, Object> args) {
		try (Dataset dataset = client.open(map(args.get("table")))) {
			List<String> names = dataset.listIndexes().stream().filter(name -> args.get("prefix") == null || name.startsWith((String) args.get("prefix")))
					.sorted().toList();
			return head(names, number(args, "limit"));
		}
	}

	/** Compacts small files and adds new rows to every index (the SDKs' optimize, without pruning old versions). */
	/**
	 * Compacts small files, removes untagged versions older than seven days and adds new rows to every index. Lance 14.0.2 cannot add rows to a scalar index on a nested column
	 * that was created on an empty table (it looks the leaf name up as a top-level column, rust/lance/src/index/scalar.rs), so
	 * such indexes are rebuilt over the rows first.
	 */
	public static void optimize(Client client, Map<String, Object> args) {
		try (Dataset dataset = client.open(map(args.get("table")))) {
			if (dataset.countRows() > 0) {
				Map<Integer, String> paths = new LinkedHashMap<>();
				fieldPaths(dataset.getLanceSchema().fields(), "", paths);
				for (IndexDescription index : dataset.describeIndices()) {
					String nested = paths.get(index.getFieldIds().get(0));
					String kind = SCALAR.get(index.getIndexType());
					if (kind != null && nested != null && nested.contains(".") && index.getRowsIndexed() == 0) {
						createIndexOn(dataset, args("name", index.getName(), "column", nested, "kind", kind));
					}
				}
			}
		}
		try (Dataset dataset = client.open(map(args.get("table")))) {
			dataset.compact();
		}
		try (Dataset dataset = client.open(map(args.get("table")))) {
			dataset.cleanupWithPolicy(CleanupPolicy.builder().withBeforeTimestampMillis(System.currentTimeMillis() - PRUNE_AFTER_MILLIS)
					.withErrorIfTaggedOldVersions(false).build());
		}
		try (Dataset dataset = client.open(map(args.get("table")))) {
			dataset.optimizeIndices(OptimizeOptions.builder().build());
		}
	}

	/** LanceDB's optimize removes untagged versions older than seven days (rust/lancedb/src/table/optimize.rs); Java does the same and keeps tagged versions without an error. */
	private static final long PRUNE_AFTER_MILLIS = 7L * 24 * 60 * 60 * 1000;

	private static final Map<String, String> SCALAR = Map.of("BTree", "btree", "Bitmap", "bitmap", "LabelList", "label_list");

	private static void fieldPaths(List<LanceField> fields, String prefix, Map<Integer, String> paths) {
		for (LanceField field : fields) {
			paths.put(field.getId(), prefix + field.getName());
			fieldPaths(field.getChildren(), prefix + field.getName() + ".", paths);
		}
	}

	public static Map<String, Object> describe(Client client, Map<String, Object> args) {
		Map<String, Object> table = map(args.get("table"));
		try (Dataset dataset = client.open(table)) {
			Map<String, Object> result = args("name", table.get("name"));
			List<Object> fields = new ArrayList<>();
			Map<String, String> keyMetadata = Map.of();
			for (Field field : dataset.getSchema().getFields()) {
				fields.add(args("name", field.getName(), "type", typeName(field), "nullable", field.isNullable()));
				if (field.getName().equals(table.get("key")) && field.getMetadata() != null) {
					keyMetadata = field.getMetadata();
				}
			}
			result.put("fields", fields);
			result.put("indexes", dataset.listIndexes().stream().sorted().toList());
			keyMetadata.entrySet().stream().sorted(Map.Entry.comparingByKey()).forEach(entry -> result.put(entry.getKey(), entry.getValue()));
			if (Boolean.TRUE.equals(args.get("stats"))) {
				result.put("rows", dataset.countRows());
				result.put("version", dataset.version());
			}
			if (Boolean.TRUE.equals(args.get("index_progress"))) {
				Map<String, Object> progress = new LinkedHashMap<>();
				for (String name : dataset.listIndexes()) {
					progress.put(name, indexProgress(dataset, name));
				}
				result.put("index_progress", progress);
			}
			return result;
		}
	}

	/** Arrow type names as pyarrow writes them, so that describe agrees across languages. */
	private static String typeName(Field field) {
		ArrowType type = field.getType();
		return switch (type) {
		case ArrowType.FixedSizeList list -> "fixed_size_list<item: " + typeName(field.getChildren().get(0)) + ">[" + list.getListSize() + "]";
		case ArrowType.List list -> "list<item: " + typeName(field.getChildren().get(0)) + ">";
		case ArrowType.Struct struct -> "struct<" + String.join(", ", field.getChildren().stream().map(child -> child.getName() + ": " + typeName(child)).toList())
				+ ">";
		case ArrowType.Int integer -> (integer.getIsSigned() ? "int" : "uint") + integer.getBitWidth();
		case ArrowType.FloatingPoint floating -> switch (floating.getPrecision()) {
			case HALF -> "halffloat";
			case SINGLE -> "float";
			case DOUBLE -> "double";
		};
		case ArrowType.Bool bool -> "bool";
		case ArrowType.Utf8 utf8 -> "string";
		case ArrowType.LargeUtf8 utf8 -> "large_string";
		case ArrowType.Binary binary -> "binary";
		case ArrowType.LargeBinary binary -> "large_binary";
		case ArrowType.Date date -> "date32[day]";
		case ArrowType.Timestamp timestamp -> timestamp.getTimezone() == null ? "timestamp[us]" : "timestamp[us, tz=" + timestamp.getTimezone() + "]";
		default -> type.toString().toLowerCase(java.util.Locale.ROOT);
		};
	}

