/**
 * Shared result shapes of vecDSL searches. Generated by vecDSL 7. Do not edit.
 *
 * One implementation of the result-shape clauses (boost, cursor, mmr, group-by with size, sort, offset and limit, score bounds,
 * with-total, aggregate, exclude, with-vectors) over the candidate window a target retrieved, following the pgvector generator's
 * pipeline. The same module exists in Python and TypeScript; equal
 * input gives equal output in the three languages (generator/common/shapes/README.md). Standard library only.
 *
 * Values are JSON values as maps, lists, strings, numbers, booleans and null. A candidate is {key, score, fields, vectors?,
 * highlight?, explanation?}: score is the canonical similarity (higher is better), the native score under
 * {@code score native}, or null for a scroll, whose records have no score.
 */
public final class Shapes {

	private static final int DIGITS = 6;
	private static final int[] PERCENTS = { 1, 5, 25, 50, 75, 95, 99 };
	private static final Map<String, Double> UNITS = units();
	private static final Pattern INTERVAL = Pattern.compile("\\s*([0-9]+(?:\\.[0-9]+)?)\\s*([A-Za-z]+)");
	private static final Pattern NUMBER = Pattern.compile("[+-]?(?:[0-9]+\\.?[0-9]*|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?");
	private static final Pattern TIMESTAMP = Pattern.compile("([0-9]{4})-([0-9]{2})-([0-9]{2})(?:[T ]([0-9]{2}):([0-9]{2})(?::([0-9]{2})(\\.[0-9]+)?)?)?"
			+ "(Z|z|[+-][0-9]{2}(?::?[0-9]{2})?)?");

	private Shapes() {
	}

	/** A combination of result-shape clauses the module refuses, with pgvector's reason. */
	public static final class UnsupportedShape extends UnsupportedOperationException {

		private static final long serialVersionUID = 1L;

		UnsupportedShape(String message) {
			super(message);
		}
	}

	private static final class Hit {
		final Object key;
		Double score;
		final Map<?, ?> fields;
		final Map<?, ?> vectors;
		final Object highlight;
		final Object explanation;
		int ord;

		Hit(Object key, Double score, Map<?, ?> fields, Map<?, ?> vectors, Object highlight, Object explanation) {
			this.key = key;
			this.score = score;
			this.fields = fields;
			this.vectors = vectors;
			this.highlight = highlight;
			this.explanation = explanation;
		}
	}

	private static Map<String, Double> units() {
		Map<String, Double> result = new LinkedHashMap<>();
		Object[][] table = { { 0.001, "ms", "msec", "msecs", "millisecond", "milliseconds" }, { 1.0, "s", "sec", "secs", "second", "seconds" },
				{ 60.0, "m", "min", "mins", "minute", "minutes" }, { 3600.0, "h", "hr", "hrs", "hour", "hours" }, { 86400.0, "d", "day", "days" },
				{ 604800.0, "w", "week", "weeks" } };
		for (Object[] row : table) {
			for (int i = 1; i < row.length; i++) result.put((String) row[i], (Double) row[0]);
		}
		return result;
	}

	private static boolean isNumber(Object value) {
		return value instanceof Number;
	}

	private static double number(Object value) {
		return ((Number) value).doubleValue();
	}

	private static boolean finite(Object value) {
		return isNumber(value) && Double.isFinite(number(value));
	}

	private static List<?> list(Object value) {
		return value instanceof List<?> items ? items : List.of();
	}

	private static Map<?, ?> map(Object value) {
		return value instanceof Map<?, ?> entries ? entries : Map.of();
	}

	@SuppressWarnings("unchecked")
	private static List<String> strings(Object value) {
		return (List<String>) list(value);
	}

	private static int integer(Object value, int otherwise) {
		return isNumber(value) ? ((Number) value).intValue() : otherwise;
	}

	private static Object form(Map<?, ?> spec) {
		return spec.containsKey("score") ? spec.get("score") : "similarity";
	}

	/**
	 * Candidates a target retrieves for the spec: the mmr pool when its {@code candidates} is written, else ten times limit plus
	 * offset when a shape clause is written, else limit plus offset; null (every matching record) for a scroll that sorts or
	 * resumes after a cursor, or has no limit.
	 */
	public static Integer windowSize(Map<?, ?> spec) {
		Object limit = spec.get("limit");
		int offset = integer(spec.get("offset"), 0);
		if (!isNumber(limit)) return null;
		int fetch = ((Number) limit).intValue() + offset;
		if (form(spec) == null) return !list(spec.get("sort")).isEmpty() || spec.get("cursor") != null ? null : fetch;
		Object candidates = map(spec.get("mmr")).get("candidates");
		if (spec.get("mmr") != null && isNumber(candidates)) return Math.max(((Number) candidates).intValue(), fetch);
		return shaped(spec) ? 10 * fetch : fetch;
	}

	private static boolean shaped(Map<?, ?> spec) {
		return spec.get("cursor") != null || spec.get("boost") != null || spec.get("mmr") != null || spec.get("group") != null
				|| !list(spec.get("sort")).isEmpty() || Boolean.TRUE.equals(spec.get("withTotal")) || !list(spec.get("aggregations")).isEmpty();
	}

	/**
	 * The result of a search from its candidate window: a list of hits, a list of {group, hits}, or {hits, total, aggregations}
	 * when with-total or aggregate is written.
	 */
	public static Object shape(List<?> candidates, Map<?, ?> spec) {
		refuse(spec);
		Object scoreForm = form(spec);
		String keyField = spec.get("keyField") instanceof String name && !name.isEmpty() ? name : "id";
		int offset = integer(spec.get("offset"), 0);
		Integer limit = isNumber(spec.get("limit")) ? ((Number) spec.get("limit")).intValue() : null;
		Map<?, ?> bounds = map(spec.get("bounds"));
		List<?> clauses = list(spec.get("sort"));
		List<Hit> hits = hits(candidates, scoreForm == null);
		List<Hit> ranked = new ArrayList<>(hits);
		if (scoreForm == null) {
			ranked.sort((a, b) -> {
				int byClause = byClauses(a, b, clauses);
				return byClause != 0 ? byClause : compareKeys(a.key, b.key);
			});
		} else if (!"native".equals(scoreForm)) {
			ranked.sort(Shapes::byRelevance);
		}
		if (spec.get("boost") != null) {
			boost(ranked, map(spec.get("boost")));
			ranked.sort(Shapes::byRelevance);
		}
		for (int position = 0; position < ranked.size(); position++) ranked.get(position).ord = position;
		List<Hit> matched = ranked;
		if (spec.get("cursor") != null) ranked = after(ranked, spec.get("cursor"));
		Object result;
		if (spec.get("group") != null) {
			result = groups(ranked, spec, bounds, keyField, offset, limit);
		} else {
			List<Hit> page = spec.get("mmr") != null ? diverse(ranked, map(spec.get("mmr")), offset, limit) : slice(ranked, offset, limit);
			if (scoreForm != null && !clauses.isEmpty()) {
				List<Hit> selected = page;
				List<Hit> sorted = new ArrayList<>(selected);
				sorted.sort((a, b) -> {
					int byClause = byClauses(a, b, clauses);
					return byClause != 0 ? byClause : Integer.compare(selected.indexOf(a), selected.indexOf(b));
				});
				page = sorted;
			}
			List<Object> projected = new ArrayList<>();
			for (Hit hit : page) {
				if (within(hit.score, bounds)) projected.add(project(hit, spec, keyField));
			}
			result = projected;
		}
		List<?> aggregations = list(spec.get("aggregations"));
		boolean total = Boolean.TRUE.equals(spec.get("withTotal"));
		if (total || !aggregations.isEmpty()) {
			List<Hit> inside = new ArrayList<>();
			for (Hit hit : matched) {
				if (within(hit.score, bounds)) inside.add(hit);
			}
			Map<String, Object> wrapped = new LinkedHashMap<>();
			wrapped.put("hits", result);
			if (total) wrapped.put("total", (long) inside.size());
			if (!aggregations.isEmpty()) {
				Map<String, Object> values = new LinkedHashMap<>();
				for (Object a : aggregations) values.put(aggregationName(map(a)), aggregate(inside, map(a)));
				wrapped.put("aggregations", values);
			}
			result = wrapped;
		}
		return value(result);
	}

	private static <T> List<T> slice(List<T> items, int from, Integer count) {
		int start = Math.min(from, items.size());
		int end = count == null ? items.size() : Math.min(items.size(), from + count);
		return new ArrayList<>(items.subList(start, Math.max(start, end)));
	}

	private static void refuse(Map<?, ?> spec) {
		Object scoreForm = form(spec);
		boolean group = spec.get("group") != null;
		boolean mmr = spec.get("mmr") != null;
		boolean boosted = spec.get("boost") != null;
		if (spec.get("cursor") != null && (group || mmr)) {
			throw new UnsupportedShape("the 'cursor' clause with group-by or mmr; keyset pagination continues after one record in an "
					+ "order that each record's own values decide");
		}
		if (group && !list(spec.get("sort")).isEmpty()) throw new UnsupportedShape("sort with group-by; groups follow the relevance of their best hit");
		if (group && mmr) throw new UnsupportedShape("mmr with group-by; MMR selects single hits, groups select records per group value");
		if (boosted && "native".equals(scoreForm)) {
			throw new UnsupportedShape("boosts with score native; boosts apply to the canonical similarity, where higher is better");
		}
		if (mmr && "native".equals(scoreForm)) {
			throw new UnsupportedShape("mmr with score native; MMR weighs the canonical similarity, which a native score does not give");
		}
		if (scoreForm == null && (boosted || mmr || group)) throw new UnsupportedShape("boost, mmr and group-by on a scroll, whose records have no score");
		if (mmr) {
			Object lambda = map(spec.get("mmr")).get("lambda");
			if (!isNumber(lambda) || !(number(lambda) >= 0 && number(lambda) <= 1)) throw new UnsupportedShape("an mmr lambda outside 0 to 1");
		}
		for (Object fn : list(map(spec.get("boost")).get("functions"))) {
			Object rate = map(fn).get("rate");
			if ("decay".equals(map(fn).get("kind")) && rate != null && !(number(rate) > 0 && number(rate) < 1)) {
				throw new UnsupportedShape("a decay rate outside the open interval from 0 to 1");
			}
		}
		for (Object a : list(spec.get("aggregations"))) {
			if ("range".equals(map(a).get("kind"))) throw new UnsupportedShape("range aggregations; vecDSL gives no range bounds to count records in");
		}
	}

	private static List<Hit> hits(List<?> candidates, boolean unscored) {
		List<Hit> result = new ArrayList<>();
		Set<String> seen = new HashSet<>();
		for (Object item : candidates) {
			if (!(item instanceof Map<?, ?> candidate)) throw new IllegalArgumentException("a candidate is not an object");
			Object key = candidate.get("key");
			if (!(key instanceof String || finite(key))) {
				throw new IllegalArgumentException("a candidate key must be a string or a finite number: " + canonical(key));
			}
			String identity = canonical(key);
			if (!seen.add(identity)) throw new IllegalArgumentException("duplicate candidate key " + identity);
			Object score = candidate.get("score");
			if (score != null && !finite(score)) throw new IllegalArgumentException("the score of candidate " + identity + " is not a finite number");
			if (score == null && !unscored) throw new IllegalArgumentException("candidate " + identity + " has no score");
			Object fields = candidate.get("fields") == null ? Map.of() : candidate.get("fields");
			Object vectors = candidate.get("vectors") == null ? Map.of() : candidate.get("vectors");
			if (!(fields instanceof Map<?, ?> fieldMap) || !(vectors instanceof Map<?, ?> vectorMap)) {
				throw new IllegalArgumentException("the fields or vectors of candidate " + identity + " are not an object");
			}
			result.add(new Hit(key, score == null ? null : number(score), fieldMap, vectorMap, candidate.get("highlight"), candidate.get("explanation")));
		}
		return result;
	}

	// ---------------------------------------------------------------- order

	/** Strings by code point, as Python compares them. */
	private static int compareText(String a, String b) {
		int[] x = a.codePoints().toArray();
		int[] y = b.codePoints().toArray();
		for (int i = 0; i < Math.min(x.length, y.length); i++) {
			if (x[i] != y[i]) return x[i] < y[i] ? -1 : 1;
		}
		return Integer.compare(x.length, y.length);
	}

	private static int sign(double a, double b) {
		return a < b ? -1 : a > b ? 1 : 0;
	}

	/** Keys: numbers before strings, numbers by value, strings by code point (the runtimes' _order). */
	private static int compareKeys(Object a, Object b) {
		if (isNumber(a) != isNumber(b)) return isNumber(a) ? -1 : 1;
		return isNumber(a) ? sign(number(a), number(b)) : compareText((String) a, (String) b);
	}

	private static int byRelevance(Hit a, Hit b) {
		int result = sign(b.score, a.score);
		return result != 0 ? result : compareKeys(a.key, b.key);
	}

	private static int rank(Object value) {
		if (isNumber(value)) return 0;
		if (value instanceof String) return 1;
		if (value instanceof Boolean) return 2;
		return 3;
	}

	/** Field values: numbers, then strings by code point, then booleans, then lists and objects by their JSON text. */
	private static int compareValues(Object a, Object b) {
		int ra = rank(a);
		int rb = rank(b);
		if (ra != rb) return ra - rb;
		return switch (ra) {
		case 0 -> sign(number(a), number(b));
		case 1 -> compareText((String) a, (String) b);
		case 2 -> Boolean.compare((Boolean) a, (Boolean) b);
		default -> compareText(canonical(a), canonical(b));
		};
	}

	/** Sort keys: field values with missing values last in both directions, relevance by rank. */
	private static int byClauses(Hit a, Hit b, List<?> clauses) {
		for (Object item : clauses) {
			Map<?, ?> clause = map(item);
			boolean descending = "desc".equals(clause.get("direction"));
			int result;
			if (Boolean.TRUE.equals(clause.get("relevance"))) {
				result = descending ? a.ord - b.ord : b.ord - a.ord;
			} else {
				Object va = path(a.fields, strings(clause.get("field")));
				Object vb = path(b.fields, strings(clause.get("field")));
				if (va == null || vb == null) {
					result = (va == null ? 1 : 0) - (vb == null ? 1 : 0);
				} else {
					result = descending ? -compareValues(va, vb) : compareValues(va, vb);
				}
			}
			if (result != 0) return result;
		}
		return 0;
	}

	private static Object path(Map<?, ?> fields, List<String> segments) {
		Object current = fields;
		for (String segment : segments) {
			current = current instanceof Map<?, ?> entries ? entries.get(segment) : null;
		}
		return current;
	}

	/**
	 * JSON text with numbers as JavaScript prints them and object keys in code point order: the identity of a key, a group value
	 * or a term, and the text of values in messages, equal in the three languages.
	 */
	static String canonical(Object value) {
		if (value == null) return "null";
		if (value instanceof Boolean flag) return flag ? "true" : "false";
		if (isNumber(value)) return numberText((Number) value);
		if (value instanceof String text) return quote(text);
		if (value instanceof List<?> items) {
			List<String> parts = new ArrayList<>();
			for (Object item : items) parts.add(canonical(item));
			return "[" + String.join(",", parts) + "]";
		}
		if (value instanceof Map<?, ?> entries) {
			List<String> keys = new ArrayList<>();
			for (Object key : entries.keySet()) keys.add(String.valueOf(key));
			keys.sort(Shapes::compareText);
			List<String> parts = new ArrayList<>();
			for (String key : keys) parts.add(quote(key) + ":" + canonical(entries.get(key)));
			return "{" + String.join(",", parts) + "}";
		}
		return quote(String.valueOf(value));
	}

	/** A string as JSON.stringify writes it. */
	private static String quote(String text) {
		StringBuilder out = new StringBuilder("\"");
		for (int i = 0; i < text.length(); i++) {
			char c = text.charAt(i);
			switch (c) {
			case '"' -> out.append("\\\"");
			case '\\' -> out.append("\\\\");
			case '\b' -> out.append("\\b");
			case '\f' -> out.append("\\f");
			case '\n' -> out.append("\\n");
			case '\r' -> out.append("\\r");
			case '\t' -> out.append("\\t");
			default -> {
				boolean lone = Character.isHighSurrogate(c) && (i + 1 >= text.length() || !Character.isLowSurrogate(text.charAt(i + 1)))
						|| Character.isLowSurrogate(c) && (i == 0 || !Character.isHighSurrogate(text.charAt(i - 1)));
				if (c < 0x20 || lone) {
					out.append(String.format("\\u%04x", (int) c));
				} else {
					out.append(c);
				}
			}
			}
		}
		return out.append('"').toString();
	}

	/** A number as JavaScript's Number::toString writes it (shortest round-trip digits). */
	private static String numberText(Number value) {
		if ((value instanceof Long || value instanceof Integer || value instanceof Short || value instanceof Byte)
				&& Math.abs(value.longValue()) < (1L << 53)) {
			return Long.toString(value.longValue());
		}
		double x = value.doubleValue();
		if (Double.isNaN(x)) return "NaN";
		if (Double.isInfinite(x)) return x > 0 ? "Infinity" : "-Infinity";
		if (x == 0) return "0";
		BigDecimal decimal = new BigDecimal(Double.toString(Math.abs(x))).stripTrailingZeros();
		String digits = decimal.unscaledValue().toString();
		int k = digits.length();
		int n = k - decimal.scale();
		String sign = x < 0 ? "-" : "";
		if (k <= n && n <= 21) return sign + digits + "0".repeat(n - k);
		if (0 < n && n <= 21) return sign + digits.substring(0, n) + "." + digits.substring(n);
		if (-6 < n && n <= 0) return sign + "0." + "0".repeat(-n) + digits;
		int e = n - 1;
		String mantissa = k == 1 ? digits : digits.charAt(0) + "." + digits.substring(1);
		return sign + mantissa + "e" + (e >= 0 ? "+" : "-") + Math.abs(e);
	}

	// ---------------------------------------------------------------- cursor, groups, mmr, bounds

	/** The hits after the cursor record in the result order; none when no candidate has the cursor key. */
	private static List<Hit> after(List<Hit> ranked, Object cursor) {
		for (int position = 0; position < ranked.size(); position++) {
			if (sameKey(ranked.get(position).key, cursor)) return new ArrayList<>(ranked.subList(position + 1, ranked.size()));
		}
		return new ArrayList<>();
	}

	private static boolean sameKey(Object key, Object cursor) {
		if (key instanceof String text) return text.equals(cursor);
		if (isNumber(cursor)) return number(key) == number(cursor);
		String text = String.valueOf(cursor).strip();
		return NUMBER.matcher(text).matches() && Double.parseDouble(text) == number(key);
	}

	private static boolean within(Double score, Map<?, ?> bounds) {
		if (score == null) return true;
		Object low = bounds.get("min");
		Object high = bounds.get("max");
		return (!isNumber(low) || score >= number(low)) && (!isNumber(high) || score <= number(high));
	}

	/**
	 * Groups in the order of their best hit, limit and offset counting groups, {@code size} hits each (1 by default); a record
	 * without the group field belongs to the group null; hits outside the bounds are dropped, and so is a group left empty.
	 */
	private static List<Object> groups(List<Hit> ranked, Map<?, ?> spec, Map<?, ?> bounds, String keyField, int offset, Integer limit) {
		Map<?, ?> group = map(spec.get("group"));
		int size = integer(group.get("size"), 1);
		Map<String, List<Hit>> members = new LinkedHashMap<>();
		Map<String, Object> values = new LinkedHashMap<>();
		for (Hit hit : ranked) {
			Object groupValue = path(hit.fields, strings(group.get("field")));
			String identity = canonical(groupValue);
			members.computeIfAbsent(identity, ignored -> new ArrayList<>()).add(hit);
			values.putIfAbsent(identity, groupValue);
		}
		List<Object> result = new ArrayList<>();
		for (String identity : slice(new ArrayList<>(members.keySet()), offset, limit)) {
			List<Object> kept = new ArrayList<>();
			for (Hit hit : slice(members.get(identity), 0, size)) {
				if (within(hit.score, bounds)) kept.add(project(hit, spec, keyField));
			}
			if (!kept.isEmpty()) {
				Map<String, Object> entry = new LinkedHashMap<>();
				entry.put("group", values.get(identity));
				entry.put("hits", kept);
				result.add(entry);
			}
		}
		return result;
	}

	/** 1 - x in decimal arithmetic, so that 1 - 0.7 is 0.3. */
	private static double complement(double x) {
		return Double.parseDouble(BigDecimal.ONE.subtract(BigDecimal.valueOf(x)).toString());
	}

	/**
	 * Maximal marginal relevance: from the pool, pick the hit maximizing lambda * relevance - (1 - lambda) *
	 * its highest similarity to a picked hit, the earlier rank breaking ties, until limit plus offset; each hit keeps its score.
	 */
	private static List<Hit> diverse(List<Hit> ranked, Map<?, ?> mmr, int offset, Integer limit) {
		int fetch = offset + (limit == null ? ranked.size() : limit);
		Object written = mmr.get("candidates");
		int size = isNumber(written) ? Math.max(((Number) written).intValue(), fetch) : Math.max(10 * fetch, 10);
		if (!(mmr.get("vectorField") instanceof String field) || !(mmr.get("metric") instanceof String metric)) {
			throw new IllegalArgumentException("mmr needs the diversity vector field and its metric");
		}
		List<Hit> pool = new ArrayList<>();
		for (Hit hit : ranked) {
			if (hit.vectors.get(field) != null && pool.size() < size) pool.add(hit);
		}
		double lambda = number(mmr.get("lambda"));
		double rest = complement(lambda);
		double[] penalty = new double[pool.size()];
		boolean[] taken = new boolean[pool.size()];
		List<Hit> picked = new ArrayList<>();
		while (picked.size() < fetch) {
			int best = -1;
			double bestValue = 0;
			for (int i = 0; i < pool.size(); i++) {
				if (!taken[i]) {
					double candidateValue = lambda * pool.get(i).score - rest * penalty[i];
					if (best < 0 || candidateValue > bestValue) {
						best = i;
						bestValue = candidateValue;
					}
				}
			}
			if (best < 0) break;
			taken[best] = true;
			Hit chosen = pool.get(best);
			for (int i = 0; i < pool.size(); i++) {
				if (!taken[i]) {
					double similar = similarity(pool.get(i).vectors.get(field), chosen.vectors.get(field), metric);
					penalty[i] = picked.isEmpty() ? similar : Math.max(penalty[i], similar);
				}
			}
			picked.add(chosen);
		}
		return slice(picked, offset, null);
	}

	private static double[] bits(Object value) {
		if (value instanceof String text) {
			if (!text.matches("[01]*")) throw new IllegalArgumentException("a bit vector string holds only 0 and 1");
			double[] result = new double[text.length()];
			for (int i = 0; i < text.length(); i++) result[i] = text.charAt(i) - '0';
			return result;
		}
		List<?> items = value instanceof List<?> list ? list : null;
		if (items == null || !items.stream().allMatch(Shapes::isNumber)) {
			throw new IllegalArgumentException("a stored vector is a list of numbers or a bit string");
		}
		double[] result = new double[items.size()];
		for (int i = 0; i < result.length; i++) result[i] = number(items.get(i));
		return result;
	}

	/** The canonical similarity of two stored vectors under the diversity field's metric. */
	private static double similarity(Object a, Object b, String metric) {
		double[] x = bits(a);
		double[] y = bits(b);
		if (x.length != y.length) throw new IllegalArgumentException("mmr compares vectors of one dimension");
		double total = 0;
		switch (metric) {
		case "cosine" -> {
			double normX = 0;
			double normY = 0;
			for (int i = 0; i < x.length; i++) {
				total += x[i] * y[i];
				normX += x[i] * x[i];
				normY += y[i] * y[i];
			}
			double norm = Math.sqrt(normX * normY);
			return norm != 0 ? total / norm : 0.0;
		}
		case "dot" -> {
			for (int i = 0; i < x.length; i++) total += x[i] * y[i];
			return total;
		}
		case "euclidean" -> {
			for (int i = 0; i < x.length; i++) total += (x[i] - y[i]) * (x[i] - y[i]);
			return -Math.sqrt(total);
		}
		case "manhattan" -> {
			for (int i = 0; i < x.length; i++) total += Math.abs(x[i] - y[i]);
			return -total;
		}
		case "hamming" -> {
			for (int i = 0; i < x.length; i++) {
				if ((x[i] != 0) != (y[i] != 0)) total += 1;
			}
			return -total;
		}
		case "jaccard" -> {
			int both = 0;
			int either = 0;
			for (int i = 0; i < x.length; i++) {
				if (x[i] != 0 && y[i] != 0) both++;
				if (x[i] != 0 || y[i] != 0) either++;
			}
			return either != 0 ? (double) both / either : 0.0;
		}
		default -> throw new IllegalArgumentException("unknown metric " + metric);
		}
	}

	// ---------------------------------------------------------------- boosts

	/** Each hit's score becomes its relevance with the combined boost applied; a hit no function applies to keeps it. */
	private static void boost(List<Hit> hits, Map<?, ?> block) {
		String combine = block.get("combine") instanceof String text ? text : "multiply";
		String mode = block.get("apply") instanceof String text ? text : "multiply";
		for (Hit hit : hits) {
			List<Double> present = new ArrayList<>();
			for (Object fn : list(block.get("functions"))) {
				Double result = functionValue(hit.fields, map(fn));
				if (result != null) present.add(result);
			}
			if (present.isEmpty()) continue;
			double combined;
			switch (combine) {
			case "sum" -> combined = total(present);
			case "multiply" -> {
				combined = 1;
				for (double v : present) combined *= v;
			}
			case "max" -> {
				combined = present.get(0);
				for (double v : present) combined = v > combined ? v : combined;
			}
			case "avg" -> combined = total(present) / present.size();
			case "replace" -> combined = present.get(0);
			default -> throw new IllegalArgumentException("unknown boost combination " + combine);
			}
			hit.score = applied(mode, hit.score, combined);
		}
	}

	private static double total(Collection<Double> values) {
		double sum = 0;
		for (double value : values) sum += value;
		return sum;
	}

	private static double applied(String mode, double relevance, double boostValue) {
		return switch (mode) {
		case "sum" -> relevance + boostValue;
		case "multiply" -> relevance * boostValue;
		case "max" -> boostValue > relevance ? boostValue : relevance;
		case "avg" -> (relevance + boostValue) / 2;
		case "replace" -> boostValue;
		default -> throw new IllegalArgumentException("unknown boost application " + mode);
		};
	}

	/**
	 * One boost function: the weighted field value, the weighted decay of the field's distance from the origin, or the weight; null
	 * where its field is null or its condition is not true.
	 */
	private static Double functionValue(Map<?, ?> fields, Map<?, ?> fn) {
		if (fn.get("when") != null && !Boolean.TRUE.equals(test(fields, map(fn.get("when"))))) return null;
		double weight = isNumber(fn.get("weight")) ? number(fn.get("weight")) : 1;
		Object kind = fn.get("kind");
		if ("condition".equals(kind)) return weight;
		Object fieldValue = path(fields, strings(fn.get("field")));
		if (fieldValue == null) return null;
		if ("field_value".equals(kind)) {
			if (!isNumber(fieldValue)) throw new IllegalArgumentException("a field_value boost on a value that is not a number: " + canonical(fieldValue));
			return weight != 1 ? weight * number(fieldValue) : number(fieldValue);
		}
		if (!"decay".equals(kind)) throw new IllegalArgumentException("unknown boost kind " + kind);
		double rate = isNumber(fn.get("rate")) ? number(fn.get("rate")) : 0.5;
		double distance;
		double scale;
		double shift;
		if (fn.get("origin") instanceof String origin) {
			distance = Math.abs(epoch(fieldValue) - epoch(origin));
			scale = seconds(fn.get("scale"));
			shift = fn.get("offset") != null ? seconds(fn.get("offset")) : 0;
		} else {
			if (!isNumber(fieldValue)) throw new IllegalArgumentException("a decay boost on a value that is not a number: " + canonical(fieldValue));
			distance = Math.abs(number(fieldValue) - number(fn.get("origin")));
			scale = number(fn.get("scale"));
			shift = fn.get("offset") != null ? number(fn.get("offset")) : 0;
		}
		double d = Math.max(distance - shift, 0) / scale;
		double decay = switch (String.valueOf(fn.get("shape"))) {
		case "gauss" -> StrictMath.pow(rate, StrictMath.pow(d, 2));
		case "exp" -> StrictMath.pow(rate, d);
		case "linear" -> Math.max(1 - d * complement(rate), 0);
		default -> throw new IllegalArgumentException("unknown decay shape " + fn.get("shape"));
		};
		return weight != 1 ? weight * decay : decay;
	}

	// ---------------------------------------------------------------- conditions

	/** A boost condition in three-valued logic, as SQL evaluates it: null where a compared value is missing. */
	private static Boolean test(Map<?, ?> fields, Map<?, ?> condition) {
		if (condition.get("and") instanceof List<?> parts) {
			List<Boolean> results = new ArrayList<>();
			for (Object part : parts) results.add(test(fields, map(part)));
			return results.contains(Boolean.FALSE) ? Boolean.FALSE : results.contains(null) ? null : Boolean.TRUE;
		}
		if (condition.get("or") instanceof List<?> parts) {
			List<Boolean> results = new ArrayList<>();
			for (Object part : parts) results.add(test(fields, map(part)));
			return results.contains(Boolean.TRUE) ? Boolean.TRUE : results.contains(null) ? null : Boolean.FALSE;
		}
		if (condition.get("not") instanceof Map<?, ?> operandCondition) return !Boolean.TRUE.equals(test(fields, operandCondition));
		String op = String.valueOf(condition.get("op"));
		Object fieldValue = path(fields, strings(condition.get("field")));
		Object operand = condition.get("value");
		switch (op) {
		case "is_null", "not_exists" -> {
			return fieldValue == null;
		}
		case "is_not_null", "exists" -> {
			return fieldValue != null;
		}
		case "neq" -> {
			if (fieldValue == null || operand == null) return fieldValue != null || operand != null;
			return !canonical(fieldValue).equals(canonical(operand));
		}
		case "not_in" -> {
			return !Boolean.TRUE.equals(member(fieldValue, operand));
		}
		default -> {
		}
		}
		if (fieldValue == null || operand == null && !op.equals("is_empty")) return null;
		switch (op) {
		case "eq" -> {
			return canonical(fieldValue).equals(canonical(operand));
		}
		case "gt", "gte", "lt", "lte" -> {
			return ordered(op, fieldValue, operand);
		}
		case "between" -> {
			Object upper = condition.get("upper");
			Boolean low = ordered("gte", fieldValue, operand);
			Boolean high = upper == null ? null : ordered("lte", fieldValue, upper);
			return Boolean.FALSE.equals(low) || Boolean.FALSE.equals(high) ? Boolean.FALSE : low == null || high == null ? null : Boolean.TRUE;
		}
		case "in" -> {
			return member(fieldValue, operand);
		}
		case "contains" -> {
			if (fieldValue instanceof List<?> items) {
				String wanted = canonical(operand);
				return items.stream().anyMatch(item -> canonical(item).equals(wanted));
			}
			return fieldValue instanceof String text && operand instanceof String part ? text.contains(part) : null;
		}
		case "contains_any", "contains_all" -> {
			if (!(fieldValue instanceof List<?> items) || !(operand instanceof List<?> wanted)) return null;
			Set<String> held = new HashSet<>();
			for (Object item : items) held.add(canonical(item));
			boolean any = false;
			boolean all = true;
			for (Object item : wanted) {
				boolean found = held.contains(canonical(item));
				any |= found;
				all &= found;
			}
			return op.equals("contains_any") ? any : all;
		}
		case "like", "prefix", "contains_text" -> {
			if (!(fieldValue instanceof String text) || !(operand instanceof String pattern)) return null;
			if (op.equals("prefix")) return text.startsWith(pattern);
			return op.equals("contains_text") ? text.contains(pattern) : like(text, pattern);
		}
		case "is_empty" -> {
			if (fieldValue instanceof List<?> items) return items.isEmpty();
			return fieldValue instanceof String text ? text.isEmpty() : null;
		}
		default -> {
			if (!op.startsWith("length_")) throw new IllegalArgumentException("unknown condition operator " + op);
			if (fieldValue instanceof List<?> items) return ordered(op.substring(7), (long) items.size(), operand);
			return fieldValue instanceof String text ? ordered(op.substring(7), (long) text.codePointCount(0, text.length()), operand) : null;
		}
		}
	}

	private static Boolean member(Object fieldValue, Object operand) {
		if (fieldValue == null || !(operand instanceof List<?> items)) return null;
		String wanted = canonical(fieldValue);
		return items.stream().anyMatch(item -> canonical(item).equals(wanted));
	}

	private static Boolean ordered(String op, Object fieldValue, Object operand) {
		if (rank(fieldValue) != rank(operand) || rank(fieldValue) == 3) return null;
		int c = compareValues(fieldValue, operand);
		return switch (op) {
		case "eq" -> c == 0;
		case "neq" -> c != 0;
		case "gt" -> c > 0;
		case "gte" -> c >= 0;
		case "lt" -> c < 0;
		case "lte" -> c <= 0;
		default -> throw new IllegalArgumentException("unknown comparison " + op);
		};
	}

	/** SQL LIKE: % matches any sequence, _ one character, a backslash escapes the next character. */
	private static boolean like(String text, String pattern) {
		int[] chars = text.codePoints().toArray();
		int[] symbols = pattern.codePoints().toArray();
		boolean[] reach = new boolean[chars.length + 1];
		reach[0] = true;
		for (int i = 0; i < symbols.length; i++) {
			int c = symbols[i];
			if (c == '\\' && i + 1 < symbols.length) {
				c = symbols[++i];
			} else if (c == '%') {
				for (int j = 1; j <= chars.length; j++) reach[j] = reach[j] || reach[j - 1];
				continue;
			} else if (c == '_') {
				c = -1;
			}
			boolean[] next = new boolean[chars.length + 1];
			for (int j = 0; j < chars.length; j++) next[j + 1] = reach[j] && (c == -1 || chars[j] == c);
			reach = next;
		}
		return reach[chars.length];
	}

	// ---------------------------------------------------------------- aggregations

	private static String aggregationName(Map<?, ?> a) {
		return a.get("name") instanceof String name && !name.isEmpty() ? name : a.get("kind") + "_" + String.join("_", strings(a.get("field")));
	}

	/** The non-null values of a field over the hits; a list value contributes its elements. */
	private static List<Object> valuesOf(List<Hit> hits, List<String> segments) {
		List<Object> result = new ArrayList<>();
		for (Hit hit : hits) {
			Object fieldValue = path(hit.fields, segments);
			for (Object item : fieldValue instanceof List<?> items ? items : java.util.Collections.singletonList(fieldValue)) {
				if (item != null) result.add(item);
			}
		}
		return result;
	}

	private static List<Double> numbers(List<Object> values, String kind) {
		List<Double> result = new ArrayList<>();
		for (Object item : values) {
			if (!isNumber(item)) throw new IllegalArgumentException("the " + kind + " aggregation over a value that is not a number: " + canonical(item));
			result.add(number(item));
		}
		return result;
	}

	private static Object aggregate(List<Hit> hits, Map<?, ?> a) {
		String kind = String.valueOf(a.get("kind"));
		List<Object> values = valuesOf(hits, strings(a.get("field")));
		switch (kind) {
		case "count" -> {
			return (long) values.size();
		}
		case "distinct_count", "cardinality" -> {
			Set<String> distinct = new HashSet<>();
			for (Object item : values) distinct.add(canonical(item));
			return (long) distinct.size();
		}
		case "min", "max" -> {
			if (values.isEmpty()) return null;
			Object best = values.get(0);
			for (Object item : values.subList(1, values.size())) {
				int c = compareValues(item, best);
				if (kind.equals("min") ? c < 0 : c > 0) best = item;
			}
			return best;
		}
		case "sum", "avg", "stats" -> {
			List<Double> found = numbers(values, kind);
			Double sum = found.isEmpty() ? null : total(found);
			Double average = sum == null ? null : sum / found.size();
			if (kind.equals("sum")) return sum;
			if (kind.equals("avg")) return average;
			Map<String, Object> stats = new LinkedHashMap<>();
			stats.put("count", (long) found.size());
			stats.put("min", found.isEmpty() ? null : found.stream().reduce((x, y) -> y < x ? y : x).get());
			stats.put("max", found.isEmpty() ? null : found.stream().reduce((x, y) -> y > x ? y : x).get());
			stats.put("avg", average);
			stats.put("sum", sum);
			return stats;
		}
		case "terms", "facet" -> {
			Map<String, Object> keys = new LinkedHashMap<>();
			Map<String, Long> counts = new LinkedHashMap<>();
			for (Object item : values) {
				String identity = canonical(item);
				keys.putIfAbsent(identity, item);
				counts.merge(identity, 1L, Long::sum);
			}
			List<String> order = new ArrayList<>(keys.keySet());
			order.sort((x, y) -> {
				int byCount = Long.compare(counts.get(y), counts.get(x));
				return byCount != 0 ? byCount : compareValues(keys.get(x), keys.get(y));
			});
			List<Object> result = new ArrayList<>();
			for (String identity : slice(order, 0, integer(a.get("size"), 10))) result.add(bucket(keys.get(identity), counts.get(identity)));
			return result;
		}
		case "histogram" -> {
			double interval = intervalNumber(a.get("interval"));
			Map<Double, Long> counts = new TreeMap<>();
			for (double v : numbers(values, kind)) counts.merge(Math.floor(v / interval) * interval, 1L, Long::sum);
			List<Object> result = new ArrayList<>();
			counts.forEach((key, count) -> result.add(bucket(key, count)));
			return result;
		}
		case "date_histogram" -> {
			double interval = seconds(a.get("interval"));
			Map<Double, Long> counts = new TreeMap<>();
			for (Object v : values) counts.merge(Math.floor(epoch(v) / interval) * interval, 1L, Long::sum);
			List<Object> result = new ArrayList<>();
			counts.forEach((key, count) -> result.add(bucket(timestamp(key), count)));
			return result;
		}
		case "percentiles" -> {
			List<Double> sorted = new ArrayList<>(numbers(values, kind));
			sorted.sort(Double::compare);
			Map<String, Object> result = new LinkedHashMap<>();
			for (int p : PERCENTS) result.put(Integer.toString(p), percentile(sorted, p / 100.0));
			return result;
		}
		default -> throw new IllegalArgumentException("unknown aggregation kind " + kind);
		}
	}

	private static Map<String, Object> bucket(Object key, long count) {
		Map<String, Object> result = new LinkedHashMap<>();
		result.put("key", key);
		result.put("count", count);
		return result;
	}

	/** percentile_cont: linear interpolation between the closest ranks. */
	private static Double percentile(List<Double> sorted, double fraction) {
		if (sorted.isEmpty()) return null;
		double position = fraction * (sorted.size() - 1);
		int low = (int) Math.floor(position);
		int high = Math.min(low + 1, sorted.size() - 1);
		return sorted.get(low) + (sorted.get(high) - sorted.get(low)) * (position - low);
	}

	private static double intervalNumber(Object interval) {
		if (isNumber(interval) && number(interval) > 0) return number(interval);
		if (interval instanceof String text && NUMBER.matcher(text.strip()).matches() && Double.parseDouble(text.strip()) > 0) {
			return Double.parseDouble(text.strip());
		}
		throw new IllegalArgumentException("a histogram without a numeric interval");
	}

	// ---------------------------------------------------------------- time

	/** An interval such as 1d, 12h or 1 day 6 hours, in seconds (PostgreSQL interval units of fixed length). */
	private static double seconds(Object interval) {
		if (isNumber(interval) && number(interval) > 0) return number(interval);
		if (!(interval instanceof String given)) throw new IllegalArgumentException("an interval is a string such as 1d or 12h");
		String text = given.strip();
		double sum = 0;
		int position = 0;
		Matcher matcher = INTERVAL.matcher(text);
		while (position < text.length()) {
			if (!matcher.find(position) || matcher.start() != position || !UNITS.containsKey(matcher.group(2).toLowerCase(java.util.Locale.ROOT))) {
				throw new IllegalArgumentException("an interval of numbers with the units ms, s, m, h, d or w: " + given);
			}
			sum += Double.parseDouble(matcher.group(1)) * UNITS.get(matcher.group(2).toLowerCase(java.util.Locale.ROOT));
			position = matcher.end();
			while (position < text.length() && text.charAt(position) == ' ') position++;
		}
		if (!(sum > 0)) throw new IllegalArgumentException("an interval of numbers with the units ms, s, m, h, d or w: " + given);
		return sum;
	}

	/** Days since 1970-01-01 of a proleptic Gregorian date. */
	private static long days(long year, long month, long day) {
		long y = year - (month <= 2 ? 1 : 0);
		long era = Math.floorDiv(y, 400);
		long yoe = y - era * 400;
		long doy = (153 * (month + (month > 2 ? -3 : 9)) + 2) / 5 + day - 1;
		long doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
		return era * 146097 + doe - 719468;
	}

	/** Seconds since the epoch of an ISO 8601 timestamp (UTC unless it carries an offset), of now, or of a number of seconds. */
	private static double epoch(Object item) {
		if (isNumber(item)) return number(item);
		if ("now".equals(item)) return System.currentTimeMillis() / 1000.0;
		Matcher match = item instanceof String text ? TIMESTAMP.matcher(text) : null;
		if (match == null || !match.matches()) throw new IllegalArgumentException("a timestamp in ISO 8601 form: " + canonical(item));
		long year = Long.parseLong(match.group(1));
		long month = Long.parseLong(match.group(2));
		long day = Long.parseLong(match.group(3));
		long hour = match.group(4) == null ? 0 : Long.parseLong(match.group(4));
		long minute = match.group(5) == null ? 0 : Long.parseLong(match.group(5));
		long second = match.group(6) == null ? 0 : Long.parseLong(match.group(6));
		if (!(month >= 1 && month <= 12 && day >= 1 && day <= 31 && hour < 24 && minute < 60 && second < 60)) {
			throw new IllegalArgumentException("a timestamp in ISO 8601 form: " + item);
		}
		double result = days(year, month, day) * 86400 + hour * 3600 + minute * 60 + second
				+ Double.parseDouble("0" + (match.group(7) == null ? "" : match.group(7)));
		String zone = match.group(8);
		if (zone != null && !zone.equals("Z") && !zone.equals("z")) {
			String digits = zone.substring(1).replace(":", "");
			long shift = Long.parseLong(digits.substring(0, 2)) * 3600 + (digits.length() > 2 ? Long.parseLong(digits.substring(2, 4)) * 60 : 0);
			result -= zone.charAt(0) == '+' ? shift : -shift;
		}
		return result;
	}

	/** A bin start as PostgreSQL prints a timestamp in JSON: 2026-11-16T12:00:00, with up to six fraction digits. */
	private static String timestamp(double secondsSinceEpoch) {
		long micros = (long) Math.floor(secondsSinceEpoch * 1_000_000 + 0.5);
		long dayCount = Math.floorDiv(micros, 86_400_000_000L);
		long rest = micros - dayCount * 86_400_000_000L;
		long z = dayCount + 719468;
		long era = Math.floorDiv(z, 146097);
		long doe = z - era * 146097;
		long yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
		long doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
		long mp = (5 * doy + 2) / 153;
		long day = doy - (153 * mp + 2) / 5 + 1;
		long month = mp + (mp < 10 ? 3 : -9);
		long year = yoe + era * 400 + (month <= 2 ? 1 : 0);
		long second = rest / 1_000_000;
		long fraction = rest % 1_000_000;
		String text = String.format("%04d-%02d-%02dT%02d:%02d:%02d", year, month, day, second / 3600, second / 60 % 60, second % 60);
		return text + (fraction != 0 ? "." + String.format("%06d", fraction).replaceAll("0+$", "") : "");
	}

	// ---------------------------------------------------------------- projection and values

	/**
	 * The hit object: key, score, the output fields in output order (all fields for {@code output *}) without the excluded ones,
	 * the stored vectors with with-vectors, then the highlight and the explanation as the target gave them.
	 */
	private static Map<String, Object> project(Hit hit, Map<?, ?> spec, String keyField) {
		Set<Object> excluded = new HashSet<>(list(spec.get("exclude")));
		Map<String, Object> record = new LinkedHashMap<>();
		record.put(keyField, hit.key);
		if (hit.score != null) record.put("score", hit.score);
		List<String> names = new ArrayList<>();
		if (spec.get("output") instanceof List<?> output) {
			for (Object name : output) {
				if (hit.fields.containsKey(name)) names.add(String.valueOf(name));
			}
		} else {
			for (Object name : hit.fields.keySet()) names.add(String.valueOf(name));
		}
		for (String name : names) {
			if (!name.equals(keyField) && !excluded.contains(name)) record.put(name, hit.fields.get(name));
		}
		if (Boolean.TRUE.equals(spec.get("withVectors"))) {
			for (Map.Entry<?, ?> vector : hit.vectors.entrySet()) {
				if (!excluded.contains(vector.getKey())) record.put(String.valueOf(vector.getKey()), vector.getValue());
			}
		}
		if (hit.highlight != null) record.put("highlight", hit.highlight);
		if (hit.explanation != null) record.put("explanation", hit.explanation);
		return record;
	}

	/**
	 * Result values in one form for every host language: floats rounded to six digits (half to even on the exact binary value),
	 * integral values as Long.
	 */
	private static Object value(Object item) {
		if (item instanceof Double || item instanceof Float || item instanceof BigDecimal) {
			double x = ((Number) item).doubleValue();
			if (!Double.isFinite(x)) return x;
			double rounded = Double.parseDouble(new BigDecimal(x).setScale(DIGITS, RoundingMode.HALF_EVEN).toString());
			return rounded == Math.rint(rounded) && Math.abs(rounded) < 1e15 ? (Object) (long) rounded : (Object) rounded;
		}
		if (item instanceof Integer || item instanceof Short || item instanceof Byte) return ((Number) item).longValue();
		if (item instanceof List<?> items) {
			List<Object> result = new ArrayList<>();
			for (Object entry : items) result.add(value(entry));
			return result;
		}
		if (item instanceof Map<?, ?> entries) {
			Map<String, Object> result = new LinkedHashMap<>();
			for (Map.Entry<?, ?> entry : entries.entrySet()) result.put(String.valueOf(entry.getKey()), value(entry.getValue()));
			return result;
		}
		return item;
	}
}
