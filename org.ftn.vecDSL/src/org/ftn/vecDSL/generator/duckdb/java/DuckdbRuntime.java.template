package {{java.package}};

import java.io.IOException;
import java.math.BigDecimal;
import java.math.RoundingMode;
import java.nio.file.Files;
import java.nio.file.Path;
import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.ResultSetMetaData;
import java.sql.SQLException;
import java.sql.Statement;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.Collection;
import java.util.HashSet;
import java.util.LinkedHashMap;
import java.util.LinkedHashSet;
import java.util.List;
import java.util.Map;
import java.util.Set;
import java.util.regex.Pattern;

import com.google.gson.Gson;
import com.google.gson.GsonBuilder;
import com.google.gson.JsonParseException;
import com.google.gson.JsonParser;
import com.google.gson.ToNumberPolicy;

/**
 * Runtime support for vecDSL programs generated for DuckDB with the vss and fts extensions, through the DuckDB JDBC driver and
 * Gson. Generated by vecDSL 7. Do not edit.
 *
 * DuckDB runs inside this process over one database file; there is no server. Every statement arrives as SQL text with
 * numbered parameters ($1, $2, ...), identical in the Python, TypeScript and Java programs; DuckDB prepares $n placeholders
 * itself, so parameter n is bound with setString(n). Parameters are sent as text (lists and objects as JSON text) and cast in
 * the SQL; queries return one JSON value per row. Each call runs in its own transaction (BEGIN ... COMMIT on a connection in
 * autocommit mode). Search settings are applied with SET before the statement and RESET after it (DuckDB has no SET LOCAL).
 */
public final class DuckdbRuntime {

	private static final int DIGITS = 6;
	private static final int BATCH = 500;
	private static final List<String> EXTENSIONS = List.of("vss", "fts");
	private static final Pattern SETTING = Pattern.compile("[a-z_]+");
	private static final Pattern SETTING_VALUE = Pattern.compile("[0-9]+|true|false");
	private static final Gson PRETTY = new GsonBuilder().serializeNulls().setPrettyPrinting().create();
	private static final Gson NUMBERS = new GsonBuilder().setObjectToNumberStrategy(ToNumberPolicy.LONG_OR_DOUBLE).create();

	private DuckdbRuntime() {
	}

	public static final class UnsupportedFeature extends UnsupportedOperationException {

		private static final long serialVersionUID = 1L;

		UnsupportedFeature(String message) {
			super(message);
		}
	}

	public static RuntimeException unsupported(String vendor, String feature) {
		return new UnsupportedFeature(feature + " is not supported for target " + vendor);
	}

	// ---------------------------------------------------------------- values

	public static Map<String, Object> args(Object... pairs) {
		Map<String, Object> result = new LinkedHashMap<>();
		for (int i = 0; i < pairs.length; i += 2) {
			result.put((String) pairs[i], pairs[i + 1]);
		}
		return result;
	}

	public static List<Object> list(Object... items) {
		return new ArrayList<>(Arrays.asList(items));
	}

	public static String env(String name) {
		String value = System.getenv(name);
		if (value == null) {
			throw new IllegalStateException("environment variable " + name + " is not set");
		}
		return value;
	}

	public static String envOr(String name, String fallback) {
		String value = System.getenv(name);
		return value == null ? fallback : value;
	}

	public static String text(Object value) {
		return value == null ? null : value.toString();
	}

	public static long integer(Object value) {
		return ((Number) value).longValue();
	}

	public static double decimal(Object value) {
		return ((Number) value).doubleValue();
	}

	public static boolean flag(Object value) {
		return (Boolean) value;
	}

	public static List<Float> floats(Object value) {
		return ((Collection<?>) value).stream().map(item -> ((Number) item).floatValue()).toList();
	}

	public static List<String> texts(Object value) {
		return ((Collection<?>) value).stream().map(String::valueOf).toList();
	}

	@SuppressWarnings("unchecked")
	public static List<Map<String, Object>> records(Object value) {
		return (List<Map<String, Object>>) value;
	}

	public static String toJson(Object value) {
		return PRETTY.toJson(value);
	}

	public static Map<String, Object> parameters(Map<String, Object> given, Map<String, Object> defaults, List<String> names) {
		Set<String> unknown = new HashSet<>(given.keySet());
		unknown.removeAll(names);
		if (!unknown.isEmpty()) {
			throw new IllegalArgumentException("unknown program parameters: " + unknown);
		}
		Map<String, Object> values = new LinkedHashMap<>(defaults);
		values.putAll(given);
		List<String> missing = names.stream().filter(name -> !values.containsKey(name)).toList();
		if (!missing.isEmpty()) {
			throw new IllegalArgumentException("missing program parameters: " + missing);
		}
		return values;
	}

	public static Map<String, Object> parseArguments(String[] arguments) {
		Map<String, Object> parameters = new LinkedHashMap<>();
		for (String argument : arguments) {
			int separator = argument.indexOf('=');
			if (separator < 0) {
				throw new IllegalArgumentException("expected name=value, got " + argument);
			}
			String raw = argument.substring(separator + 1);
			Object value;
			try {
				value = NUMBERS.fromJson(JsonParser.parseString(raw), Object.class);
			} catch (JsonParseException e) {
				value = raw;
			}
			parameters.put(argument.substring(0, separator), value);
		}
		return parameters;
	}

	/** Result values in one form for every host language: floats rounded, integral numbers as integers. */
	@SuppressWarnings("unchecked")
	static Object value(Object item) {
		if (item instanceof Float || item instanceof Double) {
			double number = ((Number) item).doubleValue();
			if (!Double.isFinite(number)) {
				return number;
			}
			double rounded = new BigDecimal(number).setScale(DIGITS, RoundingMode.HALF_EVEN).doubleValue();
			return rounded == Math.rint(rounded) && Math.abs(rounded) < 1e15 ? (Object) (long) rounded : (Object) rounded;
		}
		if (item instanceof Number number) {
			return number.longValue();
		}
		if (item instanceof Collection<?> items) {
			return items.stream().map(DuckdbRuntime::value).toList();
		}
		if (item instanceof Map<?, ?> map) {
			Map<String, Object> result = new LinkedHashMap<>();
			((Map<String, Object>) map).forEach((key, entry) -> result.put(key, value(entry)));
			return result;
		}
		return item;
	}

	/** A parameter as text: strings as they are, booleans and numbers in JSON form, lists and objects as JSON. */
	static String parameter(Object value) {
		if (value == null || value instanceof String) {
			return (String) value;
		}
		StringBuilder out = new StringBuilder();
		json(value, out);
		return out.toString();
	}

	private static void json(Object value, StringBuilder out) {
		if (value == null) {
			out.append("null");
		} else if (value instanceof String text) {
			out.append(PRETTY.toJson(text));
		} else if (value instanceof Boolean flag) {
			out.append(flag);
		} else if (value instanceof Float || value instanceof Double) {
			double number = ((Number) value).doubleValue();
			if (number == Math.rint(number) && Math.abs(number) < 1e15) {
				out.append((long) number);
			} else {
				out.append(value instanceof Float single ? Float.toString(single) : Double.toString(number));
			}
		} else if (value instanceof Number number) {
			out.append(number.longValue());
		} else if (value instanceof Map<?, ?> map) {
			out.append('{');
			boolean first = true;
			for (Map.Entry<?, ?> entry : map.entrySet()) {
				if (!first) {
					out.append(',');
				}
				first = false;
				out.append(PRETTY.toJson(String.valueOf(entry.getKey()))).append(':');
				json(entry.getValue(), out);
			}
			out.append('}');
		} else if (value instanceof Collection<?> items) {
			out.append('[');
			boolean first = true;
			for (Object item : items) {
				if (!first) {
					out.append(',');
				}
				first = false;
				json(item, out);
			}
			out.append(']');
		} else {
			throw new IllegalArgumentException("cannot send " + value.getClass().getName() + " as a parameter");
		}
	}

	// ---------------------------------------------------------------- connection

	/** One in-process DuckDB connection: the extensions are loaded first, then the database file is attached and used. */
	public static final class Client implements AutoCloseable {

		final String path;
		final Connection connection;

		Client(String path, boolean readOnly, String extensionDirectory) {
			this.path = path;
			try {
				connection = DriverManager.getConnection("jdbc:duckdb:");
				connection.setAutoCommit(true);
				if (extensionDirectory != null && !extensionDirectory.isEmpty()) {
					plain(connection, "SET extension_directory = " + literal(extensionDirectory));
				}
				for (String name : EXTENSIONS) {
					load(name);
				}
				plain(connection, "SET hnsw_enable_experimental_persistence = true");
				plain(connection, "SET hnsw_prefilter = true");
				if (!":memory:".equals(path)) {
					Path parent = Path.of(path).toAbsolutePath().getParent();
					if (parent != null) {
						Files.createDirectories(parent);
					}
					plain(connection, "ATTACH " + literal(path) + " AS vecdsl" + (readOnly ? " (READ_ONLY)" : ""));
					plain(connection, "USE vecdsl");
				}
			} catch (SQLException | IOException e) {
				throw new IllegalStateException("cannot open the DuckDB database " + path + ": " + e.getMessage(), e);
			}
		}

		private void load(String name) throws SQLException {
			try {
				plain(connection, "LOAD " + name);
				return;
			} catch (SQLException e) {
				// not installed yet
			}
			try {
				plain(connection, "INSTALL " + name);
				plain(connection, "LOAD " + name);
			} catch (SQLException e) {
				throw new IllegalStateException("the DuckDB extension " + name + " could not be installed: INSTALL downloads it once from "
						+ "extensions.duckdb.org; set VECDSL_DUCKDB_EXTENSIONS to a directory that holds it (" + e.getMessage() + ")", e);
			}
		}

		@Override
		public void close() {
			try {
				connection.close();
			} catch (SQLException e) {
				throw new IllegalStateException(e);
			}
		}
	}

	private static String literal(String text) {
		return "'" + text.replace("'", "''") + "'";
	}

	public static Client connect(Map<String, Object> args) {
		Object readOnly = args.get("read_only");
		return new Client((String) args.get("path"), Boolean.TRUE.equals(readOnly), (String) args.get("extension_directory"));
	}

	// ---------------------------------------------------------------- statements

	/** One step: the decoded rows of a query, or {counter: changed rows} of a write. */
	@SuppressWarnings("unchecked")
	private static Object run(Connection connection, Map<String, Object> step) throws SQLException {
		List<?> params = step.get("params") == null ? List.of() : (List<?>) step.get("params");
		Object counter = step.get("counter");
		try (PreparedStatement statement = connection.prepareStatement((String) step.get("sql"))) {
			for (int i = 0; i < params.size(); i++) {
				statement.setString(i + 1, parameter(params.get(i)));
			}
			List<Object> rows = new ArrayList<>();
			long changed = 0;
			if (statement.execute()) {
				try (ResultSet result = statement.getResultSet()) {
					ResultSetMetaData meta = result.getMetaData();
					while (result.next()) {
						if (counter != null) {
							changed = result.getLong(1);
						} else {
							String json = meta.getColumnCount() == 0 ? null : result.getString(1);
							rows.add(json == null ? null : value(NUMBERS.fromJson(JsonParser.parseString(json), Object.class)));
						}
					}
				}
			} else {
				changed = statement.getLargeUpdateCount();
			}
			if (counter == null) {
				return rows;
			}
			Map<String, Object> result = new LinkedHashMap<>();
			result.put((String) counter, changed);
			if (Boolean.TRUE.equals(step.get("skipped"))) {
				result.put("skipped", ((Collection<?>) params.get(0)).size() - changed);
			}
			return result;
		}
	}

	private static void plain(Connection connection, String sql) throws SQLException {
		try (Statement statement = connection.createStatement()) {
			statement.execute(sql);
		}
	}

	/**
	 * The steps in one transaction, then each distinct refresh statement once: rebuilding an fts index twice in one transaction
	 * fails at commit (DuckDB 2.0.0, measured).
	 */
	@SuppressWarnings("unchecked")
	private static List<Object> inTransaction(Client client, List<?> steps, Map<String, Object> settings) {
		Connection connection = client.connection;
		List<String> applied = new ArrayList<>();
		try {
			try {
				if (settings != null) {
					for (Map.Entry<String, Object> setting : settings.entrySet()) {
						String value = String.valueOf(setting.getValue());
						if (!SETTING.matcher(setting.getKey()).matches() || !SETTING_VALUE.matcher(value).matches()) {
							throw new IllegalArgumentException("invalid DuckDB setting " + setting.getKey() + " = " + value);
						}
						plain(connection, "SET " + setting.getKey() + " = " + value);
						applied.add(setting.getKey());
					}
				}
				plain(connection, "BEGIN TRANSACTION");
				try {
					List<Object> results = new ArrayList<>();
					Set<String> refresh = new LinkedHashSet<>();
					for (Object step : steps) {
						Map<String, Object> entry = (Map<String, Object>) step;
						results.add(run(connection, entry));
						if (entry.get("refresh") != null) {
							for (Object sql : (List<Object>) entry.get("refresh")) {
								refresh.add((String) sql);
							}
						}
					}
					for (String sql : refresh) {
						plain(connection, sql);
					}
					plain(connection, "COMMIT");
					return results;
				} catch (SQLException | RuntimeException e) {
					plain(connection, "ROLLBACK");
					throw e;
				}
			} finally {
				for (String name : applied) {
					plain(connection, "RESET " + name);
				}
			}
		} catch (SQLException e) {
			throw new IllegalStateException(e.getMessage(), e);
		}
	}

	@SuppressWarnings("unchecked")
	private static Map<String, Object> settings(Map<String, Object> args) {
		return (Map<String, Object>) args.get("settings");
	}

	/** The JSON values of a query's rows. */
	@SuppressWarnings("unchecked")
	public static List<Object> query(Client client, Map<String, Object> args) {
		return (List<Object>) inTransaction(client, List.of(args("sql", args.get("sql"), "params", args.get("params"))), settings(args)).get(0);
	}

	/** The JSON value of the first row, or null. */
	public static Object value(Client client, Map<String, Object> args) {
		List<Object> rows = query(client, args);
		return rows.isEmpty() ? null : rows.get(0);
	}

	public static boolean exists(Client client, Map<String, Object> args) {
		return Boolean.TRUE.equals(value(client, args));
	}

	/** A write and the statements that refresh what depends on it (full-text indexes), in one transaction: {counter: rows}. */
	public static Object change(Client client, Map<String, Object> args) {
		return inTransaction(client, List.of(args), null).get(0);
	}

	/** Statements without results (DDL) in one transaction. */
	public static void execute(Client client, Map<String, Object> args) {
		inTransaction(client, (List<?>) args.get("steps"), null);
	}

	/** The statements of a vecDSL transaction in one DuckDB transaction; any failure rolls back all of them. */
	public static List<Object> transaction(Client client, Map<String, Object> args) {
		List<Object> results = new ArrayList<>();
		for (Object result : inTransaction(client, (List<?>) args.get("steps"), null)) {
			results.add(result instanceof List<?> rows ? (rows.isEmpty() ? null : rows.get(0)) : result);
		}
		return results;
	}

	/** Records of a local JSON array or JSON Lines file (file:// URI or path). */
	@SuppressWarnings("unchecked")
	public static List<Map<String, Object>> readRecords(Client client, Map<String, Object> args) {
		String location = (String) args.get("location");
		Path path = Path.of(location.startsWith("file://") ? location.substring("file://".length()) : location);
		String content;
		try {
			content = Files.readString(path);
		} catch (IOException e) {
			throw new IllegalStateException("cannot read " + location + ": " + e.getMessage(), e);
		}
		if (content.stripLeading().startsWith("[")) {
			return (List<Map<String, Object>>) NUMBERS.fromJson(content, List.class);
		}
		List<Map<String, Object>> records = new ArrayList<>();
		for (String line : content.split("\\r?\\n")) {
			if (!line.isBlank()) {
				records.add((Map<String, Object>) NUMBERS.fromJson(line, Map.class));
			}
		}
		return records;
	}

	/** A local file written in batches by one INSERT statement ($1 is the batch), all in one transaction. */
	@SuppressWarnings("unchecked")
	public static Object importFile(Client client, Map<String, Object> args) {
		List<Map<String, Object>> records = readRecords(client, args);
		int size = args.get("batch_size") == null ? BATCH : ((Number) args.get("batch_size")).intValue();
		List<Object> extra = args.get("params") == null ? List.of() : (List<Object>) args.get("params");
		String counter = (String) args.get("counter");
		List<Object> steps = new ArrayList<>();
		for (int start = 0; start < records.size(); start += size) {
			List<Object> params = new ArrayList<>();
			params.add(new ArrayList<>(records.subList(start, Math.min(records.size(), start + size))));
			params.addAll(extra);
			steps.add(args("sql", args.get("sql"), "params", params, "counter", counter, "skipped", args.get("skipped"), "refresh",
					start + size >= records.size() ? args.get("refresh") : null));
		}
		Map<String, Object> totals = new LinkedHashMap<>();
		totals.put(counter, 0L);
		for (Object counts : inTransaction(client, steps, null)) {
			((Map<String, Object>) counts).forEach((key, count) -> totals.merge(key, ((Number) count).longValue(), (a, b) -> (Long) a + (Long) b));
		}
		return totals;
	}
}
