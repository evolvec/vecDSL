# vecDSL: the model-driven bundles, the language specification, the toolchain (vecdsl-cli, vecdsl-lsp), the VS Code
# extension, the Capability Matrix site and CI. Only the files and folders listed below belong to the repository.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/NOTICE
!/TROUBLESHOOTING.md
!/org.ftn.vecDSL/
!/org.ftn.vecDSL.ide/
!/org.ftn.vecDSL.ui/
!/org.ftn.vecDSL.tests/
!/org.ftn.vecDSL.ui.tests/
!/spec/
!/vecdsl-cli/
!/vecdsl-lsp/
!/vscode-vecdsl/
!/coverage-site/
!/ci/
!/.github/

# Build outputs (Eclipse, Maven, Xtend, Python)
bin/
!/vecdsl-cli/bin/
!/vecdsl-lsp/bin/
test-bin/
target/
*._trace
*.xtendbin
.antlr-generator-*.jar
__pycache__/
*.pyc

# Build outputs of vscode-vecdsl (npm, esbuild, tsc, vsce, the VS Code test)
node_modules/
vscode-vecdsl/out/
vscode-vecdsl/out-test/
vscode-vecdsl/server/
vscode-vecdsl/.vscode-test/
*.vsix

# Built by coverage-site/tools/build_site.py and by the ci/ scripts
coverage-site/site/
ci/.work/

# Written by the tests and the Eclipse builder
org.ftn.vecDSL.tests/generated/
org.ftn.vecDSL.tests/samples/generated/
org.ftn.vecDSL.tests/scenarios/scenario-results.csv
org.ftn.vecDSL.tests/scenarios/negative/negative-results.csv
