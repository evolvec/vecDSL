# The expected numbers of every CI step, read by the ci/ scripts (bash `source`). A 15th vendor or a new test changes
# this file only. Where each number comes from: ci/README.md, "expected.env".

# Vendors, in the order of VecDSLOutputConfigurationProvider.VENDORS, and the coverage index
VENDORS="milvus pinecone weaviate qdrant chroma pgvector redis mongodb oracledb elasticsearch opensearch vespa lancedb duckdb"
COVERAGE_ROWS=456

# Capability Matrix site: files written by build_site.py (index, about, style.css, per vendor a page and a badge, per
# construct a page, per sample a page, the CI badge)
SITE_FILES=516

# vecdsl-cli: mvn -q clean package (surefire)
CLI_TESTS="ArgsTest=8 VecdslTest=13"

# vecdsl-lsp: mvn -q clean package (surefire, then failsafe against the shaded jar), the scripted client and the sweep
LSP_SUREFIRE="LspClientTest=25 MainTest=2 RootlessClientTest=1"
LSP_FAILSAFE="LspClientTest=25 RootlessClientTest=1"
LSP_CLIENT_SUMMARY="25 of 25 checks passed"
LSP_SWEEP_SUMMARY="589 statements, 9282 requests, 18576 sections, 9282 passed, 0 failed, 0 answered with an error"

# org.ftn.vecDSL.tests without Eclipse (ci/tests/pom.xml)
CORE_TESTS=1959

# vscode-vecdsl
EXT_GRAMMAR="checked: 584 keywords (13 vendor ids), brackets {} [] ()"
EXT_TESTS=19
EXT_VSIX_FILES=12

# Samples: vecdsl check, gen for the own target (files per sample of each vendor), gen through every generator with
# the targets line removed, ir --check
SAMPLES=28
CHECK_SUMMARY="28 programs, 0 errors, 18 warnings"
GEN_FILES_PER_SAMPLE="milvus=12 pinecone=11 weaviate=11 qdrant=11 chroma=11 pgvector=11 redis=11 mongodb=14 oracledb=12 elasticsearch=11 opensearch=14 vespa=11 lancedb=11 duckdb=11"
GEN_OWN_FILES=324
# sample:vendor pairs that stop with an internal error (exit 3): the Weaviate printers
# have no Python, TypeScript or Java form for a sparse vector literal (WeaviatePython.expr: "no Python form for
# Sparse[...]"), which these five samples use. Remove a pair when the generator is fixed.
GEN_ALL_KNOWN_FAILURES="elasticsearch_full:weaviate opensearch_full:weaviate oracledb_full:weaviate pgvector_full:weaviate pinecone_full:weaviate"
GEN_ALL_FILES=4481
IR_CHECK_SUMMARY="28 programs, 28 round trips passed, 0 failed"
