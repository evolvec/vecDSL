{
  "name": "vscode-vecdsl",
  "displayName": "vecDSL",
  "description": "vecDSL language support from the vecDSL Language Server (vecdsl-lsp), with a preview of the code vecdsl gen writes for each statement",
  "version": "0.1.2",
  "publisher": "vecdsl",
  "author": "Elena Akik",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:vecdsl"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "vecdsl",
        "aliases": [
          "vecDSL"
        ],
        "extensions": [
          ".vecDSL"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "vecdsl",
        "scopeName": "source.vecdsl",
        "path": "./syntaxes/vecdsl.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "vecDSL",
      "properties": {
        "vecdsl.java.home": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Java home (21 or later) whose `bin/java` starts the language server. Empty: `JAVA_HOME`, else the `java.home` of the `java` on the PATH. Read when the server starts."
        },
        "vecdsl.lsp.jar": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path of `vecdsl-lsp.jar`. Empty: the jar in the extension's `server` folder. Read when the server starts."
        },
        "vecdsl.lsp.log": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Log file of the language server (`--log`); a relative path is taken from the first workspace folder. Empty: the server logs to the output channel \"vecDSL Language Server\". Read when the server starts."
        },
        "vecdsl.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "scope": "window",
          "description": "Traces the protocol between VS Code and the language server in the output channel."
        },
        "vecdsl.preview.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Shows a code lens above each statement that opens the generated-code preview."
        },
        "vecdsl.preview.target": {
          "type": "string",
          "default": "",
          "markdownDescription": "Target of the code lens. Empty: the first of the program's `targets [...]`, else the first target the server lists."
        },
        "vecdsl.preview.language": {
          "type": "string",
          "enum": [
            "python",
            "typescript",
            "java"
          ],
          "default": "python",
          "description": "Host language of the code lens."
        }
      }
    },
    "commands": [
      {
        "command": "vecdsl.restartServer",
        "title": "Restart Language Server",
        "category": "vecDSL"
      },
      {
        "command": "vecdsl.showServerLog",
        "title": "Show Server Log",
        "category": "vecDSL"
      },
      {
        "command": "vecdsl.previewGeneratedCode",
        "title": "Preview Generated Code",
        "category": "vecDSL"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "vecdsl.previewGeneratedCode",
          "when": "editorLangId == vecdsl"
        }
      ]
    }
  },
  "scripts": {
    "grammar": "python tools/tmgrammar.py",
    "check-grammar": "python tools/tmgrammar.py --check",
    "compile": "tsc -p . && node esbuild.mjs",
    "lint": "eslint .",
    "test": "tsc -p tsconfig.test.json && node --test out-test/test/*.test.js",
    "test:integration": "tsc -p tsconfig.test.json && node out-test/integration/run.js",
    "server": "node tools/copy-server.mjs",
    "notices": "python tools/notices.py",
    "check-notices": "python tools/notices.py --check",
    "vscode:prepublish": "npm run check-grammar && npm run compile && npm run check-notices && npm run server"
  },
  "dependencies": {
    "vscode-languageclient": "11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "20.19.43",
    "@types/vscode": "1.91.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  },
  "vsce": {
    "dependencies": false,
    "allowMissingRepository": true
  }
}
