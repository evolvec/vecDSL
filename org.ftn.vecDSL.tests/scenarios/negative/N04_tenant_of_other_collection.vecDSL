// Judgment: Resolution-D6. Intended: reject. A write is scoped to a tenant of another collection.
script n04
version "7.1"

createArticles: create collection articles {
    primary key
    field key type varchar
    field topic type varchar
    vector-field embedding type float_vector dim 4 metric cosine
    tenant acme
}

createBooks: create collection books {
    primary id
    field id type varchar
    field genre type varchar
    vector-field embedding type float_vector dim 4 metric cosine
}

seed: upsert into books values [
    { id: "00000000-0000-4000-8000-000000000001", genre: "fiction", embedding: [0.9, 0.1, 0.0, 0.1] },
    { id: "00000000-0000-4000-8000-000000000002", genre: "science", embedding: [0.1, 0.8, 0.2, 0.0] }
] tenant acme
