// Axis: hybrid search, S1 plus a full-text field and an RRF-fused search with one vector leg and one keyword leg. Hypothesis: realizable where the engine fuses a vector leg and a lexical leg with RRF.
script s5Hybrid
version "7.1"

createBooks: create collection books {
    primary id
    field id type varchar
    field genre type varchar
    field body type text full-text
    vector-field embedding type float_vector dim 4 metric cosine
}

seed: upsert into books values [
    { id: "00000000-0000-4000-8000-000000000001", genre: "fiction", body: "a novel about vector spaces", embedding: [0.9, 0.1, 0.0, 0.1] },
    { id: "00000000-0000-4000-8000-000000000002", genre: "science", body: "a survey of index structures", embedding: [0.1, 0.8, 0.2, 0.0] }
]

nearest: vector-search in books top 10 query vector [0.8, 0.2, 0.1, 0.0] using embedding
    output [id, genre]
    where genre eq "fiction"

fused: hybrid-search in books top 10 fusion rrf {
    vector { query vector [0.8, 0.2, 0.1, 0.0] using embedding limit 50 }
    keyword { query text "vector index" fields [body] limit 50 }
} output [id, genre]
